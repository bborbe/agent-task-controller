/ notFoundAttempts is the total number of times WriteResult looks for the task file\n60\t// before giving up, and notFoundBackoff is the pause between those attempts.\n61\t//\n62\t// A miss is not always permanent: the controller lists files over git-rest's HTTP API\n63\t// rather than a local clone, and git-rest pulls on a timer, so a result can arrive\n64\t// before the file it belongs to is visible. Without a retry that result is dropped for\n65\t// good — WriteResult acks the Kafka message either way.\n66\t//\n67\t// Retrying in-process rather than by returning an error is deliberate. The consumer runs\n68\t// SkipCorruptBatches:false on an offset consumer, so a message that keeps failing is\n69\t// never skipped; returning an error for a permanently-missing file (deleted or renamed\n70\t// task) would block the partition and halt the controller. An in-process retry bounds the\n71\t// cost at notFoundBackoff*(notFoundAttempts-1) per miss and always lets the offset advance.\n72\tconst (\n73\t\tnotFoundAttempts = 3\n74\t\tnotFoundBackoff  = libtime.Duration(time.Second)\n75\t)\n76\t\n77\t// FindTaskFilePath lists files in taskDir via gitClient and returns the relative path of\n78\t// the .md file whose frontmatter has task_identifier == id, plus the parsed existing frontmatter.\n79\t// Returns (\"\", nil, nil) when no match is found (not an error).\n80\t// Returns (\"\", nil, err) naming both paths when more than one file carries id: the match is\n81\t// ambiguous, so no caller may write. Callers must check the error before treating an empty\n82\t// path as \"not found\" — the two outcomes mean opposite things.\n83\tfunc FindTaskFilePath(\n84\t\tctx context.Context,\n85\t\tgitClient gitclient.GitClient,\n86\t\ttaskDir string,\n87\t\tid lib.TaskIdentifier,\n88\t) (string, lib.TaskFrontmatter, error) {\n89\t\tglob := taskDir + \"/*.md\"\n90\t\tpaths, err := gitClient.ListFiles(ctx, glob)\n91\t\tif err != nil {\n92\t\t\treturn \"\", nil, errors.Wrapf(ctx, err, \"list task files with glob %s\", glob)\n93\t\t}\n94\t\tvar matchedRelPath string\n95\t\tvar existingFrontmatter lib.TaskFrontmatter\n96\t\tfor _, relPath := range paths {\n97\t\t\tcontent, readErr := gitClient.ReadFile(ctx, relPath)\n98\t\t\tif readErr != nil {\n99\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (read error: %v)\", relPath, readErr)\n100\t\t\t\tcontinue\n101\t\t\t}\n102\t\t\tfrontmatter, fmErr := ExtractFrontmatter(ctx, content)\n103\t\t\tif fmErr != nil {\n104\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (frontmatter error: %v)\", relPath, fmErr)\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tvar fm struct {\n108\t\t\t\tTaskIdentifier string `yaml:\"task_identifier\"`\n109\t\t\t}\n110\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &fm); umErr != nil {\n111\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (unmarshal error: %v)\", relPath, umErr)\n112\t\t\t\tcontinue\n113\t\t\t}\n114\t\t\tglog.V(3).\n115\t\t\t\tInfof(\"FindTaskFilePath: file %s has task_identifier=%s\", relPath, fm.TaskIdentifier)\n116\t\t\tif lib.TaskIdentifier(fm.TaskIdentifier) == id {\n117\t\t\t\t// Two files sharing one task_identifier is never resolvable: picking\n118\t\t\t\t// either one writes an agent's result onto a file that may belong to a\n119\t\t\t\t// different task. The previous behaviour silently kept the LAST match\n120\t\t\t\t// from an unsorted ListFiles, which on 2026-08-31 marked\n121\t\t\t\t// `Sentry Alert Fan-Out - 2026-08-31` done/completed carrying another\n122\t\t\t\t// task's analysis, for a run no executor ever performed. Fail loudly\n123\t\t\t\t// instead — the caller must not write anything.\n124\t\t\t\tif matchedRelPath != \"\" {\n125\t\t\t\t\treturn \"\", nil, errors.Errorf(\n126\t\t\t\t\t\tctx,\n127\t\t\t\t\t\t\"duplicate task_identifier %s in %s and %s\",\n128\t\t\t\t\t\tid, matchedRelPath, relPath,\n129\t\t\t\t\t)\n130\t\t\t\t}\n131\t\t\t\tmatchedRelPath = relPath\n132\t\t\t\tglog.V(2).Infof(\"FindTaskFilePath: matched file %s for task %s\", matchedRelPath, id)\n133\t\t\t\tvar existingFm lib.TaskFrontmatter\n134\t\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &existingFm); umErr != nil {\n135\t\t\t\t\tglog.V(3).\n136\t\t\t\t\t\tInfof(\"FindTaskFilePath: could not unmarshal existing frontmatter for %s: %v\", relPath, umErr)\n137\t\t\t\t} else {\n138\t\t\t\t\texistingFrontmatter = existingFm\n139\t\t\t\t}\n140\t\t\t}\n141\t\t}\n142\t\treturn matchedRelPath, existingFrontmatter, nil\n143\t}\n144\t\n145\tfunc (r *resultWriter) WriteResult(ctx context.Context, req lib.Task) error {\n146\t\tglog.V(2).Infof(\"WriteResult: starting for task %s\", req.TaskIdentifier)\n147\t\tglog.V(3).Infof(\"WriteResult: scanning taskDir=%s\", r.taskDir)\n148\t\n149\t\tvar matchedRelPath string\n150\t\tfor attempt := 1; attempt <= notFoundAttempts; attempt++ {\n151\t\t\tvar err error\n152\t\t\tmatchedRelPath, _, err = FindTaskFilePath(\n153\t\t\t\tctx,\n154\t\t\t\tr.gitClient,\n155\t\t\t\tr.taskDir,\n156\t\t\t\treq.TaskIdentifier,\n157\t\t\t)\n158\t\t\tif err != nil {\n159\t\t\t\treturn errors.Wrapf(ctx, err, \"find task file path failed\")\n160\t\t\t}\n161\t\t\tif matchedRelPath != \"\" {\n162\t\t\t\tif attempt > 1 {\n163\t\t\t\t\t// Unconditional: this is the only signal separating a transient\n164\t\t\t\t\t// git-rest lag miss from a permanent one, and the `not_found`\n165\t\t\t\t\t// alert threshold is tuned from that split.\n166\t\t\t\t\tglog.Infof(\n167\t\t\t\t\t\t\"task file for identifier %s resolved on attempt %d of %d\",\n168\t\t\t\t\t\treq.TaskIdentifier,\n169\t\t\t\t\t\tattempt,\n170\t\t\t\t\t\tnotFoundAttempts,\n171\t\t\t\t\t)\n172\t\t\t\t}\n173\t\t\t\tbreak\n174\t\t\t}\n175\t\t\tif attempt == notFoundAttempts {\n176\t\t\t\tbreak\n177\t\t\t}\n178\t\t\tglog.V(2).Infof(\n179\t\t\t\t\"task file not found for identifier %s on attempt %d of %d, retrying in %v\",\n180\t\t\t\treq.TaskIdentifier,\n181\t\t\t\tattempt,\n182\t\t\t\tnotFoundAttempts,\n183\t\t\t\tnotFoundBackoff,\n184\t\t\t)\n185\t\t\tif waitErr := r.waiter.Wait(ctx, notFoundBackoff); waitErr != nil {\n186\t\t\t\treturn errors.Wrapf(ctx, waitErr, \"wait before retrying task file lookup\")\n187\t\t\t}\n188\t\t}\n189\t\n190\t\tif matchedRelPath == \"\" {\n191\t\t\tglog.Warningf(\n192\t\t\t\t\"task file not found for identifier %s after %d attempts, skipping\",\n193\t\t\t\treq.TaskIdentifier,\n194\t\t\t\tnotFoundAttempts,\n195\t\t\t)\n196\t\t\tr.metrics.ResultsWrittenTotal(\"not_found\").Inc()\n197\t\t\treturn nil\n198\t\t}\n199\t\n200\t\tabsPath := filepath.Join(r.gitClient.Path(), matchedRelPath)\n201\t\tcommitMessage := fmt.Sprintf(\n202\t\t\t\"[agent-task-controller] write result for task %s\",\n203\t\t\treq.TaskIdentifier,\n204\t\t)\n205\t\tglog.V(2).Infof(\"WriteResult: writing and pushing for task %s\", req.TaskIdentifier)\n206\t\tif err := r.gitClient.AtomicReadModifyWriteAndCommitPush(\n207\t\t\tctx,\n208\t\t\tabsPath,\n209\t\t\tr.buildResultModifyFn(ctx, req),\n210\t\t\tcommitMessage,\n211\t\t); err != nil {\n212\t\t\tr.metrics.ResultsWrittenTotal(\"error\").Inc()\n213\t\t\treturn errors.Wrapf(ctx, err, \"atomic read-modify-write and push failed\")\n214\t\t}\n215\t\n216\t\tglog.V(2).Infof(\"WriteResult: completed successfully for task %s\", req.TaskIdentifier)\n217\t\tr.metrics.ResultsWrittenTotal(\"success\").Inc()\n218\t\treturn nil\n219\t}\n220\t\n221\t// buildResultModifyFn returns a modify callback for AtomicReadModifyWriteAndCommitPush\n222\t// that re-reads the on-disk frontmatter+body on every git retry, then applies the\n223\t// merge / retry-counter / cap rules. Re-reading per retry eliminates the read-then-write\n224\t// race against the partial-update executor (task_update_frontmatter_executor.go) that\n225\t// previously caused stale-snapshot writes to roll back terminal status.\n226\tfunc (r *resultWriter) buildResultModifyFn(\n227\t\tctx context.Context,\n228\t\treq lib.Task,\n229\t) func(current []byte) ([]byte, error) {\n230\t\treturn func(current []byte) ([]byte, error) {\n231\t\t\tfrontmatterStr, err := ExtractFrontmatter(ctx, current)\n232\t\t\tif err != nil {\n233\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n234\t\t\t}\n235\t\t\tbodyStr, err := ExtractBody(ctx, current)\n236\t\t\tif err != nil {\n237\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n238\t\t\t}\n239\t\t\tvar currentOnDisk lib.TaskFrontmatter\n240\t\t\t// NOTE: inlined yaml ops mirror the pre-race version of WriteResult; pkg/command/ helpers\n241\t\t\t// are unexported and the lift-and-share is out of scope for this race fix.\n242\t\t\tif err := yaml.Unmarshal([]byte(frontmatterStr), &currentOnDisk); err != nil {\n243\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal current frontmatter\")\n244\t\t\t}\n245\t\n246\t\t\tmerged, decisions := MergeFrontmatter(currentOnDisk, req.Frontmatter)\n247\t\t\tfor _, d := range decisions {\n248\t\t\t\tglog.Infof(\n249\t\t\t\t\t\"ownership guard kept on-disk: task %s field %s kept %v rejected %v\",\n250\t\t\t\t\treq.TaskIdentifier,\n251\t\t\t\t\td.Field,\n252\t\t\t\t\td.Kept,\n253\t\t\t\t\td.Rejected,\n254\t\t\t\t)\n255\t\t\t}\n256\t\t\tbody := r.applyRetryCounter(merged, currentOnDisk, string(req.Content))\n257\t\n258\t\t\tmarshaledFrontmatter, err := yaml.Marshal(map[string]any(merged))\n259\t\t\tif err != nil {\n260\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n261\t\t\t}\n262\t\t\t// Discard the on-disk body — WriteResult fully replaces body with req.Content\n263\t\t\t// (post-applyRetryCounter modifications), matching the prior single-write\n264\t\t\t// semantics. bodyStr is read above only to validate the file has well-formed\n265\t\t\t// delimiters; an extraction error must surface so we do not silently overwrite a\n266\t\t\t// corrupted file.\n267\t\t\t_ = bodyStr\n268\t\t\treturn []byte(\"---\\n\" + string(marshaledFrontmatter) + \"---\\n\" + body), nil\n269\t\t}\n270\t}\n271\t\n272\tfunc (r *resultWriter) applyRetryCounter(merged, existing lib.TaskFrontmatter, body string) string {\n273\t\tif isTerminalStatus(merged.Status()) {\n274\t\t\treturn body\n275\t\t}\n276\t\n277\t\t// Trigger-count cap enforcement runs unconditionally before any early\n278\t\t// returns below: it is a derived invariant on the on-disk state that\n279\t\t// must hold after every WriteResult. Placing it here also prevents the\n280\t\t// spawn_notification short-circuit below from silently skipping\n281\t\t// escalation on agent result writes that inherited spawn_notification\n282\t\t// from a previous merge (observed live on dev 2026-04-24, task\n283\t\t// ba1bad61: spawn-notification update set spawn_notification=true,\n284\t\t// then the agent's result publish inherited it via mergeFrontmatter\n285\t\t// and skipped the cap check, reverting phase: human_review to\n286\t\t// ai_review). The triggerCount > 0 guard prevents degenerate\n287\t\t// escalation of brand-new tasks where trigger_count is absent.\n288\t\ttriggerCount := merged.TriggerCount()\n289\t\tbody = r.applyTriggerCap(merged, existing, triggerCount, body)\n290\t\n291\t\t// human_review assignee-clear guard runs BEFORE the spawn_notification\n292\t\t// early return below. On a pr-reviewer agent's first post-spawn write, the merged\n293\t\t// frontmatter carries spawn_notification: true (inherited from the executor's\n294\t\t// spawn-time UpdateFrontmatterCommand) AND incoming phase: human_review (from\n295\t\t// Result.NextPhase via resolveNextPhase). If this guard were below the\n296\t\t// spawn_notification early return, clearAssignee would never fire and the\n297\t\t// operator inbox filter (assignee == \"\") would miss the task. Same bug class\n298\t\t// as prompt 075 (2026-04-24 applyTriggerCap precedent, task ba1bad61); spec 041\n299\t\t// fixes the 2026-05-25 prod incident (task bborbe-agent #3).\n300\t\t// needs_input: agent explicitly requested human review — clear assignee so task surfaces in operator inbox.\n301\t\t// Routes through ClearAssigneeIfHumanReview (spec 042) so the partial-update executor shares the same chokepoint.\n302\t\tClearAssigneeIfHumanReview(merged)\n303\t\n304\t\tif merged.SpawnNotification() {\n305\t\t\tdelete(merged, \"spawn_notification\")\n306\t\t\treturn body\n307\t\t}\n308\t\n309\t\t// retry_count is authoritative in the task file — the executor bumped it\n310\t\t// at spawn time (spec 011). The writer only applies escalation.\n311\t\tretryCount := merged.RetryCount()\n312\t\tbody = r.applyRetryCap(merged, existing, retryCount, body)\n313\t\n314\t\treturn body\n315\t}\n316\t\n317\t// applyTriggerCap enforces the trigger-count cap. The cap is opt-in: an absent\n318\t// max_triggers means no cap, so recurring tasks that accumulate trigger_count\n319\t// across re-dispatches are never escalated and never have their routing assignee\n320\t// stripped (the lib default-3 fallback would kill the re-dispatch loop). The\n321\t// triggerCount > 0 guard prevents degenerate escalation of brand-new tasks where\n322\t// trigger_count is absent. When the task is already parked (section present),\n323\t// existing.Phase() restores the on-disk lifecycle phase to prevent stale-result\n324\t// phase clobber (cap stickiness).\n325\tfunc (r *resultWriter) applyTriggerCap(\n326\t\tmerged, existing lib.TaskFrontmatter,\n327\t\ttriggerCount int,\n328\t\tbody string,\n329\t) string {\n330\t\tif _, ok := merged[\"max_triggers\"]; !ok {\n331\t\t\treturn body\n332\t\t}\n333\t\tif triggerCount == 0 || triggerCount < merged.MaxTriggers() {\n334\t\t\treturn body\n335\t\t}\n336\t\tagentName := clearAssignee(merged)\n337\t\tif containsEscalationSection(body, \"## Trigger Cap Escalation\") {\n338\t\t\trestoreExistingPhase(existing, merged)\n339\t\t\treturn body\n340\t\t}\n341\t\treturn body + r.triggerEscalationSection(triggerCount, agentName, merged)\n342\t}\n343\t\n344\t// applyRetryCap enforces the retry-count cap. The cap is opt-in: an absent max_retries\n345\t// means no cap, so tasks that accumulate retry_count across re-dispatches are never\n346\t// escalated and never have their routing assignee stripped (the lib default-3 fallback\n347\t// would kill the re-dispatch loop). When the task is already parked (section present),\n348\t// existing.Phase() restores the on-disk lifecycle phase (cap stickiness).\n349\tfunc (r *resultWriter) applyRetryCap(\n350\t\tmerged, existing lib.TaskFrontmatter,\n351\t\tretryCount int,\n352\t\tbody string,\n353\t) string {\n354\t\tif _, ok := merged[\"max_retries\"]; !ok {\n355\t\t\treturn body\n356\t\t}\n357\t\tif retryCount < merged.MaxRetries() {\n358\t\t\treturn body\n359\t\t}\n360\t\tagentName := clearAssignee(merged)\n361\t\tif containsEscalationSection(body, \"## Retry Escalation\") {\n362\t\t\trestoreExistingPhase(existing, merged)\n363\t\t\treturn body\n364\t\t}\n365\t\treturn body + r.escalationSection(retryCount, agentName)\n366\t}\n367\t\n368\t// clearAssignee sets previous_assignee to the current assignee value (if non-empty),\n369\t// then clears assignee to \"\". Returns the captured name for use in escalation body text.\n370\t// This is the single chokepoint for all assignee-clear operations in the result writer.\n371\tfunc clearAssignee(merged lib.TaskFrontmatter) string {\n372\t\tagentName := string(merged.Assignee())\n373\t\tif agentName != \"\" {\n374\t\t\tmerged[\"previous_assignee\"] = agentName\n375\t\t}\n376\t\tmerged[\"assignee\"] = \"\"\n377\t\treturn agentName\n378\t}\n379\t\n380\t// ClearAssigneeIfHumanReview enforces the spec-039 / spec-042 doctrine:\n381\t// when merged frontmatter has phase == \"human_review\", clear assignee via\n382\t// clearAssignee (which captures the prior assignee into previous_assignee\n383\t// if non-empty, then sets assignee to \"\"). Returns the prior assignee\n384\t// name (empty string when no clear happened OR when the prior assignee\n385\t// was already empty). This is the single chokepoint for the human_review\n386\t// assignee-clear invariant; both the result writer and the partial-update\n387\t// executor (spec 042) route through here.\n388\tfunc ClearAssigneeIfHumanReview(merged lib.TaskFrontmatter) string {\n389\t\tif phase, ok := merged[\"phase\"].(string); ok && phase == \"human_review\" {\n390\t\t\treturn clearAssignee(merged)\n391\t\t}\n392\t\treturn \"\"\n393\t}\n394\t\n395\t// restoreExistingPhase writes the on-disk phase back into merged when the existing\n396\t// frontmatter has a phase value. Used to enforce cap stickiness on repeated writes.\n397\tfunc restoreExistingPhase(existing, merged lib.TaskFrontmatter) {\n398\t\tif p := existing.Phase(); p != nil {\n399\t\t\tmerged[\"phase\"] = string(*p)\n400\t\t}\n401\t}\n402\t\n403\tfunc (r *resultWriter) escalationSection(retryCount int, agentName string) string {\n404\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n405\t\treturn fmt.Sprintf(\n406\t\t\t\"\\n## Retry Escalation\\n\\n- **Timestamp:** %s\\n- **Attempts:** %d\\n- **Assignee:** %s\\n- **Last error:** see agent output above\\n\",\n407\t\t\tts,\n408\t\t\tretryCount,\n409\t\t\tagentName,\n410\t\t)\n411\t}\n412\t\n413\tfunc (r *resultWriter) triggerEscalationSection(\n414\t\ttriggerCount int,\n415\t\tagentName string,\n416\t\tmerged lib.TaskFrontmatter,\n417\t) string {\n418\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n419\t\treturn fmt.Sprintf(\n420\t\t\t\"\\n## Trigger Cap Escalation\\n\\n- **Timestamp:** %s\\n- **Trigger count:** %d\\n- **Max triggers:** %d\\n- **Assignee:** %s\\n- **Last agent output:** see `## Result` above\\n\",\n421\t\t\tts,\n422\t\t\ttriggerCount,\n423\t\t\tmerged.MaxTriggers(),\n424\t\t\tagentName,\n425\t\t)\n426\t}\n427\t\n428\t// containsEscalationSection reports whether body already has the given\n429\t// escalation header on its own line. Used to prevent duplicate escalation\n430\t// sections when WriteResult runs multiple times on a task that is already\n431\t// at cap (e.g. agent publishes another result while the task sits in\n432\t// phase: human_review).\n433\tfunc containsEscalationSection(body, header string) bool {\n434\t\treturn strings.Contains(body, \"\\n\"+header+\"\\n\")\n435\t}\n436\t\n437\t// GuardDecision records a single ownership-guard discard: the merge kept the\n438\t// on-disk value of a controller-owned field (or the pinned terminal status) and\n439\t// rejected a differing incoming value. Equal values produce no decision.\n440\ttype GuardDecision struct {\n441\t\tField    string\n442\t\tKept     any\n443\t\tRejected any\n444\t}\n445\t\n446\t// controllerOwnedFields lists frontmatter keys whose on-disk value always wins:\n447\t// the result writer never lets the agent's incoming value overwrite them, and an\n448\t// incoming value can never introduce a controller-owned key that is absent on disk.\n449\tvar controllerOwnedFields = []string{\n450\t\t\"trigger_count\",\n451\t\t\"retry_count\",\n452\t}\n453\t\n454\t// terminalStatuses lists the statuses that end a task's lifecycle. When the on-disk\n455\t// status is terminal, the merge pins it (discarding the incoming status) and the\n456\t// escalation machinery short-circuits. Terminal is decided via the normalizing\n457\t// TaskFrontmatter.Status() accessor compared against these constants.\n458\tvar terminalStatuses = []domain.TaskStatus{\n459\t\tdomain.TaskStatusCompleted,\n460\t\tdomain.TaskStatusAborted,\n461\t}\n462\t\n463\t// MergeFrontmatter returns a new frontmatter map with all keys from existing,\n464\t// overridden by all keys from incoming, then applies the field-ownership guard:\n465\t// controller-owned counters take the on-disk value when present on disk and are\n466\t// absent from the result when not; a terminal on-disk status is pinned. The\n467\t// returned decisions name every field whose differing incoming value was discarded\n468\t// (equal values produce no decision). Neither input map is modified.\n469\tfunc MergeFrontmatter(\n470\t\texisting, incoming lib.TaskFrontmatter,\n471\t) (lib.TaskFrontmatter, []GuardDecision) {\n472\t\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n473\t\tfor k, v := range existing {\n474\t\t\tmerged[k] = v\n475\t\t}\n476\t\tfor k, v := range incoming {\n477\t\t\tmerged[k] = v\n478\t\t}\n479\t\tvar decisions []GuardDecision\n480\t\n481\t\t// Controller-owned counters: the on-disk value always wins when the key exists\n482\t\t// on disk (kept verbatim, whatever its type); a key absent on disk stays absent\n483\t\t// even if the incoming payload carries it.\n484\t\tfor _, field := range controllerOwnedFields {\n485\t\t\tdiskValue, onDisk := existing[field]\n486\t\t\tincomingValue, inIncoming := incoming[field]\n487\t\t\tif !onDisk {\n488\t\t\t\tif inIncoming {\n489\t\t\t\t\tdelete(merged, field)\n490\t\t\t\t}\n491\t\t\t\tcontinue\n492\t\t\t}\n493\t\t\tmerged[field] = diskValue\n494\t\t\tif inIncoming && !frontmatterValueEqual(diskValue, incomingValue) {\n495\t\t\t\tdecisions = append(\n496\t\t\t\t\tdecisions,\n497\t\t\t\t\tGuardDecision{Field: field, Kept: diskValue, Rejected: incomingValue},\n498\t\t\t\t)\n499\t\t\t}\n500\t\t}\n501\t\n502\t\t// Terminal on-disk status is pinned: the on-disk status value is kept and the\n503\t\t// incoming status is discarded. Terminal is decided by the normalizing Status()\n504\t\t// accessor compared against terminalStatuses, never by raw string equality on\n505\t\t// the unparsed value. The status decision is reported only when the normalized\n506\t\t// values differ (an incoming alias such as \"done\" against on-disk \"completed\"\n507\t\t// is normalized-equal and produces no decision).\n508\t\tif diskStatus, onDisk := existing[\"status\"]; onDisk && isTerminalStatus(existing.Status()) {\n509\t\t\tmerged[\"status\"] = diskStatus\n510\t\t\tif incomingStatus, ok := incoming[\"status\"]; ok && existing.Status() != incoming.Status() {\n511\t\t\t\tdecisions = append(\n512\t\t\t\t\tdecisions,\n513\t\t\t\t\tGuardDecision{Field: \"status\", Kept: diskStatus, Rejected: incomingStatus},\n514\t\t\t\t)\n515\t\t\t}\n516\t\t}\n517\t\n518\t\treturn merged, decisions\n519\t}\n520\t\n521\tfunc isTerminalStatus(s domain.TaskStatus) bool {\n522\t\tfor _, t := range terminalStatuses {\n523\t\t\tif s == t {\n524\t\t\t\treturn true\n525\t\t\t}\n526\t\t}\n527\t\treturn false\n528\t}\n529\t\n530\t// frontmatterValueEqual reports whether two frontmatter values compare equal,\n531\t// treating numeric int/float64 pairs as equal so a JSON-decoded incoming counter\n532\t// (float64) equals a YAML-decoded on-disk counter (int) at steady state — equal\n533\t// counters must produce no guard log line (DB 6).\n534\tfunc frontmatterValueEqual(a, b any) bool {\n535\t\t// NEVER use `a == b` on two `any` values here. Go panics with\n536\t\t// \"comparing uncomparable type map[string]interface {}\" when both sides hold\n537\t\t// the same uncomparable dynamic type, and both sides come from YAML (on disk)\n538\t\t// or JSON (incoming payload) decoding, either of which can yield a map or a\n539\t\t// slice. A panic here would kill the single result-write chokepoint. The spec's\n540\t\t// Failure Modes table requires a non-integer on-disk counter to be kept\n541\t\t// verbatim, not to crash. reflect.DeepEqual never panics.\n542\t\taf, aOK := numericValue(a)\n543\t\tbf, bOK := numericValue(b)\n544\t\tif aOK && bOK {\n545\t\t\treturn af == bf\n546\t\t}\n547\t\treturn reflect.DeepEqual(a, b)\n548\t}\n549\t\n550\tfunc numericValue(v any) (float64, bool) {\n551\t\tswitch n := v.(type) {\n552\t\tcase int:\n553\t\t\treturn float64(n), true\n554\t\tcase int64:\n555\t\t\treturn float64(n), true\n556\t\tcase float64:\n557\t\t\treturn n, true\n558\t\tdefault:\n559\t\t\treturn 0, false\n560\t\t}\n561\t}\n562\t\n563\t// ExtractFrontmatter returns the YAML frontmatter string between the opening and\n564\t// closing \"---\" delimiters. Returns an error if delimiters are missing.\n565\tfunc ExtractFrontmatter(ctx context.Context, content []byte) (string, error) {\n566\t\ts := string(content)\n567\t\tconst delim = \"---\"\n568\t\tif !strings.HasPrefix(s, delim) {\n569\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n570\t\t}\n571\t\trest := strings.TrimPrefix(s, delim)\n572\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n573\t\t\trest = rest[2:]\n574\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n575\t\t\trest = rest[1:]\n576\t\t}\n577\t\tbefore, _, found := strings.Cut(rest, \"\\n---\")\n578\t\tif !found {\n579\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n580\t\t}\n581\t\treturn before, nil\n582\t}\n583\t\n584\t// ExtractBody returns the file body — the bytes after the closing \"---\\n\" delimiter.\n585\t// Returns an empty string if the body is empty; error if delimiters are missing.\n586\tfunc ExtractBody(ctx context.Context, content []byte) (string, error) {\n587\t\ts := string(content)\n588\t\tconst delim = \"---\"\n589\t\tif !strings.HasPrefix(s, delim) {\n590\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n591\t\t}\n592\t\trest := strings.TrimPrefix(s, delim)\n593\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n594\t\t\trest = rest[2:]\n595\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n596\t\t\trest = rest[1:]\n597\t\t}\n598\t\t_, after, found := strings.Cut(rest, \"\\n---\\n\")\n599\t\tif !found {\n600\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n601\t\t}\n602\t\treturn after, nil\n603\t}\n604\t"}]},"parent_tool_use_id":"chatcmpl-tool-a4a9f6d255065971","session_id":"f8060dff-ade6-47a7-ae93-9a11186adf90","uuid":"67c415ac-1668-4829-adf3-d04ead23a5e5","timestamp":"2026-09-03T18:17:30.642Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 (code change)"}
