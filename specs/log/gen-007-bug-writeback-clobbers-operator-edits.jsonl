{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8f8c6e5fb66f901c","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage result\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\t\"path/filepath\"\n11\t\t\"reflect\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\t\"github.com/bborbe/errors\"\n17\t\tlibtime \"github.com/bborbe/time\"\n18\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n19\t\t\"github.com/golang/glog\"\n20\t\t\"gopkg.in/yaml.v3\"\n21\t\n22\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n23\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n24\t)\n25\t\n26\t//counterfeiter:generate -o ../../mocks/result_writer.go --fake-name ResultWriter . ResultWriter\n27\t\n28\t// ResultWriter writes a Task back to the vault task file.\n29\ttype ResultWriter interface {\n30\t\tWriteResult(ctx context.Context, req lib.Task) error\n31\t}\n32\t\n33\t// NewResultWriter creates a ResultWriter that locates task files in the vault\n34\t// and writes the result, committing via gitClient.\n35\tfunc NewResultWriter(\n36\t\tgitClient gitclient.GitClient,\n37\t\ttaskDir string,\n38\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n39\t\tm metrics.Metrics,\n40\t\twaiter libtime.WaiterDuration,\n41\t) ResultWriter {\n42\t\treturn &resultWriter{\n43\t\t\tgitClient:       gitClient,\n44\t\t\ttaskDir:         taskDir,\n45\t\t\tcurrentDateTime: currentDateTime,\n46\t\t\tmetrics:         m,\n47\t\t\twaiter:          waiter,\n48\t\t}\n49\t}\n50\t\n51\ttype resultWriter struct {\n52\t\tgitClient       gitclient.GitClient\n53\t\ttaskDir         string\n54\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n55\t\tmetrics         metrics.Metrics\n56\t\twaiter          libtime.WaiterDuration\n57\t}\n58\t\n59\t// notFoundAttempts is the total number of times WriteResult looks for the task file\n60\t// before giving up, and notFoundBackoff is the pause between those attempts.\n61\t//\n62\t// A miss is not always permanent: the controller lists files over git-rest's HTTP API\n63\t// rather than a local clone, and git-rest pulls on a timer, so a result can arrive\n64\t// before the file it belongs to is visible. Without a retry that result is dropped for\n65\t// good — WriteResult acks the Kafka message either way.\n66\t//\n67\t// Retrying in-process rather than by returning an error is deliberate. The consumer runs\n68\t// SkipCorruptBatches:false on an offset consumer, so a message that keeps failing is\n69\t// never skipped; returning an error for a permanently-missing file (deleted or renamed\n70\t// task) would block the partition and halt the controller. An in-process retry bounds the\n71\t// cost at notFoundBackoff*(notFoundAttempts-1) per miss and always lets the offset advance.\n72\tconst (\n73\t\tnotFoundAttempts = 3\n74\t\tnotFoundBackoff  = libtime.Duration(time.Second)\n75\t)\n76\t\n77\t// FindTaskFilePath lists files in taskDir via gitClient and returns the relative path of\n78\t// the .md file whose frontmatter has task_identifier == id, plus the parsed existing frontmatter.\n79\t// Returns (\"\", nil, nil) when no match is found (not an error).\n80\t// Returns (\"\", nil, err) naming both paths when more than one file carries id: the match is\n81\t// ambiguous, so no caller may write. Callers must check the error before treating an empty\n82\t// path as \"not found\" — the two outcomes mean opposite things.\n83\tfunc FindTaskFilePath(\n84\t\tctx context.Context,\n85\t\tgitClient gitclient.GitClient,\n86\t\ttaskDir string,\n87\t\tid lib.TaskIdentifier,\n88\t) (string, lib.TaskFrontmatter, error) {\n89\t\tglob := taskDir + \"/*.md\"\n90\t\tpaths, err := gitClient.ListFiles(ctx, glob)\n91\t\tif err != nil {\n92\t\t\treturn \"\", nil, errors.Wrapf(ctx, err, \"list task files with glob %s\", glob)\n93\t\t}\n94\t\tvar matchedRelPath string\n95\t\tvar existingFrontmatter lib.TaskFrontmatter\n96\t\tfor _, relPath := range paths {\n97\t\t\tcontent, readErr := gitClient.ReadFile(ctx, relPath)\n98\t\t\tif readErr != nil {\n99\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (read error: %v)\", relPath, readErr)\n100\t\t\t\tcontinue\n101\t\t\t}\n102\t\t\tfrontmatter, fmErr := ExtractFrontmatter(ctx, content)\n103\t\t\tif fmErr != nil {\n104\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (frontmatter error: %v)\", relPath, fmErr)\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tvar fm struct {\n108\t\t\t\tTaskIdentifier string `yaml:\"task_identifier\"`\n109\t\t\t}\n110\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &fm); umErr != nil {\n111\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (unmarshal error: %v)\", relPath, umErr)\n112\t\t\t\tcontinue\n113\t\t\t}\n114\t\t\tglog.V(3).\n115\t\t\t\tInfof(\"FindTaskFilePath: file %s has task_identifier=%s\", relPath, fm.TaskIdentifier)\n116\t\t\tif lib.TaskIdentifier(fm.TaskIdentifier) == id {\n117\t\t\t\t// Two files sharing one task_identifier is never resolvable: picking\n118\t\t\t\t// either one writes an agent's result onto a file that may belong to a\n119\t\t\t\t// different task. The previous behaviour silently kept the LAST match\n120\t\t\t\t// from an unsorted ListFiles, which on 2026-08-31 marked\n121\t\t\t\t// `Sentry Alert Fan-Out - 2026-08-31` done/completed carrying another\n122\t\t\t\t// task's analysis, for a run no executor ever performed. Fail loudly\n123\t\t\t\t// instead — the caller must not write anything.\n124\t\t\t\tif matchedRelPath != \"\" {\n125\t\t\t\t\treturn \"\", nil, errors.Errorf(\n126\t\t\t\t\t\tctx,\n127\t\t\t\t\t\t\"duplicate task_identifier %s in %s and %s\",\n128\t\t\t\t\t\tid, matchedRelPath, relPath,\n129\t\t\t\t\t)\n130\t\t\t\t}\n131\t\t\t\tmatchedRelPath = relPath\n132\t\t\t\tglog.V(2).Infof(\"FindTaskFilePath: matched file %s for task %s\", matchedRelPath, id)\n133\t\t\t\tvar existingFm lib.TaskFrontmatter\n134\t\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &existingFm); umErr != nil {\n135\t\t\t\t\tglog.V(3).\n136\t\t\t\t\t\tInfof(\"FindTaskFilePath: could not unmarshal existing frontmatter for %s: %v\", relPath, umErr)\n137\t\t\t\t} else {\n138\t\t\t\t\texistingFrontmatter = existingFm\n139\t\t\t\t}\n140\t\t\t}\n141\t\t}\n142\t\treturn matchedRelPath, existingFrontmatter, nil\n143\t}\n144\t\n145\tfunc (r *resultWriter) WriteResult(ctx context.Context, req lib.Task) error {\n146\t\tglog.V(2).Infof(\"WriteResult: starting for task %s\", req.TaskIdentifier)\n147\t\tglog.V(3).Infof(\"WriteResult: scanning taskDir=%s\", r.taskDir)\n148\t\n149\t\tvar matchedRelPath string\n150\t\tfor attempt := 1; attempt <= notFoundAttempts; attempt++ {\n151\t\t\tvar err error\n152\t\t\tmatchedRelPath, _, err = FindTaskFilePath(\n153\t\t\t\tctx,\n154\t\t\t\tr.gitClient,\n155\t\t\t\tr.taskDir,\n156\t\t\t\treq.TaskIdentifier,\n157\t\t\t)\n158\t\t\tif err != nil {\n159\t\t\t\treturn errors.Wrapf(ctx, err, \"find task file path failed\")\n160\t\t\t}\n161\t\t\tif matchedRelPath != \"\" {\n162\t\t\t\tif attempt > 1 {\n163\t\t\t\t\t// Unconditional: this is the only signal separating a transient\n164\t\t\t\t\t// git-rest lag miss from a permanent one, and the `not_found`\n165\t\t\t\t\t// alert threshold is tuned from that split.\n166\t\t\t\t\tglog.Infof(\n167\t\t\t\t\t\t\"task file for identifier %s resolved on attempt %d of %d\",\n168\t\t\t\t\t\treq.TaskIdentifier,\n169\t\t\t\t\t\tattempt,\n170\t\t\t\t\t\tnotFoundAttempts,\n171\t\t\t\t\t)\n172\t\t\t\t}\n173\t\t\t\tbreak\n174\t\t\t}\n175\t\t\tif attempt == notFoundAttempts {\n176\t\t\t\tbreak\n177\t\t\t}\n178\t\t\tglog.V(2).Infof(\n179\t\t\t\t\"task file not found for identifier %s on attempt %d of %d, retrying in %v\",\n180\t\t\t\treq.TaskIdentifier,\n181\t\t\t\tattempt,\n182\t\t\t\tnotFoundAttempts,\n183\t\t\t\tnotFoundBackoff,\n184\t\t\t)\n185\t\t\tif waitErr := r.waiter.Wait(ctx, notFoundBackoff); waitErr != nil {\n186\t\t\t\treturn errors.Wrapf(ctx, waitErr, \"wait before retrying task file lookup\")\n187\t\t\t}\n188\t\t}\n189\t\n190\t\tif matchedRelPath == \"\" {\n191\t\t\tglog.Warningf(\n192\t\t\t\t\"task file not found for identifier %s after %d attempts, skipping\",\n193\t\t\t\treq.TaskIdentifier,\n194\t\t\t\tnotFoundAttempts,\n195\t\t\t)\n196\t\t\tr.metrics.ResultsWrittenTotal(\"not_found\").Inc()\n197\t\t\treturn nil\n198\t\t}\n199\t\n200\t\tabsPath := filepath.Join(r.gitClient.Path(), matchedRelPath)\n201\t\tcommitMessage := fmt.Sprintf(\n202\t\t\t\"[agent-task-controller] write result for task %s\",\n203\t\t\treq.TaskIdentifier,\n204\t\t)\n205\t\tglog.V(2).Infof(\"WriteResult: writing and pushing for task %s\", req.TaskIdentifier)\n206\t\tif err := r.gitClient.AtomicReadModifyWriteAndCommitPush(\n207\t\t\tctx,\n208\t\t\tabsPath,\n209\t\t\tr.buildResultModifyFn(ctx, req),\n210\t\t\tcommitMessage,\n211\t\t); err != nil {\n212\t\t\tr.metrics.ResultsWrittenTotal(\"error\").Inc()\n213\t\t\treturn errors.Wrapf(ctx, err, \"atomic read-modify-write and push failed\")\n214\t\t}\n215\t\n216\t\tglog.V(2).Infof(\"WriteResult: completed successfully for task %s\", req.TaskIdentifier)\n217\t\tr.metrics.ResultsWrittenTotal(\"success\").Inc()\n218\t\treturn nil\n219\t}\n220\t\n221\t// buildResultModifyFn returns a modify callback for AtomicReadModifyWriteAndCommitPush\n222\t// that re-reads the on-disk frontmatter+body on every git retry, then applies the\n223\t// merge / retry-counter / cap rules. Re-reading per retry eliminates the read-then-write\n224\t// race against the partial-update executor (task_update_frontmatter_executor.go) that\n225\t// previously caused stale-snapshot writes to roll back terminal status.\n226\tfunc (r *resultWriter) buildResultModifyFn(\n227\t\tctx context.Context,\n228\t\treq lib.Task,\n229\t) func(current []byte) ([]byte, error) {\n230\t\treturn func(current []byte) ([]byte, error) {\n231\t\t\tfrontmatterStr, err := ExtractFrontmatter(ctx, current)\n232\t\t\tif err != nil {\n233\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n234\t\t\t}\n235\t\t\tbodyStr, err := ExtractBody(ctx, current)\n236\t\t\tif err != nil {\n237\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n238\t\t\t}\n239\t\t\tvar currentOnDisk lib.TaskFrontmatter\n240\t\t\t// NOTE: inlined yaml ops mirror the pre-race version of WriteResult; pkg/command/ helpers\n241\t\t\t// are unexported and the lift-and-share is out of scope for this race fix.\n242\t\t\tif err := yaml.Unmarshal([]byte(frontmatterStr), &currentOnDisk); err != nil {\n243\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal current frontmatter\")\n244\t\t\t}\n245\t\n246\t\t\tmerged, decisions := MergeFrontmatter(currentOnDisk, req.Frontmatter)\n247\t\t\tfor _, d := range decisions {\n248\t\t\t\tglog.Infof(\n249\t\t\t\t\t\"ownership guard kept on-disk: task %s field %s kept %v rejected %v\",\n250\t\t\t\t\treq.TaskIdentifier,\n251\t\t\t\t\td.Field,\n252\t\t\t\t\td.Kept,\n253\t\t\t\t\td.Rejected,\n254\t\t\t\t)\n255\t\t\t}\n256\t\t\tbody := r.applyRetryCounter(merged, currentOnDisk, string(req.Content))\n257\t\n258\t\t\tmarshaledFrontmatter, err := yaml.Marshal(map[string]any(merged))\n259\t\t\tif err != nil {\n260\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n261\t\t\t}\n262\t\t\t// Discard the on-disk body — WriteResult fully replaces body with req.Content\n263\t\t\t// (post-applyRetryCounter modifications), matching the prior single-write\n264\t\t\t// semantics. bodyStr is read above only to validate the file has well-formed\n265\t\t\t// delimiters; an extraction error must surface so we do not silently overwrite a\n266\t\t\t// corrupted file.\n267\t\t\t_ = bodyStr\n268\t\t\treturn []byte(\"---\\n\" + string(marshaledFrontmatter) + \"---\\n\" + body), nil\n269\t\t}\n270\t}\n271\t\n272\tfunc (r *resultWriter) applyRetryCounter(merged, existing lib.TaskFrontmatter, body string) string {\n273\t\tif isTerminalStatus(merged.Status()) {\n274\t\t\treturn body\n275\t\t}\n276\t\n277\t\t// Trigger-count cap enforcement runs unconditionally before any early\n278\t\t// returns below: it is a derived invariant on the on-disk state that\n279\t\t// must hold after every WriteResult. Placing it here also prevents the\n280\t\t// spawn_notification short-circuit below from silently skipping\n281\t\t// escalation on agent result writes that inherited spawn_notification\n282\t\t// from a previous merge (observed live on dev 2026-04-24, task\n283\t\t// ba1bad61: spawn-notification update set spawn_notification=true,\n284\t\t// then the agent's result publish inherited it via mergeFrontmatter\n285\t\t// and skipped the cap check, reverting phase: human_review to\n286\t\t// ai_review). The triggerCount > 0 guard prevents degenerate\n287\t\t// escalation of brand-new tasks where trigger_count is absent.\n288\t\ttriggerCount := merged.TriggerCount()\n289\t\tbody = r.applyTriggerCap(merged, existing, triggerCount, body)\n290\t\n291\t\t// human_review assignee-clear guard runs BEFORE the spawn_notification\n292\t\t// early return below. On a pr-reviewer agent's first post-spawn write, the merged\n293\t\t// frontmatter carries spawn_notification: true (inherited from the executor's\n294\t\t// spawn-time UpdateFrontmatterCommand) AND incoming phase: human_review (from\n295\t\t// Result.NextPhase via resolveNextPhase). If this guard were below the\n296\t\t// spawn_notification early return, clearAssignee would never fire and the\n297\t\t// operator inbox filter (assignee == \"\") would miss the task. Same bug class\n298\t\t// as prompt 075 (2026-04-24 applyTriggerCap precedent, task ba1bad61); spec 041\n299\t\t// fixes the 2026-05-25 prod incident (task bborbe-agent #3).\n300\t\t// needs_input: agent explicitly requested human review — clear assignee so task surfaces in operator inbox.\n301\t\t// Routes through ClearAssigneeIfHumanReview (spec 042) so the partial-update executor shares the same chokepoint.\n302\t\tClearAssigneeIfHumanReview(merged)\n303\t\n304\t\tif merged.SpawnNotification() {\n305\t\t\tdelete(merged, \"spawn_notification\")\n306\t\t\treturn body\n307\t\t}\n308\t\n309\t\t// retry_count is authoritative in the task file — the executor bumped it\n310\t\t// at spawn time (spec 011). The writer only applies escalation.\n311\t\tretryCount := merged.RetryCount()\n312\t\tbody = r.applyRetryCap(merged, existing, retryCount, body)\n313\t\n314\t\treturn body\n315\t}\n316\t\n317\t// applyTriggerCap enforces the trigger-count cap. The cap is opt-in: an absent\n318\t// max_triggers means no cap, so recurring tasks that accumulate trigger_count\n319\t// across re-dispatches are never escalated and never have their routing assignee\n320\t// stripped (the lib default-3 fallback would kill the re-dispatch loop). The\n321\t// triggerCount > 0 guard prevents degenerate escalation of brand-new tasks where\n322\t// trigger_count is absent. When the task is already parked (section present),\n323\t// existing.Phase() restores the on-disk lifecycle phase to prevent stale-result\n324\t// phase clobber (cap stickiness).\n325\tfunc (r *resultWriter) applyTriggerCap(\n326\t\tmerged, existing lib.TaskFrontmatter,\n327\t\ttriggerCount int,\n328\t\tbody string,\n329\t) string {\n330\t\tif _, ok := merged[\"max_triggers\"]; !ok {\n331\t\t\treturn body\n332\t\t}\n333\t\tif triggerCount == 0 || triggerCount < merged.MaxTriggers() {\n334\t\t\treturn body\n335\t\t}\n336\t\tagentName := clearAssignee(merged)\n337\t\tif containsEscalationSection(body, \"## Trigger Cap Escalation\") {\n338\t\t\trestoreExistingPhase(existing, merged)\n339\t\t\treturn body\n340\t\t}\n341\t\treturn body + r.triggerEscalationSection(triggerCount, agentName, merged)\n342\t}\n343\t\n344\t// applyRetryCap enforces the retry-count cap. The cap is opt-in: an absent max_retries\n345\t// means no cap, so tasks that accumulate retry_count across re-dispatches are never\n346\t// escalated and never have their routing assignee stripped (the lib default-3 fallback\n347\t// would kill the re-dispatch loop). When the task is already parked (section present),\n348\t// existing.Phase() restores the on-disk lifecycle phase (cap stickiness).\n349\tfunc (r *resultWriter) applyRetryCap(\n350\t\tmerged, existing lib.TaskFrontmatter,\n351\t\tretryCount int,\n352\t\tbody string,\n353\t) string {\n354\t\tif _, ok := merged[\"max_retries\"]; !ok {\n355\t\t\treturn body\n356\t\t}\n357\t\tif retryCount < merged.MaxRetries() {\n358\t\t\treturn body\n359\t\t}\n360\t\tagentName := clearAssignee(merged)\n361\t\tif containsEscalationSection(body, \"## Retry Escalation\") {\n362\t\t\trestoreExistingPhase(existing, merged)\n363\t\t\treturn body\n364\t\t}\n365\t\treturn body + r.escalationSection(retryCount, agentName)\n366\t}\n367\t\n368\t// clearAssignee sets previous_assignee to the current assignee value (if non-empty),\n369\t// then clears assignee to \"\". Returns the captured name for use in escalation body text.\n370\t// This is the single chokepoint for all assignee-clear operations in the result writer.\n371\tfunc clearAssignee(merged lib.TaskFrontmatter) string {\n372\t\tagentName := string(merged.Assignee())\n373\t\tif agentName != \"\" {\n374\t\t\tmerged[\"previous_assignee\"] = agentName\n375\t\t}\n376\t\tmerged[\"assignee\"] = \"\"\n377\t\treturn agentName\n378\t}\n379\t\n380\t// ClearAssigneeIfHumanReview enforces the spec-039 / spec-042 doctrine:\n381\t// when merged frontmatter has phase == \"human_review\", clear assignee via\n382\t// clearAssignee (which captures the prior assignee into previous_assignee\n383\t// if non-empty, then sets assignee to \"\"). Returns the prior assignee\n384\t// name (empty string when no clear happened OR when the prior assignee\n385\t// was already empty). This is the single chokepoint for the human_review\n386\t// assignee-clear invariant; both the result writer and the partial-update\n387\t// executor (spec 042) route through here.\n388\tfunc ClearAssigneeIfHumanReview(merged lib.TaskFrontmatter) string {\n389\t\tif phase, ok := merged[\"phase\"].(string); ok && phase == \"human_review\" {\n390\t\t\treturn clearAssignee(merged)\n391\t\t}\n392\t\treturn \"\"\n393\t}\n394\t\n395\t// restoreExistingPhase writes the on-disk phase back into merged when the existing\n396\t// frontmatter has a phase value. Used to enforce cap stickiness on repeated writes.\n397\tfunc restoreExistingPhase(existing, merged lib.TaskFrontmatter) {\n398\t\tif p := existing.Phase(); p != nil {\n399\t\t\tmerged[\"phase\"] = string(*p)\n400\t\t}\n401\t}\n402\t\n403\tfunc (r *resultWriter) escalationSection(retryCount int, agentName string) string {\n404\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n405\t\treturn fmt.Sprintf(\n406\t\t\t\"\\n## Retry Escalation\\n\\n- **Timestamp:** %s\\n- **Attempts:** %d\\n- **Assignee:** %s\\n- **Last error:** see agent output above\\n\",\n407\t\t\tts,\n408\t\t\tretryCount,\n409\t\t\tagentName,\n410\t\t)\n411\t}\n412\t\n413\tfunc (r *resultWriter) triggerEscalationSection(\n414\t\ttriggerCount int,\n415\t\tagentName string,\n416\t\tmerged lib.TaskFrontmatter,\n417\t) string {\n418\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n419\t\treturn fmt.Sprintf(\n420\t\t\t\"\\n## Trigger Cap Escalation\\n\\n- **Timestamp:** %s\\n- **Trigger count:** %d\\n- **Max triggers:** %d\\n- **Assignee:** %s\\n- **Last agent output:** see `## Result` above\\n\",\n421\t\t\tts,\n422\t\t\ttriggerCount,\n423\t\t\tmerged.MaxTriggers(),\n424\t\t\tagentName,\n425\t\t)\n426\t}\n427\t\n428\t// containsEscalationSection reports whether body already has the given\n429\t// escalation header on its own line. Used to prevent duplicate escalation\n430\t// sections when WriteResult runs multiple times on a task that is already\n431\t// at cap (e.g. agent publishes another result while the task sits in\n432\t// phase: human_review).\n433\tfunc containsEscalationSection(body, header string) bool {\n434\t\treturn strings.Contains(body, \"\\n\"+header+\"\\n\")\n435\t}\n436\t\n437\t// GuardDecision records a single ownership-guard discard: the merge kept the\n438\t// on-disk value of a controller-owned field (or the pinned terminal status) and\n439\t// rejected a differing incoming value. Equal values produce no decision.\n440\ttype GuardDecision struct {\n441\t\tField    string\n442\t\tKept     any\n443\t\tRejected any\n444\t}\n445\t\n446\t// controllerOwnedFields lists frontmatter keys whose on-disk value always wins:\n447\t// the result writer never lets the agent's incoming value overwrite them, and an\n448\t// incoming value can never introduce a controller-owned key that is absent on disk.\n449\tvar controllerOwnedFields = []string{\n450\t\t\"trigger_count\",\n451\t\t\"retry_count\",\n452\t}\n453\t\n454\t// terminalStatuses lists the statuses that end a task's lifecycle. When the on-disk\n455\t// status is terminal, the merge pins it (discarding the incoming status) and the\n456\t// escalation machinery short-circuits. Terminal is decided via the normalizing\n457\t// TaskFrontmatter.Status() accessor compared against these constants.\n458\tvar terminalStatuses = []domain.TaskStatus{\n459\t\tdomain.TaskStatusCompleted,\n460\t\tdomain.TaskStatusAborted,\n461\t}\n462\t\n463\t// MergeFrontmatter returns a new frontmatter map with all keys from existing,\n464\t// overridden by all keys from incoming, then applies the field-ownership guard:\n465\t// controller-owned counters take the on-disk value when present on disk and are\n466\t// absent from the result when not; a terminal on-disk status is pinned. The\n467\t// returned decisions name every field whose differing incoming value was discarded\n468\t// (equal values produce no decision). Neither input map is modified.\n469\tfunc MergeFrontmatter(\n470\t\texisting, incoming lib.TaskFrontmatter,\n471\t) (lib.TaskFrontmatter, []GuardDecision) {\n472\t\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n473\t\tfor k, v := range existing {\n474\t\t\tmerged[k] = v\n475\t\t}\n476\t\tfor k, v := range incoming {\n477\t\t\tmerged[k] = v\n478\t\t}\n479\t\tvar decisions []GuardDecision\n480\t\n481\t\t// Controller-owned counters: the on-disk value always wins when the key exists\n482\t\t// on disk (kept verbatim, whatever its type); a key absent on disk stays absent\n483\t\t// even if the incoming payload carries it.\n484\t\tfor _, field := range controllerOwnedFields {\n485\t\t\tdiskValue, onDisk := existing[field]\n486\t\t\tincomingValue, inIncoming := incoming[field]\n487\t\t\tif !onDisk {\n488\t\t\t\tif inIncoming {\n489\t\t\t\t\tdelete(merged, field)\n490\t\t\t\t}\n491\t\t\t\tcontinue\n492\t\t\t}\n493\t\t\tmerged[field] = diskValue\n494\t\t\tif inIncoming && !frontmatterValueEqual(diskValue, incomingValue) {\n495\t\t\t\tdecisions = append(\n496\t\t\t\t\tdecisions,\n497\t\t\t\t\tGuardDecision{Field: field, Kept: diskValue, Rejected: incomingValue},\n498\t\t\t\t)\n499\t\t\t}\n500\t\t}\n501\t\n502\t\t// Terminal on-disk status is pinned: the on-disk status value is kept and the\n503\t\t// incoming status is discarded. Terminal is decided by the normalizing Status()\n504\t\t// accessor compared against terminalStatuses, never by raw string equality on\n505\t\t// the unparsed value. The status decision is reported only when the normalized\n506\t\t// values differ (an incoming alias such as \"done\" against on-disk \"completed\"\n507\t\t// is normalized-equal and produces no decision).\n508\t\tif diskStatus, onDisk := existing[\"status\"]; onDisk && isTerminalStatus(existing.Status()) {\n509\t\t\tmerged[\"status\"] = diskStatus\n510\t\t\tif incomingStatus, ok := incoming[\"status\"]; ok && existing.Status() != incoming.Status() {\n511\t\t\t\tdecisions = append(\n512\t\t\t\t\tdecisions,\n513\t\t\t\t\tGuardDecision{Field: \"status\", Kept: diskStatus, Rejected: incomingStatus},\n514\t\t\t\t)\n515\t\t\t}\n516\t\t}\n517\t\n518\t\treturn merged, decisions\n519\t}\n520\t\n521\tfunc isTerminalStatus(s domain.TaskStatus) bool {\n522\t\tfor _, t := range terminalStatuses {\n523\t\t\tif s == t {\n524\t\t\t\treturn true\n525\t\t\t}\n526\t\t}\n527\t\treturn false\n528\t}\n529\t\n530\t// frontmatterValueEqual reports whether two frontmatter values compare equal,\n531\t// treating numeric int/float64 pairs as equal so a JSON-decoded incoming counter\n532\t// (float64) equals a YAML-decoded on-disk counter (int) at steady state — equal\n533\t// counters must produce no guard log line (DB 6).\n534\tfunc frontmatterValueEqual(a, b any) bool {\n535\t\t// NEVER use `a == b` on two `any` values here. Go panics with\n536\t\t// \"comparing uncomparable type map[string]interface {}\" when both sides hold\n537\t\t// the same uncomparable dynamic type, and both sides come from YAML (on disk)\n538\t\t// or JSON (incoming payload) decoding, either of which can yield a map or a\n539\t\t// slice. A panic here would kill the single result-write chokepoint. The spec's\n540\t\t// Failure Modes table requires a non-integer on-disk counter to be kept\n541\t\t// verbatim, not to crash. reflect.DeepEqual never panics.\n542\t\taf, aOK := numericValue(a)\n543\t\tbf, bOK := numericValue(b)\n544\t\tif aOK && bOK {\n545\t\t\treturn af == bf\n546\t\t}\n547\t\treturn reflect.DeepEqual(a, b)\n548\t}\n549\t\n550\tfunc numericValue(v any) (float64, bool) {\n551\t\tswitch n := v.(type) {\n552\t\tcase int:\n553\t\t\treturn float64(n), true\n554\t\tcase int64:\n555\t\t\treturn float64(n), true\n556\t\tcase float64:\n557\t\t\treturn n, true\n558\t\tdefault:\n559\t\t\treturn 0, false\n560\t\t}\n561\t}\n562\t\n563\t// ExtractFrontmatter returns the YAML frontmatter string between the opening and\n564\t// closing \"---\" delimiters. Returns an error if delimiters are missing.\n565\tfunc ExtractFrontmatter(ctx context.Context, content []byte) (string, error) {\n566\t\ts := string(content)\n567\t\tconst delim = \"---\"\n568\t\tif !strings.HasPrefix(s, delim) {\n569\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n570\t\t}\n571\t\trest := strings.TrimPrefix(s, delim)\n572\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n573\t\t\trest = rest[2:]\n574\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n575\t\t\trest = rest[1:]\n576\t\t}\n577\t\tbefore, _, found := strings.Cut(rest, \"\\n---\")\n578\t\tif !found {\n579\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n580\t\t}\n581\t\treturn before, nil\n582\t}\n583\t\n584\t// ExtractBody returns the file body — the bytes after the closing \"---\\n\" delimiter.\n585\t// Returns an empty string if the body is empty; error if delimiters are missing.\n586\tfunc ExtractBody(ctx context.Context, content []byte) (string, error) {\n587\t\ts := string(content)\n588\t\tconst delim = \"---\"\n589\t\tif !strings.HasPrefix(s, delim) {\n590\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n591\t\t}\n592\t\trest := strings.TrimPrefix(s, delim)\n593\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n594\t\t\trest = rest[2:]\n595\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n596\t\t\trest = rest[1:]\n597\t\t}\n598\t\t_, after, found := strings.Cut(rest, \"\\n---\\n\")\n599\t\tif !found {\n600\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n601\t\t}\n602\t\treturn after, nil\n603\t}\n604\t"}]},"parent_tool_use_id":"chatcmpl-tool-8be384ae12952508","session_id":"f8060dff-ade6-47a7-ae93-9a11186adf90","uuid":"3b86bf9b-fedc-4a86-8418-1f9c1e063f94","timestamp":"2026-09-03T18:10:13.547Z","subagent_type":"dark-factory:prompt-creator","task_description":"Create prompts from spec 007"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ad87dba2e371dda6","type":"tool_result","content":"1\t---\n2\tstatus: completed\n3\tspec: [006-bug-frontmatter-field-ownership]\n4\tsummary: 'Implemented the field-ownership guard in the result-write chokepoint: on-disk trigger_count/retry_count always win (never introduced from the incoming payload), terminal on-disk status is pinned via the normalizing Status() accessor, the applyRetryCounter early return covers both terminal statuses, each differing-value discard emits one unconditional ''ownership guard kept on-disk'' INFO log, proven by new unit specs in pkg/result, with the CHANGELOG Unreleased entry added.'\n5\texecution_id: agent-task-controller-fieldmerge-exec-010-spec-006-field-ownership-guard\n6\tdark-factory-version: dev\n7\tcreated: \"2026-08-31T11:56:38Z\"\n8\tqueued: \"2026-08-31T12:18:44Z\"\n9\tstarted: \"2026-08-31T12:19:11Z\"\n10\tcompleted: \"2026-08-31T12:32:25Z\"\n11\tbranch: dark-factory/bug-frontmatter-field-ownership\n12\t---\n13\t\n14\t# Field-ownership guard, terminal pin, guard log, unit specs, changelog\n15\t\n16\t<summary>\n17\t\n18\t- A result publish can no longer roll back `trigger_count` / `retry_count`: the on-disk counter always wins, and an incoming payload can never introduce a controller-owned counter that is absent on disk — so the trigger and retry caps compare against real spawn counts and can fire.\n19\t- A terminal on-disk `status` (`aborted` / `completed`) is pinned: the incoming `status` is discarded, so an operator's abort survives every publish.\n20\t- A pinned-terminal task short-circuits the escalation machinery uniformly for both terminal statuses: no Trigger Cap / Retry Escalation section, no assignee clear, no `previous_assignee`, no phase restore, and an inherited `spawn_notification: true` survives — escalation exists to park a live task, not one an operator already ended.\n21\t- Everything the agent legitimately authors — `phase`, arbitrary keys, the body — keeps today's incoming-wins behavior on terminal and non-terminal tasks alike.\n22\t- Every guard discard of a differing incoming value emits one unconditional INFO log line containing `ownership guard kept on-disk` (task, field, kept value, rejected value); equal values stay silent, so steady-state publishes produce no log noise.\n23\t- The controller-owned field names and the terminal status set are each declared once at package level, so adding a controller-owned field later is a one-line change.\n24\t- The one pre-existing spec that models an incoming counter reset is rewritten to model the reset the way the system actually performs it — the scanner's Empty-to-Named Reset writing `trigger_count: 0` to disk — while preserving its intent (`previous_assignee` persistence, `assignee: backtest-agent`).\n25\t- New unit specs prove: counters survive, absent counters are never introduced, the cap fires because the on-disk counter won, terminal statuses pin, escalation short-circuits, the merge reports exactly the right guard decisions, and agent-owned fields still win on non-terminal tasks.\n26\t- The changelog records the fix under `## Unreleased` naming the counter rollback and the reverted terminal status.\n27\t\n28\t</summary>\n29\t\n30\t<objective>\n31\t\n32\tMake the single result-write chokepoint (`pkg/result`) field-ownership-aware: `trigger_count` / `retry_count` always take the on-disk value (and are never introduced from the incoming payload), a terminal on-disk `status` is pinned and discards the incoming status, the escalation early return covers both terminal statuses, every differing-value discard emits one unconditional `ownership guard kept on-disk` INFO log line, and all of it is proven by unit specs in `pkg/result/result_writer_test.go`. Record the behavior change in `CHANGELOG.md`.\n33\t\n34\t</objective>\n35\t\n36\t<context>\n37\t\n38\tThere is no CLAUDE.md in this repo; the global YOLO container CLAUDE.md (already in your context) governs project conventions. Read the repo's own code as the source of truth for style.\n39\t\n40\tRead the coding-plugin docs that apply to this change:\n41\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-glog-guide.md` (unconditional `glog.Infof` vs `glog.V(n).Infof`)\n42\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-testing-guide.md` (Ginkgo/Gomega, `DescribeTable`, coverage ≥80% for changed code)\n43\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-error-wrapping-guide.md`\n44\t- `/home/node/.claude/plugins/marketplaces/coding/docs/definition-of-done.md`\n45\t- `/home/node/.claude/plugins/marketplaces/coding/docs/changelog-guide.md`\n46\t\n47\tRead `pkg/result/result_writer.go` IN FULL (15309 bytes). The functions you change:\n48\t- `func mergeFrontmatter(existing, incoming lib.TaskFrontmatter) lib.TaskFrontmatter` — currently at the bottom of the file (around line 353-364); the ONLY call site is `buildResultModifyFn` (line 171), so changing its signature is safe. It is the result-write chokepoint this spec targets.\n49\t- `func (r *resultWriter) buildResultModifyFn(ctx context.Context, req lib.Task) func(current []byte) ([]byte, error)` (line 151) — the modify callback re-reads on-disk frontmatter per git retry and calls the merge. This is where the guard log lines are emitted (it holds `req.TaskIdentifier`).\n50\t- `func (r *resultWriter) applyRetryCounter(merged, existing lib.TaskFrontmatter, body string) string` (line 188) — its terminal early return is currently `if string(merged.Status()) == \"completed\" { return body }` (line 189).\n51\t- `applyTriggerCap`, `applyRetryCap`, `clearAssignee`, `ClearAssigneeIfHumanReview`, `restoreExistingPhase` — NOT changed by this spec; they simply become unreachable for pinned-terminal tasks because the widened early return fires first.\n52\t\n53\tVerified library facts (grep-checked against module sources; do not re-derive):\n54\t- `type TaskFrontmatter map[string]interface{}` from `github.com/bborbe/agent` (imported as `lib`).\n55\t- `func (f TaskFrontmatter) Status() domain.TaskStatus` — the normalizing accessor; canonicalises aliases via `domain.NormalizeTaskStatus` (e.g. `done` → `completed`), and returns `domain.TaskStatus(v)` for unknown values. Terminal detection MUST use this accessor, never a raw string comparison.\n56\t- `domain.TaskStatusCompleted TaskStatus = \"completed\"` and `domain.TaskStatusAborted TaskStatus = \"aborted\"` from `github.com/bborbe/vault-cli/pkg/domain` (already a direct require in `go.mod`; `result_writer.go` does NOT yet import it — add the import).\n57\t- `func (f TaskFrontmatter) TriggerCount() int` / `RetryCount() int` — both accept `int` and `float64` underlying values.\n58\t- `github.com/golang/glog` is already imported; `glog.Infof(format string, args ...any)` is the unconditional INFO call.\n59\t- On-disk frontmatter is parsed with `gopkg.in/yaml.v3` into `map[string]interface{}`, which decodes `trigger_count: 3` as `int(3)`; the incoming `req.Frontmatter` reaches `WriteResult` after a `json.Marshal`+`json.Unmarshal` round-trip through cqrs (`base/base_event.go MarshalInto`, standard `encoding/json`, no `UseNumber`), which decodes the same number as `float64(3)`. The guard's value-equality test MUST therefore treat `int` and `float64` as numerically equal, or every steady-state publish would log a spurious guard line, violating DB 6 (\"Equal values produce no log line, so a steady-state publish is silent\").\n60\t\n61\tRead `pkg/result/result_writer_test.go` IN FULL (1748 lines, package `result_test`, external test package). The harness you reuse:\n62\t- `BeforeEach` (line 57-105): builds `fakeGit *mocks.GitClient` with a real-filesystem `AtomicReadModifyWriteAndCommitPushStub`, `fakeTime`, `identifier`, and `writer = result.NewResultWriter(fakeGit, taskDir, fakeTime, metrics.New())`.\n63\t- `writeTaskFile := func(name, content string) string` (line 111) writes an on-disk file; `taskFile = lib.Task{...}` models the agent's incoming payload; assertions read the written file and use `ContainSubstring` / `NotTo(ContainSubstring)`.\n64\t- The existing spec `It(\"agent keys override existing keys\")` (line 186) MUST keep passing with unmodified `Expect(` lines — it is the non-terminal agent-wins control.\n65\t- Two pre-existing blocks may be modified, and only these two: `It(\"previous_assignee persists when operator re-delegates by setting a non-empty assignee\")` (line 1351-1404, Requirement 7) and `It(\"fully replaces content on second call\")` (line 215, Requirement 7b). Every other existing `It(`/`Expect(` in this file must remain byte-identical. Neither carve-out deletes or weakens an `Expect(` line.\n66\t- Every existing spec that carries `trigger_count` / `retry_count` in its incoming payload already uses on-disk == incoming values, so the guard changes none of their outcomes — this is deliberate; the only incoming-carried counter reset in the file is inside the carved block.\n67\t\n68\tThe spec's Test-style directive: use `DescribeTable` for the counter rows and for the two terminal-status rows (same fixture shape, differing values), and plain `It` blocks for the pin-not-freeze, short-circuit, log (DB 6), and negative-control cases, matching the surrounding file. `DescribeTable` style precedent lives in `pkg/command/command_operations_test.go` (line 21): `DescribeTable(\"...\", func(...) {...}, Entry(\"name\", args...), ...)`.\n69\t\n70\tRead `CHANGELOG.md` — a `## Unreleased` section already exists (line 8) with one `fix:` bullet (terminal-task reopens); append a NEW `fix:` bullet to that existing section (do not create a second `## Unreleased`, do not touch the top version heading `## v0.6.1`).\n71\t\n72\tSpec cross-references to keep straight:\n73\t- DB 1-2: counters read only from disk → caps see real spawn counts.\n74\t- DB 3: terminal pin via normalizing `Status()` vs the two `domain` constants.\n75\t- DB 4: pin happens during the merge, before `applyRetryCounter`, whose early return is widened from `completed` to BOTH terminal statuses; consequence = pinned-terminal tasks never reach the cap/assignee/`spawn_notification` machinery.\n76\t- DB 5: agent-owned keys keep incoming-wins on terminal and non-terminal tasks alike.\n77\t- DB 6: the merge helper reports guard decisions to the caller; the caller emits one unconditional INFO line per decision naming task, field, kept value, rejected value; equal values → no decision → silent.\n78\t- DB 7: controller-owned field names and terminal statuses each declared once at package level.\n79\t\n80\t</context>\n81\t\n82\t<requirements>\n83\t\n84\tAll changes below are in `pkg/result/result_writer.go` unless stated otherwise.\n85\t\n86\t1. **Add the `domain` import.** Add `domain \"github.com/bborbe/vault-cli/pkg/domain\"` to the import block (already a direct `go.mod` dependency; `github.com/bborbe/agent` imports the same package, so no cycle). goimports-reviser in `make precommit` will place it; match the grouping style of the existing imports.\n87\t\n88\t2. **Add the two package-level ownership declarations (DB 7).** Place them near the top of the file, after the `resultWriter` struct (around line 52), before `FindTaskFilePath`. The set of controller-owned field names and the set of terminal statuses each live here ONCE — a future controller-owned field is a one-line addition to `controllerOwnedFields`:\n89\t   ```go\n90\t   // controllerOwnedFields lists frontmatter keys whose on-disk value always wins:\n91\t   // the result writer never lets the agent's incoming value overwrite them, and an\n92\t   // incoming value can never introduce a controller-owned key that is absent on disk.\n93\t   var controllerOwnedFields = []string{\n94\t       \"trigger_count\",\n95\t       \"retry_count\",\n96\t   }\n97\t\n98\t   // terminalStatuses lists the statuses that end a task's lifecycle. When the on-disk\n99\t   // status is terminal, the merge pins it (discarding the incoming status) and the\n100\t   // escalation machinery short-circuits. Terminal is decided via the normalizing\n101\t   // TaskFrontmatter.Status() accessor compared against these constants.\n102\t   var terminalStatuses = []domain.TaskStatus{\n103\t       domain.TaskStatusCompleted,\n104\t       domain.TaskStatusAborted,\n105\t   }\n106\t   ```\n107\t   The string literal `\"trigger_count\"` MUST appear in this declaration (spec AC 12 greps for it).\n108\t\n109\t3. **Replace `mergeFrontmatter` with the exported `MergeFrontmatter` and add the `GuardDecision` type.** Delete the existing `mergeFrontmatter` function and its doc comment (currently around line 353-364). Add the decision type and the new exported function in its place (the export is REQUIRED: `result_writer_test.go` is `package result_test`, so the DB 6 decision-reporting unit specs can only reach the helper through an exported symbol — `FindTaskFilePath` and `ExtractBody` are already exported in this package, so this matches surrounding style):\n110\t   ```go\n111\t   // GuardDecision records a single ownership-guard discard: the merge kept the\n112\t   // on-disk value of a controller-owned field (or the pinned terminal status) and\n113\t   // rejected a differing incoming value. Equal values produce no decision.\n114\t   type GuardDecision struct {\n115\t       Field    string\n116\t       Kept     any\n117\t       Rejected any\n118\t   }\n119\t\n120\t   // MergeFrontmatter returns a new frontmatter map with all keys from existing,\n121\t   // overridden by all keys from incoming, then applies the field-ownership guard:\n122\t   // controller-owned counters take the on-disk value when present on disk and are\n123\t   // absent from the result when not; a terminal on-disk status is pinned. The\n124\t   // returned decisions name every field whose differing incoming value was discarded\n125\t   // (equal values produce no decision). Neither input map is modified.\n126\t   func MergeFrontmatter(existing, incoming lib.TaskFrontmatter) (lib.TaskFrontmatter, []GuardDecision) {\n127\t       merged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n128\t       for k, v := range existing {\n129\t           merged[k] = v\n130\t       }\n131\t       for k, v := range incoming {\n132\t           merged[k] = v\n133\t       }\n134\t       var decisions []GuardDecision\n135\t\n136\t       // Controller-owned counters: the on-disk value always wins when the key exists\n137\t       // on disk (kept verbatim, whatever its type); a key absent on disk stays absent\n138\t       // even if the incoming payload carries it.\n139\t       for _, field := range controllerOwnedFields {\n140\t           diskValue, onDisk := existing[field]\n141\t           incomingValue, inIncoming := incoming[field]\n142\t           if !onDisk {\n143\t               if inIncoming {\n144\t                   delete(merged, field)\n145\t               }\n146\t               continue\n147\t           }\n148\t           merged[field] = diskValue\n149\t           if inIncoming && !frontmatterValueEqual(diskValue, incomingValue) {\n150\t               decisions = append(decisions, GuardDecision{Field: field, Kept: diskValue, Rejected: incomingValue})\n151\t           }\n152\t       }\n153\t\n154\t       // Terminal on-disk status is pinned: the on-disk status value is kept and the\n155\t       // incoming status is discarded. Terminal is decided by the normalizing Status()\n156\t       // accessor compared against terminalStatuses, never by raw string equality on\n157\t       // the unparsed value. The status decision is reported only when the normalized\n158\t       // values differ (an incoming alias such as \"done\" against on-disk \"completed\"\n159\t       // is normalized-equal and produces no decision).\n160\t       if diskStatus, onDisk := existing[\"status\"]; onDisk && isTerminalStatus(existing.Status()) {\n161\t           merged[\"status\"] = diskStatus\n162\t           if incomingStatus, ok := incoming[\"status\"]; ok && existing.Status() != incoming.Status() {\n163\t               decisions = append(decisions, GuardDecision{Field: \"status\", Kept: diskStatus, Rejected: incomingStatus})\n164\t           }\n165\t       }\n166\t\n167\t       return merged, decisions\n168\t   }\n169\t   ```\n170\t   All other keys follow today's incoming-wins merge, on terminal and non-terminal tasks alike (DB 5) — no extra branching.\n171\t\n172\t4. **Add the three package-private helpers** `isTerminalStatus`, `frontmatterValueEqual`, `numericValue` (place near `MergeFrontmatter`):\n173\t   ```go\n174\t   func isTerminalStatus(s domain.TaskStatus) bool {\n175\t       for _, t := range terminalStatuses {\n176\t           if s == t {\n177\t               return true\n178\t           }\n179\t       }\n180\t       return false\n181\t   }\n182\t\n183\t   // frontmatterValueEqual reports whether two frontmatter values compare equal,\n184\t   // treating numeric int/float64 pairs as equal so a JSON-decoded incoming counter\n185\t   // (float64) equals a YAML-decoded on-disk counter (int) at steady state — equal\n186\t   // counters must produce no guard log line (DB 6).\n187\t   func frontmatterValueEqual(a, b any) bool {\n188\t       if a == b {\n189\t           return true\n190\t       }\n191\t       af, aOK := numericValue(a)\n192\t       bf, bOK := numericValue(b)\n193\t       return aOK && bOK && af == bf\n194\t   }\n195\t\n196\t   func numericValue(v any) (float64, bool) {\n197\t       switch n := v.(type) {\n198\t       case int:\n199\t           return float64(n), true\n200\t       case int64:\n201\t           return float64(n), true\n202\t       case float64:\n203\t           return n, true\n204\t       default:\n205\t           return 0, false\n206\t       }\n207\t   }\n208\t   ```\n209\t   Do NOT coerce the on-disk counter value to an integer when keeping it: a non-integer on-disk value (e.g. the string `\"3\"` or `null`) is kept verbatim, and the cap arithmetic reads it through the existing `TriggerCount()`/`RetryCount()` accessors (which yield `0` for non-integers, so no escalation fires — unchanged from today, spec Failure-Modes row \"On-disk counter is not an integer\").\n210\t\n211\t5. **Update `buildResultModifyFn` to consume the decisions and emit the guard log.** Replace the single merge call at line 171 with the two-value return and a loop that emits one unconditional INFO line per decision. The frozen substring `ownership guard kept on-disk` MUST appear verbatim in the `glog.Infof` call, which MUST be unconditional (`glog.Infof`, NOT `glog.V(n).Infof`), naming the task identifier, the field, the kept on-disk value and the rejected incoming value (spec AC 13 + DB 6; the Rung-3 post-deploy AC greps prod logs for it at default verbosity):\n212\t   ```go\n213\t   merged, decisions := MergeFrontmatter(currentOnDisk, req.Frontmatter)\n214\t   for _, d := range decisions {\n215\t       glog.Infof(\n216\t           \"ownership guard kept on-disk: task %s field %s kept %v rejected %v\",\n217\t           req.TaskIdentifier,\n218\t           d.Field,\n219\t           d.Kept,\n220\t           d.Rejected,\n221\t       )\n222\t   }\n223\t   body := r.applyRetryCounter(merged, currentOnDisk, string(req.Content))\n224\t   ```\n225\t   The log line must name only the task identifier, the field, and the two values — NEVER the body or the full frontmatter (spec Security / Log safety). Do not change anything else in `buildResultModifyFn` (the per-retry re-read, the body-replacement semantics, and the marshal/write steps stay exactly as they are).\n226\t\n227\t6. **Widen the terminal early return in `applyRetryCounter` (DB 4).** Change:\n228\t   ```go\n229\t   if string(merged.Status()) == \"completed\" {\n230\t       return body\n231\t   }\n232\t   ```\n233\t   (currently at line 189) to:\n234\t   ```go\n235\t   if isTerminalStatus(merged.Status()) {\n236\t       return body\n237\t   }\n238\t   ```\n239\t   This is the intended control-flow change: the pin during the merge means `merged.Status()` is already terminal for a pinned-terminal task, so the early return fires before `applyTriggerCap`, `ClearAssigneeIfHumanReview`, the `spawn_notification` delete, and `applyRetryCap` — a pinned-terminal task accrues no escalation section, its `assignee` is not cleared, `previous_assignee` is not written, `phase` is not restored by `restoreExistingPhase`, and an inherited `spawn_notification: true` key survives. Both terminal statuses take one uniform control flow. Do not change any other statement in `applyRetryCounter`.\n240\t\n241\t> Indentation in the code blocks below is normalized to spaces for readability — match the file's existing TAB indentation when applying them.\n242\t\n243\t7. **Rewrite the carved-out spec** `It(\"previous_assignee persists when operator re-delegates by setting a non-empty assignee\")` (currently line 1351-1403) in `pkg/result/result_writer_test.go`. This is one of exactly TWO existing blocks you may modify (see Requirement 7b for the second). The first write (lines 1354-1377, cap fires → `previous_assignee: claude` written, `assignee` cleared) stays unchanged. Rewrite the second-write portion to model the reset the way the system actually performs it — the scanner's Empty-to-Named Reset (spec 021) writes `trigger_count: 0` to DISK on an empty→named assignee transition, it is NOT carried in the incoming payload:\n244\t   - Delete `\"trigger_count\":   0, // operator reset` from the second-write incoming `lib.Task{...}`.\n245\t   - BEFORE the second `Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())`, add a `writeTaskFile(\"my-task.md\", ...)` call that rewrites the on-disk file to `status: in_progress`, `phase: planning`, `trigger_count: 0`, `max_triggers: 3`, `assignee: backtest-agent`, AND `previous_assignee: claude`, body `## Task\\nRetrying with backtest-agent.\\n`. The rewritten on-disk content MUST itself retain `previous_assignee: claude` so the persistence assertion tests persistence rather than re-creation.\n246\t   - The second-write incoming `lib.Task{...}` keeps `status: in_progress`, `phase: planning`, `max_triggers: 3`, `assignee: backtest-agent` (no `trigger_count` key).\n247\t   - Keep both existing post-write assertions unchanged: `Expect(s2).To(ContainSubstring(\"previous_assignee: claude\"))` and `Expect(s2).To(ContainSubstring(\"assignee: backtest-agent\"))`.\n248\t   The spec's intent is preserved: `previous_assignee: claude` persists (retained on disk through the reset, then preserved by the merge because the incoming payload does not carry it) and `assignee: backtest-agent` is set. With `trigger_count: 0` on disk, the second publish does not re-escalate.\n249\t\n250\t\n251\t7b. **Second carve-out — `It(\"fully replaces content on second call\")`** (`pkg/result/result_writer_test.go`, line 215, inside `Context(\"overwrite\")`). This spec writes twice. Its FIRST write carries `\"status\": \"done\"`, and the normalizing accessor canonicalises `done` → `completed`, which is terminal. Under the new pin the second write's incoming `\"status\": \"closed\"` is therefore correctly discarded and `Expect(string(written)).To(ContainSubstring(\"status: closed\"))` fails. The spec's intent is body replacement across two writes, not terminal-status semantics, so restore it by making the FIRST write's status non-terminal. Change ONLY that one fixture value — do not touch any `Expect(` line (AC 14 must stay clean).\n252\t\n253\t    Find:\n254\t\n255\t    ```go\n256\t    \t\t\t\ttaskFile = lib.Task{\n257\t    \t\t\t\t\tTaskIdentifier: identifier,\n258\t    \t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n259\t    \t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n260\t    \t\t\t\t\t\t\"status\":          \"done\",\n261\t    \t\t\t\t\t},\n262\t    \t\t\t\t\tContent: lib.TaskContent(\"First result\\n\"),\n263\t    \t\t\t\t}\n264\t    ```\n265\t\n266\t    Replace with:\n267\t\n268\t    ```go\n269\t    \t\t\t\ttaskFile = lib.Task{\n270\t    \t\t\t\t\tTaskIdentifier: identifier,\n271\t    \t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n272\t    \t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n273\t    \t\t\t\t\t\t\"status\":          \"in_progress\",\n274\t    \t\t\t\t\t},\n275\t    \t\t\t\t\tContent: lib.TaskContent(\"First result\\n\"),\n276\t    \t\t\t\t}\n277\t    ```\n278\t\n279\t8. **Add the new unit specs to `pkg/result/result_writer_test.go`.** Do not modify any existing block other than the carve-out. Follow the spec's Test-style directive (`DescribeTable` for the counter rows and the terminal-status rows; plain `It` for the rest), and reuse the `writeTaskFile` / `lib.Task` / `ContainSubstring` harness from `BeforeEach`. Assert on the WRITTEN FILE BYTES (the full serialize path through `MergeFrontmatter` → `yaml.Marshal` → write), not on struct shapes:\n280\t\n281\t   8a. Inside `Context(\"trigger_count cap escalation\")` (which closes around line 1494), add the load-bearing plain `It` (spec AC 4):\n282\t   ```go\n283\t   It(\"escalates on the on-disk trigger_count even when the incoming payload carries a stale lower value\", func() {\n284\t       writeTaskFile(\n285\t           \"my-task.md\",\n286\t           \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\ntrigger_count: 3\\nmax_triggers: 3\\nassignee: claude\\n---\\n## Result\\nStatus: failed\\n\",\n287\t       )\n288\t       taskFile = lib.Task{\n289\t           TaskIdentifier: identifier,\n290\t           Frontmatter: lib.TaskFrontmatter{\n291\t               \"task_identifier\": \"test-task-uuid-1234\",\n292\t               \"status\":          \"in_progress\",\n293\t               \"phase\":           \"ai_review\",\n294\t               \"trigger_count\":   1, // stale snapshot — on-disk is 3\n295\t               \"max_triggers\":    3,\n296\t               \"assignee\":        \"claude\",\n297\t           },\n298\t           Content: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n299\t       }\n300\t       Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n301\t       written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n302\t       s := string(written)\n303\t       Expect(s).To(ContainSubstring(\"## Trigger Cap Escalation\"))\n304\t       Expect(s).To(ContainSubstring(\"trigger_count: 3\"))\n305\t       Expect(s).NotTo(ContainSubstring(\"trigger_count: 1\"))\n306\t       Expect(s).To(ContainSubstring(\"assignee: \\\"\\\"\"))\n307\t   })\n308\t   ```\n309\t   The cap fires BECAUSE the on-disk counter won (AC 4 is the load-bearing case).\n310\t\n311\t   8b. Inside `Describe(\"WriteResult\")`, add a new `Context(\"field ownership guard\")` (place it right after `Context(\"trigger_count cap escalation\")` closes and before `Context(\"atomic write and push error\")` around line 1589). It contains:\n312\t   - A `DescribeTable` for the counter rows (ACs 1, 2, 3) with this shared body:\n313\t     ```go\n314\t     DescribeTable(\n315\t         \"the on-disk counter always wins and an absent counter stays absent\",\n316\t         func(onDiskFM string, incomingFM lib.TaskFrontmatter, present, absent []string) {\n317\t             writeTaskFile(\"my-task.md\", \"---\\n\"+onDiskFM+\"---\\n## Result\\nStatus: failed\\n\")\n318\t             taskFile = lib.Task{\n319\t                 TaskIdentifier: identifier,\n320\t                 Frontmatter:    incomingFM,\n321\t                 Content:        lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n322\t             }\n323\t             Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n324\t             written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n325\t             s := string(written)\n326\t             for _, want := range present {\n327\t                 Expect(s).To(ContainSubstring(want))\n328\t             }\n329\t             for _, unwanted := range absent {\n330\t                 Expect(s).NotTo(ContainSubstring(unwanted))\n331\t             }\n332\t         },\n333\t         Entry(\"keeps on-disk trigger_count over a stale incoming value\",\n334\t             \"task_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\ntrigger_count: 5\\n\",\n335\t             lib.TaskFrontmatter{\"task_identifier\": \"test-task-uuid-1234\", \"status\": \"in_progress\", \"phase\": \"ai_review\", \"trigger_count\": 1},\n336\t             []string{\"trigger_count: 5\"},\n337\t             []string{\"trigger_count: 1\"},\n338\t         ),\n339\t         Entry(\"keeps on-disk retry_count over a stale incoming value\",\n340\t             \"task_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\nretry_count: 4\\n\",\n341\t             lib.TaskFrontmatter{\"task_identifier\": \"test-task-uuid-1234\", \"status\": \"in_progress\", \"phase\": \"ai_review\", \"retry_count\": 0},\n342\t             []string{\"retry_count: 4\"},\n343\t             []string{\"retry_count: 0\"},\n344\t         ),\n345\t         Entry(\"incoming counters absent on disk are never written\",\n346\t             \"task_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\n\",\n347\t             lib.TaskFrontmatter{\"task_identifier\": \"test-task-uuid-1234\", \"status\": \"in_progress\", \"phase\": \"ai_review\", \"trigger_count\": 1, \"retry_count\": 0},\n348\t             []string{},\n349\t             []string{\"trigger_count\", \"retry_count\"},\n350\t         ),\n351\t     )\n352\t     ```\n353\t     (The third row's negative assertions `NotTo(ContainSubstring(\"trigger_count\"))` and `NotTo(ContainSubstring(\"retry_count\"))` prove an incoming value can never introduce a controller-owned counter absent on disk — AC 3.)\n354\t   - A `DescribeTable` for the two terminal-status pin rows (ACs 5 and 6, same fixture shape, differing terminal status value):\n355\t     ```go\n356\t     DescribeTable(\n357\t         \"a terminal on-disk status is pinned and the incoming status is discarded\",\n358\t         func(terminalStatus string) {\n359\t             writeTaskFile(\n360\t                 \"my-task.md\",\n361\t                 \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: \"+terminalStatus+\"\\nphase: ai_review\\n---\\n## Result\\nStatus: failed\\n\",\n362\t             )\n363\t             taskFile = lib.Task{\n364\t                 TaskIdentifier: identifier,\n365\t                 Frontmatter: lib.TaskFrontmatter{\n366\t                     \"task_identifier\": \"test-task-uuid-1234\",\n367\t                     \"status\":          \"in_progress\",\n368\t                     \"phase\":           \"ai_review\",\n369\t                 },\n370\t                 Content: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n371\t             }\n372\t             Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n373\t             written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n374\t             s := string(written)\n375\t             Expect(s).To(ContainSubstring(\"status: \" + terminalStatus))\n376\t             Expect(s).NotTo(ContainSubstring(\"status: in_progress\"))\n377\t         },\n378\t         Entry(\"aborted\", \"aborted\"),\n379\t         Entry(\"completed\", \"completed\"),\n380\t         Entry(\"done (alias normalized to completed)\", \"done\"),\n381\t     )\n382\t     ```\n383\t   - A plain `It` for the pin-not-freeze case (AC 7, four assertions in one spec):\n384\t     ```go\n385\t     It(\"pins only status and still records the agent payload on a terminal task\", func() {\n386\t         writeTaskFile(\n387\t             \"my-task.md\",\n388\t             \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: aborted\\n---\\nOld body\\n\",\n389\t         )\n390\t         taskFile = lib.Task{\n391\t             TaskIdentifier: identifier,\n392\t             Frontmatter: lib.TaskFrontmatter{\n393\t                 \"task_identifier\": \"test-task-uuid-1234\",\n394\t                 \"status\":          \"in_progress\",\n395\t                 \"phase\":           \"execution\",\n396\t             },\n397\t             Content: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n398\t         }\n399\t         Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n400\t         written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n401\t         s := string(written)\n402\t         Expect(s).To(ContainSubstring(\"status: aborted\"))\n403\t         Expect(s).To(ContainSubstring(\"phase: execution\"))\n404\t         Expect(s).To(ContainSubstring(\"## Result\"))\n405\t         Expect(s).NotTo(ContainSubstring(\"status: in_progress\"))\n406\t     })\n407\t     ```\n408\t   - Two plain `It` blocks for the terminal short-circuit (ACs 8 and 9 — DB 4), identical fixtures except the on-disk terminal status, identical assertions (one positive, three negative). The aborted row:\n409\t     ```go\n410\t     It(\"short-circuits the escalation machinery when the on-disk status is aborted (DB 4)\", func() {\n411\t         writeTaskFile(\n412\t             \"my-task.md\",\n413\t             \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: aborted\\nphase: ai_review\\ntrigger_count: 3\\nmax_triggers: 3\\nassignee: claude\\nspawn_notification: true\\n---\\n## Result\\nStatus: failed\\n\",\n414\t         )\n415\t         taskFile = lib.Task{\n416\t             TaskIdentifier: identifier,\n417\t             Frontmatter: lib.TaskFrontmatter{\n418\t                 \"task_identifier\": \"test-task-uuid-1234\",\n419\t                 \"status\":          \"in_progress\",\n420\t                 \"phase\":           \"ai_review\",\n421\t             },\n422\t             Content: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n423\t         }\n424\t         Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n425\t         written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n426\t         s := string(written)\n427\t         Expect(s).NotTo(ContainSubstring(\"## Trigger Cap Escalation\"))\n428\t         Expect(s).To(ContainSubstring(\"\\nassignee: claude\"))\n429\t         Expect(s).NotTo(ContainSubstring(\"previous_assignee\"))\n430\t         Expect(s).To(ContainSubstring(\"spawn_notification: true\"))\n431\t     })\n432\t     ```\n433\t     Add a second `It` with the identical body and assertions but on-disk `status: completed` instead of `aborted` (AC 9 — both terminal statuses take one uniform control flow). Keep the incoming payload identical (do NOT carry `trigger_count`/`max_triggers`/`assignee`/`spawn_notification`, so those on-disk values survive the merge and the terminal early return is what protects them).\n434\t   - A plain `It` for the negative control (AC 10 — the fix is NOT \"existing always wins\"):\n435\t     ```go\n436\t     It(\"still lets the agent own phase, status, and new keys on a non-terminal task (negative control)\", func() {\n437\t         writeTaskFile(\n438\t             \"my-task.md\",\n439\t             \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: next\\nphase: ai_review\\n---\\nOld body\\n\",\n440\t         )\n441\t         taskFile = lib.Task{\n442\t             TaskIdentifier: identifier,\n443\t             Frontmatter: lib.TaskFrontmatter{\n444\t                 \"task_identifier\": \"test-task-uuid-1234\",\n445\t                 \"status\":          \"in_progress\",\n446\t                 \"phase\":           \"execution\",\n447\t                 \"custom_field\":    \"from-agent\",\n448\t             },\n449\t             Content: lib.TaskContent(\"New body\\n\"),\n450\t         }\n451\t         Expect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n452\t         written, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n453\t         s := string(written)\n454\t         Expect(s).To(ContainSubstring(\"status: in_progress\"))\n455\t         Expect(s).To(ContainSubstring(\"phase: execution\"))\n456\t         Expect(s).To(ContainSubstring(\"custom_field: from-agent\"))\n457\t         Expect(s).NotTo(ContainSubstring(\"phase: ai_review\"))\n458\t     })\n459\t     ```\n460\t\n461\t   8c. Add a new `Describe(\"MergeFrontmatter\", func() { ... })` after `Describe(\"ExtractBody\")` closes and before the file's final closing `})` (around line 1747-1748). This is the DB 6 decision-reporting spec, calling the exported helper directly (AC 11):\n462\t   ```go\n463\t   Describe(\"MergeFrontmatter\", func() {\n464\t       It(\"reports zero guard decisions when the incoming counter equals the on-disk counter\", func() {\n465\t           existing := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n466\t           incoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n467\t           _, decisions := result.MergeFrontmatter(existing, incoming)\n468\t           Expect(decisions).To(HaveLen(0))\n469\t       })\n470\t\n471\t       It(\"reports zero decisions when a JSON-decoded float64 counter equals the YAML-decoded int counter\", func() {\n472\t           existing := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n473\t           incoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": float64(3)}\n474\t           _, decisions := result.MergeFrontmatter(existing, incoming)\n475\t           Expect(decisions).To(HaveLen(0))\n476\t       })\n477\t\n478\t       It(\"reports exactly one decision naming the field and both values when the incoming counter differs\", func() {\n479\t           existing := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n480\t           incoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 1}\n481\t           _, decisions := result.MergeFrontmatter(existing, incoming)\n482\t           Expect(decisions).To(HaveLen(1))\n483\t           Expect(decisions[0].Field).To(Equal(\"trigger_count\"))\n484\t           Expect(decis