{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-810d0c62809686e2","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage result_test\n6\t\n7\timport (\n8\t\tlib \"github.com/bborbe/agent\"\n9\t\t. \"github.com/onsi/ginkgo/v2\"\n10\t\t. \"github.com/onsi/gomega\"\n11\t\n12\t\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n13\t)\n14\t\n15\tvar _ = Describe(\"MergeFrontmatter\", func() {\n16\t\tIt(\n17\t\t\t\"reports zero guard decisions when the incoming counter equals the on-disk counter\",\n18\t\t\tfunc() {\n19\t\t\t\texisting := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n20\t\t\t\tincoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n21\t\t\t\t_, decisions := result.MergeFrontmatter(existing, incoming)\n22\t\t\t\tExpect(decisions).To(HaveLen(0))\n23\t\t\t},\n24\t\t)\n25\t\n26\t\tIt(\n27\t\t\t\"reports zero decisions when a JSON-decoded float64 counter equals the YAML-decoded int counter\",\n28\t\t\tfunc() {\n29\t\t\t\texisting := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n30\t\t\t\tincoming := lib.TaskFrontmatter{\n31\t\t\t\t\t\"status\":        \"in_progress\",\n32\t\t\t\t\t\"trigger_count\": float64(3),\n33\t\t\t\t}\n34\t\t\t\t_, decisions := result.MergeFrontmatter(existing, incoming)\n35\t\t\t\tExpect(decisions).To(HaveLen(0))\n36\t\t\t},\n37\t\t)\n38\t\n39\t\tIt(\n40\t\t\t\"reports exactly one decision naming the field and both values when the incoming counter differs\",\n41\t\t\tfunc() {\n42\t\t\t\texisting := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 3}\n43\t\t\t\tincoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 1}\n44\t\t\t\t_, decisions := result.MergeFrontmatter(existing, incoming)\n45\t\t\t\tExpect(decisions).To(HaveLen(1))\n46\t\t\t\tExpect(decisions[0].Field).To(Equal(\"trigger_count\"))\n47\t\t\t\tExpect(decisions[0].Kept).To(Equal(3))\n48\t\t\t\tExpect(decisions[0].Rejected).To(Equal(1))\n49\t\t\t},\n50\t\t)\n51\t\n52\t\tIt(\n53\t\t\t\"reports a decision when the on-disk counter is an int64 and the incoming differs (numeric comparison)\",\n54\t\t\tfunc() {\n55\t\t\t\texisting := lib.TaskFrontmatter{\n56\t\t\t\t\t\"status\":        \"in_progress\",\n57\t\t\t\t\t\"trigger_count\": int64(3),\n58\t\t\t\t}\n59\t\t\t\tincoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 1}\n60\t\t\t\t_, decisions := result.MergeFrontmatter(existing, incoming)\n61\t\t\t\tExpect(decisions).To(HaveLen(1))\n62\t\t\t\tExpect(decisions[0].Field).To(Equal(\"trigger_count\"))\n63\t\t\t},\n64\t\t)\n65\t\n66\t\tIt(\n67\t\t\t\"keeps a non-integer on-disk counter verbatim and still reports a decision (DB failure-mode)\",\n68\t\t\tfunc() {\n69\t\t\t\texisting := lib.TaskFrontmatter{\n70\t\t\t\t\t\"status\":        \"in_progress\",\n71\t\t\t\t\t\"trigger_count\": \"3\",\n72\t\t\t\t}\n73\t\t\t\tincoming := lib.TaskFrontmatter{\"status\": \"in_progress\", \"trigger_count\": 1}\n74\t\t\t\tmerged, decisions := result.MergeFrontmatter(existing, incoming)\n75\t\t\t\tExpect(decisions).To(HaveLen(1))\n76\t\t\t\tExpect(decisions[0].Field).To(Equal(\"trigger_count\"))\n77\t\t\t\tExpect(merged[\"trigger_count\"]).To(Equal(\"3\"))\n78\t\t\t},\n79\t\t)\n80\t\n81\t\tIt(\n82\t\t\t\"does not panic when both counters hold the same uncomparable type (map)\",\n83\t\t\tfunc() {\n84\t\t\t\texisting := lib.TaskFrontmatter{\n85\t\t\t\t\t\"status\":        \"in_progress\",\n86\t\t\t\t\t\"trigger_count\": map[string]interface{}{\"bad\": 1},\n87\t\t\t\t}\n88\t\t\t\tincoming := lib.TaskFrontmatter{\n89\t\t\t\t\t\"status\":        \"in_progress\",\n90\t\t\t\t\t\"trigger_count\": map[string]interface{}{\"other\": 2},\n91\t\t\t\t}\n92\t\t\t\tmerged, decisions := result.MergeFrontmatter(existing, incoming)\n93\t\t\t\tExpect(decisions).To(HaveLen(1))\n94\t\t\t\tExpect(merged[\"trigger_count\"]).To(Equal(map[string]interface{}{\"bad\": 1}))\n95\t\t\t},\n96\t\t)\n97\t\n98\t\tIt(\n99\t\t\t\"does not panic when both counters hold the same uncomparable type (slice)\",\n100\t\t\tfunc() {\n101\t\t\t\texisting := lib.TaskFrontmatter{\n102\t\t\t\t\t\"status\":      \"in_progress\",\n103\t\t\t\t\t\"retry_count\": []interface{}{1, 2},\n104\t\t\t\t}\n105\t\t\t\tincoming := lib.TaskFrontmatter{\n106\t\t\t\t\t\"status\":      \"in_progress\",\n107\t\t\t\t\t\"retry_count\": []interface{}{3},\n108\t\t\t\t}\n109\t\t\t\tmerged, decisions := result.MergeFrontmatter(existing, incoming)\n110\t\t\t\tExpect(decisions).To(HaveLen(1))\n111\t\t\t\tExpect(merged[\"retry_count\"]).To(Equal([]interface{}{1, 2}))\n112\t\t\t},\n113\t\t)\n114\t})\n115\t"}]},"parent_tool_use_id":"chatcmpl-tool-a4a9f6d255065971","session_id":"f8060dff-ade6-47a7-ae93-9a11186adf90","uuid":"70a5d2ac-3023-443c-8be1-2eaa9a6e70bd","timestamp":"2026-09-03T18:18:14.394Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 (code change)"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8cd0ca7b5abd27f3","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage result_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"errors\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\tlibtime \"github.com/bborbe/time\"\n17\t\tlibtimemocks \"github.com/bborbe/time/mocks\"\n18\t\t. \"github.com/onsi/ginkgo/v2\"\n19\t\t. \"github.com/onsi/gomega\"\n20\t\t\"gopkg.in/yaml.v3\"\n21\t\n22\t\t\"github.com/bborbe/agent-task-controller/mocks\"\n23\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n24\t\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n25\t)\n26\t\n27\tvar errTest = errors.New(\"test error\")\n28\t\n29\tfunc extractTestFrontmatter(content string) (map[string]interface{}, error) {\n30\t\tif !strings.HasPrefix(content, \"---\\n\") {\n31\t\t\treturn nil, errors.New(\"no frontmatter\")\n32\t\t}\n33\t\trest := content[4:]\n34\t\tbefore, _, found := strings.Cut(rest, \"\\n---\\n\")\n35\t\tif !found {\n36\t\t\treturn nil, errors.New(\"frontmatter not closed\")\n37\t\t}\n38\t\tvar fm map[string]interface{}\n39\t\tif err := yaml.Unmarshal([]byte(before), &fm); err != nil {\n40\t\t\treturn nil, err\n41\t\t}\n42\t\treturn fm, nil\n43\t}\n44\t\n45\tvar _ = Describe(\"ResultWriter\", func() {\n46\t\tvar (\n47\t\t\tctx        context.Context\n48\t\t\ttmpDir     string\n49\t\t\ttaskDir    string\n50\t\t\tfakeGit    *mocks.GitClient\n51\t\t\tfakeTime   *libtimemocks.CurrentDateTimeGetter\n52\t\t\twriter     result.ResultWriter\n53\t\t\ttaskFile   lib.Task\n54\t\t\tidentifier lib.TaskIdentifier\n55\t\t)\n56\t\n57\t\tBeforeEach(func() {\n58\t\t\tctx = context.Background()\n59\t\t\tvar err error\n60\t\t\ttmpDir, err = os.MkdirTemp(\"\", \"re