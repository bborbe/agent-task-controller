{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8ea28128108768b6","type":"tool_result","content":"1195\t\t\t\t\t\ts := string(written)\n1196\t\t\t\t\t\tExpect(strings.Count(s, \"## Retry Escalation\")).To(Equal(1))\n1197\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: human_review\"))\n1198\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"\\nassignee: claude\")) // assignee cleared\n1199\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"previous_assignee: claude\"))\n1200\t\t\t\t\t},\n1201\t\t\t\t)\n1202\t\n1203\t\t\t\tIt(\"writes assignee: empty and preserves phase: ai_review at trigger cap\", func() {\n1204\t\t\t\t\twriteTaskFile(\n1205\t\t\t\t\t\t\"my-task.md\",\n1206\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\ntrigger_count: 3\\nmax_triggers: 3\\nassignee: claude\\n---\\n## Result\\nStatus: failed\\n\",\n1207\t\t\t\t\t)\n1208\t\t\t\t\ttaskFile = lib.Task{\n1209\t\t\t\t\t\tTaskIdentifier: identifier,\n1210\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1211\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1212\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n1213\t\t\t\t\t\t\t\"phase\":           \"ai_review\",\n1214\t\t\t\t\t\t\t\"trigger_count\":   3,\n1215\t\t\t\t\t\t\t\"max_triggers\":    3,\n1216\t\t\t\t\t\t\t\"assignee\":        \"claude\",\n1217\t\t\t\t\t\t},\n1218\t\t\t\t\t\tContent: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n1219\t\t\t\t\t}\n1220\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n1221\t\t\t\t\twritten, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n1222\t\t\t\t\ts := string(written)\n1223\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: ai_review\"))\n1224\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"phase: human_review\"))\n1225\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"\\nassignee: claude\"))\n1226\t\t\t\t\tExpect(s).To(ContainSubstring(\"**Assignee:** claude\"))\n1227\t\t\t\t\tExpect(s).To(ContainSub