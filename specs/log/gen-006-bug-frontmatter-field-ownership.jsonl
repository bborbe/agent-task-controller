{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a50fb000c5983ccd","type":"tool_result","content":"160\t\td := libtime.DateOrDateTime(*t)\n161\t\treturn &d\n162\t}\n163\t\n164\t// DueDate reads \"due_date\" key as *libtime.DateOrDateTime.\n165\t// Handles both time.Time (YAML-parsed) and string (hand-authored) forms.\n166\t// Returns nil on missing or unparseable value.\n167\tfunc (f TaskFrontmatter) DueDate() *libtime.DateOrDateTime {\n168\t\tt := f.GetTime(\"due_date\")\n169\t\tif t == nil {\n170\t\t\treturn nil\n171\t\t}\n172\t\td := libtime.DateOrDateTime(*t)\n173\t\treturn &d\n174\t}\n175\t\n176\t// TaskIdentifier reads \"task_identifier\" key as string.\n177\tfunc (f TaskFrontmatter) TaskIdentifier() string { return f.GetString(\"task_identifier\") }\n178\t\n179\t// SetStatus validates and stores the status in the map.\n180\t// Close-out transitions (aborted, completed) are rejected unless the frontmatter\n181\t// already holds a non-empty aborted_reason AND a non-empty gate_successor; the\n182\t// rejection is raised before any write, so the frontmatter is left unchanged.\n183\tfunc (f *TaskFrontmatter) SetStatus(s TaskStatus) error {\n184\t\tif err := s.Validate(context.Background()); err != nil {\n185\t\t\treturn err\n186\t\t}\n187\t\tif s == TaskStatusAborted || s == TaskStatusCompleted {\n188\t\t\tif missing := missingCloseOutFields(f.FrontmatterMap); len(missing) > 0 {\n189\t\t\t\treturn errors.Wrapf(\n190\t\t\t\t\tcontext.Background(),\n191\t\t\t\t\tvalidation.Error,\n192\t\t\t\t\t\"cannot set status %q: missing close-out field(s) %s; a close-out must record why the work is being closed out (aborted_reason), consider what it owns (trigger / gate / threshold / recurring check), and name where that risk moves (gate_successor, or %q when nothing is inherited)\",\n193\t\t\t\t\ts,\n194\t\t\t\t\tstrings.Join(missing, \", \"),\n195\t\t\t\t\t\"none\",\n196\t\t\t\t)\n197\t\t\t}\n198\t\t}\n199\t\tf.Set(\"status\", string(s))\n200\t\treturn nil\n201\t}\n202\t\n203\t// SetPageType stores the page_type in the map.\n204\tfunc (f *TaskFrontmatter) SetPageType(v string) { f.Set(\"page_type\", v) }\n205\t\n206\t// SetGoals stores goals in the map. Deletes the key if v is nil or empty.\n207\tfunc (f *TaskFrontmatter) SetGoals(v []string) {\n208\t\tif len(v) == 0 {\n209\t\t\tf.Delete(\"goals\")\n210\t\t\treturn\n211\t\t}\n212\t\tf.Set(\"goals\", stringSliceToAny(v))\n213\t}\n214\t\n215\t// SetAssignee stores the assignee in the map.\n216\tfunc (f *TaskFrontmatter) SetAssignee(v string) { f.Set(\"assignee\", v) }\n217\t\n218\t// SetClaudeSessionID stores the claude_session_id in the map.\n219\tfunc (f *TaskFrontmatter) SetClaudeSessionID(v string) { f.Set(\"claude_session_id\", v) }"}]},"parent_tool_use_id":"chatcmpl-tool-9dd1ef7ac5355a1e","session_id":"d5b7e577-b8e1-45e9-9e5a-be2299ed6cef","uuid":"80f43130-3b2a-4d19-a9ef-ab7dbbe1d0eb","timestamp":"2026-08-31T11:50:19.394Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 006"}
