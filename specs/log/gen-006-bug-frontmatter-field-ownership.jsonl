{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a47023c9c6439964","type":"tool_result","content":"1\t// Copyright (c) 2025 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage domain\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\t\"github.com/bborbe/collection\"\n11\t\t\"github.com/bborbe/errors\"\n12\t\t\"github.com/bborbe/validation\"\n13\t)\n14\t\n15\t// TaskStatus represents the status of a task.\n16\ttype TaskStatus string\n17\t\n18\tconst (\n19\t\t// TaskStatusNext means the task is queued for action but not yet started.\n20\t\t// This is the canonical value; \"todo\" is accepted as an alias via NormalizeTaskStatus.\n21\t\tTaskStatusNext TaskStatus = \"next\"\n22\t\t// TaskStatusTodo is an alias for TaskStatusNext kept for backward compatibility.\n23\t\t// Existing vault files with status: \"todo\" continue to read and validate via NormalizeTaskStatus.\n24\t\t// Do not use TaskStatusTodo for new writes — use TaskStatusNext.\n25\t\tTaskStatusTodo TaskStatus = \"todo\"\n26\t\t// TaskStatusInProgress means someone is actively working on the task.\n27\t\tTaskStatusInProgress TaskStatus = \"in_progress\"\n28\t\t// TaskStatusBacklog means the task is potential future work, not yet scheduled.\n29\t\tTaskStatusBacklog TaskStatus = \"backlog\"\n30\t\t// TaskStatusCompleted means the task is finished.\n31\t\tTaskStatusCompleted TaskStatus = \"completed\"\n32\t\t// TaskStatusHold means the task is blocked or paused.\n33\t\tTaskStatusHold TaskStatus = \"hold\"\n34\t\t// TaskStatusAborted means the task was cancelled and will not be completed.\n35\t\tTaskStatusAborted TaskStatus = \"aborted\"\n36\t)\n37\t\n38\t// AvailableTaskStatuses lists all valid canonical task status values.\n39\tvar AvailableTaskStatuses = TaskStatuses{\n40\t\tTaskStatusNext,\n41\t\tTaskStatusInProgress,\n42\t\tTaskStatusBacklog,\n43\t\tTaskStatusCompleted,\n44\t\tTaskStatusHold,\n45\t\tTaskStatusAborted,\n46\t}\n47\t\n48\t// TaskStatuses is a collection of TaskStatus values.\n49\ttype TaskStatuses []TaskStatus\n50\t\n51\t// Contains returns true if the collection contains the given status.\n52\tfunc (t TaskStatuses) Contains(status TaskStatus) bool {\n53\t\treturn collection.Contains(t, status)\n54\t}\n55\t\n56\t// String returns the string representation of the status.\n57\tfunc (s TaskStatus) String() string {\n58\t\treturn string(s)\n59\t}\n60\t\n61\t// Validate returns an error if the status is not a valid canonical value.\n62\tfunc (s TaskStatus) Validate(ctx context.Context) error {\n63\t\tif !AvailableTaskStatuses.Contains(s) {\n64\t\t\treturn errors.Wrapf(ctx, validation.Error, \"unknown task status '%s'\", s)\n65\t\t}\n66\t\treturn nil\n67\t}\n68\t\n69\t// Ptr returns a pointer to a copy of the status.\n70\tfunc (s TaskStatus) Ptr() *TaskStatus {\n71\t\treturn &s\n72\t}\n73\t\n74\t// IsValidTaskStatus returns true if the status is a valid canonical status value.\n75\tfunc IsValidTaskStatus(status TaskStatus) bool {\n76\t\treturn AvailableTaskStatuses.Contains(status)\n77\t}\n78\t\n79\t// NormalizeTaskStatus converts alias status values to their canonical form.\n80\t// Returns the canonical status and true if valid, or empty and false if unknown.\n81\tfunc NormalizeTaskStatus(raw string) (TaskStatus, bool) {\n82\t\t// Check if already valid canonical status\n83\t\tstatus := TaskStatus(raw)\n84\t\tif IsValidTaskStatus(status) {\n85\t\t\treturn status, true\n86\t\t}\n87\t\n88\t\t// Migration map for legacy/alias status values\n89\t\tmigrationMap := map[string]TaskStatus{\n90\t\t\t\"todo\":     TaskStatusNext,\n91\t\t\t\"current\":  TaskStatusInProgress,\n92\t\t\t\"done\":     TaskStatusCompleted,\n93\t\t\t\"deferred\": TaskStatusHold,\n94\t\t}\n95\t\n96\t\tif canonical, ok := migrationMap[raw]; ok {\n97\t\t\treturn canonical, true\n98\t\t}\n99\t\n100\t\treturn \"\", false\n101\t}\n102\t"}]},"parent_tool_use_id"