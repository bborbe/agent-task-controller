{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b3a4bb9fc8a07e42","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\t\"github.com/bborbe/cqrs/cdb\"\n13\t\t\"github.com/bborbe/errors\"\n14\t\tlibkv \"github.com/bborbe/kv\"\n15\t\t\"github.com/golang/glog\"\n16\t\n17\t\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n18\t\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n19\t)\n20\t\n21\t// TaskResultCommandOperation is the CQRS command operation name for task result updates.\n22\tconst TaskResultCommandOperation base.CommandOperation = \"update\"\n23\t\n24\t// NewTaskResultExecutor creates a cdb.CommandObjectExecutorTx for update commands.\n25\t// Uses cdb.CommandObjectExecutorTxFunc adapter — same pattern as trading command handlers.\n26\t// vaultName is the controller's VAULT_NAME; a result whose target_vault frontmatter\n27\t// (stamped at task create, echoed by the agent) does not match is cross-vault traffic\n28\t// and is skipped before the write scan (no write, no not_found count, no result event).\n29\tfunc NewTaskResultExecutor(\n30\t\twriter result.ResultWriter,\n31\t\tretryGate PlanningRetryGate,\n32\t\tvaultName string,\n33\t) cdb.CommandObjectExecutorTx {\n34\t\treturn cdb.CommandObjectExecutorTxFunc(\n35\t\t\tTaskResultCommandOperation,\n36\t\t\ttrue,\n37\t\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n38\t\t\t\tvar req lib.Task\n39\t\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &req); err != nil {\n40\t\t\t\t\treturn nil, nil, errors.Wrapf(\n41\t\t\t\t\t\tctx,\n42\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n43\t\t\t\t\t\t\"malformed Task command: %v\",\n44\t\t\t\t\t\terr,\n45\t\t\t\t\t)\n46\t\t\t\t}\n47\t\t\t\tglog.V(2).\n48\t\t\t\t\tInfof(\"task result executor: deserialized task %s (content length=%d, frontmatter keys=%d)\", req.TaskIdentifier, len(req.Content), len(req.Frontmatter))\n49\t\t\t\tif err := req.Validate(ctx); err != nil {\n50\t\t\t\t\treturn nil, nil, errors.Wrapf(\n51\t\t\t\t\t\tctx,\n52\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n53\t\t\t\t\t\t\"invalid Task (taskID=%s): %v\",\n54\t\t\t\t\t\treq.TaskIdentifier,\n55\t\t\t\t\t\terr,\n56\t\t\t\t\t)\n57\t\t\t\t}\n58\t\t\t\tif !routing.ShouldProcessResult(req, vaultName) {\n59\t\t\t\t\tglog.V(2).Infof(\n60\t\t\t\t\t\t\"task result executor: skipped vault mismatch target_vault=%q vault=%q task=%s\",\n61\t\t\t\t\t\treq.Frontmatter[\"target_vault\"], vaultName, req.TaskIdentifier,\n62\t\t\t\t\t)\n63\t\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n64\t\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n65\t\t\t\t\t// cross-vault result (go-cqrs/skipped-not-nil-for-non-retryable).\n66\t\t\t\t\treturn nil, nil, errors.Wrapf(\n67\t\t\t\t\t\tctx,\n68\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n69\t\t\t\t\t\t\"cross-vault result for task %s\",\n70\t\t\t\t\t\treq.TaskIdentifier,\n71\t\t\t\t\t)\n72\t\t\t\t}\n73\t\t\t\thandled, err := retryGate.Handle(ctx, req)\n74\t\t\t\tif err != nil {\n75\t\t\t\t\treturn nil, nil, errors.Wrapf(\n76\t\t\t\t\t\tctx,\n77\t\t\t\t\t\terr,\n78\t\t\t\t\t\t\"planning retry gate for task %s\",\n79\t\t\t\t\t\treq.TaskIdentifier,\n80\t\t\t\t\t)\n81\t\t\t\t}\n82\t\t\t\tif handled {\n83\t\t\t\t\treturn resultEvent(ctx, req)\n84\t\t\t\t}\n85\t\t\t\tif err := writer.WriteResult(ctx, req); err != nil {\n86\t\t\t\t\treturn nil, nil, errors.Wrapf(\n87\t\t\t\t\t\tctx,\n88\t\t\t\t\t\terr,\n89\t\t\t\t\t\t\"write result for task %s\",\n90\t\t\t\t\t\treq.TaskIdentifier,"}]},"parent_tool_use_id":"chatcmpl-tool-9dd1ef7ac5355a1e","session_id":"d5b7e577-b8e1-45e9-9e5