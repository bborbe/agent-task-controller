pect(body).To(ContainSubstring(\"\\n---\\n\"), \"body --- must be preserved\")\n478\t\t\t\t\t\tExpect(body).NotTo(ContainSubstring(`\\-\\-\\-`), \"body --- must NOT be escaped\")\n479\t\n480\t\t\t\t\t\t// 7. Body contains result section\n481\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"## Result\"))\n482\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"b3b44eb0-60d9-40b9-9e7d-5afdc3272020\"))\n483\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"DONE\"))\n484\t\n485\t\t\t\t\t\t// 8. Body contains Tags line (Obsidian links)\n486\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"Tags: [[Task]] [[Trading]]\"))\n487\t\n488\t\t\t\t\t\t// 9. Committed exactly once\n489\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n490\t\n491\t\t\t\t\t\t// 10. Verify the full file can be re-read and re-parsed\n492\t\t\t\t\t\t// (simulates controller reading it again on next cycle)\n493\t\t\t\t\t\treParsedFm, reParseErr := extractTestFrontmatter(s)\n494\t\t\t\t\t\tExpect(reParseErr).NotTo(HaveOccurred())\n495\t\t\t\t\t\tExpect(reParsedFm[\"status\"]).To(Equal(\"completed\"))\n496\t\t\t\t\t\tExpect(reParsedFm[\"phase\"]).To(Equal(\"done\"))\n497\t\t\t\t\t},\n498\t\t\t\t)\n499\t\t\t})\n500\t\n501\t\t\tContext(\"retry counter\", func() {\n502\t\t\t\tIt(\"does not modify retry_count on failure and keeps ai_review phase\", func() {\n503\t\t\t\t\twriteTaskFile("}]},"parent_tool_use_id":"chatcmpl-tool-9dd1ef7ac5355a1e","session_id":"d5b7e577-b8e1-45e9-9e5a-be2299ed6cef","uuid":"ad0d1ed7-18c7-4f99-922a-d6ece9eddf15","timestamp":"2026-08-31T11:50:49.376Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 006"}
