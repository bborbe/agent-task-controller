sult-writer-test-*\")\n61\t\t\tExpect(err).NotTo(HaveOccurred())\n62\t\n63\t\t\ttaskDir = \"tasks\"\n64\t\t\tExpect(os.MkdirAll(filepath.Join(tmpDir, taskDir), 0750)).To(Succeed())\n65\t\n66\t\t\tfakeGit = &mocks.GitClient{}\n67\t\t\tfakeGit.PathReturns(tmpDir)\n68\t\t\tfakeGit.ListFilesStub = func(_ context.Context, glob string) ([]string, error) {\n69\t\t\t\tmatches, err := filepath.Glob(filepath.Join(tmpDir, glob))\n70\t\t\t\tif err != nil {\n71\t\t\t\t\treturn nil, err\n72\t\t\t\t}\n73\t\t\t\tvar rel []string\n74\t\t\t\tfor _, m := range matches {\n75\t\t\t\t\tr, _ := filepath.Rel(tmpDir, m)\n76\t\t\t\t\trel = append(rel, r)\n77\t\t\t\t}\n78\t\t\t\treturn rel, nil\n79\t\t\t}\n80\t\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n81\t\t\t\treturn os.ReadFile(filepath.Join(tmpDir, relPath)) // #nosec G304 -- test-only path\n82\t\t\t}\n83\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n84\t\t\t\tctx context.Context,\n85\t\t\t\tabsPath string,\n86\t\t\t\tmodify func([]byte) ([]byte, error),\n87\t\t\t\tmessage string,\n88\t\t\t) error {\n89\t\t\t\tcurrent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn err\n92\t\t\t\t}\n93\t\t\t\tupdated, err := modify(current)\n94\t\t\t\tif err != nil {\n95\t\t\t\t\treturn err\n96\t\t\t\t}\n97\t\t\t\treturn os.WriteFile(absPath, updated, 0600) // #nosec G306 -- test helper\n98\t\t\t}\n99\t\n100\t\t\tfakeTime = &libtimemocks.CurrentDateTimeGetter{}\n101\t\t\tfakeTime.NowReturns(libtime.DateTime(time.Date(2026, 4, 18, 12, 0, 0, 0, time.UTC)))\n102\t\n103\t\t\tidentifier = lib.TaskIdentifier(\"test-task-uuid-1234\")\n104\t\t\twriter = result.NewResultWriter(fakeGit, taskDir, fakeTime, metrics.New())\n105\t\t})\n106\t\n107\t\tAfterEach(func() {\n108\t\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n109\t\t})\n110\t\n111\t\twriteTaskFile := func(name, content string) string {\n112\t\t\tabsPath := filepath.Join(tmpDir, taskDir, name)\n113\t\t\tExpect(os.WriteFile(absPath, []byte(content), 0600)).To(Succeed())\n114\t\t\treturn absPath\n115\t\t}\n116\t\n117\t\tDescribe(\"WriteResult\", func() {\n118\t\t\tContext(\"normal write\", func() {\n119\t\t\t\tIt(\"writes frontmatter and content to the matched file\", func() {\n120\t\t\t\t\twriteTaskFile(\n121\t\t\t\t\t\t\"my-task.md\",\n122\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\nassignee: backtest-agent\\ntags:\\n  - agent-task\\n  - test\\n---\\nOld content\\n\",\n123\t\t\t\t\t)\n124\t\n125\t\t\t\t\ttaskFile = lib.Task{\n126\t\t\t\t\t\tTaskIdentifier: identifier,\n127\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n128\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n129\t\t\t\t\t\t\t\"status\":          \"done\",\n130\t\t\t\t\t\t\t\"phase\":           \"done\",\n131\t\t\t\t\t\t},\n132\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n133\t\t\t\t\t}\n134\t\n135\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n136\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n137\t\n138\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n139\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n140\t\t\t\t\tExpect(string(written)).To(HavePrefix(\"---\\n\"))\n141\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"status: done\"))\n142\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"phase: done\"))\n143\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"assignee: backtest-agent\"))\n144\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"agent-task\"))\n145\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"---\\nNew content\\n\"))\n146\t\n147\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n148\t\t\t\t\t_, _, _, msg := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(0)\n149\t\t\t\t\tExpect(msg).To(ContainSubstring(string(identifier)))\n150\t\t\t\t})\n151\t\t\t})\n152\t\n153\t\t\tContext(\"frontmatter merge\", func() {\n154\t\t\t\tIt(\"preserves existing frontmatter keys not sent by agent\", func() {\n155\t\t\t\t\twriteTaskFile(\n156\t\t\t\t\t\t\"my-task.md\",\n157\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nassignee: backtest-agent\\ntags:\\n  - a\\n  - b\\ncustom_field: hello\\n---\\nOld content\\n\",\n158\t\t\t\t\t)\n159\t\n160\t\t\t\t\ttaskFile = lib.Task{\n161\t\t\t\t\t\tTaskIdentifier: identifier,\n162\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n163\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n164\t\t\t\t\t\t\t\"status\":          \"completed\",\n165\t\t\t\t\t\t\t\"phase\":           \"done\",\n166\t\t\t\t\t\t},\n167\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n168\t\t\t\t\t}\n169\t\n170\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n171\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n172\t\n173\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n174\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n175\t\t\t\t\ts := string(written)\n176\t\t\t\t\tExpect(s).To(ContainSubstring(\"assignee: backtest-agent\"))\n177\t\t\t\t\tExpect(s).To(ContainSubstring(\"custom_field: hello\"))\n178\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n179\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n180\t\t\t\t\tExpect(s).To(ContainSubstring(\"task_identifier: test-task-uuid-1234\"))\n181\t\t\t\t\t// tags preserved\n182\t\t\t\t\tExpect(s).To(ContainSubstring(\"- a\"))\n183\t\t\t\t\tExpect(s).To(ContainSubstring(\"- b\"))\n184\t\t\t\t})\n185\t\n186\t\t\t\tIt(\"agent keys override existing keys\", func() {\n187\t\t\t\t\twriteTaskFile(\n188\t\t\t\t\t\t\"my-task.md\",\n189\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: in_progress\\n---\\nOld content\\n\",\n190\t\t\t\t\t)\n191\t\n192\t\t\t\t\ttaskFile = lib.Task{\n193\t\t\t\t\t\tTaskIdentifier: identifier,\n194\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n195\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n196\t\t\t\t\t\t\t\"status\":          \"completed\",\n197\t\t\t\t\t\t\t\"phase\":           \"done\",\n198\t\t\t\t\t\t},\n199\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n200\t\t\t\t\t}\n201\t\n202\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n203\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n204\t\n205\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n206\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n207\t\t\t\t\ts := string(written)\n208\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n209\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n210\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"in_progress\"))\n211\t\t\t\t})\n212\t\t\t})\n213\t\n214\t\t\tContext(\"overwrite\", func() {\n215\t\t\t\tIt(\"fully replaces content on second call\", func() {\n216\t\t\t\t\twriteTaskFile(\n217\t\t\t\t\t\t\"my-task.md\",\n218\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\n---\\nFirst content\\n\",\n219\t\t\t\t\t)\n220\t"}]},"parent_tool_use_id":"chatcmpl-tool-919a73eb6bd8d5d6","session_id":"d5b7e577-b8e1-45e9-9e5a-be2299ed6cef","uuid":"3e779d87-0960-4df8-98ba-71de78b551e1","timestamp":"2026-08-31T12:05:26.183Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1-spec-006-field-ownership-guard"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b73908e4aba7f2c2","type":"tool_result","content":"1\t# Changelog\n2\t\n3\tAll notable changes to this project will be documented in this file.\n4\t\n5\tThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/),\n6\tand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\n7\t\n8\t## Unreleased\n9\t\n10\t- fix: make terminal-task reopens operator-visible — a `create-task` that reopens a title path held by a `completed`/`aborted` task now emits an unconditional `create-task: reopening terminal task` INFO log (naming the path and prior status) at default verbosity and commits with a distinct `[agent-task-controller] reopen terminal task <id>` message, so a terminal-task reopen is greppable in prod logs and vault history without raising the log level\n11\t\n12\t## v0.6.1\n13\t\n14\t- fix: recurring-task instances never reopen a terminal task file — a `create-task` from the `recurring-task-creator` publisher now holds the title path when the existing file's status is `completed`/`aborted` (the title-path file IS the recurring dedup state), so an hourly always-fire tick can no longer overwrite a completed recurring task with a blank `in_progress` instance; non-recurring per-alert commands keep the v0.6.0 reopen behavior\n15\t- fix: non-reopen creates use a create-only write — the create path now calls git-rest's `POST ?create_only=1` (`AtomicWriteIfAbsentAndCommitPush`/`PostIfAbsent`), and a 409 Conflict is mapped to the benign `ErrTaskAlreadyExists` (no write, no git commit) instead of overwriting; the pre-write title-path read stays only as a fast-path, never authoritative, so a falsely-free read can no longer lead to an overwrite\n16\t\n17\t## v0.6.0\n18\t\n19\t- feat: `create-task` reopens a title path held by a terminal task — a path whose existing file has frontmatter status `completed` or `aborted` is treated as free, so a create command materializes a fresh non-terminal task at that path instead of returning `ErrTaskAlreadyExists`; any non-terminal status, absent/empty/unknown status, missing frontmatter delimiters, or unparseable YAML still holds the path (dedup decision moved from file existence to the existing task's status)\n20\t- fix: make terminal-task reopens operator-visible — a create-task that materializes a fresh task over a `completed`/`aborted` file now emits an unconditional `create-task: reopening terminal task` INFO log (naming the path and prior status) at default verbosity and commits with a distinct `[agent-task-controller] reopen terminal task <id>` message, so a reopen is greppable in prod logs and vault history without raising the log level\n21\t\n22\t## v0.5.2\n23\t\n24\t- fix: make the trigger/retry caps opt-in — an absent `max_triggers`/`max_retries` now means no cap, so a recurring task that accumulates `trigger_count` across zombie-failure re-dispatches never has its routing `assignee` stripped and never appends spurious escalation sections (increment-frontmatter executor + result-writer caps). Previously the lib default-3 fallback stripped `assignee` on the 3rd trigger, silently killing the re-dispatch loop (2026-08-27 prod incident: Daily Sentry Triage assignee strip).\n25\t\n26\t## v0.5.1\n27\t\n28\t- chore: update github.com/bborbe/metrics to v0.5.15, github.com/bborbe/vault-cli to v0.116.1\n29\t## v0.5.0\n30\t\n31\t- feat: vault-routing guard on the result path — `target_vault` stamped into every created task; the result executor skips cross-vault results before the write scan (no write, no not_found count, no result event), mirroring the create-path `routing.ShouldProcess` guard (spec 044)\n32\t\n33\t## v0.4.0\n34\t\n35\t- feat: handle `complete-task` command — transitions an open vault task to `status: completed`, `phase: done` with a `# Resolution` body block (recovery SHA, closed-at); idempotent (no duplicate Resolution) — closes build-failure tasks on build red→green (spec 076)\n36\t\n37\t## v0.3.6\n38\t\n39\t- chore: update Go to 1.27.0 and github.com/bborbe/agent to v0.82.1, github.com/bborbe/argument/v2 to v2.12.37, github.com/bborbe/boltkv to v1.14.9, github.com/bborbe/cqrs to v0.6.8, github.com/bborbe/errors to v1.5.20, github.com/bborbe/http to v1.26.24, github.com/bborbe/kafka to v1.25.9, github.com/bborbe/kv to v1.21.11, github.com/bborbe/log to v1.6.24, github.com/bborbe/metrics to v0.5.14, github.com/bborbe/run to v1.9.37, github.com/bborbe/sentry to v1.9.27, github.com/bborbe/service to v1.10.9, github.com/bborbe/time to v1.27.10, github.com/bborbe/validation to v1.4.22, github.com/bborbe/vault-cli to v0.115.0\n40\t"}]},"parent_tool_use_id":"chatcmpl-tool-919a73eb6bd8d5d6","session_id":"d5b7e577-b8e1-45e9-9e5a-be2299ed6cef","uuid":"f8ff8e66-9ba3-48fa-87e6-98604f7eb81d","timestamp":"2026-08-31T12:05:26.185Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1-spec-006-field-ownership-guard"}
