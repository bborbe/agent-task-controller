{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-addc0cd02ede9d0b","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage result\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\tlib \"github.com/bborbe/agent\"\n15\t\t\"github.com/bborbe/errors\"\n16\t\tlibtime \"github.com/bborbe/time\"\n17\t\t\"github.com/golang/glog\"\n18\t\t\"gopkg.in/yaml.v3\"\n19\t\n20\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n21\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n22\t)\n23\t\n24\t//counterfeiter:generate -o ../../mocks/result_writer.go --fake-name ResultWriter . ResultWriter\n25\t\n26\t// ResultWriter writes a Task back to the vault task file.\n27\ttype ResultWriter interface {\n28\t\tWriteResult(ctx context.Context, req lib.Task) error\n29\t}\n30\t\n31\t// NewResultWriter creates a ResultWriter that locates task files in the vault\n32\t// and writes the result, committing via gitClient.\n33\tfunc NewResultWriter(\n34\t\tgitClient gitclient.GitClient,\n35\t\ttaskDir string,\n36\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n37\t\tm metrics.Metrics,\n38\t) ResultWriter {\n39\t\treturn &resultWriter{\n40\t\t\tgitClient:       gitClient,\n41\t\t\ttaskDir:         taskDir,\n42\t\t\tcurrentDateTime: currentDateTime,\n43\t\t\tmetrics:         m,\n44\t\t}\n45\t}\n46\t\n47\ttype resultWriter struct {\n48\t\tgitClient       gitclient.GitClient\n49\t\ttaskDir         string\n50\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n51\t\tmetrics         metrics.Metrics\n52\t}\n53\t\n54\t// FindTaskFilePath lists files in taskDir via gitClient and returns the relative path of\n55\t// the .md file whose frontmatter has task_identifier == id, plus the parsed existing frontmatter.\n56\t// Returns (\"\", nil, nil) when no match is found (not an error).\n57\tfunc FindTaskFilePath(\n58\t\tctx context.Context,\n59\t\tgitClient gitclient.GitClient,\n60\t\ttaskDir string,\n61\t\tid lib.TaskIdentifier,\n62\t) (string, lib.TaskFrontmatter, error) {\n63\t\tglob := taskDir + \"/*.md\"\n64\t\tpaths, err := gitClient.ListFiles(ctx, glob)\n65\t\tif err != nil {\n66\t\t\treturn \"\", nil, errors.Wrapf(ctx, err, \"list task files with glob %s\", glob)\n67\t\t}\n68\t\tvar matchedRelPath string\n69\t\tvar existingFrontmatter lib.TaskFrontmatter\n70\t\tfor _, relPath := range paths {\n71\t\t\tcontent, readErr := gitClient.ReadFile(ctx, relPath)\n72\t\t\tif readErr != nil {\n73\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (read error: %v)\", relPath, readErr)\n74\t\t\t\tcontinue\n75\t\t\t}\n76\t\t\tfrontmatter, fmErr := ExtractFrontmatter(ctx, content)\n77\t\t\tif fmErr != nil {\n78\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (frontmatter error: %v)\", relPath, fmErr)\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tvar fm struct {\n82\t\t\t\tTaskIdentifier string `yaml:\"task_identifier\"`\n83\t\t\t}\n84\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &fm); umErr != nil {\n85\t\t\t\tglog.V(3).Infof(\"FindTaskFilePath: skip %s (unmarshal error: %v)\", relPath, umErr)\n86\t\t\t\tcontinue\n87\t\t\t}\n88\t\t\tglog.V(3).\n89\t\t\t\tInfof(\"FindTaskFilePath: file %s has task_identifier=%s\", relPath, fm.TaskIdentifier)\n90\t\t\tif lib.TaskIdentifier(fm.TaskIdentifier) == id {\n91\t\t\t\tmatchedRelPath = relPath\n92\t\t\t\tglog.V(2).Infof(\"FindTaskFilePath: matched file %s for task %s\", matchedRelPath, id)\n93\t\t\t\tvar existingFm lib.TaskFrontmatter\n94\t\t\t\tif umErr := yaml.Unmarshal([]byte(frontmatter), &existingFm); umErr != nil {\n95\t\t\t\t\tglog.V(3).\n96\t\t\t\t\t\tInfof(\"FindTaskFilePath: could not unmarshal existing frontmatter for %s: %v\", relPath, umErr)\n97\t\t\t\t} else {\n98\t\t\t\t\texistingFrontmatter = existingFm\n99\t\t\t\t}\n100\t\t\t}\n101\t\t}\n102\t\treturn matchedRelPath, existingFrontmatter, nil\n103\t}\n104\t\n105\tfunc (r *resultWriter) WriteResult(ctx context.Context, req lib.Task) error {\n106\t\tglog.V(2).Infof(\"WriteResult: starting for task %s\", req.TaskIdentifier)\n107\t\tglog.V(3).Infof(\"WriteResult: scanning taskDir=%s\", r.taskDir)\n108\t\n109\t\tmatchedRelPath, _, err := FindTaskFilePath(\n110\t\t\tctx,\n111\t\t\tr.gitClient,\n112\t\t\tr.taskDir,\n113\t\t\treq.TaskIdentifier,\n114\t\t)\n115\t\tif err != nil {\n116\t\t\treturn errors.Wrapf(ctx, err, \"find task file path failed\")\n117\t\t}\n118\t\n119\t\tif matchedRelPath == \"\" {\n120\t\t\tglog.Warningf(\"task file not found for identifier %s, skipping\", req.TaskIdentifier)\n121\t\t\tr.metrics.ResultsWrittenTotal(\"not_found\").Inc()\n122\t\t\treturn nil\n123\t\t}\n124\t\n125\t\tabsPath := filepath.Join(r.gitClient.Path(), matchedRelPath)\n126\t\tcommitMessage := fmt.Sprintf(\n127\t\t\t\"[agent-task-controller] write result for task %s\",\n128\t\t\treq.TaskIdentifier,\n129\t\t)\n130\t\tglog.V(2).Infof(\"WriteResult: writing and pushing for task %s\", req.TaskIdentifier)\n131\t\tif err := r.gitClient.AtomicReadModifyWriteAndCommitPush(\n132\t\t\tctx,\n133\t\t\tabsPath,\n134\t\t\tr.buildResultModifyFn(ctx, req),\n135\t\t\tcommitMessage,\n136\t\t); err != nil {\n137\t\t\tr.metrics.ResultsWrittenTotal(\"error\").Inc()\n138\t\t\treturn errors.Wrapf(ctx, err, \"atomic read-modify-write and push failed\")\n139\t\t}\n140\t\n141\t\tglog.V(2).Infof(\"WriteResult: completed successfully for task %s\", req.TaskIdentifier)\n142\t\tr.metrics.ResultsWrittenTotal(\"success\").Inc()\n143\t\treturn nil\n144\t}\n145\t\n146\t// buildResultModifyFn returns a modify callback for AtomicReadModifyWriteAndCommitPush\n147\t// that re-reads the on-disk frontmatter+body on every git retry, then applies the\n148\t// merge / retry-counter / cap rules. Re-reading per retry eliminates the read-then-write\n149\t// race against the partial-update executor (task_update_frontmatter_executor.go) that\n150\t// previously caused stale-snapshot writes to roll back terminal status.\n151\tfunc (r *resultWriter) buildResultModifyFn(\n152\t\tctx context.Context,\n153\t\treq lib.Task,\n154\t) func(current []byte) ([]byte, error) {\n155\t\treturn func(current []byte) ([]byte, error) {\n156\t\t\tfrontmatterStr, err := ExtractFrontmatter(ctx, current)\n157\t\t\tif err != nil {\n158\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n159\t\t\t}\n160\t\t\tbodyStr, err := ExtractBody(ctx, current)\n161\t\t\tif err != nil {\n162\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n163\t\t\t}\n164\t\t\tvar currentOnDisk lib.TaskFrontmatter\n165\t\t\t// NOTE: inlined yaml ops mirror the pre-race version of WriteResult; pkg/command/ helpers\n166\t\t\t// are unexported and the lift-and-share is out of scope for this race fix.\n167\t\t\tif err := yaml.Unmarshal([]byte(frontmatterStr), &currentOnDisk); err != nil {\n168\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal current frontmatter\")\n169\t\t\t}\n170\t\n171\t\t\tmerged := mergeFrontmatter(currentOnDisk, req.Frontmatter)\n172\t\t\tbody := r.applyRetryCounter(merged, currentOnDisk, string(req.Content))\n173\t\n174\t\t\tmarshaledFrontmatter, err := yaml.Marshal(map[string]any(merged))\n175\t\t\tif err != nil {\n176\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n177\t\t\t}\n178\t\t\t// Discard the on-disk body — WriteResult fully replaces body with req.Content\n179\t\t\t// (post-applyRetryCounter modifications), matching the prior single-write\n180\t\t\t// semantics. bodyStr is read above only to validate the file has well-formed\n181\t\t\t// delimiters; an extraction error must surface so we do not silently overwrite a\n182\t\t\t// corrupted file.\n183\t\t\t_ = bodyStr\n184\t\t\treturn []byte(\"---\\n\" + string(marshaledFrontmatter) + \"---\\n\" + body), nil\n185\t\t}\n186\t}\n187\t\n188\tfunc (r *resultWriter) applyRetryCounter(merged, existing lib.TaskFrontmatter, body string) string {\n189\t\tif string(merged.Status()) == \"completed\" {\n190\t\t\treturn body\n191\t\t}\n192\t\n193\t\t// Trigger-count cap enforcement runs unconditionally before any early\n194\t\t// returns below: it is a derived invariant on the on-disk state that\n195\t\t// must hold after every WriteResult. Placing it here also prevents the\n196\t\t// spawn_notification short-circuit below from silently skipping\n197\t\t// escalation on agent result writes that inherited spawn_notification\n198\t\t// from a previous merge (observed live on dev 2026-04-24, task\n199\t\t// ba1bad61: spawn-notification update set spawn_notification=true,\n200\t\t// then the agent's result publish inherited it via mergeFrontmatter\n201\t\t// and skipped the cap check, reverting phase: human_review to\n202\t\t// ai_review). The triggerCount > 0 guard prevents degenerate\n203\t\t// escalation of brand-new tasks where trigger_count is absent.\n204\t\ttriggerCount := merged.TriggerCount()\n205\t\tbody = r.applyTriggerCap(merged, existing, triggerCount, body)\n206\t\n207\t\t// human_review assignee-clear guard runs BEFORE the spawn_notification\n208\t\t// early return below. On a pr-reviewer agent's first post-spawn write, the merged\n209\t\t// frontmatter carries spawn_notification: true (inherited from the executor's\n210\t\t// spawn-time UpdateFrontmatterCommand) AND incoming phase: human_review (from\n211\t\t// Result.NextPhase via resolveNextPhase). If this guard were below the\n212\t\t// spawn_notification early return, clearAssignee would never fire and the\n213\t\t// operator inbox filter (assignee == \"\") would miss the task. Same bug class\n214\t\t// as prompt 075 (2026-04-24 applyTriggerCap precedent, task ba1bad61); spec 041\n215\t\t// fixes the 2026-05-25 prod incident (task bborbe-agent #3).\n216\t\t// needs_input: agent explicitly requested human review — clear assignee so task surfaces in operator inbox.\n217\t\t// Routes through ClearAssigneeIfHumanReview (spec 042) so the partial-update executor shares the same chokepoint.\n218\t\tClearAssigneeIfHumanReview(merged)\n219\t\n220\t\tif merged.SpawnNotification() {\n221\t\t\tdelete(merged, \"spawn_notification\")\n222\t\t\treturn body\n223\t\t}\n224\t\n225\t\t// retry_count is authoritative in the task file — the executor bumped it\n226\t\t// at spawn time (spec 011). The writer only applies escalation.\n227\t\tretryCount := merged.RetryCount()\n228\t\tbody = r.applyRetryCap(merged, existing, retryCount, body)\n229\t\n230\t\treturn body\n231\t}\n232\t\n233\t// applyTriggerCap enforces the trigger-count cap. The cap is opt-in: an absent\n234\t// max_triggers means no cap, so recurring tasks that accumulate trigger_count\n235\t// across re-dispatches are never escalated and never have their routing assignee\n236\t// stripped (the lib default-3 fallback would kill the re-dispatch loop). The\n237\t// triggerCount > 0 guard prevents degenerate escalation of brand-new tasks where\n238\t// trigger_count is absent. When the task is already parked (section present),\n239\t// existing.Phase() restores the on-disk lifecycle phase to prevent stale-result\n240\t// phase clobber (cap stickiness).\n241\tfunc (r *resultWriter) applyTriggerCap(\n242\t\tmerged, existing lib.TaskFrontmatter,\n243\t\ttriggerCount int,\n244\t\tbody string,\n245\t) string {\n246\t\tif _, ok := merged[\"max_triggers\"]; !ok {\n247\t\t\treturn body\n248\t\t}\n249\t\tif triggerCount == 0 || triggerCount < merged.MaxTriggers() {\n250\t\t\treturn body\n251\t\t}\n252\t\tagentName := clearAssignee(merged)\n253\t\tif containsEscalationSection(body, \"## Trigger Cap Escalation\") {\n254\t\t\trestoreExistingPhase(existing, merged)\n255\t\t\treturn body\n256\t\t}\n257\t\treturn body + r.triggerEscalationSection(triggerCount, agentName, merged)\n258\t}\n259\t\n260\t// applyRetryCap enforces the retry-count cap. The cap is opt-in: an absent max_retries\n261\t// means no cap, so tasks that accumulate retry_count across re-dispatches are never\n262\t// escalated and never have their routing assignee stripped (the lib default-3 fallback\n263\t// would kill the re-dispatch loop). When the task is already parked (section present),\n264\t// existing.Phase() restores the on-disk lifecycle phase (cap stickiness).\n265\tfunc (r *resultWriter) applyRetryCap(\n266\t\tmerged, existing lib.TaskFrontmatter,\n267\t\tretryCount int,\n268\t\tbody string,\n269\t) string {\n270\t\tif _, ok := merged[\"max_retries\"]; !ok {\n271\t\t\treturn body\n272\t\t}\n273\t\tif retryCount < merged.MaxRetries() {\n274\t\t\treturn body\n275\t\t}\n276\t\tagentName := clearAssignee(merged)\n277\t\tif containsEscalationSection(body, \"## Retry Escalation\") {\n278\t\t\trestoreExistingPhase(existing, merged)\n279\t\t\treturn body\n280\t\t}\n281\t\treturn body + r.escalationSection(retryCount, agentName)\n282\t}\n283\t\n284\t// clearAssignee sets previous_assignee to the current assignee value (if non-empty),\n285\t// then clears assignee to \"\". Returns the captured name for use in escalation body text.\n286\t// This is the single chokepoint for all assignee-clear operations in the result writer.\n287\tfunc clearAssignee(merged lib.TaskFrontmatter) string {\n288\t\tagentName := string(merged.Assignee())\n289\t\tif agentName != \"\" {\n290\t\t\tmerged[\"previous_assignee\"] = agentName\n291\t\t}\n292\t\tmerged[\"assignee\"] = \"\"\n293\t\treturn agentName\n294\t}\n295\t\n296\t// ClearAssigneeIfHumanReview enforces the spec-039 / spec-042 doctrine:\n297\t// when merged frontmatter has phase == \"human_review\", clear assignee via\n298\t// clearAssignee (which captures the prior assignee into previous_assignee\n299\t// if non-empty, then sets assignee to \"\"). Returns the prior assignee\n300\t// name (empty string when no clear happened OR when the prior assignee\n301\t// was already empty). This is the single chokepoint for the human_review\n302\t// assignee-clear invariant; both the result writer and the partial-update\n303\t// executor (spec 042) route through here.\n304\tfunc ClearAssigneeIfHumanReview(merged lib.TaskFrontmatter) string {\n305\t\tif phase, ok := merged[\"phase\"].(string); ok && phase == \"human_review\" {\n306\t\t\treturn clearAssignee(merged)\n307\t\t}\n308\t\treturn \"\"\n309\t}\n310\t\n311\t// restoreExistingPhase writes the on-disk phase back into merged when the existing\n312\t// frontmatter has a phase value. Used to enforce cap stickiness on repeated writes.\n313\tfunc restoreExistingPhase(existing, merged lib.TaskFrontmatter) {\n314\t\tif p := existing.Phase(); p != nil {\n315\t\t\tmerged[\"phase\"] = string(*p)\n316\t\t}\n317\t}\n318\t\n319\tfunc (r *resultWriter) escalationSection(retryCount int, agentName string) string {\n320\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n321\t\treturn fmt.Sprintf(\n322\t\t\t\"\\n## Retry Escalation\\n\\n- **Timestamp:** %s\\n- **Attempts:** %d\\n- **Assignee:** %s\\n- **Last error:** see agent output above\\n\",\n323\t\t\tts,\n324\t\t\tretryCount,\n325\t\t\tagentName,\n326\t\t)\n327\t}\n328\t\n329\tfunc (r *resultWriter) triggerEscalationSection(\n330\t\ttriggerCount int,\n331\t\tagentName string,\n332\t\tmerged lib.TaskFrontmatter,\n333\t) string {\n334\t\tts := r.currentDateTime.Now().UTC().Format(time.RFC3339)\n335\t\treturn fmt.Sprintf(\n336\t\t\t\"\\n## Trigger Cap Escalation\\n\\n- **Timestamp:** %s\\n- **Trigger count:** %d\\n- **Max triggers:** %d\\n- **Assignee:** %s\\n- **Last agent output:** see `## Result` above\\n\",\n337\t\t\tts,\n338\t\t\ttriggerCount,\n339\t\t\tmerged.MaxTriggers(),\n340\t\t\tagentName,\n341\t\t)\n342\t}\n343\t\n344\t// containsEscalationSection reports whether body already has the given\n345\t// escalation header on its own line. Used to prevent duplicate escalation\n346\t// sections when WriteResult runs multiple times on a task that is already\n347\t// at cap (e.g. agent publishes another result while the task sits in\n348\t// phase: human_review).\n349\tfunc containsEscalationSection(body, header string) bool {\n350\t\treturn strings.Contains(body, \"\\n\"+header+\"\\n\")\n351\t}\n352\t\n353\t// mergeFrontmatter returns a new frontmatter map with all keys from existing,\n354\t// overridden by all keys from incoming. Neither input map is modified.\n355\tfunc mergeFrontmatter(existing, incoming lib.TaskFrontmatter) lib.TaskFrontmatter {\n356\t\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n357\t\tfor k, v := range existing {\n358\t\t\tmerged[k] = v\n359\t\t}\n360\t\tfor k, v := range incoming {\n361\t\t\tmerged[k] = v\n362\t\t}\n363\t\treturn merged\n364\t}\n365\t\n366\t// ExtractFrontmatter returns the YAML frontmatter string between the opening and\n367\t// closing \"---\" delimiters. Returns an error if delimiters are missing.\n368\tfunc ExtractFrontmatter(ctx context.Context, content []byte) (string, error) {\n369\t\ts := string(content)\n370\t\tconst delim = \"---\"\n371\t\tif !strings.HasPrefix(s, delim) {\n372\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n373\t\t}\n374\t\trest := strings.TrimPrefix(s, delim)\n375\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n376\t\t\trest = rest[2:]\n377\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n378\t\t\trest = rest[1:]\n379\t\t}\n380\t\tbefore, _, found := strings.Cut(rest, \"\\n---\")\n381\t\tif !found {\n382\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n383\t\t}\n384\t\treturn before, nil\n385\t}\n386\t\n387\t// ExtractBody returns the file body — the bytes after the closing \"---\\n\" delimiter.\n388\t// Returns an empty string if the body is empty; error if delimiters are missing.\n389\tfunc ExtractBody(ctx context.Context, content []byte) (string, error) {\n390\t\ts := string(content)\n391\t\tconst delim = \"---\"\n392\t\tif !strings.HasPrefix(s, delim) {\n393\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n394\t\t}\n395\t\trest := strings.TrimPrefix(s, delim)\n396\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n397\t\t\trest = rest[2:]\n398\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n399\t\t\trest = rest[1:]\n400\t\t}\n401\t\t_, after, found := strings.Cut(rest, \"\\n---\\n\")\n402\t\tif !found {\n403\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n404\t\t}\n405\t\treturn after, nil\n406\t}\n407\t"}]},"parent_tool_use_id":"chatcmpl-tool-919a73eb6bd8d5d6","session_id":"d5b7e577-b8e1-45e9-9e5a-be2299ed6cef","uuid":"f263a8f5-11ed-4591-9431-cfdcc5f287af","timestamp":"2026-08-31T12:04:31.968Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1-spec-006-field-ownership-guard"}
