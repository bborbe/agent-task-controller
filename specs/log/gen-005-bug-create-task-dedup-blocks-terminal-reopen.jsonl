t: every title path is free unless a test overrides ReadFile.\n61\t\t\tfakeGit.ReadFileReturns(nil, errors.New(\"GET file returned 404: not found\"))\n62\t\n63\t\t\tclock = &libtimemocks.CurrentDateTimeGetter{}\n64\t\t\tclock.NowReturns(libtime.DateTime(time.Date(2026, 6, 15, 10, 0, 0, 0, time.UTC)))\n65\t\n66\t\t\texecutor = command.NewCreateTaskExecutor(fakeGit, taskDir, \"openclaw\", clock, testK)\n67\t\t\tschemaID = cdb.SchemaID{Group: \"agent\", Kind: \"task\", Version: \"v1\"}\n68\t\t})\n69\t\n70\t\tAfterEach(func() {\n71\t\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n72\t\t})\n73\t\n74\t\tbuildCmdObj := func(cmd task.CreateCommand) cdb.CommandObject {\n75\t\t\tevent, err := base.ParseEvent(ctx, cmd)\n76\t\t\tExpect(err).NotTo(HaveOccurred())\n77\t\t\treturn cdb.CommandObject{\n78\t\t\t\tCommand: base.Command{\n79\t\t\t\t\tRequestID: base.NewRequestID(),\n80\t\t\t\t\tOperation: task.CreateCommandOperation,\n81\t\t\t\t\tInitiator: \"test\",\n82\t\t\t\t\tData:      event,\n83\t\t\t\t},\n84\t\t\t\tSchemaID: schemaID,\n85\t\t\t}\n86\t\t}\n87\t\n88\t\tDescribe(\"CommandOperation\", func() {\n89\t\t\tIt(\"returns create-task\", func() {\n90\t\t\t\tExpect(executor.CommandOperation()).To(Equal(base.CommandOperation(\"create-task\")))\n91\t\t\t})\n92\t\t})\n93\t\n94\t\tDescribe(\"HandleCommand\", func() {\n95\t\t\tContext(\"malformed command payload\", func() {\n96\t\t\t\tIt(\"returns ErrCommandObjectSkipped without writing\", func() {\n97\t\t\t\t\t// A channel is not JSON-marshalable, so MarshalInto will fail.\n98\t\t\t\t\tcmdObj := cdb.CommandObject{\n99\t\t\t\t\t\tCommand: base.Command{\n100\t\t\t\t\t\t\tRequestID: base.NewRequestID(),\n101\t\t\t\t\t\t\tOperation: task.CreateCommandOperation,\n102\t\t\t\t\t\t\tInitiator: \"test\",\n103\t\t\t\t\t\t\tData:      base.Event{\"taskIdentifier\": make(chan int)},\n104\t\t\t\t\t\t},\n105\t\t\t\t\t\tSchemaID: schemaID,\n106\t\t\t\t\t}\n107\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n108\t\t\t\t\tExpect(err).To(HaveOccurred())\n109\t\t\t\t\tExpect(errors.Is(err, cdb.ErrCommandObjectSkipped)).To(BeTrue())\n110\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n111\t\t\t\t})\n112\t\t\t})\n113\t\n114\t\t\tContext(\"empty TaskIdentifier\", func() {\n115\t\t\t\tIt(\"returns a validation error without writing\", func() {\n116\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n117\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"\"),\n118\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n119\t\t\t\t\t\t\t\"assignee\": \"claude\",\n120\t\t\t\t\t\t\t\"status\":   \"next\",\n121\t\t\t\t\t\t},\n122\t\t\t\t\t})\n123\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n124\t\t\t\t\tExpect(err).To(HaveOccurred())\n125\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n126\t\t\t\t})\n127\t\t\t})\n128\t\n129\t\t\tContext(\"empty assignee in frontmatter (task born parked)\", func() {\n130\t\t\t\t// An empty assignee is the operator-inbox signal, not a defect:\n131\t\t\t\t// github-pr-watcher's untrusted-author path creates tasks with\n132\t\t\t\t// `assignee: \"\", phase: human_review` so a human picks them up.\n133\t\t\t\t// Requiring assignee here silently dropped every such task.\n134\t\t\t\tIt(\"creates the task without an assignee\", func() {\n135\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n136\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n137\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n138\t\t\t\t\t\t\t\"status\": \"todo\",\n139\t\t\t\t\t\t\t\"phase\":  \"human_review\",\n140\t\t\t\t\t\t},\n141\t\t\t\t\t})\n142\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n143\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n144\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n145\t\t\t\t})\n146\t\t\t})\n147\t\n148\t\t\tContext(\"missing status in frontmatter\", func() {\n149\t\t\t\tIt(\"returns a validation error without writing\", func() {\n150\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n151\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n152\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n153\t\t\t\t\t\t\t\"assignee\": \"claude\",\n154\t\t\t\t\t\t},\n155\t\t\t\t\t})\n156\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n157\t\t\t\t\tExpect(err).To(HaveOccurred())\n158\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"status\"))\n159\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n160\t\t\t\t})\n161\t\t\t})\n162\t\n163\t\t\tContext(\"title path already occupied (collision)\", func() {\n164\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC2)\", func() {\n165\t\t\t\t\t// Second ReadFile call returns existing content → collision on replay.\n166\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(0,\n167\t\t\t\t\t\tnil, errors.New(\"GET 24 Tasks/Replay Task.md returned 404: not found\"))\n168\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n169\t\t\t\t\t\t1,\n170\t\t\t\t\t\t[]byte(\n171\t\t\t\t\t\t\t\"---\\ntask_identifier: replay-task\\nassignee: claude\\nstatus: next\\n---\\n\",\n172\t\t\t\t\t\t),\n173\t\t\t\t\t\tnil,\n174\t\t\t\t\t)\n175\t\n176\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n177\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"replay-task\"),\n178\t\t\t\t\t\tTitle:          \"Replay Task\",\n179\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n180\t\t\t\t\t})\n181\t\n182\t\t\t\t\t// First create: file not found → writes.\n183\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n184\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n185\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n186\t\n187\t\t\t\t\t// Replay: file now exists → sentinel, no second write.\n188\t\t\t\t\t_, _, err = executor.HandleCommand(ctx, nil, cmdObj)\n189\t\t\t\t\tExpect(err).To(HaveOccurred())\n190\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n191\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1)) // still 1\n192\t\t\t\t})\n193\t\t\t})\n194\t\n195\t\t\tContext(\"new filename\", func() {\n196\t\t\t\tIt(\"writes exactly once and returns nil when ReadFile reports not-found (AC3)\", func() {\n197\t\t\t\t\tfakeGit.ReadFileReturns(\n198\t\t\t\t\t\tnil,\n199\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Brand New.md returned 404: not found\"),\n200\t\t\t\t\t)\n201\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n202\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"brand-new\"),\n203\t\t\t\t\t\tTitle:          \"Brand New\",\n204\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n205\t\t\t\t\t})\n206\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n207\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n208\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n209\t\t\t\t})\n210\t\t\t})\n211\t\n212\t\t\tContext(\"collision with a different task_identifier\", func() {\n213\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC4)\", func() {\n214\t\t\t\t\t// Existing file at the title path belongs to a DIFFERENT task — filename owns the\n215\t\t\t\t\t// slot; the executor must not consult frontmatter, must not write.\n216\t\t\t\t\tfakeGit.ReadFileReturns(\n217\t\t\t\t\t\t[]byte(\n218\t\t\t\t\t\t\t\"---\\ntask_identifier: someone-else\\nassignee: alice\\nstatus: todo\\n---\\n\",\n219\t\t\t\t\t\t),\n220\t\t\t\t\t\tnil,\n221\t\t\t\t\t)\n222\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n223\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"new-task-id\"),\n224\t\t\t\t\t\tTitle:          \"My Colliding Task\",\n225\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n226\t\t\t\t\t})\n227\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n228\t\t\t\t\tExpect(err).To(HaveOccurred())\n229\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n230\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n231\t\t\t\t})\n232\t\t\t})\n233\t\n234\t\t\tContext(\"transient git-rest read error\", func() {\n235\t\t\t\tIt(\"propagates the wrapped error and does not write (AC5)\", func() {\n236\t\t\t\t\tfakeGit.ReadFileReturns(\n237\t\t\t\t\t\tnil,\n238\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Flaky.md returned 503: service unavailable\"),\n239\t\t\t\t\t)\n240\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n241\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"flaky-task\"),\n242\t\t\t\t\t\tTitle:          \"Flaky\",\n243\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n244\t\t\t\t\t})\n245\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n246\t\t\t\t\tExpect(err).To(HaveOccurred())\n247\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeFalse())\n248\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"503\"))\n249\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n250\t\t\t\t})\n251\t\t\t})\n252\t\n253\t\t\tContext(\"success: new file created\", func() {\n254\t\t\t\tIt(\"calls AtomicWriteAndCommitPush with correct content and commit message\", func() {\n255\t\t\t\t\ttaskID := lib.TaskIdentifier(\"new-task-abc\")\n256\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n257\t\t\t\t\t\tTaskIdentifier: taskID,\n258\t\t\t\t\t\tTitle:          \"New Task ABC\",\n259\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n260\t\t\t\t\t\t\t\"assignee\": \"claude\",\n261\t\t\t\t\t\t\t\"status\":   \"next\",\n262\t\t\t\t\t\t},\n263\t\t\t\t\t\tBody: \"This is the task body.\\n\",\n264\t\t\t\t\t})\n265\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n266\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n267\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n268\t\n269\t\t\t\t\t_, absPath, content, message := fakeGit.AtomicWriteAndCommitPushArgsForCall(0)\n270\t\t\t\t\tExpect(absPath).To(HaveSuffix(\"New Task ABC.md\"))\n271\t\t\t\t\tExpect(message).To(ContainSubstring(string(taskID)))\n272\t\n273\t\t\t\t\tcontentStr := string(content)\n274\t\t\t\t\tExpect(contentStr).To(HavePrefix(\"---\\n\"))\n275\t\t\t\t\tExpect(strings.Count(contentStr, \"---\")).To(BeNumerically(\">=\", 2))\n276\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"task_identifier:\"))\n277\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"assignee:\"))\n278\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"status:\"))\n279\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"target_vault: openclaw\"))\n280\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"This is the task body.\"))\n281\t\t\t\t})\n282\t\t\t})\n283\t\n284\t\t\tContext(\"git write error\", func() {\n285\t\t\t\tIt(\"returns a wrapped error when AtomicWriteAndCommitPush fails\", func() {\n286\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushStub = nil\n287\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushReturns(errors.New(\"git push failed\"))\n288\t\n289\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n290\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"error-task\"),\n291\t\t\t\t\t\tTitle:          \"Error Task\",\n292\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n293\t\t\t\t\t\t\t\"assignee\": \"claude\",\n294\t\t\t\t\t\t\t\"status\":   \"next\",\n295\t\t\t\t\t\t},\n296\t\t\t\t\t})\n297\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n298\t\t\t\t\tExpect(err).To(HaveOccurred())\n299\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"git push failed\"))\n300\t\t\t\t})\n301\t\t\t})\n302\t\n303\t\t\tContext(\"valid title\", func() {\n304\t\t\t\tIt(\"writes the task file at tasks/{title}.md\", func() {\n305\t\t\t\t\ttaskID := lib.TaskIdentifier(\"uuid-1234\")\n306\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n307\t\t\t\t\t\tTaskIdentifier: taskID,\n308\t\t\t\t\t\tTitle:          \"My Feature Task\",\n309\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n310\t\t\t\t\t\t\t\"assignee\": \"claude\",\n311\t\t\t\t\t\t\t\"status\":   \"next\",\n312\t\t\t\t\t\t},\n313\t