{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-af39a53f94538884","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"maps\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\tlib \"github.com/bborbe/agent\"\n15\t\ttask \"github.com/bborbe/agent/command/task\"\n16\t\t\"github.com/bborbe/cqrs/base\"\n17\t\t\"github.com/bborbe/cqrs/cdb\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibkv \"github.com/bborbe/kv\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/validation\"\n22\t\t\"github.com/golang/glog\"\n23\t\n24\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n25\t\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n27\t)\n28\t\n29\t// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n30\t// a new vault task file for the given task_identifier. If cmd.Title passes validation\n31\t// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n32\t// If a file already exists at the resolved path the command returns ErrTaskAlreadyExists\n33\t// (a benign Failure on the result topic — no overwrite, no git write).\n34\t// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n35\t// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n36\t// match vaultName are skipped without side effects (no git write, no error, no result event).\n37\tfunc NewCreateTaskExecutor(\n38\t\tgitClient gitclient.GitClient,\n39\t\ttaskDir string,\n40\t\tvaultName string,\n41\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n42\t\tk int,\n43\t) cdb.CommandObjectExecutorTx {\n44\t\treturn cdb.CommandObjectExecutorTxFunc(\n45\t\t\ttask.CreateCommandOperation,\n46\t\t\ttrue,\n47\t\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n48\t\t\t\tvar cmd task.CreateCommand\n49\t\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n50\t\t\t\t\treturn nil, nil, errors.Wrapf(\n51\t\t\t\t\t\tctx,\n52\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n53\t\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n54\t\t\t\t\t\terr,\n55\t\t\t\t\t)\n56\t\t\t\t}\n57\t\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n58\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n59\t\t\t\t}\n60\t\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n61\t\t\t\t\teffective := cmd.TargetVault\n62\t\t\t\t\tif effective == \"\" {\n63\t\t\t\t\t\teffective = routing.LegacyDefaultVault\n64\t\t\t\t\t}\n65\t\t\t\t\tglog.V(2).Infof(\n66\t\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n67\t\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n68\t\t\t\t\t)\n69\t\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n70\t\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n71\t\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n72\t\t\t\t\treturn nil, nil, errors.Wrapf(\n73\t\t\t\t\t\tctx,\n74\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n75\t\t\t\t\t\t\"cross-vault create for task %s\",\n76\t\t\t\t\t\tcmd.TaskIdentifier,\n77\t\t\t\t\t)\n78\t\t\t\t}\n79\t\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n80\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n81\t\t\t\t}\n82\t\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n83\t\t\t\tif err := checkTitlePathFree(ctx, gitClient, relPath, cmd.TaskIdentifier); err != nil {\n84\t\t\t\t\treturn nil, nil, err\n85\t\t\t\t}\n86\t\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName); err != nil {\n87\t\t\t\t\treturn nil, nil, err\n88\t\t\t\t}\n89\t\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n90\t\t\t\treturn nil, nil, nil\n91\t\t\t},\n92\t\t)\n93\t}\n94\t\n95\t// checkTitlePathFree returns ErrTaskAlreadyExists when the title path is\n96\t// already occupied (benign Failure on the result topic — no overwrite, no\n97\t// git write). A transient git-rest read error is propagated. A \"not found\"\n98\t// read error is swallowed (title path is free).\n99\tfunc checkTitlePathFree(\n100\t\tctx context.Context,\n101\t\tgitClient gitclient.GitClient,\n102\t\trelPath string,\n103\t\ttaskIdentifier lib.TaskIdentifier,\n104\t) error {\n105\t\texisting, err := gitClient.ReadFile(ctx, relPath)\n106\t\tif err == nil {\n107\t\t\tglog.V(2).Infof(\n108\t\t\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n109\t\t\t\trelPath,\n110\t\t\t\tlen(existing),\n111\t\t\t\ttaskIdentifier,\n112\t\t\t)\n113\t\t\treturn errors.Wrapf(\n114\t\t\t\tctx, task.ErrTaskAlreadyExists, \"title path %s occupied\", relPath,\n115\t\t\t)\n116\t\t}\n117\t\tif !isNotFoundReadError(err) {\n118\t\t\treturn errors.Wrapf(\n119\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n120\t\t\t)\n121\t\t}\n122\t\treturn nil\n123\t}\n124\t\n125\t// writeTaskFile builds the task content and writes it atomically to the vault\n126\t// via git-rest, then logs the creation. vaultName is stamped as target_vault so\n127\t// the created task is self-describing for the result-path routing guard.\n128\tfunc writeTaskFile(\n129\t\tctx context.Context,\n130\t\tgitClient gitclient.GitClient,\n131\t\trelPath string,\n132\t\tcmd task.CreateCommand,\n133\t\tvaultName string,\n134\t) error {\n135\t\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n136\t\tif err != nil {\n137\t\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n138\t\t}\n139\t\tabsPath := filepath.Join(gitClient.Path(), relPath)\n140\t\tif err := gitClient.AtomicWriteAndCommitPush(\n141\t\t\tctx,\n142\t\t\tabsPath,\n143\t\t\tcontent,\n144\t\t\t\"[agent-task-controller] create task \"+string(cmd.TaskIdentifier),\n145\t\t); err != nil {\n146\t\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n147\t\t}\n148\t\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n149\t\treturn nil\n150\t}\n151\t\n152\t// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n153\t// file should be written. If cmd.Title passes validation and contains no path\n154\t// separators, the title-derived path is returned; otherwise a WARN is logged and\n155\t// the UUID-derived path is returned as fallback so the task is always materialized.\n156\t// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n157\t// function no longer reads the vault or compares task_identifier.\n158\tfunc resolveCreateTaskRelPath(\n159\t\tctx context.Context,\n160\t\ttaskDir string,\n161\t\tcmd task.CreateCommand,\n162\t) string {\n163\t\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n164\t\n165\t\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n166\t\tif err := cmd.Validate(ctx); err != nil {\n167\t\t\tglog.Warningf(\n168\t\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n169\t\t\t\tcmd.TaskIdentifier, err,\n170\t\t\t)\n171\t\t\treturn uuidRelPath\n172\t\t}\n173\t\n174\t\t// Reject titles containing path separators to prevent path traversal.\n175\t\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n176\t\t\tglog.Warningf(\n177\t\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n178\t\t\t\tcmd.Title,\n179\t\t\t)\n180\t\t\treturn uuidRelPath\n181\t\t}\n182\t\n183\t\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n184\t}\n185\t\n186\t// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n187\t// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n188\t// typed not-found sentinel, so this matches the \"404\" status embedded in the\n189\t// wrapped error message produced by gitRestClient.Get\n190\t// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n191\t// be handled by the caller before calling this helper.\n192\tfunc isNotFoundReadError(err error) bool {\n193\t\tif err == nil {\n194\t\t\treturn false\n195\t\t}\n196\t\treturn strings.Contains(err.Error(), \"returned 404\")\n197\t}\n198\t\n199\t// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n200\t// unusable downstream.\n201\t//\n202\t// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n203\t// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n204\t// doctrine): escalation clears the assignee so no agent claims the task and a\n205\t// human picks it up. Requiring it here made a task that is *born* parked\n206\t// unrepresentable — github-pr-watcher's untrusted-author path stamps\n207\t// `assignee: \"\", phase: human_review` and every such command was rejected, so\n208\t// the PR silently never reached the operator queue (bborbe/git-sync#5,\n209\t// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n210\t// so accepting it at create matches how update and dispatch already behave.\n211\tfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n212\t\tif s, _ := fm.String(\"status\"); s == \"\" {\n213\t\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n214\t\t}\n215\t\treturn nil\n216\t}\n217\t\n218\tfunc buildCreateTaskContent(\n219\t\tctx context.Context,\n220\t\tcmd task.CreateCommand,\n221\t\tvaultName string,\n222\t) ([]byte, error) {\n223\t\tfm := make(lib.TaskFrontmatter)\n224\t\tmaps.Copy(fm, cmd.Frontmatter)\n225\t\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n226\t\tfm[\"target_vault\"] = vaultName\n227\t\treturn marshalFileContent(ctx, fm, cmd.Body)\n228\t}\n229\t\n230\t// supersedePriorRecurringTask collapses a recurring schedule to a single open\n231\t// instance: after a new instance is materialized it lists same-slug candidates,\n232\t// excludes the new instance, ranks them most-recent-first, and transitions every\n233\t// still-in_progress candidate whose period-token is strictly older than the new\n234\t// instance's token to aborted — capped at the k most-recent such candidates.\n235\t// Best-effort: list/read/parse/write errors on any single file are logged and\n236\t// swallowed; the already-written new instance is never rolled back. newRelPath is\n237\t// the repo-root-relative path of the new instance (the superseded_by back-pointer).\n238\tfunc supersedePriorRecurringTask(\n239\t\tctx context.Context,\n240\t\tgitClient gitclient.GitClient,\n241\t\ttaskDir string,\n242\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n243\t\tk int,\n244\t\tcmd task.CreateCommand,\n245\t\tnewRelPath string,\n246\t) {\n247\t\tif !isEligibleForSupersede(cmd) {\n248\t\t\treturn\n249\t\t}\n250\t\tslug, newToken, ok := splitTitleToken(cmd.Title)\n251\t\tif !ok {\n252\t\t\tglog.V(3).Infof(\n253\t\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n254\t\t\t\tcmd.Title, cmd.TaskIdentifier,\n255\t\t\t)\n256\t\t\treturn\n257\t\t}\n258\t\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n259\t\tif err != nil {\n260\t\t\tglog.Warningf(\n261\t\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n262\t\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n263\t\t\t)\n264\t\t\treturn\n265\t\t}\n266\t\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n267\t\tif err != nil {\n268\t\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n269\t\t\treturn\n270\t\t}\n271\t\t// Exclude the new instance and rank.\n272\t\tvar kept []string\n273\t\tfor _, t := range titles {\n274\t\t\tif err := ctx.Err(); err != nil {\n275\t\t\t\treturn\n276\t\t\t}\n277\t\t\tif t == cmd.Title {\n278\t\t\t\tcontinue\n279\t\t\t}\n280\t\t\tkept = append(kept, t)\n281\t\t}\n282\t\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n283\t\tcollapseCandidates(\n284\t\t\tctx,\n285\t\t\tgitClient,\n286\t\t\ttaskDir,\n287\t\t\tcurrentDateTime,\n288\t\t\tk,\n289\t\t\tranked,\n290\t\t\tnewOrdinal,\n291\t\t\tnewRelPath,\n292\t\t\tcmd,\n293\t\t)\n294\t}\n295\t\n296\t// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n297\t// returns their TITLES (basename without \".md\"), filtered to those whose title\n298\t// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n299\t// glob metacharacters; otherwise it lists all task files and filters in memory\n300\t// (glob-injection defense). List errors are returned; the caller logs them once.\n301\tfunc listSameSlugCandidateTitles(\n302\t\tctx context.Context,\n303\t\tgitClient gitclient.GitClient,\n304\t\ttaskDir string,\n305\t\tslug string,\n306\t) ([]string, error) {\n307\t\tprefix := slug + \" - \"\n308\t\tvar glob string\n309\t\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n310\t\t\tglob = filepath.Join(taskDir, \"*.md\")\n311\t\t\tglog.V(2).Infof(\n312\t\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n313\t\t\t\tslug,\n314\t\t\t)\n315\t\t} else {\n316\t\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n317\t\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n318\t\t}\n319\t\trelPaths, err := gitClient.ListFiles(ctx, glob)\n320\t\tif err != nil {\n321\t\t\treturn nil, err\n322\t\t}\n323\t\tvar titles []string\n324\t\tfor _, relPath := range relPaths {\n325\t\t\tif err := ctx.Err(); err != nil {\n326\t\t\t\treturn nil, err\n327\t\t\t}\n328\t\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n329\t\t\tif strings.HasPrefix(title, prefix) {\n330\t\t\t\ttitles = append(titles, title)\n331\t\t\t}\n332\t\t}\n333\t\treturn titles, nil\n334\t}\n335\t\n336\t// collapseCandidates iterates ranked candidates most-recent-first, transitions\n337\t// each still-in_progress candidate older than newOrdinal to aborted, and stops\n338\t// after k candidates have been inspected (read attempted). Best-effort per file.\n339\tfunc collapseCandidates(\n340\t\tctx context.Context,\n341\t\tgitClient gitclient.GitClient,\n342\t\ttaskDir string,\n343\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n344\t\tk int,\n345\t\tranked []rankedCandidate,\n346\t\tnewOrdinal int64,\n347\t\tnewRelPath string,\n348\t\tcmd task.CreateCommand,\n349\t) {\n350\t\tinspected := 0\n351\t\tfor _, rc := range ranked {\n352\t\t\tif err := ctx.Err(); err != nil {\n353\t\t\t\treturn\n354\t\t\t}\n355\t\t\tif inspected >= k {\n356\t\t\t\tbreak\n357\t\t\t}\n358\t\t\tif rc.Ordinal > newOrdinal {\n359\t\t\t\tcontinue\n360\t\t\t}\n361\t\t\tinspected++\n362\t\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n363\t\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n364\t\t\t\tglog.Warningf(\n365\t\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n366\t\t\t\t\trc.Title, cmd.TaskIdentifier,\n367\t\t\t\t)\n368\t\t\t\tcontinue\n369\t\t\t}\n370\t\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n371\t\t\tif err != nil || content == nil {\n372\t\t\t\tcontinue\n373\t\t\t}\n374\t\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n375\t\t\t\tcontinue\n376\t\t\t}\n377\t\t\ttransitionPrior(\n378\t\t\t\tctx,\n379\t\t\t\tgitClient,\n380\t\t\t\tcurrentDateTime,\n381\t\t\t\tcandidateRelPath,\n382\t\t\t\trc.Title,\n383\t\t\t\tnewRelPath,\n384\t\t\t\tcmd.TaskIdentifier,\n385\t\t\t)\n386\t\t}\n387\t}\n388\t\n389\t// isEligibleForSupersede reports whether cmd is a recurring-task instance\n390\t// that should auto-supersede its prior. Returns true only when created_by is\n391\t// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n392\t// Returns false (no supersede) when auto_abort_prior is absent or false — the\n393\t// safe default that prevents accidental supersede of audit-style tasks.\n394\tfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n395\t\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n396\t\tif createdBy != \"recurring-task-creator\" {\n397\t\t\tglog.V(3).\n398\t\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n399\t\t\treturn false\n400\t\t}\n401\t\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n402\t\t\treturn true\n403\t\t}\n404\t\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n405\t\t\treturn true\n406\t\t}\n407\t\tglog.V(3).\n408\t\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n409\t\treturn false\n410\t}\n411\t\n412\t// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n413\t// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n414\t// transient git-rest error (logged by caller).\n415\tfunc readPriorForSupersede(\n416\t\tctx context.Context,\n417\t\tgitClient gitclient.GitClient,\n418\t\tpriorRelPath string,\n419\t\ttaskIdentifier lib.TaskIdentifier,\n420\t) ([]byte, error) {\n421\t\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n422\t\tif err == nil {\n423\t\t\treturn content, nil\n424\t\t}\n425\t\tif isNotFoundReadError(err) {\n426\t\t\tglog.V(3).\n427\t\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n428\t\t\treturn nil, nil\n429\t\t}\n430\t\tglog.Warningf(\n431\t\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n432\t\t\tpriorRelPath,\n433\t\t\ttaskIdentifier,\n434\t\t\terr,\n435\t\t)\n436\t\treturn nil, err\n437\t}\n438\t\n439\t// priorIsInProgress parses the prior file's frontmatter and reports whether\n440\t// its status is in_progress. Returns false (no-op) on parse error or any\n441\t// non-in_progress status.\n442\tfunc priorIsInProgress(\n443\t\tctx context.Context,\n444\t\tcontent []byte,\n445\t\tpriorRelPath string,\n446\t\ttaskIdentifier lib.TaskIdentifier,\n447\t) bool {\n448\t\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n449\t\tif err != nil {\n450\t\t\tglog.Warningf(\n451\t\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n452\t\t\t\tpriorRelPath,\n453\t\t\t\ttaskIdentifier,\n454\t\t\t\terr,\n455\t\t\t)\n456\t\t\treturn false\n457\t\t}\n458\t\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n459\t\tif err != nil {\n460\t\t\tglog.Warningf(\n461\t\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n462\t\t\t\tpriorRelPath,\n463\t\t\t\ttaskIdentifier,\n464\t\t\t\terr,\n465\t\t\t)\n466\t\t\treturn false\n467\t\t}\n468\t\tstatus, _ := priorFm.String(\"status\")\n469\t\tif status != \"in_progress\" {\n470\t\t\tglog.V(3).\n471\t\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n472\t\t\treturn false\n473\t\t}\n474\t\treturn true\n475\t}\n476\t\n477\t// transitionPrior performs the read-modify-write that transitions the prior\n478\t// file to aborted. Best-effort: write errors are logged and swallowed.\n479\tfunc transitionPrior(\n480\t\tctx context.Context,\n481\t\tgitClient gitclient.GitClient,\n482\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n483\t\tpriorRelPath string,\n484\t\tpriorTitle string,\n485\t\tnewRelPath string,\n486\t\ttaskIdentifier lib.TaskIdentifier,\n487\t) {\n488\t\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n489\t\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n490\t\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n491\t\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n492\t\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n493\t\t\tglog.Warningf(\n494\t\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n495\t\t\t\tpriorRelPath,\n496\t\t\t\ttaskIdentifier,\n497\t\t\t\terr,\n498\t\t\t)\n499\t\t\treturn\n500\t\t}\n501\t\tglog.V(2).Infof(\n502\t\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n503\t\t\tpriorRelPath,\n504\t\t\tnewRelPath,\n505\t\t)\n506\t}\n507\t\n508\t// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n509\t// that transitions a prior-period recurring-task instance to aborted.\n510\tfunc buildSupersedeModifyFn(\n511\t\tctx context.Context,\n512\t\tnewRelPath string,\n513\t\tts string,\n514\t) func([]byte) ([]byte, error) {\n515\t\treturn func(current []byte) ([]byte, error) {\n516\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n517\t\t\tif err != nil {\n518\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n519\t\t\t}\n520\t\t\tbody, err := result.ExtractBody(ctx, current)\n521\t\t\tif err != nil {\n522\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n523\t\t\t}\n524\t\t\tfm, err := parseTaskFrontmatter(fmStr)\n525\t\t\tif err != nil {\n526\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n527\t\t\t}\n528\t\t\tfm[\"status\"] = \"aborted\"\n529\t\t\tfm[\"phase\"] = \"done\"\n530\t\t\tfm[\"completed_date\"] = ts\n531\t\t\tfm[\"superseded_by\"] = newRelPath\n532\t\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n533\t\t\treturn marshalFileContent(ctx, fm, body)\n534\t\t}\n535\t}\n536\t"}]},"parent_tool_use_id":"chatcmpl-tool-bbe611f52983ba48","session_id":"c245cf91-e27d-42c2-b8e2-b86a59610663","uuid":"740f0df1-52d6-4ab9-b716