nd{\n401\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"task-1\"),\n402\t\t\t\t\t\t\tTitle:          \"Openclaw Task\",\n403\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n404\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n405\t\t\t\t\t\t\t\t\"status\":   \"next\",\n406\t\t\t\t\t\t\t},\n407\t\t\t\t\t\t\tTargetVault: \"openclaw\",\n408\t\t\t\t\t\t})\n409\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n410\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n411\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n412\t\t\t\t\t},\n413\t\t\t\t)\n414\t\n415\t\t\t\tIt(\n416\t\t\t\t\t\"processes a command with empty TargetVault when vaultName=openclaw (legacy fallback)\",\n417\t\t\t\t\tfunc() {\n418\t\t\t\t\t\texecutor := command.NewCreateTaskExecutor(\n419\t\t\t\t\t\t\tfakeGit,\n420\t\t\t\t\t\t\ttaskDir,\n421\t\t\t\t\t\t\t\"openclaw\",\n422\t\t\t\t\t\t\tclock,\n423\t\t\t\t\t\t\ttestK,\n424\t\t\t\t\t\t)\n425\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n426\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"task-1\"),\n427\t\t\t\t\t\t\tTitle:          \"Legacy Task\",\n428\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n429\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n430\t\t\t\t\t\t\t\t\"status\":   \"next\",\n431\t\t\t\t\t\t\t},\n432\t\t\t\t\t\t\t// TargetVault deliberately empty — legacy producer.\n433\t\t\t\t\t\t})\n434\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n435\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n436\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n437\t\t\t\t\t},\n438\t\t\t\t)\n439\t\n440\t\t\t\tIt(\n441\t\t\t\t\t\"skips a command with empty TargetVault when vaultName=personal (legacy fallback is openclaw, not personal)\",\n442\t\t\t\t\tfunc() {\n443\t\t\t\t\t\texecutor := command.NewCreateTaskExecutor(\n444\t\t\t\t\t\t\tfakeGit,\n445\t\t\t\t\t\t\ttaskDir,\n446\t\t\t\t\t\t\t\"personal\",\n447\t\t\t\t\t\t\tclock,\n448\t\t\t\t\t\t\ttestK,\n449\t\t\t\t\t\t)\n450\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n451\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"task-1\"),\n452\t\t\t\t\t\t\tTitle:          \"Legacy Task\",\n453\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n454\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n455\t\t\t\t\t\t\t\t\"status\":   \"next\",\n456\t\t\t\t\t\t\t},\n457\t\t\t\t\t\t\t// TargetVault deliberately empty.\n458\t\t\t\t\t\t})\n459\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n460\t\t\t\t\t\tExpect(errors.Is(err, cdb.ErrCommandObjectSkipped)).To(BeTrue())\n461\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n462\t\t\t\t\t},\n463\t\t\t\t)\n464\t\t\t})\n465\t\n466\t\t\tContext(\"scan-and-collapse supersede\", func() {\n467\t\t\t\tinProgress := func(id string) []byte {\n468\t\t\t\t\treturn []byte(\n469\t\t\t\t\t\t\"---\\ntask_identifier: \" + id + \"\\nassignee: claude\\nstatus: in_progress\\n---\\nbody\\n\",\n470\t\t\t\t\t)\n471\t\t\t\t}\n472\t\n473\t\t\t\t// AC: N-collapse — missed-day gap (Mon+Tue open, Wed fires → both close, Wed stays open)\n474\t\t\t\tIt(\n475\t\t\t\t\t\"closes multiple older in_progress priors when new instance fires (missed-day gap)\",\n476\t\t\t\t\tfunc() {\n477\t\t\t\t\t\tnewTitle := \"IBKR Swing Trading - 2026W28-wed\"\n478\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n479\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"ibkr-w28wed\"),\n480\t\t\t\t\t\t\tTitle:          newTitle,\n481\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n482\t\t\t\t\t\t\t\t\"assignee\":         \"claude\",\n483\t\t\t\t\t\t\t\t\"status\":           \"next\",\n484\t\t\t\t\t\t\t\t\"created_by\":       \"recurring-task-creator\",\n485\t\t\t\t\t\t\t\t\"auto_abort_prior\": true,\n486\t\t\t\t\t\t\t},\n487\t\t\t\t\t\t})\n488\t\n489\t\t\t\t\t\tcandidatePaths := []string{\n490\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-mon.md\",\n491\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-tue.md\",\n492\t\t\t\t\t\t}\n493\t\t\t\t\t\tfakeGit.ListFilesReturns(candidatePaths, nil)\n494\t\t\t\t\t\tmonContent := inProgress(\"ibkr-w28mon\")\n495\t\t\t\t\t\ttueContent := inProgress(\"ibkr-w28tue\")\n496\t\t\t\t\t\tfileContents := map[string][]byte{\n497\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-mon.md\": monContent,\n498\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-tue.md\": tueContent,\n499\t\t\t\t\t\t}\n500\t\t\t\t\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n501\t\t\t\t\t\t\tif content, ok := fileContents[relPath]; ok {\n502\t\t\t\t\t\t\t\treturn content, nil\n503\t\t\t\t\t\t\t}\n504\t\t\t\t\t\t\treturn nil, errors.New(\"GET \" + relPath + \" returned 404: not found\")\n505\t\t\t\t\t\t}\n506\t\n507\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n508\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n509\t\t\t\t\t\tExpect(\n510\t\t\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushCallCount(),\n511\t\t\t\t\t\t).To(Equal(1))\n512\t\t\t\t\t\t// new instance only\n513\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(2))\n514\t\n515\t\t\t\t\t\t// Ranking sorts by ordinal desc; equal ordinals sort by Title desc.\n516\t\t\t\t\t\t// \"2026W28-tue\" > \"2026W28-mon\" alphabetically, so tue is first.\n517\t\t\t\t\t\tpriorContents := [][]byte{tueContent, monContent}\n518\t\t\t\t\t\tpriorSuffixes := []string{\"tue\", \"mon\"}\n519\t\t\t\t\t\tfor i := 0; i < 2; i++ {\n520\t\t\t\t\t\t\t_, absPath, modify, msg := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(\n521\t\t\t\t\t\t\t\ti,\n522\t\t\t\t\t\t\t)\n523\t\t\t\t\t\t\tExpect(msg).To(ContainSubstring(\"auto-supersede prior recurring task\"))\n524\t\t\t\t\t\t\tresultContent, parseErr := modify(priorContents[i])\n525\t\t\t\t\t\t\tExpect(parseErr).NotTo(HaveOccurred())\n526\t\t\t\t\t\t\tresultStr := string(resultContent)\n527\t\t\t\t\t\t\tExpect(resultStr).To(ContainSubstring(\"status: aborted\"))\n528\t\t\t\t\t\t\tExpect(resultStr).To(ContainSubstring(\"phase: done\"))\n529\t\t\t\t\t