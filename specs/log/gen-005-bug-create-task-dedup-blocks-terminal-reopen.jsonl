{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b4e59dac75bba889","type":"tool_result","content":"355\tfunc mergeFrontmatter(existing, incoming lib.TaskFrontmatter) lib.TaskFrontmatter {\n356\t\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n357\t\tfor k, v := range existing {\n358\t\t\tmerged[k] = v\n359\t\t}\n360\t\tfor k, v := range incoming {\n361\t\t\tmerged[k] = v\n362\t\t}\n363\t\treturn merged\n364\t}\n365\t\n366\t// ExtractFrontmatter returns the YAML frontmatter string between the opening and\n367\t// closing \"---\" delimiters. Returns an error if delimiters are missing.\n368\tfunc ExtractFrontmatter(ctx context.Context, content []byte) (string, error) {\n369\t\ts := string(content)\n370\t\tconst delim = \"---\"\n371\t\tif !strings.HasPrefix(s, delim) {\n372\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n373\t\t}\n374\t\trest := strings.TrimPrefix(s, delim)\n375\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n376\t\t\trest = rest[2:]\n377\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n378\t\t\trest = rest[1:]\n379\t\t}\n380\t\tbefore, _, found := strings.Cut(rest, \"\\n---\")\n381\t\tif !found {\n382\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n383\t\t}\n384\t\treturn before, nil\n385\t}\n386\t\n387\t// ExtractBody returns the file body — the bytes after the closing \"---\\n\" delimiter.\n388\t// Returns an empty string if the body is empty; error if delimiters are missing.\n389\tfunc ExtractBody(ctx context.Context, content []byte) (string, error) {\n390\t\ts := string(content)\n391\t\tconst delim = \"---\"\n392\t\tif !strings.HasPrefix(s, delim) {\n393\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n394\t\t}\n395\t\trest := strings.TrimPrefix(s, delim)\n396\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n397\t\t\trest = rest[2:]\n398\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n399\t\t\trest = rest[1:]\n400\t\t}\n401\t\t_, after, found := strings.Cut(rest, \"\\n---\\n\")\n402\t\tif !found {\n403\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n404\t\t}\n405\t\treturn after, nil"}]},"parent_tool_use_id":"chatcmpl-tool-bbe611f52983ba48","session_id":"c245cf91-e27d-42c2-b8e2-b86a59610663","uuid":"1b9f6d6e-1d94-4dea-9f75-88817979f9af","timestamp":"2026-08-27T18:34:41.374Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 spec-005"}
