{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-94c9e034a8403ae9","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"time\"\n9\t\n10\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n11\t)\n12\t\n13\t// TaskFrontmatter is a generic map of frontmatter key-value pairs.\n14\t// Serializable as JSON (Kafka) and YAML (vault file).\n15\t// Typed accessors provide type-safe access to well-known fields.\n16\ttype TaskFrontmatter map[string]interface{}\n17\t\n18\tfunc (f TaskFrontmatter) Status() domain.TaskStatus {\n19\t\tv, _ := f[\"status\"].(string)\n20\t\tif canonical, ok := domain.NormalizeTaskStatus(v); ok {\n21\t\t\treturn canonical\n22\t\t}\n23\t\treturn domain.TaskStatus(v)\n24\t}\n25\t\n26\tfunc (f TaskFrontmatter) Phase() *domain.TaskPhase {\n27\t\tv, ok := f[\"phase\"].(string)\n28\t\tif !ok || v == \"\" {\n29\t\t\treturn nil\n30\t\t}\n31\t\tif canonical, ok := domain.NormalizeTaskPhase(v); ok {\n32\t\t\treturn &canonical\n33\t\t}\n34\t\tp := domain.TaskPhase(v)\n35\t\treturn &p\n36\t}\n37\t\n38\tfunc (f TaskFrontmatter) Assignee() TaskAssignee {\n39\t\tv, _ := f[\"assignee\"].(string)\n40\t\treturn TaskAssignee(v)\n41\t}\n42\t\n43\t// TaskType returns the task_type frontmatter field as a typed TaskType.\n44\t// Returns TaskType(\"\") when the field is absent or holds a non-string value.\n45\tfunc (f TaskFrontmatter) TaskType() TaskType {\n46\t\tv, _ := f[\"task_type\"].(string)\n47\t\treturn TaskType(v)\n48\t}\n49\t\n50\t// Stage returns the execution stage from the \"stage\" key.\n51\t// Returns \"prod\" if the key is absent or empty.\n52\tfunc (f TaskFrontmatter) Stage() string {\n53\t\tv, _ := f[\"stage\"].(string)\n54\t\tif v == \"\" {\n55\t\t\treturn \"prod\"\n56\t\t}\n57\t\treturn v\n58\t}\n59\t\n60\t// RetryCount returns the number of failed attempts recorded in frontmatter."}]},"parent_tool_use_id":"chatcmpl-tool-9412ecfd5e7d447b","session_id":"c245cf91-e27d-42c2-b8e2-b86a59610663","uuid":"50ca76aa-2b3b-44a0-b4c5-5fa971d7c76d","timestamp":"2026-08-27T18:29:46.194Z","subagent_type":"dark-factory:prompt-creator","task_description":"Create prompts from spec 005"}
