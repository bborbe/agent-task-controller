{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-96ac3635d784eb51","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage metrics\n6\t\n7\timport (\n8\t\t\"github.com/prometheus/client_golang/prometheus\"\n9\t\t\"github.com/prometheus/client_golang/prometheus/promauto\"\n10\t)\n11\t\n12\t//go:generate go run github.com/maxbrunsfeld/counterfeiter/v6@v6.12.2 -generate\n13\t\n14\t// Metrics defines the interface for accessing Prometheus metrics.\n15\t// Use this interface in business logic packages to enable mock injection in tests.\n16\t//\n17\t//counterfeiter:generate -o ../../mocks/metrics.go --fake-name Metrics . Metrics\n18\ttype Metrics interface {\n19\t\tScanCyclesTotal(outcome string) prometheus.Counter\n20\t\tTasksPublishedTotal(outcome string) prometheus.Counter\n21\t\tPlanningRetryTotal(result string) prometheus.Counter\n22\t\tResultsWrittenTotal(outcome string) prometheus.Counter\n23\t\tGitPushTotal(outcome string) prometheus.Counter\n24\t\tConflictResolutionsTotal() prometheus.Counter\n25\t\tFrontmatterCommandsTotal(operation, outcome string) prometheus.Counter\n26\t\tGitRestCallsTotal(operation, status string) prometheus.Counter\n27\t\tKafkaConsumePausedTotal() prometheus.Counter\n28\t\tSkippedFilesTotal(reason SkipReason) prometheus.Counter\n29\t}\n30\t\n31\t// defaultMetrics implements Metrics using promauto-registered counters.\n32\ttype defaultMetrics struct{}\n33\t\n34\tvar _ Metrics = &defaultMetrics{}\n35\t\n36\t// New returns a new default Metrics implementation.\n37\tfunc New() Metrics {\n38\t\treturn &defaultMetrics{}\n39\t}\n40\t\n41\tfunc (m *defaultMetrics) ScanCyclesTotal(outcome string) prometheus.Counter {\n42\t\treturn ScanCyclesTotal.WithLabelValues(outcome)\n43\t}\n44\t\n45\tfunc (m *defaultMetrics) TasksPublishedTotal(outcome string) prometheus.Counter {\n46\t\treturn TasksPublishedTotal.WithLabelValues(outcome)\n47\t}\n48\t\n49\tfunc (m *defaultMetrics) PlanningRetryTotal(result string) prometheus.Counter {\n50\t\treturn PlanningRetryTotal.WithLabelValues(result)\n51\t}\n52\t\n53\tfunc (m *defaultMetrics) ResultsWrittenTotal(outcome string) prometheus.Counter {\n54\t\treturn ResultsWrittenTotal.WithLabelValues(outcome)\n55\t}\n56\t\n57\tfunc (m *defaultMetrics) GitPushTotal(outcome string) prometheus.Counter {\n58\t\treturn GitPushTotal.WithLabelValues(outcome)\n59\t}\n60\t\n61\tfunc (m *defaultMetrics) ConflictResolutionsTotal() prometheus.Counter {\n62\t\treturn ConflictResolutionsTotal.WithLabelValues()\n63\t}\n64\t\n65\tfunc (m *defaultMetrics) FrontmatterCommandsTotal(operation, outcome string) prometheus.Counter {\n66\t\treturn FrontmatterCommandsTotal.WithLabelValues(operation, outcome)\n67\t}\n68\t\n69\tfunc (m *defaultMetrics) GitRestCallsTotal(operation, status string) prometheus.Counter {\n70\t\treturn GitRestCallsTotal.WithLabelValues(operation, status)\n71\t}\n72\t\n73\tfunc (m *defaultMetrics) KafkaConsumePausedTotal() prometheus.Counter {\n74\t\treturn KafkaConsumePausedTotal\n75\t}\n76\t\n77\tfunc (m *defaultMetrics) SkippedFilesTotal(reason SkipReason) prometheus.Counter {\n78\t\treturn SkippedFilesTotal.WithLabelValues(reason.String())\n79\t}\n80\t\n81\t// ScanCyclesTotal counts scan cycle completions by result.\n82\tvar ScanCyclesTotal = promauto.NewCounterVec(\n83\t\tprometheus.CounterOpts{\n84\t\t\tName: \"agent_controller_scan_cycles_total\",\n85\t\t\tHelp: \"Total number of scan cycles completed.\",\n86\t\t},\n87\t\t[]string{\"result\"},\n88\t)\n89\t\n90\t// TasksPublishedTotal counts task events published by type.\n91\tvar TasksPublishedTotal = promauto.NewCounterVec(\n92\t\tprometheus.CounterOpts{\n93\t\t\tName: \"agent_controller_tasks_published_total\",\n94\t\t\tHelp: \"Total number of task events published.\",\n95\t\t},\n96\t\t[]string{\"type\"},\n97\t)\n98\t\n99\t// PlanningRetryTotal counts controller-side pr-review planning-retry gate outcomes\n100\t// by result (\"retry\" | \"exhausted\"). \"passthrough\" is intentionally NOT a label —\n101\t// the metric fires only when the retry gate matches (spec DB 7).\n102\tvar PlanningRetryTotal = promauto.NewCounterVec(\n103\t\tprometheus.CounterOpts{\n104\t\t\tName: \"agent_controller_planning_retry_total\",\n105\t\t\tHelp: \"Total number of controller-side pr-review planning-retry gate outcomes, by result.\",\n106\t\t},\n107\t\t[]string{\"result\"},\n108\t)\n109\t\n110\t// ResultsWrittenTotal counts result write attempts by outcome.\n111\tvar ResultsWrittenTotal = promauto.NewCounterVec(\n112\t\tprometheus.CounterOpts{\n113\t\t\tName: \"agent_controller_results_written_total\",\n114\t\t\tHelp: \"Total number of task result write attempts.\",\n115\t\t},\n116\t\t[]string{\"result\"},\n117\t)\n118\t\n119\t// GitPushTotal counts git push attempts by outcome.\n120\tvar GitPushTotal = promauto.NewCounterVec(\n121\t\tprometheus.CounterOpts{\n122\t\t\tName: \"agent_controller_git_push_total\",\n123\t\t\tHelp: \"Total number of git push attempts.\",\n124\t\t},\n125\t\t[]string{\"result\"},\n126\t)\n127\t\n128\t// ConflictResolutionsTotal counts per-file conflict resolution attempts by outcome.\n129\tvar ConflictResolutionsTotal = promauto.NewCounterVec(\n130\t\tprometheus.CounterOpts{\n131\t\t\tName: \"agent_controller_conflict_resolutions_total\",\n132\t\t\tHelp: \"Total number of per-file conflict resolution attempts.\",\n133\t\t},\n134\t\t[]string{\"result\"},\n135\t)\n136\t\n137\t// FrontmatterCommandsTotal counts atomic frontmatter command executions\n138\t// by operation (\"increment-frontmatter\" | \"update-frontmatter\") and\n139\t// outcome (\"success\" | \"error\" | \"not_found\").\n140\tvar FrontmatterCommandsTotal = promauto.NewCounterVec(\n141\t\tprometheus.CounterOpts{\n142\t\t\tName: \"agent_controller_frontmatter_commands_total\",\n143\t\t\tHelp: \"Total number of atomic frontmatter commands processed, by operation and outcome.\",\n144\t\t},\n145\t\t[]string{\"operation\", \"outcome\"},\n146\t)\n147\t\n148\t// GitRestCallsTotal counts git-rest HTTP API calls by operation and outcome.\n149\tvar GitRestCallsTotal = promauto.NewCounterVec(\n150\t\tprometheus.CounterOpts{\n151\t\t\tName: \"agent_controller_git_rest_calls_total\",\n152\t\t\tHelp: \"Total number of git-rest HTTP API calls by operation and outcome.\",\n153\t\t},\n154\t\t[]string{\"op\", \"status\"},\n155\t)\n156\t\n157\t// KafkaConsumePausedTotal counts times a Kafka command executor blocked\n158\t// waiting for git-rest to become available (i.e. retry attempts after the first).\n159\tvar KafkaConsumePausedTotal = promauto.NewCounter(prometheus.CounterOpts{\n160\t\tName: \"controller_kafka_consume_paused_total\",\n161\t\tHelp: \"Total number of times Kafka consumption was paused waiting for git-rest.\",\n162\t})\n163\t\n164\t// SkipReason is the closed set of structured reasons the vault scanner skips a task file.\n165\ttype SkipReason string\n166\t\n167\t// String returns the Prometheus label value for the reason.\n168\tfunc (r SkipReason) String() string { return string(r) }\n169\t\n170\tconst (\n171\t\tReasonInvalidFrontmatter          SkipReason = \"invalid_frontmatter\"\n172\t\tReasonDuplicateFrontmatterInvalid SkipReason = \"duplicate_frontmatter_invalid\"\n173\t\tReasonEmptyStatus                 SkipReason = \"empty_status\"\n174\t\tReasonInjectTaskIdentifierFailed  SkipReason = \"inject_task_identifier_failed\"\n175\t\tReasonReadFailed                  SkipReason = \"read_failed\"\n176\t\tReasonAutoInjectDisabled          SkipReason = \"auto_inject_disabled\"\n177\t)\n178\t\n179\t// AvailableSkipReasons is the full closed set of skip reasons, used for counter\n180\t// pre-initialisation so every reason series exists at 0 before the first skip.\n181\tvar AvailableSkipReasons = []SkipReason{\n182\t\tReasonInvalidFrontmatter,\n183\t\tReasonDuplicateFrontmatterInvalid,\n184\t\tReasonEmptyStatus,\n185\t\tReasonInjectTaskIdentifierFailed,\n186\t\tReasonReadFailed,\n187\t\tReasonAutoInjectDisabled,\n188\t}\n189\t\n190\t// SkippedFilesTotal counts vault task files the scanner skipped during a scan cycle,\n191\t// labelled by the structured reason for the skip. A non-zero value on any label\n192\t// indicates operator-actionable vault health issues (broken frontmatter, empty status,\n193\t// unreadable files, injection failures); a stuck broken file will keep the relevant\n194\t// label rate-positive until repaired. The closed set of reason values is declared\n195\t// as constants above and pre-initialised in init().\n196\tvar SkippedFilesTotal = promauto.NewCounterVec(\n197\t\tprometheus.CounterOpts{\n198\t\t\tName: \"agent_controller_vault_scanner_skipped_files_total\",\n199\t\t\tHelp: \"Total number of vault task files the scanner skipped during a scan cycle, by reason. Increments exactly once per skipped file per cycle — re-scans of an unrepaired broken file keep the rate positive.\",\n200\t\t},\n201\t\t[]string{\"reason\"},\n202\t)\n203\t\n204\tfunc init() {\n205\t\tScanCyclesTotal.WithLabelValues(\"changes\").Add(0)\n206\t\tScanCyclesTotal.WithLabelValues(\"no_changes\").Add(0)\n207\t\tScanCyclesTotal.WithLabelValues(\"error\").Add(0)\n208\t\n209\t\tTasksPublishedTotal.WithLabelValues(\"changed\").Add(0)\n210\t\tTasksPublishedTotal.WithLabelValues(\"deleted\").Add(0)\n211\t\n212\t\tResultsWrittenTotal.WithLabelValues(\"success\").Add(0)\n213\t\tResultsWrittenTotal.WithLabelValues(\"not_found\").Add(0)\n214\t\tResultsWrittenTotal.WithLabelValues(\"error\").Add(0)\n215\t\n216\t\tPlanningRetryTotal.WithLabelValues(\"retry\").Add(0)\n217\t\tPlanningRetryTotal.WithLabelValues(\"exhausted\").Add(0)\n218\t\n219\t\tGitPushTotal.WithLabelValues(\"success\").Add(0)\n220\t\tGitPushTotal.WithLabelValues(\"retry_success\").Add(0)\n221\t\tGitPushTotal.WithLabelValues(\"conflict_resolved\").Add(0)\n222\t\tGitPushTotal.WithLabelValues(\"error\").Add(0)