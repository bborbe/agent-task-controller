dentifier)))\n156\t\t\t\t})\n157\t\t\t})\n158\t\n159\t\t\tContext(\"frontmatter merge\", func() {\n160\t\t\t\tIt(\"preserves existing frontmatter keys not sent by agent\", func() {\n161\t\t\t\t\twriteTaskFile(\n162\t\t\t\t\t\t\"my-task.md\",\n163\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nassignee: backtest-agent\\ntags:\\n  - a\\n  - b\\ncustom_field: hello\\n---\\nOld content\\n\",\n164\t\t\t\t\t)\n165\t\n166\t\t\t\t\ttaskFile = lib.Task{\n167\t\t\t\t\t\tTaskIdentifier: identifier,\n168\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n169\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n170\t\t\t\t\t\t\t\"status\":          \"completed\",\n171\t\t\t\t\t\t\t\"phase\":           \"done\",\n172\t\t\t\t\t\t},\n173\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n174\t\t\t\t\t}\n175\t\n176\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n177\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n178\t\n179\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n180\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n181\t\t\t\t\ts := string(written)\n182\t\t\t\t\tExpect(s).To(ContainSubstring(\"assignee: backtest-agent\"))\n183\t\t\t\t\tExpect(s).To(ContainSubstring(\"custom_field: hello\"))\n184\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n185\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n186\t\t\t\t\tExpect(s).To(ContainSubstring(\"task_identifier: test-task-uuid-1234\"))\n187\t\t\t\t\t// tags preserved\n188\t\t\t\t\tExpect(s).To(ContainSubstring(\"- a\"))\n189\t\t\t\t\tExpect(s).To(ContainSubstring(\"- b\"))\n190\t\t\t\t})\n191\t\n192\t\t\t\tIt(\"agent keys override existing keys\", func() {\n193\t\t\t\t\twriteTaskFile(\n194\t\t\t\t\t\t\"my-task.md\",\n195\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: in_progress\\n---\\nOld content\\n\",\n196\t\t\t\t\t)\n197\t\n198\t\t\t\t\ttaskFile = lib.Task{\n199\t\t\t\t\t\tTaskIdentifier: identifier,\n200\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n201\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n202\t\t\t\t\t\t\t\"status\":          \"completed\",\n203\t\t\t\t\t\t\t\"phase\":           \"done\",\n204\t\t\t\t\t\t},\n205\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n206\t\t\t\t\t}\n207\t\n208\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n209\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n210\t\n211\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n212\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n213\t\t\t\t\ts := string(written)\n214\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n215\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n216\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"in_progress\"))\n217\t\t\t\t})\n218\t\t\t})\n219\t\n220\t\t\tContext(\"overwrite\", func() {\n221\t\t\t\tIt(\"fully replaces content on second call\", func() {\n222\t\t\t\t\twriteTaskFile(\n223\t\t\t\t\t\t\"my-task.md\",\n224\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\n---\\nFirst content\\n\",\n225\t\t\t\t\t)\n226\t\n227\t\t\t\t\ttaskFile = lib.Task{\n228\t\t\t\t\t\tTaskIdentifier: identifier,\n229\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n230\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n231\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n232\t\t\t\t\t\t},\n233\t\t\t\t\t\tContent: lib.TaskContent(\"First result\\n\"),\n234\t\t\t\t\t}\n235\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n236\t\n237\t\t\t\t\ttaskFile.Content = lib.TaskContent(\"Second result\\n\")\n238\t\t\t\t\ttaskFile.Frontmatter[\"status\"] = \"closed\"\n239\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n240\t\n241\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n242\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n243\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"Second result\\n\"))\n244\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"status: closed\"))\n245\t\t\t\t\tExpect(string(written)).NotTo(ContainSubstring(\"First result\"))\n246\t\n247\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(2))\n248\t\t\t\t})\n249\t\t\t})\n250\t\n251\t\t\tContext(\"unknown task identifier\", func() {\n252\t\t\t\tIt(\"returns nil without committing when no matching file found\", func() {\n253\t\t\t\t\twriteTaskFile(\n254\t\t\t\t\t\t\"other-task.md\",\n255\t\t\t\t\t\t\"---\\ntask_identifier: different-uuid\\nstatus: open\\n---\\nSome content\\n\",\n256\t\t\t\t\t)\n257\t\n258\t\t\t\t\ttaskFile = lib.Task{\n259\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"non-existent-uuid\"),\n260\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"status\": \"done\"},\n261\t\t\t\t\t\tContent:        lib.TaskContent(\"Result\\n\"),\n262\t\t\t\t\t}\n263\t\n264\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n265\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n266\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(0))\n267\t\t\t\t})\n268\t\t\t})\n269\t\n270\t\t\tContext(\"empty frontmatter\", func() {\n271\t\t\t\tIt(\"preserves existing keys when agent sends empty frontmatter\", func() {\n272\t\t\t\t\twriteTaskFile(\n273\t\t\t\t\t\t\"my-task.md\",\n274\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nassignee: backtest-agent\\n---\\nOld content\\n\",\n275\t\t\t\t\t)\n276\t\n277\t\t\t\t\ttaskFile = lib.Task{\n278\t\t\t\t\t\tTaskIdentifier: identifier,\n279\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{},\n280\t\t\t\t\t\tContent:        lib.TaskContent(\"New content\\n\"),\n281\t\t\t\t\t}\n282\t\n283\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n284\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n285\t\n286\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n287\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n288\t\t\t\t\ts := string(written)\n289\t\t\t\t\tExpect(s).To(ContainSubstring(\"task_identifier: test-task-uuid-1234\"))\n290\t\t\t\t\tExpect(s).To(ContainSubstring(\"assignee: backtest-agent\"))\n291\t\t\t\t\tExpect(s).To(ContainSubstring(\"---\\nNew content\\n\"))\n292\t\t\t\t})\n293\t\t\t})\n294\t\n295\t\t\tContext(\"frontmatter with nested values\", func() {\n296\t\t\t\tIt(\"serializes lists and nested maps correctly\", func() {\n297\t\t\t\t\twriteTaskFile(\n298\t\t\t\t\t\t\"my-task.md\",\n299\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: open\\n---\\nOld content\\n\",\n300\t\t\t\t\t)\n301\t\n302\t\t\t\t\ttaskFile = lib.Task{\n303\t\t\t\t\t\tTaskIdentifier: identifier,\n304\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n305\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n306\t\t\t\t\t\t\t\"status\":          \"done\",\n307\t\t\t\t\t\t\t\"tags\":            []interface{}{\"agent-task\", \"automated\"},\n308\t\t\t\t\t\t\t\"meta\": map[string]interface{}{\n309\t\t\t\t\t\t\t\t\"model\": \"claude-sonnet-4-6\",\n310\t\t\t\t\t\t\t},\n311\t\t\t\t\t\t},\n312\t\t\t\t\t\tContent: lib.TaskContent(\"Result content\\n\"),\n313\t\t\t\t\t}\n314\t\n315\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n316\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n317\t\n318\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n319\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n320\t\n321\t\t\t\t\t// Parse and verify frontmatter\n322\t\t\t\t\ts := string(written)\n323\t\t\t\t\tExpect(s).To(HavePrefix(\"---\\n\"))\n324\t\t\t\t\tparts := strings.SplitN(s[4:], \"\\n---\\n\", 2)\n325\t\t\t\t\tExpect(parts).To(HaveLen(2))\n326\t\n327\t\t\t\t\tvar parsedFm map[string]interface{}\n328\t\t\t\t\tExpect(yaml.Unmarshal([]byte(parts[0]), &parsedFm)).To(Succeed())\n329\t\t\t\t\tExpect(parsedFm[\"status\"]).To(Equal(\"done\"))\n330\t\n331\t\t\t\t\ttags, ok := parsedFm[\"tags\"].([]interface{})\n332\t\t\t\t\tExpect(ok).To(BeTrue())\n333\t\t\t\t\tExpect(tags).To(ContainElements(\"agent-task\", \"automated\"))\n334\t\n335\t\t\t\t\tmeta, ok := parsedFm[\"meta\"].(map[string]interface{})\n336\t\t\t\t\tExpect(ok).To(BeTrue())\n337\t\t\t\t\tExpect(meta[\"model\"]).To(Equal(\"claude-sonnet-4-6\"))\n338\t\n339\t\t\t\t\tExpect(parts[1]).To(Equal(\"Result content\\n\"))\n340\t\t\t\t})\n341\t\t\t})\n342\t\n343\t\t\tContext(\"content with YAML delimiters\", func() {\n344\t\t\t\tIt(\"preserves bare --- lines in body without escaping\", func() {\n345\t\t\t\t\twriteTaskFile(\n346\t\t\t\t\t\t\"my-task.md\",\n347\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: open\\n---\\nOld content\\n\",\n348\t\t\t\t\t)\n349\t\n350\t\t\t\t\ttaskFile = lib.Task{\n351\t\t\t\t\t\tTaskIdentifier: identifier,\n352\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n353\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n354\t\t\t\t\t\t\t\"status\":          \"done\",\n355\t\t\t\t\t\t},\n356\t\t\t\t\t\tContent: lib.TaskContent(\n357\t\t\t\t\t\t\t\"## Result\\n\\nOutput:\\n---\\nsome yaml block\\n---\\nDone.\\n\",\n358\t\t\t\t\t\t),\n359\t\t\t\t\t}\n360\t\n361\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n362\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n363\t\n364\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n365\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n366\t\n367\t\t\t\t\ts := string(written)\n368\t\t\t\t\t// Verify frontmatter is parseable\n369\t\t\t\t\tExpect(s).To(HavePrefix(\"---\\n\"))\n370\t\t\t\t\tparts := strings.SplitN(s[4:], \"\\n---\\n\", 2)\n371\t\t\t\t\tExpect(parts).To(HaveLen(2))\n372\t\n373\t\t\t\t\tvar parsedFm map[string]interface{}\n374\t\t\t\t\tExpect(yaml.Unmarshal([]byte(parts[0]), &parsedFm)).To(Succeed())\n375\t\t\t\t\tExpect(parsedFm[\"status\"]).To(Equal(\"done\"))\n376\t\n377\t\t\t\t\t// Body --- preserved as-is (valid markdown horizontal rule)\n378\t\t\t\t\tExpect(parts[1]).To(ContainSubstring(\"\\n---\\n\"))\n379\t\t\t\t\tExpect(parts[1]).NotTo(ContainSubstring(`\\-\\-\\-`))\n380\t\n381\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n382\t\t\t\t})\n383\t\t\t})\n384\t\n385\t\t\tContext(\"realistic end-to-end\", func() {\n386\t\t\t\tIt(\n387\t\t\t\t\t\"reads a real Obsidian task, applies agent result, and produces correct output\",\n388\t\t\t\t\tfunc() {\n389\t\t\t\t\t\t// Realistic task file matching actual Obsidian format:\n390\t\t\t\t\t\t// frontmatter + Tags line + --- separator + body\n391\t\t\t\t\t\toriginalTask := `---\n392\ttask_identifier: e2e-uuid-1234-5678\n393\tstatus: in_progress\n394\tphase: ai_review\n395\tassignee: backtest-agent\n396\tstage: dev\n397\tplanned_date: \"2026-04-17\"\n398\tpage_type: task\n399\ttags:\n400\t  - agent-task\n401\t  - backtest\n402\t---\n403\tTags: [[Task]] [[Trading]]\n404\t\n405\t---\n406\t\n407\tRun a backtest for strategy **capitalcom-backtest-BACKTEST** from 2026-04-10 to 2026-04-17.\n408\t\n409\t## Details\n410\t\n411\t- **Strategy:** capitalcom-backtest-BACKTEST\n412\t- **From:** 2026-04-10\n413\t- **Until:** 2026-04-17\n414\t`\n415\t\t\t\t\t\twriteTaskFile(\"e2e-backtest.md\", originalTask)\n416\t\n417\t\t\t\t\t\t// Simulate agent result: status completed, body includes --- separators\n418\t\t\t\t\t\ttaskFile = lib.Task{\n419\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"e2e-uuid-1234-5678\"),\n420\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n421\t\t\t\t\t\t\t\t\"task_identifier\": \"e2e-uuid-1234-5678\",\n422\t\t\t\t\t\t\t\t\"status\":          \"completed\",\n423\t\t\t\t\t\t\t\t\"phase\":           \"done\",\n424\t\t\t\t\t\t\t},\n425\t\t\t\t\t\t\tContent: lib.TaskContent(`Tags: [[Task]] [[Trading]]\n426\t\n427\t---\n428\t\n429\tRun a backtest for strategy **capitalcom-backtest-BACKTEST** from 2026-04-10 to 2026-04-17.\n430\t\n431\t## Details\n432\t\n433\t- **Strategy:** capitalcom-backtest-BACKTEST\n434\t- **From:** 2026-04-10\n435\t- **Until:** 2026-04-17\n436\t\n437\t## Result\n438\t\n439\t- **Strategy:** capitalcom-backtest-BACKTEST\n440\t- **Period:** 2026-04-10 — 2026-04-17\n441\t- **Backtest ID:** b3b44eb0-60d9-40b9-9e7d-5afdc3272020\n442\t- **Status:** DONE\n443\t`),\n444\t\t\t\t\t\t}\n445\t\n446\t\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n447\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n448\t\n449\t\t\t\t\t\twritten, readErr := os.ReadFile(\n450\t\t\t\t\t\t\tfilepath.Join(tmpDir, taskDir, \"e2e-backtest.md\"),\n451\t\t\t\t\t\t)\n452\t\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n453\t\t\t\t\t\ts := string(written)\n454\t\n455\t\t\t\t\t\t// 1. File starts with frontmatter delimiter\n456\t\t\t\t\t\tExpect(s).To(HavePrefix(\"---\\n\"))\n457\t\n458\t\t\t\t\t\t// 2. Parse frontmatter correctly\n459\t\t\t\t\t\tparts := strings.SplitN(s[4:], \"\\n---\\n\", 2)\n460\t\t\t\t\t\tExpect(parts).To(HaveLen(2), \"frontmatter must be closed by ---\")\n461\t\n462\t\t\t\t\t\tvar parsedFm map[string]interface{}\n463\t\t\t\t\t\tExpect(yaml.Unmarshal([]byte(parts[0]), &parsedFm)).To(Succeed())\n464\t\n465\t\t\t\t\t\t// 3. Agent keys override existing\n466\t\t\t\t\t\tExpect(parsedFm[\"status\"]).To(Equal(\"completed\"))\n467\t\t\t\t\t\tExpect(parsedFm[\"phase\"]).To(Equal(\"done\"))\n468\t\t\t\t\t\tExpect(parsedFm[\"task_identifier\"]).To(Equal(\"e2e-uuid-1234-5678\"))\n469\t\n470\t\t\t\t\t\t// 4. Existing keys NOT in agent result are preserved\n471\t\t\t\t\t\tExpect(parsedFm[\"assignee\"]).To(Equal(\"backtest-agent\"))\n472\t\t\t\t\t\tExpect(parsedFm[\"stage\"]).To(Equal(\"dev\"))\n473\t\t\t\t\t\tExpect(parsedFm[\"page_type\"]).To(Equal(\"task\"))\n474\t\t\t\t\t\tExpect(parsedFm[\"planned_date\"]).To(Equal(\"2026-04-17\"))\n475\t\n476\t\t\t\t\t\t// 5. Tags list preserved\n477\t\t\t\t\t\ttags, ok := parsedFm[\"tags\"].([]interface{})\n478\t\t\t\t\t\tExpect(ok).To(BeTrue(), \"tags should be a list\")\n479\t\t\t\t\t\tExpect(tags).To(ContainElements(\"agent-task\", \"backtest\"))\n480\t\n481\t\t\t\t\t\t// 6. Body contains --- as-is (not escaped to \\-\\-\\-)\n482\t\t\t\t\t\tbody := parts[1]\n483\t\t\t\t\t\tExpect(body).To(Contain