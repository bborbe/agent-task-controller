{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a3ae74eb3ddc7f46","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"path/filepath\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\t\"unicode/utf8\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\t\"github.com/bborbe/errors\"\n17\t\tlibtime \"github.com/bborbe/time\"\n18\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n19\t\t\"github.com/golang/glog\"\n20\t\t\"github.com/google/uuid\"\n21\t\t\"gopkg.in/yaml.v3\"\n22\t\n23\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n24\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n25\t\t\"github.com/bborbe/agent-task-controller/pkg/prcomment\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n27\t)\n28\t\n29\t// maxControllerPlanningRetries is the frozen cap on controller-side planning\n30\t// retries. Invariant per spec 003 — never an env var, CLI flag, config field,\n31\t// or CRD field.\n32\tconst maxControllerPlanningRetries = 3\n33\t\n34\t//counterfeiter:generate -o ../../mocks/planning_retry_gate.go --fake-name PlanningRetryGate . PlanningRetryGate\n35\t\n36\t// PlanningRetryGate decides whether a failed pr-review planning result should be\n37\t// retried controller-side. Handle inspects the incoming result and the on-disk\n38\t// task state and, when the retry gate matches, performs the retry write (counter\n39\t// bump + ## Progress append + phase reset + fresh task_identifier) and returns\n40\t// handled=true. When the gate does not match (non-pr-review, non-planning,\n41\t// success/skipped, no failure marker, or counter already at cap in this prompt),\n42\t// it returns handled=false and the caller falls through to the default\n43\t// WriteResult path.\n44\ttype PlanningRetryGate interface {\n45\t\tHandle(ctx context.Context, req lib.Task) (handled bool, err error)\n46\t}\n47\t\n48\t// NewPlanningRetryGate constructs the gate.\n49\tfunc NewPlanningRetryGate(\n50\t\tgitClient gitclient.GitClient,\n51\t\ttaskDir string,\n52\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n53\t\tprCommenter prcomment.PRCommenter,\n54\t\tm metrics.Metrics,\n55\t) PlanningRetryGate {\n56\t\treturn &planningRetryGate{\n57\t\t\tgitClient:       gitClient,\n58\t\t\ttaskDir:         taskDir,\n59\t\t\tcurrentDateTime: currentDateTime,\n60\t\t\tprCommenter:     prCommenter,\n61\t\t\tmetrics:         m,\n62\t\t}\n63\t}\n64\t\n65\ttype planningRetryGate struct {\n66\t\tgitClient       gitclient.GitClient\n67\t\ttaskDir         string\n68\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n69\t\tprCommenter     prcomment.PRCommenter\n70\t\tmetrics         metrics.Metrics\n71\t}\n72\t\n73\tfunc (g *planningRetryGate) Handle(ctx context.Context, req lib.Task) (handled bool, err error) {\n74\t\tif !g.matchesRetryGate(req) {\n75\t\t\treturn false, nil\n76\t\t}\n77\t\n78\t\trelPath, existingFrontmatter, findErr := result.FindTaskFilePath(\n79\t\t\tctx, g.gitClient, g.taskDir, req.TaskIdentifier,\n80\t\t)\n81\t\tif findErr != nil {\n82\t\t\treturn false, errors.Wrapf(ctx, findErr, \"planning-retry: find task file\")\n83\t\t}\n84\t\tif relPath == \"\" {\n85\t\t\tglog.Warningf(\"planning-retry: task file not found for %s; skipping\", req.TaskIdentifier)\n86\t\t\treturn false, nil\n87\t\t}\n88\t\n89\t\tcount, _ := existingFrontmatter.Int(\"planning_retry_count\")\n90\t\tif count < 0 {\n91\t\t\tcount = 0\n92\t\t}\n93\t\n94\t\tif count >= maxControllerPlanningRetries {\n95\t\t\treturn g.escalate(ctx, req, relPath, existingFrontmatter)\n96\t\t}\n97\t\n98\t\treason := g.extractReason(string(req.Content))\n99\t\tbump := false\n100\t\tts := g.currentDateTime.Now().UTC().Format(\"2006-01-02T15:04:05Z07:00\")\n101\t\n102\t\tmsg := \"[agent-task-controller] planning retry \" + strconv.Itoa(\n103\t\t\tcount+1,\n104\t\t) + \"/3 for task \" + string(\n105\t\t\treq.TaskIdentifier,\n106\t\t)\n107\t\tabsPath := filepath.Join(g.gitClient.Path(), relPath)\n108\t\n109\t\tmodifyErr := g.gitClient.AtomicReadModifyWriteAndCommitPush(\n110\t\t\tctx, absPath, g.buildRetryModifyFn(ctx, count, reason, ts, &bump), msg,\n111\t\t)\n112\t\tif modifyErr != nil {\n113\t\t\treturn false, errors.Wrapf(\n114\t\t\t\tctx,\n115\t\t\t\tmodifyErr,\n116\t\t\t\t\"planning-retry: write retry for task %s\",\n117\t\t\t\treq.TaskIdentifier,\n118\t\t\t)\n119\t\t}\n120\t\n121\t\tif bump {\n122\t\t\tg.metrics.PlanningRetryTotal(\"retry\").Inc()\n123\t\t\tglog.V(2).Infof(\n124\t\t\t\t\"planning-retry: attempt %d/3 for task %s (reason=%q)\",\n125\t\t\t\tcount+1,\n126\t\t\t\treq.TaskIdentifier,\n127\t\t\t\treason,\n128\t\t\t)\n129\t\t}\n130\t\treturn true, nil\n131\t}\n132\t\n133\tfunc (g *planningRetryGate) matchesRetryGate(req lib.Task) bool {\n134\t\ttaskType := req.Frontmatter.TaskType()\n135\t\tif taskType != lib.TaskTypePRReview &&\n136\t\t\treq.Frontmatter.Assignee() != lib.TaskAssignee(\"pr-reviewer-agent\") {\n137\t\t\tglog.V(3).\n138\t\t\t\tInfof(\"planning-retry: task %s is not pr-review (task_type=%q, assignee=%q); skipping gate\", req.TaskIdentifier, taskType, req.Frontmatter.Assignee())\n139\t\t\treturn false\n140\t\t}\n141\t\tphase := req.Frontmatter.Phase()\n142\t\tif phase == nil || phase.String() != domain.TaskPhasePlanning.String() {\n143\t\t\tglog.V(3).\n144\t\t\t\tInfof(\"planning-retry: task %s phase is not planning; skipping gate\", req.TaskIdentifier)\n145\t\t\treturn false\n146\t\t}\n147\t\tif !hasFailureMarker(string(req.Content)) {\n148\t\t\tglog.V(2).\n149\t\t\t\tInfof(\"planning-retry: no failure signal; skipping retry gate for task %s\", req.TaskIdentifier)\n150\t\t\treturn false\n151\t\t}\n152\t\treturn true\n153\t}\n154\t\n155\tfunc hasFailureMarker(content string) bool {\n156\t\tfor _, line := range strings.Split(content, \"\\n\") {\n157\t\t\tif strings.HasPrefix(strings.TrimSpace(line), \"Status: failed\") {\n158\t\t\t\treturn true\n159\t\t\t}\n160\t\t}\n161\t\treturn false\n162\t}\n163\t\n164\tfunc (g *planningRetryGate) extractReason(content string) string {\n165\t\tafterMarker := false\n166\t\tfor _, line := range strings.Split(content, \"\\n\") {\n167\t\t\ttrimmed := strings.TrimSpace(line)\n168\t\t\tif afterMarker {\n169\t\t\t\tif trimmed != \"\" {\n170\t\t\t\t\treturn sanitizeReason(trimmed)\n171\t\t\t\t}\n172\t\t\t}\n173\t\t\tif strings.HasPrefix(trimmed, \"Status: failed\") {\n174\t\t\t\tafterMarker = true\n175\t\t\t}\n176\t\t}\n177\t\treturn sanitizeReason(strings.TrimSpace(content))\n178\t}\n179\t\n180\tfunc sanitizeReason(raw string) string {\n181\t\tvar builder strings.Builder\n182\t\tfor _, r := range raw {\n183\t\t\tif r == '\\r' || r == '\\n' {\n184\t\t\t\tbuilder.WriteRune(' ')\n185\t\t\t\tcontinue\n186\t\t\t}\n187\t\t\tif r < 0x20 && r != ' ' {\n188\t\t\t\tcontinue\n189\t\t\t}\n190\t\t\tbuilder.WriteRune(r)\n191\t\t}\n192\t\tsanitized := strings.TrimSpace(builder.String())\n193\t\tif utf8.RuneCountInString(sanitized) > 200 {\n194\t\t\treturn string([]rune(sanitized)[:200])\n195\t\t}\n196\t\treturn sanitized\n197\t}\n198\t\n199\tfunc (g *planningRetryGate) buildRetryModifyFn(\n200\t\tctx context.Context,\n201\t\tcount int,\n202\t\treason string,\n203\t\tts string,\n204\t\tbump *bool,\n205\t) func(current []byte) ([]byte, error) {\n206\t\treturn func(current []byte) ([]byte, error) {\n207\t\t\t*bump = false\n208\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n209\t\t\tif err != nil {\n210\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n211\t\t\t}\n212\t\t\tbody, err := result.ExtractBody(ctx, current)\n213\t\t\tif err != nil {\n214\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n215\t\t\t}\n216\t\t\tvar fm lib.TaskFrontmatter\n217\t\t\tif err := yaml.Unmarshal([]byte(fmStr), &fm); err != nil {\n218\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal frontmatter\")\n219\t\t\t}\n220\t\n221\t\t\tonDiskCount, _ := fm.Int(\"planning_retry_count\")\n222\t\t\tif onDiskCount != count {\n223\t\t\t\treturn current, nil\n224\t\t\t}\n225\t\n226\t\t\tretryLine := \"retry \" + strconv.Itoa(count+1) + \"/3: \" + reason + \" at \" + ts\n227\t\t\tretryLineBullet := \"- \" + retryLine\n228\t\t\tfor _, line := range strings.Split(body, \"\\n\") {\n229\t\t\t\tif strings.TrimSpace(line) == retryLineBullet {\n230\t\t\t\t\treturn current, nil\n231\t\t\t\t}\n232\t\t\t}\n233\t\n234\t\t\t*bump = true\n235\t\n236\t\t\tfm[\"planning_retry_count\"] = count + 1\n237\t\t\tfm[\"phase\"] = \"planning\"\n238\t\t\tfm[\"task_identifier\"] = uuid.NewString()\n239\t\n240\t\t\tnewBody := appendProgressLine(body, retryLineBullet)\n241\t\n242\t\t\tmarshaled, err := yaml.Marshal(map[string]any(fm))\n243\t\t\tif err != nil {\n244\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n245\t\t\t}\n246\t\t\treturn []byte(\"---\\n\" + string(marshaled) + \"---\\n\" + newBody), nil\n247\t\t}\n248\t}\n249\t\n250\tfunc (g *planningRetryGate) escalate(\n251\t\tctx context.Context,\n252\t\treq lib.Task,\n253\t\trelPath string,\n254\t\texistingFrontmatter lib.TaskFrontmatter,\n255\t) (bool, error) {\n256\t\treason := g.extractReason(string(req.Content))\n257\t\tts := g.currentDateTime.Now().UTC().Format(time.RFC3339)\n258\t\n259\t\tmsg := \"[agent-task-controller] planning retry exhausted for task \" + string(req.TaskIdentifier)\n260\t\tabsPath := filepath.Join(g.gitClient.Path(), relPath)\n261\t\n262\t\tfirstEscalation := true\n263\t\tmodifyErr := g.gitClient.AtomicReadModifyWriteAndCommitPush(\n264\t\t\tctx, absPath, g.buildEscalationModifyFn(ctx, &firstEscalation, reason, ts), msg,\n265\t\t)\n266\t\tif modifyErr != nil {\n267\t\t\treturn false, errors.Wrapf(\n268\t\t\t\tctx,\n269\t\t\t\tmodifyErr,\n270\t\t\t\t\"planning-retry: escalation write for task %s\",\n271\t\t\t\treq.TaskIdentifier,\n272\t\t\t)\n273\t\t}\n274\t\n275\t\tif firstEscalation {\n276\t\t\tcommentBody := \"Automated pr-review planning failed after 3 controller retries and 3 in-agent retries. Last error: \" + reason + \". Please investigate \" + relPath + \".\"\n277\t\t\tif commentErr := g.prCommenter.PostComment(ctx, existingFrontmatter, commentBody); commentErr != nil {\n278\t\t\t\tglog.Warningf(\n279\t\t\t\t\t\"planning-retry: github COMMENT post failed: task=%s err=%v\",\n280\t\t\t\t\treq.TaskIdentifier,\n281\t\t\t\t\tcommentErr,\n282\t\t\t\t)\n283\t\t\t}\n284\t\t\tg.metrics.PlanningRetryTotal(\"exhausted\").Inc()\n285\t\t\tglog.V(2).Infof(\n286\t\t\t\t\"planning-retry: exhausted after 3 retries for task %s; escalated to human_review\",\n287\t\t\t\treq.TaskIdentifier,\n288\t\t\t)\n289\t\t}\n290\t\n291\t\treturn true, nil\n292\t}\n293\t\n294\tfunc (g *planningRetryGate) buildEscalationModifyFn(\n295\t\tctx context.Context,\n296\t\tfirstEscalation *bool,\n297\t\treason, ts string,\n298\t) func(current []byte) ([]byte, error) {\n299\t\treturn func(current []byte) ([]byte, error) {\n300\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n301\t\t\tif err != nil {\n302\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n303\t\t\t}\n304\t\t\tbody, err := result.ExtractBody(ctx, current)\n305\t\t\tif err != nil {\n306\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n307\t\t\t}\n308\t\t\tvar fm lib.TaskFrontmatter\n309\t\t\tif err := yaml.Unmarshal([]byte(fmStr), &fm); err != nil {\n310\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal frontmatter\")\n311\t\t\t}\n312\t\n313\t\t\t// Idempotency: check if terminal retry line already present\n314\t\t\tfor _, line := range strings.Split(body, \"\\n\") {\n315\t\t\t\tif strings.HasPrefix(strings.TrimSpace(line), \"retry 3/3:\") {\n316\t\t\t\t\t*firstEscalation = false\n317\t\t\t\t\tbreak\n318\t\t\t\t}\n319\t\t\t}\n320\t\n321\t\t\tif *firstEscalation {\n322\t\t\t\tbody = appendProgressLine(body, \"- retry 3/3: \"+reason+\" at \"+ts)\n323\t\t\t}\n324\t\n325\t\t\tfm[\"phase\"] = \"human_review\"\n326\t\t\tresult.ClearAssigneeIfHumanReview(fm)\n327\t\n328\t\t\tmarshaled, err := yaml.Marshal(map[string]any(fm))\n329\t\t\tif err != nil {\n330\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n331\t\t\t}\n332\t\t\treturn []byte(\"---\\n\" + string(marshaled) + \"---\\n\" + body), nil\n333\t\t}\n334\t}\n335\t\n336\tfunc appendProgressLine(body string, line string) string {\n337\t\tif body != \"\" && !strings.HasSuffix(body, \"\\n\") {\n338\t\t\tbody += \"\\n\"\n339\t\t}\n340\t\tif strings.Contains(body, \"## Progress\") {\n341\t\t\treturn body + line + \"\\n\"\n342\t\t}\n343\t\treturn body + \"## Progress\\n\\n\" + line + \"\\n\"\n344\t}\n345\t"}]},"parent_tool_use_id":null,"session_id":"4d516ec6-9c37-415d-ba1d-85d6d6e1eaa0","uuid":"a3eaac5c-43b1-48b8-a270-fcb28c8294cd","timestamp":"2026-09-03T17:44:16.238Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/command/planning_retry.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage command\n\nimport (\n\t\"context\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\tlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/errors\"\n\tlibtime \"github.com/bborbe/time\"\n\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n\t\"github.com/golang/glog\"\n\t\"github.com/google/uuid\"\n\t\"gopkg.in/yaml.v3\"\n\n\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n\t\"github.com/bborbe/agent-task-controller/pkg/prcomment\"\n\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n)\n\n// maxControllerPlanningRetries is the frozen cap on controller-side planning\n// retries. Invariant per spec 003 — never an env var, CLI flag, config field,\n// or CRD field.\nconst maxControllerPlanningRetries = 3\n\n//counterfeiter:generate -o ../../mocks/planning_retry_gate.go --fake-name PlanningRetryGate . PlanningRetryGate\n\n// PlanningRetryGate decides whether a failed pr-review planning result should be\n// retried controller-side. Handle inspects the incoming result and the on-disk\n// task state and, when the retry gate matches, performs the retry write (counter\n// bump + ## Progress append + phase reset + fresh task_identifier) and returns\n// handled=true. When the gate does not match (non-pr-review, non-planning,\n// success/skipped, no failure marker, or counter already at cap in this prompt),\n// it returns handled=false and the caller falls through to the default\n// WriteResult path.\ntype PlanningRetryGate interface {\n\tHandle(ctx context.Context, req lib.Task) (handled bool, err error)\n}\n\n// NewPlanningRetryGate constructs the gate.\nfunc NewPlanningRetryGate(\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tprCommenter prcomment.PRCommenter,\n\tm metrics.Metrics,\n) PlanningRetryGate {\n\treturn &planningRetryGate{\n\t\tgitClient:       gitClient,\n\t\ttaskDir:         taskDir,\n\t\tcurrentDateTime: currentDateTime,\n\t\tprCommenter:     prCommenter,\n\t\tmetrics:         m,\n\t}\n}\n\ntype planningRetryGate struct {\n\tgitClient       gitclient.GitClient\n\ttaskDir         string\n\tcurrentDateTime libtime.CurrentDateTimeGetter\n\tprCommenter     prcomment.PRCommenter\n\tmetrics         metrics.Metrics\n}\n\nfunc (g *planningRetryGate) Handle(ctx context.Context, req lib.Task) (handled bool, err error) {\n\tif !g.matchesRetryGate(req) {\n\t\treturn false, nil\n\t}\n\n\trelPath, existingFrontmatter, findErr := result.FindTaskFilePath(\n\t\tctx, g.gitClient, g.taskDir, req.TaskIdentifier,\n\t)\n\tif findErr != nil {\n\t\treturn false, errors.Wrapf(ctx, findErr, \"planning-retry: find task file\")\n\t}\n\tif relPath == \"\" {\n\t\tglog.Warningf(\"planning-retry: task file not found for %s; skipping\", req.TaskIdentifier)\n\t\treturn false, nil\n\t}\n\n\tcount, _ := existingFrontmatter.Int(\"planning_retry_count\")\n\tif count < 0 {\n\t\tcount = 0\n\t}\n\n\tif count >= maxControllerPlanningRetries {\n\t\treturn g.escalate(ctx, req, relPath, existingFrontmatter)\n\t}\n\n\treason := g.extractReason(string(req.Content))\n\tbump := false\n\tts := g.currentDateTime.Now().UTC().Format(\"2006-01-02T15:04:05Z07:00\")\n\n\tmsg := \"[agent-task-controller] planning retry \" + strconv.Itoa(\n\t\tcount+1,\n\t) + \"/3 for task \" + string(\n\t\treq.TaskIdentifier,\n\t)\n\tabsPath := filepath.Join(g.gitClient.Path(), relPath)\n\n\tmodifyErr := g.gitClient.AtomicReadModifyWriteAndCommitPush(\n\t\tctx, absPath, g.buildRetryModifyFn(ctx, count, reason, ts, &bump), msg,\n\t)\n\tif modifyErr != nil {\n\t\treturn false, errors.Wrapf(\n\t\t\tctx,\n\t\t\tmodifyErr,\n\t\t\t\"planning-retry: write retry for task %s\",\n\t\t\treq.TaskIdentifier,\n\t\t)\n\t}\n\n\tif bump {\n\t\tg.metrics.PlanningRetryTotal(\"retry\").Inc()\n\t\tglog.V(2).Infof(\n\t\t\t\"planning-retry: attempt %d/3 for task %s (reason=%q)\",\n\t\t\tcount+1,\n\t\t\treq.TaskIdentifier,\n\t\t\treason,\n\t\t)\n\t}\n\treturn true, nil\n}\n\nfunc (g *planningRetryGate) matchesRetryGate(req lib.Task) bool {\n\ttaskType := req.Frontmatter.TaskType()\n\tif taskType != lib.TaskTypePRReview &&\n\t\treq.Frontmatter.Assignee() != lib.TaskAssignee(\"pr-reviewer-agent\") {\n\t\tglog.V(3).\n\t\t\tInfof(\"planning-retry: task %s is not pr-review (task_type=%q, assignee=%q); skipping gate\", req.TaskIdentifier, taskType, req.Frontmatter.Assignee())\n\t\treturn false\n\t}\n\tphase := req.Frontmatter.Phase()\n\tif phase == nil || phase.String() != domain.TaskPhasePlanning.String() {\n\t\tglog.V(3).\n\t\t\tInfof(\"planning-retry: task %s phase is not planning; skipping gate\", req.TaskIdentifier)\n\t\treturn false\n\t}\n\tif !hasFailureMarker(string(req.Content)) {\n\t\tglog.V(2).\n\t\t\tInfof(\"planning-retry: no failure signal; skipping retry gate for task %s\", req.TaskIdentifier)\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc hasFailureMarker(content string) bool {\n\tfor _, line := range strings.Split(content, \"\\n\") {\n\t\tif strings.HasPrefix(strings.TrimSpace(line), \"Status: failed\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc (g *planningRetryGate) extractReason(content string) string {\n\tafterMarker := false\n\tfor _, line := range strings.Split(content, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif afterMarker {\n\t\t\tif trimmed != \"\" {\n\t\t\t\treturn sanitizeReason(trimmed)\n\t\t\t}\n\t\t}\n\t\tif strings.HasPrefix(trimmed, \"Status: failed\") {\n\t\t\tafterMarker = true\n\t\t}\n\t}\n\treturn sanitizeReason(strings.TrimSpace(content))\n}\n\nfunc sanitizeReason(raw string) string {\n\tvar builder strings.Builder\n\tfor _, r := range raw {\n\t\tif r == '\\r' || r == '\\n' {\n\t\t\tbuilder.WriteRune(' ')\n\t\t\tcontinue\n\t\t}\n\t\tif r < 0x20 && r != ' ' {\n\t\t\tcontinue\n\t\t}\n\t\tbuilder.WriteRune(r)\n\t}\n\tsanitized := strings.TrimSpace(builder.String())\n\tif utf8.RuneCountInString(sanitized) > 200 {\n\t\treturn string([]rune(sanitized)[:200])\n\t}\n\treturn sanitized\n}\n\nfunc (g *planningRetryGate) buildRetryModifyFn(\n\tctx context.Context,\n\tcount int,\n\treason string,\n\tts string,\n\tbump *bool,\n) func(current []byte) ([]byte, error) {\n\treturn func(current []byte) ([]byte, error) {\n\t\t*bump = false\n\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n\t\t}\n\t\tbody, err := result.ExtractBody(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n\t\t}\n\t\tvar fm lib.TaskFrontmatter\n\t\tif err := yaml.Unmarshal([]byte(fmStr), &fm); err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal frontmatter\")\n\t\t}\n\n\t\tonDiskCount, _ := fm.Int(\"planning_retry_count\")\n\t\tif onDiskCount != count {\n\t\t\treturn current, nil\n\t\t}\n\n\t\tretryLine := \"retry \" + strconv.Itoa(count+1) + \"/3: \" + reason + \" at \" + ts\n\t\tretryLineBullet := \"- \" + retryLine\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tif strings.TrimSpace(line) == retryLineBullet {\n\t\t\t\treturn current, nil\n\t\t\t}\n\t\t}\n\n\t\t*bump = true\n\n\t\tfm[\"planning_retry_count\"] = count + 1\n\t\tfm[\"phase\"] = \"planning\"\n\t\tfm[\"task_identifier\"] = uuid.NewString()\n\n\t\tnewBody := appendProgressLine(body, retryLineBullet)\n\n\t\tmarshaled, err := yaml.Marshal(map[string]any(fm))\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n\t\t}\n\t\treturn []byte(\"---\\n\" + string(marshaled) + \"---\\n\" + newBody), nil\n\t}\n}\n\nfunc (g *planningRetryGate) escalate(\n\tctx context.Context,\n\treq lib.Task,\n\trelPath string,\n\texistingFrontmatter lib.TaskFrontmatter,\n) (bool, error) {\n\treason := g.extractReason(string(req.Content))\n\tts := g.currentDateTime.Now().UTC().Format(time.RFC3339)\n\n\tmsg := \"[agent-task-controller] planning retry exhausted for task \" + string(req.TaskIdentifier)\n\tabsPath := filepath.Join(g.gitClient.Path(), relPath)\n\n\tfirstEscalation := true\n\tmodifyErr := g.gitClient.AtomicReadModifyWriteAndCommitPush(\n\t\tctx, absPath, g.buildEscalationModifyFn(ctx, &firstEscalation, reason, ts), msg,\n\t)\n\tif modifyErr != nil {\n\t\treturn false, errors.Wrapf(\n\t\t\tctx,\n\t\t\tmodifyErr,\n\t\t\t\"planning-retry: escalation write for task %s\",\n\t\t\treq.TaskIdentifier,\n\t\t)\n\t}\n\n\tif firstEscalation {\n\t\tcommentBody := \"Automated pr-review planning failed after 3 controller retries and 3 in-agent retries. Last error: \" + reason + \". Please investigate \" + relPath + \".\"\n\t\tif commentErr := g.prCommenter.PostComment(ctx, existingFrontmatter, commentBody); commentErr != nil {\n\t\t\tglog.Warningf(\n\t\t\t\t\"planning-retry: github COMMENT post failed: task=%s err=%v\",\n\t\t\t\treq.TaskIdentifier,\n\t\t\t\tcommentErr,\n\t\t\t)\n\t\t}\n\t\tg.metrics.PlanningRetryTotal(\"exhausted\").Inc()\n\t\tglog.V(2).Infof(\n\t\t\t\"planning-retry: exhausted after 3 retries for task %s; escalated to human_review\",\n\t\t\treq.TaskIdentifier,\n\t\t)\n\t}\n\n\treturn true, nil\n}\n\nfunc (g *planningRetryGate) buildEscalationModifyFn(\n\tctx context.Context,\n\tfirstEscalation *bool,\n\treason, ts string,\n) func(current []byte) ([]byte, error) {\n\treturn func(current []byte) ([]byte, error) {\n\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n\t\t}\n\t\tbody, err := result.ExtractBody(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n\t\t}\n\t\tvar fm lib.TaskFrontmatter\n\t\tif err := yaml.Unmarshal([]byte(fmStr), &fm); err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal frontmatter\")\n\t\t}\n\n\t\t// Idempotency: check if terminal retry line already present\n\t\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\t\tif strings.HasPrefix(strings.TrimSpace(line), \"retry 3/3:\") {\n\t\t\t\t*firstEscalation = false\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\n\t\tif *firstEscalation {\n\t\t\tbody = appendProgressLine(body, \"- retry 3/3: \"+reason+\" at \"+ts)\n\t\t}\n\n\t\tfm[\"phase\"] = \"human_review\"\n\t\tresult.ClearAssigneeIfHumanReview(fm)\n\n\t\tmarshaled, err := yaml.Marshal(map[string]any(fm))\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"marshal frontmatter\")\n\t\t}\n\t\treturn []byte(\"---\\n\" + string(marshaled) + \"---\\n\" + body), nil\n\t}\n}\n\nfunc appendProgressLine(body string, line string) string {\n\tif body != \"\" && !strings.HasSuffix(body, \"\\n\") {\n\t\tbody += \"\\n\"\n\t}\n\tif strings.Contains(body, \"## Progress\") {\n\t\treturn body + line + \"\\n\"\n\t}\n\treturn body + \"## Progress\\n\\n\" + line + \"\\n\"\n}\n","numLines":345,"startLine":1,"totalLines":345}}}
