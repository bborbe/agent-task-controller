\n109\t\t\treturn cdb.CommandObject{\n110\t\t\t\tCommand: base.Command{\n111\t\t\t\t\tRequestID: base.NewRequestID(),\n112\t\t\t\t\tOperation: command.UpdateFrontmatterCommandOperation,\n113\t\t\t\t\tInitiator: \"test\",\n114\t\t\t\t\tData:      event,\n115\t\t\t\t},\n116\t\t\t\tSchemaID: schemaID,\n117\t\t\t}\n118\t\t}\n119\t\n120\t\tDescribe(\"CommandOperation\", func() {\n121\t\t\tIt(\"returns update-frontmatter\", func() {\n122\t\t\t\tExpect(\n123\t\t\t\t\texecutor.CommandOperation(),\n124\t\t\t\t).To(Equal(base.CommandOperation(\"update-frontmatter\")))\n125\t\t\t})\n126\t\t})\n127\t\n128\t\tDescribe(\"HandleCommand\", func() {\n129\t\t\tContext(\"only named keys change\", func() {\n130\t\t\t\tIt(\"updates only the specified key and leaves others unchanged\", func() {\n131\t\t\t\t\ttaskFile := writeTaskFile(\n132\t\t\t\t\t\t\"task.md\",\n133\t\t\t\t\t\t\"---\\ntask_identifier: update-test-uuid\\nstatus: in_progress\\nphase: ai_review\\nassignee: claude\\n---\\nbody\\n\",\n134\t\t\t\t\t)\n135\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n136\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"update-test-uuid\"),\n137\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n138\t\t\t\t\t\t\t\"phase\": \"done\",\n139\t\t\t\t\t\t},\n140\t\t\t\t\t})\n141\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n142\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n143\t\t\t\t\tfm := parseFrontmatter(taskFile)\n144\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"done\"))\n145\t\t\t\t\tExpect(fm[\"status\"]).To(Equal(\"in_progress\"))\n146\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"claude\"))\n147\t\t\t\t})\n148\t\t\t})\n149\t\n150\t\t\tContext(\"empty updates\", func() {\n151\t\t\t\tIt(\"returns nil without writing when Updates is nil\", func() {\n152\t\t\t\t\twriteTaskFile(\n153\t\t\t\t\t\t\"task.md\",\n154\t\t\t\t\t\t\"---\\ntask_identifier: noop-uuid\\nstatus: open\\n---\\nbody\\n\",\n155\t\t\t\t\t)\n156\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n157\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"noop-uuid\"),\n158\t\t\t\t\t\tUpdates:        nil,\n159\t\t\t\t\t})\n160\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n161\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n162\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(0))\n163\t\t\t\t})\n164\t\n165\t\t\t\tIt(\"returns nil without writing when Updates is empty map\", func() {\n166\t\t\t\t\twriteTaskFile(\n167\t\t\t\t\t\t\"task.md\",\n168\t\t\t\t\t\t\"---\\ntask_identifier: noop2-uuid\\nstatus: open\\n---\\nbody\\n\",\n169\t\t\t\t\t)\n170\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n171\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"noop2-uuid\"),\n172\t\t\t\t\t\tUpdates:        lib.TaskFrontmatter{},\n173\t\t\t\t\t})\n174\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n175\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n176\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(0))\n177\t\t\t\t})\n178\t\t\t})\n179\t\n180\t\t\tContext(\"task not found\", func() {\n181\t\t\t\tIt(\"returns nil without writing when no matching file exists\", func() {\n182\t\t\t\t\t_, _, err := executor.HandleCommand(\n183\t\t\t\t\t\tctx,\n184\t\t\t\t\t\tnil,\n185\t\t\t\t\t\tbuildCmdObj(task.UpdateFrontmatterCommand{\n186\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"nonexistent-uuid\"),\n187\t\t\t\t\t\t\tUpdates:        lib.TaskFrontmatter{\"phase\": \"human_review\"},\n188\t\t\t\t\t\t}),\n189\t\t\t\t\t)\n190\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n191\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(0))\n192\t\t\t\t})\n193\t\t\t})\n194\t\n195\t\t\tContext(\"multiple updates\", func() {\n196\t\t\t\tIt(\"applies all specified keys without touching unspecified ones\", func() {\n197\t\t\t\t\ttaskFile := writeTaskFile(\n198\t\t\t\t\t\t\"task.md\",\n199\t\t\t\t\t\t\"---\\ntask_identifier: multi-update-uuid\\nstatus: in_progress\\nphase: ai_review\\nassignee: claude\\ncustom: preserve\\n---\\nbody\\n\",\n200\t\t\t\t\t)\n201\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n202\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"multi-update-uuid\"),\n203\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n204\t\t\t\t\t\t\t\"status\": \"completed\",\n205\t\t\t\t\t\t\t\"phase\":  \"done\",\n206\t\t\t\t\t\t},\n207\t\t\t\t\t})\n208\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n209\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n210\t\t\t\t\tfm := parseFrontmatter(taskFile)\n211\t\t\t\t\tExpect(fm[\"status\"]).To(Equal(\"completed\"))\n212\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"done\"))\n213\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"claude\"))\n214\t\t\t\t\tExpect(fm[\"custom\"]).To(Equal(\"preserve\"))\n215\t\t\t\t})\n216\t\t\t})\n217\t\n218\t\t\tContext(\"Body field appends a new section\", func() {\n219\t\t\t\tIt(\n220\t\t\t\t\t\"updates frontmatter and appends the ## Failure section while preserving ## Result\",\n221\t\t\t\t\tfunc() {\n222\t\t\t\t\t\ttaskFile := writeTaskFile(\n223\t\t\t\t\t\t\t\"task.md\",\n224\t\t\t\t\t\t\t\"---\\ntask_identifier: body-append-uuid\\nstatus: in_progress\\nphase: ai_review\\n---\\n## Result\\n\\nok\\n\",\n225\t\t\t\t\t\t)\n226\t\t\t\t\t\tfailureSection := \"## Failure\\n\\n- **Timestamp:** 2026-04-24T12:00:00Z\\n- **Job:** job-abc\\n- **Reason:** OOMKilled\\n\"\n227\t\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n228\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"body-append-uuid\"),\n229\t\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n230\t\t\t\t\t\t\t\t\"status\":      \"in_progress\",\n231\t\t\t\t\t\t\t\t\"phase\":       \"human_review\",\n232\t\t\t\t\t\t\t\t\"current_job\": \"\",\n233\t\t\t\t\t\t\t},\n234\t\t\t\t\t\t\tBody: &task.BodySection{\n235\t\t\t\t\t\t\t\tHeading: \"## Failure\",\n236\t\t\t\t\t\t\t\tSection: failureSection,\n237\t\t\t\t\t\t\t},\n238\t\t\t\t\t\t})\n239\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n240\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n241\t\n242\t\t\t\t\t\tfm := parseFrontmatter(taskFile)\n243\t\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"human_review\"))\n244\t\n245\t\t\t\t\t\tcontent, err := os.ReadFile(taskFile) // #nosec G304 -- test helper\n246\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n247\t\t\t\t\t\tbody := string(content)\n248\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"## Result\"))\n249\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"## Failure\"))\n250\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"OOMKilled\"))\n251\t\t\t\t\t},\n252\t\t\t\t)\n253\t\t\t})\n254\t\n255\t\t\tContext(\"Body nil leaves body untouched\", func() {\n256\t\t\t\tIt(\"updates frontmatter without modifying the existing body\", func() {\n257\t\t\t\t\toriginalBody := \"## Result\\n\\nok\\n\"\n258\t\t\t\t\ttaskFile := writeTaskFile(\n259\t\t\t\t\t\t\"task.md\",\n260\t\t\t\t\t\t\"---\\ntask_identifier: body-nil-uuid\\nstatus: in_progress\\nphase: ai_review\\n---\\n\"+originalBody,\n261\t\t\t\t\t)\n262\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n263\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"body-nil-uuid\"),\n264\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n265\t\t\t\t\t\t\t\"phase\": \"human_review\",\n266\t\t\t\t\t\t},\n267\t\t\t\t\t\tBody: nil,\n268\t\t\t\t\t})\n269\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n270\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n271\t\n272\t\t\t\t\tfm := parseFrontmatter(taskFile)\n273\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"human_review\"))\n274\t\n275\t\t\t\t\tcontent, err := os.ReadFile(taskFile) // #nosec G304 -- test helper\n276\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n277\t\t\t\t\t// Body should be unchanged\n278\t\t\t\t\tExpect(string(content)).To(ContainSubstring(originalBody))\n279\t\t\t\t\tExpect(string(content)).NotTo(ContainSubstring(\"## Failure\"))\n280\t\t\t\t})\n281\t\t\t})\n282\t\n283\t\t\tContext(\"spec 042: phase flip to human_review clears assignee\", func() {\n284\t\t\t\tIt(\n285\t\t\t\t\t\"sets previous_assignee and clears assignee when Updates flips phase to human_review\",\n286\t\t\t\t\tfunc() {\n287\t\t\t\t\t\ttaskFile := writeTaskFile(\n288\t\t\t\t\t\t\t\"task.md\",\n289\t\t\t\t\t\t\t\"---\\ntask_identifier: spec-042-flip-uuid\\nstatus: in_progress\\nphase: planning\\nassignee: pr-reviewer-agent\\ncurrent_job: pr-reviewer-agent-e323cc47\\n---\\nbody\\n\",\n290\t\t\t\t\t\t)\n291\t\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n292\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"spec-042-flip-uuid\"),\n293\t\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n294\t\t\t\t\t\t\t\t\"phase\": \"human_review\",\n295\t\t\t\t\t\t\t},\n296\t\t\t\t\t\t})\n297\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n298\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n299\t\t\t\t\t\tfm := parseFrontmatter(taskFile)\n300\t\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"human_review\"))\n301\t\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"\"))\n302\t\t\t\t\t\tExpect(fm[\"previous_assignee\"]).To(Equal(\"pr-reviewer-agent\"))\n303\t\t\t\t\t\tExpect(fm[\"current_job\"]).To(Equal(\"pr-reviewer-agent-e323cc47\"))\n304\t\t\t\t\t\tExpect(fm[\"status\"]).To(Equal(\"in_progress\"))\n305\t\t\t\t\t},\n306\t\t\t\t)\n307\t\t\t})\n308\t\n309\t\t\tContext(\"spec 042: non-phase updates leave assignee untouched\", func() {\n310\t\t\t\tIt(\n311\t\t\t\t\t\"does not clear assignee and does not add previous_assignee when Updates contains no phase key\",\n312\t\t\t\t\tfunc() {\n313\t\t\t\t\t\ttaskFile := writeTaskFile(\n314\t\t\t\t\t\t\t\"task.md\",\n315\t\t\t\t\t\t\t\"---\\ntask_identifier: spec-042-nonphase-uuid\\nstatus: in_progress\\nphase: in_progress\\nassignee: backtest-agent\\n---\\nbody\\n\",\n316\t\t\t\t\t\t)\n317\t\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n318\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"spec-042-nonphase-uuid\"),\n319\t\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n320\t\t\t\t\t\t\t\t\"progress\": \"50%\",\n321\t\t\t\t\t\t\t},\n322\t\t\t\t\t\t})\n323\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n324\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n325\t\t\t\t\t\tfm := parseFrontmatter(taskFile)\n326\t\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"backtest-agent\"))\n327\t\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"in_progress\"))\n328\t\t\t\t\t\tExpect(fm[\"progress\"]).To(Equal(\"50%\"))\n329\t\t\t\t\t\t_, hasPrev := fm[\"previous_assignee\"]\n330\t\t\t\t\t\tExpect(hasPrev).To(BeFalse(), \"non-phase update must not add previous_assignee\")\n331\t\t\t\t\t},\n332\t\t\t\t)\n333\t\t\t})\n334\t\n335\t\t\tContext(\"spec 042: idempotent re-clear on already-parked task\", func() {\n336\t\t\t\tIt(\n337\t\t\t\t\t\"preserves previous_assignee on a parked task when Updates is a non-phase key with Body\",\n338\t\t\t\t\tfunc() {\n339\t\t\t\t\t\ttaskFile := writeTaskFile(\n340\t\t\t\t\t\t\t\"task.md\",\n341\t\t\t\t\t\t\t\"---\\ntask_identifier: spec-042-parked-uuid\\nstatus: in_progress\\nphase: human_review\\nassignee: \\\"\\\"\\nprevious_assignee: pr-reviewer-agent\\n---\\n## Result\\n\\nok\\n\",\n342\t\t\t\t\t\t)\n343\t\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n344\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"spec-042-parked-uuid\"),\n345\t\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n346\t\t\t\t\t\t\t\t\"verdict\": \"fail\",\n347\t\t\t\t\t\t\t},\n348\t\t\t\t\t\t\tBody: &task.BodySection{\n349\t\t\t\t\t\t\t\tHeading: \"## Verdict\",\n350\t\t\t\t\t\t\t\tSection: \"## Verdict\\n\\n- **Result:** fail\\n\",\n351\t\t\t\t\t\t\t},\n352\t\t\t\t\t\t})\n353\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n354\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n355\t\t\t\t\t\tfm := parseFrontmatter(taskFile)\n356\t\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"human_review\"))\n357\t\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"\"))\n358\t\t\t\t\t\t// previous_assignee must NOT be overwritten with empty string —\n359\t\t\t\t\t\t// clearAssignee only writes previous_assignee when current assignee is non-empty.\n360\t\t\t\t\t\tExpect(fm[\"previous_assignee\"]).To(Equal(\"pr-reviewer-agent\"))\n361\t\t\t\t\t\tExpect(fm[\"verdict\"]).To(Equal(\"fail\"))\n362\t\t\t\t\t\tcontent, err := os.ReadFile(taskFile) // #nosec G304 -- test helper\n363\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n364\t\t\t\t\t\tExpect(string(content)).To(ContainSubstring(\"## Verdict\"))\n365\t\t\t\t\t\tExpect(string(content)).To(ContainSubstring(\"## Result\"))\n366\t\t\t\t\t},\n367\t\t\t\t)\n368\t\t\t})\n369\t\n370\t\t\tContext(\n371\t\t\t\t\"spec 042: prod incident reproducer (phase: human_review + Body Verdict section)\",\n372\t\t\t\tfunc() {\n373\t\t\t\t\tIt(\n374\t\t\t\t\t\t\"clears assignee, captures previous_assignee, and appends the ## Verdict body section in a single atomic write\",\n375\t\t\t\t\t\tfunc() {\n376\t\t\t\t\t\t\ttaskFile := writeTaskFile(\n377\t\t\t\t\t\t\t\t\"task.md\",\n378\t\t\t\t\t\t\t\t\"---\\ntask_identifier: spec-042-incident-uuid\\nstatus: in_progress\\nphase: planning\\nassignee: pr-reviewer-agent\\ncurrent_job: pr-reviewer-agent-e323cc47\\n---\\nbody\\n\",\n379\t\t\t\t\t\t\t)\n380\t\t\t\t\t\t\tverdictSection := \"## Verdict\\n\\n- **Verdict:** fail\\n- **Reason:** hallucination detected in PR diff\\n\"\n381\t\t\t\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n382\t\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"spec-042-incident-uuid\"),\n383\t\t\t\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n384\t\t\t\t\t\t\t\t\t\"phase\": \"human_review\",\n385\t\t\t\t\t\t\t\t},\n386\t\t\t\t\t\t\t\tBody: &task.BodySection{\n387\t\t\t\t\t\t\t\t\tHeading: \"## Verdict\",\n388\t\t\t\t\t\t\t\t\tSection: verdictSection,\n389\t\t\t\t\t\t\t\t},\n390\t\t\t\t\t\t\t})\n391\t\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n392\t\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n393\t\n394\t\t\t\t\t\t\tfm := parseFrontmatter(taskFile)\n395\t\t\t\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"human_review\"))\n396\t\t\t\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"\"))\n397\t\t\t\t\t\t\tExpect(fm[\"previous_assignee\"]).To(Equal(\"pr-reviewer-agent\"))\n398\t\n399\t\t\t\t\t\t\tcontent, err := os.ReadFile(taskFile) // #nosec G304 -- test helper\n400\t\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n401\t\t\t\t\t\t\tbody := string(content)\n402\t\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"## Verdict\"))\n403\t\t\t\t\t\t\tExpect(body).To(ContainSubstring(\"hallucination detected\"))\n404\t\t\t\t\t\t},\n405\t\t\t\t\t)\n406\t\t\t\t},\n407\t\t\t)\n408\t\t})\n409\t})\n410\t"}]},"parent_tool_use_id":null,"session_id":"4d516ec6-9c37-415d-ba1d-85d6d6e1eaa0","uuid":"570b79fc-791b-499a-beca-d7bc097fc35e","timestamp":"2026-09-03T17:45:49.304Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/command/task_update_frontmatter_executor_test.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage command_test\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\tlib \"github.com/bborbe/agent\"\n\ttask \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/cqrs/cdb\"\n\t. \"github.com/onsi/ginkgo/v2\"\n\t. \"github.com/onsi/gomega\"\n\t\"gopkg.in/yaml.v3\"\n\n\t\"github.com/bborbe/agent-task-controller/mocks\"\n\t\"github.com/bborbe/agent-task-controller/pkg/command\"\n\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n)\n\nvar _ = Describe(\"NewUpdateFrontmatterExecutor\", func() {\n\tvar (\n\t\tctx      context.Context\n\t\ttmpDir   string\n\t\ttaskDir  string\n\t\tfakeGit  *mocks.GitClient\n\t\texecutor cdb.CommandObjectExecutorTx\n\t\tschemaID cdb.SchemaID\n\t)\n\n\tBeforeEach(func() {\n\t\tctx = context.Background()\n\t\tvar err error\n\t\ttmpDir, err = os.MkdirTemp(\"\", \"update-fm-test-*\")\n\t\tExpect(err).NotTo(HaveOccurred())\n\n\t\ttaskDir = \"tasks\"\n\t\tExpect(os.MkdirAll(filepath.Join(tmpDir, taskDir), 0750)).To(Succeed())\n\n\t\tfakeGit = &mocks.GitClient{}\n\t\tfakeGit.PathReturns(tmpDir)\n\t\tfakeGit.ListFilesStub = func(_ context.Context, glob string) ([]string, error) {\n\t\t\tmatches, err := filepath.Glob(filepath.Join(tmpDir, glob))\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tvar rel []string\n\t\t\tfor _, m := range matches {\n\t\t\t\tr, _ := filepath.Rel(tmpDir, m)\n\t\t\t\trel = append(rel, r)\n\t\t\t}\n\t\t\treturn rel, nil\n\t\t}\n\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n\t\t\treturn os.ReadFile(filepath.Join(tmpDir, relPath)) // #nosec G304 -- test helper\n\t\t}\n\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n\t\t\tctx context.Context,\n\t\t\tabsPath string,\n\t\t\tmodify func([]byte) ([]byte, error),\n\t\t\tmessage string,\n\t\t) error {\n\t\t\tcurrent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tupdated, err := modify(current)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn os.WriteFile(absPath, updated, 0600) // #nosec G306 -- test helper\n\t\t}\n\n\t\texecutor = command.NewUpdateFrontmatterExecutor(fakeGit, taskDir, metrics.New())\n\t\tschemaID = cdb.SchemaID{Group: \"agent\", Kind: \"task\", Version: \"v1\"}\n\t})\n\n\tAfterEach(func() {\n\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n\t})\n\n\twriteTaskFile := func(name, content string) string {\n\t\tabsPath := filepath.Join(tmpDir, taskDir, name)\n\t\tExpect(os.WriteFile(absPath, []byte(content), 0600)).To(Succeed())\n\t\treturn absPath\n\t}\n\n\tparseFrontmatter := func(absPath string) map[string]interface{} {\n\t\tcontent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n\t\tExpect(err).NotTo(HaveOccurred())\n\t\ts := string(content)\n\t\tExpect(s).To(HavePrefix(\"---\\n\"))\n\t\trest := s[4:]\n\t\tbefore, _, found := strings.Cut(rest, \"\\n---\\n\")\n\t\tExpect(found).To(BeTrue())\n\t\tvar fm map[string]interface{}\n\t\tExpect(yaml.Unmarshal([]byte(before), &fm)).To(Succeed())\n\t\treturn fm\n\t}\n\n\tbuildCmdObj := func(cmd task.UpdateFrontmatterCommand) cdb.CommandObject {\n\t\tevent, err := base.ParseEvent(ctx, cmd)\n\t\tExpect(err).NotTo(HaveOccurred())\n\t\treturn cdb.CommandObject{\n\t\t\tCommand: base.Command{\n\t\t\t\tRequestID: base.NewRequestID(),\n\t\t\t\tOperation: command.UpdateFrontmatterCommandOperation,\n\t\t\t\tInitiator: \"test\",\n\t\t\t\tData:      event,\n\t\t\t},\n\t\t\tSchemaID: schemaID,\n\t\t}\n\t}\n\n\tDescribe(\"CommandOperation\", func() {\n\t\tIt(\"returns update-frontmatter\", func() {\n\t\t\tExpect(\n\t\t\t\texecutor.CommandOperation(),\n\t\t\t).To(Equal(base.CommandOperation(\"update-frontmatter\")))\n\t\t})\n\t})\n\n\tDescribe(\"HandleCommand\", func() {\n\t\tContext(\"only named keys change\", func() {\n\t\t\tIt(\"updates only the specified key and leaves others unchanged\", func() {\n\t\t\t\ttaskFile := writeTaskFile(\n\t\t\t\t\t\"task.md\",\n\t\t\t\t\t\"---\\ntask_identifier: update-test-uuid\\nstatus: in_progress\\nphase: ai_review\\nassignee: claude\\n---\\nbody\\n\",\n\t\t\t\t)\n\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"update-test-uuid\"),\n\t\t\t\t\tUpdates: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"phase\": \"done\",\n\t\t\t\t\t},\n\t\t\t\t})\n\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmd)\n\t\t\t\tExpect(err).NotTo(HaveOccurred())\n\t\t\t\tfm := parseFrontmatter(taskFile)\n\t\t\t\tExpect(fm[\"phase\"]).To(Equal(\"done\"))\n\t\t\t\tExpect(fm[\"status\"]).To(Equal(\"in_progress\"))\n\t\t\t\tExpect(fm[\"assignee\"]).To(Equal(\"claude\"))\n\t\t\t})\n\t\t})\n\n\t\tContext(\"empty updates\", func() {\n\t\t\tIt(\"returns nil without writing when Updates is nil\", func() {\n\t\t\t\twriteTaskFile(\n\t\t\t\t\t\"task.md\",\n\t\t\t\t\t\"---\\ntask_identifier: noop-uuid\\nstatus: open\\n---\\nbody\\n\",\n\t\t\t\t)\n\t\t\t\tcmd := buildCmdObj(task.UpdateFrontmatterCommand{\n\t\t\t\t\tTas