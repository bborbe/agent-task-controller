ry_sha\"] = cmd.RecoverySHA\n\t\t}\n\t\tclosedBody := body\n\t\tif strings.TrimSpace(closedBody) != \"\" && !strings.HasSuffix(closedBody, \"\\n\") {\n\t\t\tclosedBody += \"\\n\"\n\t\t}\n\t\tclosedBody += \"\\n## Resolution\\n\\n\"\n\t\tclosedBody += \"- **Verdict:** green — build recovered; original failure no longer reproduces\\n\"\n\t\tif cmd.RecoverySHA != \"\" {\n\t\t\tclosedBody += \"- **Recovery SHA:** `\" + cmd.RecoverySHA + \"` (default-branch HEAD at close time)\\n\"\n\t\t}\n\t\tclosedBody += \"- **Closed at:** \" + ts + \" (by `complete-task`)\\n\"\n\t\treturn marshalFileContent(ctx, fm, closedBody)\n\t}\n}\n\n// hasResolutionSection reports whether the task body already carries a # Resolution\n// block (idempotency guard — never append a second one).\nfunc hasResolutionSection(body string) bool {\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif trimmed == \"# Resolution\" || trimmed == \"## Resolution\" {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc shortSHA(sha string) string {\n\tif len(sha) > 7 {\n\t\treturn sha[:7]\n\t}\n\treturn sha\n}\n","structuredPatch":[{"oldStart":127,"oldLines":6,"newStart":127,"newLines":7,"lines":["   ctx context.Context,","   cmd task.CompleteCommand,","   ts string,","+  vaultName string,"," ) func([]byte) ([]byte, error) {","   return func(current []byte) ([]byte, error) {","     fmStr, err := result.ExtractFrontmatter(ctx, current)"]},{"oldStart":155,"oldLines":6,"newStart":156,"newLines":9,"lines":["     if cmd.RecoverySHA != \"\" {","       fm[\"recovery_sha\"] = cmd.RecoverySHA","     }","+    // Heal-on-write: stamp target_vault on legacy files lacking it so the","+    // non-owning controller permanently stops falling through.","+    result.HealTargetVault(fm, vaultName)","     closedBody := body","     if strings.TrimSpace(closedBody) != \"\" && !strings.HasSuffix(closedBody, \"\\n\") {","       closedBody += \"\\n\""]}],"userModified":false,"replac