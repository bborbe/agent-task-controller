t\tIt(\"previous_assignee round-trips through YAML on a parked task\", func() {\n1436\t\t\t\t\twriteTaskFile(\n1437\t\t\t\t\t\t\"my-task.md\",\n1438\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: ai_review\\ntrigger_count: 3\\nmax_triggers: 3\\nassignee: claude\\n---\\n## Result\\nStatus: failed\\n\",\n1439\t\t\t\t\t)\n1440\t\t\t\t\ttaskFile = lib.Task{\n1441\t\t\t\t\t\tTaskIdentifier: identifier,\n1442\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1443\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1444\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n1445\t\t\t\t\t\t\t\"phase\":           \"ai_review\",\n1446\t\t\t\t\t\t\t\"trigger_count\":   3,\n1447\t\t\t\t\t\t\t\"max_triggers\":    3,\n1448\t\t\t\t\t\t\t\"assignee\":        \"claude\",\n1449\t\t\t\t\t\t},\n1450\t\t\t\t\t\tContent: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n1451\t\t\t\t\t}\n1452\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n1453\t\n1454\t\t\t\t\twritten, err := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n1455\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1456\t\n1457\t\t\t\t\t// Parse the written file's frontmatter back into a map and assert the key\n1458\t\t\t\t\t// exists with the expected value. This exercises the YAML marshal+unmarshal\n1459\t\t\t\t\t// boundary, not just substring presence in the bytes.\n1460\t\t\t\t\tfm, fmErr := extractTestFrontmatter(string(written))\n1461\t\t\t\t\tExpect(fmErr).NotTo(HaveOccurred())\n1462\t\t\t\t\tExpect(fm[\"previous_assignee\"]).To(Equal(\"claude\"))\n1463\t\t\t\t})\n1464\t\n1465\t\t\t\tIt(\n1466\t\t\t\t\t\"preserves assignee and does not escalate when max_triggers is absent (recurring task)\",\n1467\t\t\t\t\tfunc() {\n1468\t\t\t\t\t\t// trigger_count 5 would trip the lib default-3 cap; absent max_triggers\n1469\t\t\t\t\t\t// means no cap, so the routing assignee survives and no escalation section\n1470\t\t\t\t\t\t// is appended (the production incident: Daily Sentry Triage assignee strip).\n1471\t\t\t\t\t\twriteTaskFile(\n1472\t\t\t\t\t\t\t\"my-task.md\",\n1473\t\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: planning\\ntrigger_count: 5\\nassignee: sentry-collector-agent\\n---\\n## Result\\nStatus: failed\\n\",\n1474\t\t\t\t\t\t)\n1475\t\t\t\t\t\ttaskFile = lib.Task{\n1476\t\t\t\t\t\t\tTaskIdentifier: identifier,\n1477\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1478\t\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1479\t\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n1480\t\t\t\t\t\t\t\t\"phase\":           \"planning\",\n1481\t\t\t\t\t\t\t\t\"trigger_count\":   5,\n1482\t\t\t\t\t\t\t\t\"assignee\":        \"sentry-collector-agent\",\n1483\t\t\t\t\t\t\t},\n1484\t\t\t\t\t\t\tContent: lib.TaskContent(\"## Result\\nStatus: failed\\n\"),\n1485\t\t\t\t\t\t}\n1486\t\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n1487\t\t\t\t\t\twritten, _ := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n1488\t\t\t\t\t\ts := string(written)\n1489\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"## Trigger Cap Escalation\"))\n1490\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"assignee: sentry-collector-agent\"))\n1491\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"previous_assignee:\"))\n1492\t\t\t\t\t},\n1493\t\t\t\t)\n1494\t\t\t})\n1495\t\n1496\t\t\tContext(\"interleaved partial update between read and write (race-fix regression)\", func() {\n1497\t\t\t\tIt(\n1498\t\t\t\t\t\"preserves a partial frontmatter update that landed between read and modify\",\n1499\t\t\t\t\tfunc() {\n1500\t\t\t\t\t\t// Initial on-disk state: task in_progress, healthcheck-style probe.\n1501\t\t\t\t\t\twriteTaskFile(\n1502\t\t\t\t\t\t\t\"probe-task.md\",\n1503\t\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: planning\\nassignee: claude\\ntrigger_count: 1\\n---\\nProbe body\\n\",\n1504\t\t\t\t\t\t)\n1505\t\n1506\t\t\t\t\t\t// Override the BeforeEach stub for this test: simulate a partial\n1507\t\t\t\t\t\t// update from task_update_frontmatter_executor landing on disk\n1508\t\t\t\t\t\t// BETWEEN the moment AtomicReadModifyWriteAndCommitPush would\n1509\t\t\t\t\t\t// fetch current bytes and the moment modify is invoked. We do\n1510\t\t\t\t\t\t// this by mutating the file inside the stub, before calling\n1511\t\t\t\t\t\t// modify with the freshly-re-read bytes. This is exactly what\n1512\t\t\t\t\t\t// git-rest does on a CAS retry: it re-reads from disk on each\n1513\t\t\t\t\t\t// attempt, so modify sees the interleaved write.\n1514\t\t\t\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n1515\t\t\t\t\t\t\tctx context.Context,\n1516\t\t\t\t\t\t\tabsPath string,\n1517\t\t\t\t\t\t\tmodify func([]byte) ([]byte, error),\n1518\t\t\t\t\t\t\tmessage string,\n1519\t\t\t\t\t\t) error {\n1520\t\t\t\t\t\t\t// Simulate the interleaved partial update: another writer\n1521\t\t\t\t\t\t\t// (the executor) added spawn_notification: true and bumped\n1522\t\t\t\t\t\t\t// trigger_count to 2 between our initial read and the modify\n1523\t\t\t\t\t\t\t// call.\n1524\t\t\t\t\t\t\tinterleaved := \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: planning\\nassignee: claude\\ntrigger_count: 2\\nspawn_notification: true\\n---\\nProbe body\\n\"\n1525\t\t\t\t\t\t\tif err := os.WriteFile(absPath, []byte(interleaved), 0600); err != nil { // #nosec G306 -- test helper\n1526\t\t\t\t\t\t\t\treturn err\n1527\t\t\t\t\t\t\t}\n1528\t\t\t\t\t\t\tcurrent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n1529\t\t\t\t\t\t\tif err != nil {\n1530\t\t\t\t\t\t\t\treturn err\n1531\t\t\t\t\t\t\t}\n1532\t\t\t\t\t\t\tupdated, err := modify(current)\n1533\t\t\t\t\t\t\tif err != nil {\n1534\t\t\t\t\t\t\t\treturn err\n1535\t\t\t\t\t\t\t}\n1536\t\t\t\t\t\t\treturn os.WriteFile(absPath, updated, 0600) // #nosec G306 -- test helper\n1537\t\t\t\t\t\t}\n1538\t\n1539\t\t\t\t\t\t// Agent publishes terminal completion: status: completed, phase: done.\n1540\t\t\t\t\t\ttaskFile = lib.Task{\n1541\t\t\t\t\t\t\tTaskIdentifier: identifier,\n1542\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1543\t\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1544\t\t\t\t\t\t\t\t\"status\":          \"completed\",\n1545\t\t\t\t\t\t\t\t\"phase\":           \"done\",\n1546\t\t\t\t\t\t\t},\n1547\t\t\t\t\t\t\tContent: lib.TaskContent(\"Probe completed successfully.\\n\"),\n1548\t\t\t\t\t\t}\n1549\t\n1550\t\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n1551\t\n1552\t\t\t\t\t\twritten, readErr := os.ReadFile(\n1553\t\t\t\t\t\t\tfilepath.Join(tmpDir, taskDir, \"probe-task.md\"),\n1554\t\t\t\t\t\t)\n1555\t\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n1556\t\t\t\t\t\ts := string(written)\n1557\t\n1558\t\t\t\t\t\t// 1. Agent's terminal status wins over the stale-disk in_progress.\n1559\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n1560\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n1561\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"status: in_progress\"))\n1562\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"phase: planning\"))\n1563\t\n1564\t\t\t\t\t\t// 2. The interleaved partial update's trigger_count: 2 is preserved\n1565\t\t\t\t\t\t//    (because modifyFn re-reads fresh disk content; the stale\n1566\t\t\t\t\t\t//    snapshot from FindTaskFilePath would have written trigger_count: 1\n1567\t\t\t\t\t\t//    and dropped the bump). This is the load-bearing assertion that\n1568\t\t\t\t\t\t//    proves the race is fixed.\n1569\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"trigger_count: 2\"))\n1570\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"trigger_count: 1\"))\n1571\t\n1572\t\t\t\t\t\t// 3. New body fully replaces old body (WriteResult semantics).\n1573\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"Probe completed successfully.\"))\n1574\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"Probe body\"))\n1575\t\n1576\t\t\t\t\t\t// 4. Exactly one AtomicReadModifyWriteAndCommitPush call.\n1577\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1578\t\n1579\t\t\t\t\t\t// Note: do NOT assert against spawn_notification here.\n1580\t\t\t\t\t\t// applyRetryCounter early-returns when merged.Status() == \"completed\"\n1581\t\t\t\t\t\t// (result_writer.go:151-153) BEFORE the spawn_notification delete\n1582\t\t\t\t\t\t// path at line 183, so the on-disk spawn_notification: true is\n1583\t\t\t\t\t\t// preserved verbatim through the merge. That's a property of the\n1584\t\t\t\t\t\t// existing helper, not part of the race fix this test proves.\n1585\t\t\t\t\t},\n1586\t\t\t\t)\n1587\t\t\t})\n1588\t\n1589\t\t\tContext(\"atomic write and push error\", func() {\n1590\t\t\t\tIt(\"returns error when AtomicWriteAndCommitPush fails\", func() {\n1591\t\t\t\t\twriteTaskFile(\n1592\t\t\t\t\t\t\"my-task.md\",\n1593\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: open\\n---\\nOld content\\n\",\n1594\t\t\t\t\t)\n1595\t\t\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n1596\t\t\t\t\t\tctx context.Context,\n1597\t\t\t\t\t\tabsPath string,\n1598\t\t\t\t\t\tmodify func([]byte) ([]byte, error),\n1599\t\t\t\t\t\tmessage string,\n1600\t\t\t\t\t) error {\n1601\t\t\t\t\t\treturn errTest\n1602\t\t\t\t\t}\n1603\t\n1604\t\t\t\t\ttaskFile = lib.Task{\n1605\t\t\t\t\t\tTaskIdentifier: identifier,\n1606\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1607\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1608\t\t\t\t\t\t\t\"status\":          \"done\",\n1609\t\t\t\t\t\t},\n1610\t\t\t\t\t\tContent: lib.TaskContent(\"Result\\n\"),\n1611\t\t\t\t\t}\n1612\t\n1613\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n1614\t\t\t\t\tExpect(err).To(HaveOccurred())\n1615\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1616\t\t\t\t})\n1617\t\t\t})\n1618\t\n1619\t\t\tContext(\"Review section preservation\", func() {\n1620\t\t\t\t// PIt: test documents the known bug — ## Review content is currently stripped.\n1621\t\t\t\t// Remove the P prefix once WriteResult is updated to preserve existing ## Review sections.\n1622\t\t\t\tPIt(\"preserves prior ## Review content when writing a new result\", func() {\n1623\t\t\t\t\twriteTaskFile(\n1624\t\t\t\t\t\t\"my-task.md\",\n1625\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nassignee: claude\\n---\\n# Body\\n## Review\\nPrior review content\\n\",\n1626\t\t\t\t\t)\n1627\t\n1628\t\t\t\t\ttaskFile = lib.Task{\n1629\t\t\t\t\t\tTaskIdentifier: identifier,\n1630\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1631\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1632\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n1633\t\t\t\t\t\t\t\"phase\":           \"ai_review\",\n1634\t\t\t\t\t\t},\n1635\t\t\t\t\t\tContent: lib.TaskContent(\"# Body\\n\\n## Review\\nNew review content\\n\"),\n1636\t\t\t\t\t}\n1637\t\n1638\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n1639\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1640\t\n1641\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1642\t\t\t\t\t// Read the actual file the stub wrote.\n1643\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n1644\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n1645\t\t\t\t\ts := string(written)\n1646\t\t\t\t\t// Either the prior review survives in-place, OR it survives under an\n1647\t\t\t\t\t// \"## Outdated by force-push\" marker. NEVER stripped silently.\n1648\t\t\t\t\tExpect(s).To(SatisfyAny(\n1649\t\t\t\t\t\tContainSubstring(\"Prior review content\"),\n1650\t\t\t\t\t\tContainSubstring(\"## Outdated by\"),\n1651\t\t\t\t\t))\n1652\t\t\t\t})\n1653\t\t\t})\n1654\t\t})\n1655\t\n1656\t\tDescribe(\"FindTaskFilePath\", func() {\n1657\t\t\tIt(\"calls gitClient.ListFiles + ReadFile with the expected glob and matched paths\", func() {\n1658\t\t\t\tfakeGC := &mocks.GitClient{}\n1659\t\t\t\tfakeGC.ListFilesReturns([]string{\"tasks/a.md\", \"tasks/b.md\"}, nil)\n1660\t\t\t\tfakeGC.ReadFileReturnsOnCall(0, []byte(\"---\\ntask_identifier: foo\\n---\\n\"), nil)\n1661\t\t\t\tfakeGC.ReadFileReturnsOnCall(1, []byte(\"---\\ntask_identifier: bar\\n---\\n\"), nil)\n1662\t\n1663\t\t\t\tmatchedRelPath, _, err := result.FindTaskFilePath(ctx, fakeGC, \"tasks\", \"bar\")\n1664\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1665\t\t\t\tExpect(matchedRelPath).To(Equal(\"tasks/b.md\"))\n1666\t\t\t\tExpect(fakeGC.ListFilesCallCount()).To(Equal(1))\n1667\t\t\t\t_, glob := fakeGC.ListFilesArgsForCall(0)\n1668\t\t\t\tExpect(glob).To(Equal(\"tasks/*.md\"))\n1669\t\t\t\tExpect(fakeGC.ReadFileCallCount()).To(BeNumerically(\">=\", 1))\n1670\t\t\t})\n1671\t\n1672\t\t\tIt(\"returns empty path when no file matches\", func() {\n1673\t\t\t\tfakeGC := &mocks.GitClient{}\n1674\t\t\t\tfakeGC.ListFilesReturns([]string{\"tasks/a.md\"}, nil)\n1675\t\t\t\tfakeGC.ReadFileReturnsOnCall(0, []byte(\"---\\ntask_identifier: other\\n---\\n\"), nil)\n1676\t\n1677\t\t\t\tmatchedRelPath, fm, err := result.FindTaskFilePath(ctx, fakeGC, \"tasks\", \"missing\")\n1678\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1679\t\t\t\tExpect(matchedRelPath).To(Equal(\"\"))\n1680\t\t\t\tExpect(fm).To(BeNil())\n1681\t\t\t})\n1682\t\n1683\t\t\tIt(\"skips files that fail to read\", func() {\n1684\t\t\t\tfakeGC := &mocks.GitClient{}\n1685\t\t\t\tfakeGC.ListFilesReturns([]string{\"tasks/bad.md\", \"tasks/good.md\"}, nil)\n1686\t\t\t\tfakeGC.ReadFileReturnsOnCall(0, nil, errTest)\n1687\t\t\t\tfakeGC.ReadFileReturnsOnCall(1, []byte(\"---\\ntask_identifier: target\\n---\\n\"), nil)\n1688\t\n1689\t\t\t\tmatchedRelPath, _, err := result.FindTaskFilePath(ctx, fakeGC, \"tasks\", \"target\")\n1690\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1691\t\t\t\tExpect(matchedRelPath).To(Equal(\"tasks/good.md\"))\n1692\t\t\t})\n1693\t\n1694\t\t\tIt(\"skips files with invalid frontmatter\", func() {\n1695\t\t\t\tfakeGC := &mocks.GitClient{}\n1696\t\t\t\tfakeGC.ListFilesReturns([]string{\"tasks/bad.md\", \"tasks/good.md\"}, nil)\n1697\t\t\t\tfakeGC.ReadFileReturnsOnCall(0, []byte(\"no frontmatter here\"), nil)\n1698\t\t\t\tfakeGC.ReadFileReturnsOnCall(1, []byte(\"---\\ntask_identifier: target\\n---\\n\"), nil)\n1699\t\n1700\t\t\t\tmatchedRelPath, _, err := result.FindTaskFilePath(ctx, fakeGC, \"tasks\", \"target\")\n1701\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1702\t\t\t\tExpect(matchedRelPath).To(Equal(\"tasks/good.md\"))\n1703\t\t\t})\n1704\t\n1705\t\t\tIt(\"returns error when ListFiles fails\", func() {\n1706\t\t\t\tfakeGC := &mocks.GitClient{}\n1707\t\t\t\tfakeGC.ListFilesReturns(nil, errTest)\n1708\t\n1709\t\t\t\t_, _, err := result.FindTaskFilePath(ctx, fakeGC, \"tasks\", \"any\")\n1710\t\t\t\tExpect(err).To(HaveOccurred())\n1711\t\t\t})\n1712\t\t})\n1713\t\n1714\t\tDescribe(\"ExtractBody\", func() {\n1715\t\t\tIt(\"returns body after frontmatter delimiter\", func() {\n1716\t\t\t\tcontent := []byte(\"---\\nkey: value\\n---\\nbody content here\\n\")\n1717\t\t\t\tbody, err := result.ExtractBody(ctx, content)\n1718\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1719\t\t\t\tExpect(body).To(Equal(\"body content here\\n\"))\n1720\t\t\t})\n1721\t\n1722\t\t\tIt(\"returns empty string when body is empty\", func() {\n1723\t\t\t\tcontent := []byte(\"---\\nkey: value\\n---\\n\")\n1724\t\t\t\tbody, err := result.ExtractBody(ctx, content)\n1725\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1726\t\t\t\tExpect(body).To(Equal(\"\"))\n1727\t\t\t})\n1728\t\n1729\t\t\tIt(\"returns error when no frontmatter delimiter\", func() {\n1730\t\t\t\tcontent := []byte(\"no delimiter here\")\n1731\t\t\t\t_, err := result.ExtractBody(ctx, content)\n1732\t\t\t\tExpect(err).To(HaveOccurred())\n1733\t\t\t})\n1734\t\n1735\t\t\tIt(\"returns error when frontmatter is not closed\", func() {\n1736\t\t\t\tcontent := []byte(\"---\\nkey: value\\n\")\n1737\t\t\t\t_, err := result.ExtractBody(ctx, content)\n1738\t\t\t\tExpect(err).To(HaveOccurred())\n1739\t\t\t})\n1740\