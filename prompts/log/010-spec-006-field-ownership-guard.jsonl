{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a141cfef63650b2f","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage result_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"errors\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\tlibtime \"github.com/bborbe/time\"\n17\t\tlibtimemocks \"github.com/bborbe/time/mocks\"\n18\t\t. \"github.com/onsi/ginkgo/v2\"\n19\t\t. \"github.com/onsi/gomega\"\n20\t\t\"gopkg.in/yaml.v3\"\n21\t\n22\t\t\"github.com/bborbe/agent-task-controller/mocks\"\n23\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n24\t\t\"github.com/bborbe/agent-task-controller/pkg/result\"\n25\t)\n26\t\n27\tvar errTest = errors.New(\"test error\")\n28\t\n29\tfunc extractTestFrontmatter(content string) (map[string]interface{}, error) {\n30\t\tif !strings.HasPrefix(content, \"---\\n\") {\n31\t\t\treturn nil, errors.New(\"no frontmatter\")\n32\t\t}\n33\t\trest := content[4:]\n34\t\tbefore, _, found := strings.Cut(rest, \"\\n---\\n\")\n35\t\tif !found {\n36\t\t\treturn nil, errors.New(\"frontmatter not closed\")\n37\t\t}\n38\t\tvar fm map[string]interface{}\n39\t\tif err := yaml.Unmarshal([]byte(before), &fm); err != nil {\n40\t\t\treturn nil, err\n41\t\t}\n42\t\treturn fm, nil\n43\t}\n44\t\n45\tvar _ = Describe(\"ResultWriter\", func() {\n46\t\tvar (\n47\t\t\tctx        context.Context\n48\t\t\ttmpDir     string\n49\t\t\ttaskDir    string\n50\t\t\tfakeGit    *mocks.GitClient\n51\t\t\tfakeTime   *libtimemocks.CurrentDateTimeGetter\n52\t\t\twriter     result.ResultWriter\n53\t\t\ttaskFile   lib.Task\n54\t\t\tidentifier lib.TaskIdentifier\n55\t\t)\n56\t\n57\t\tBeforeEach(func() {\n58\t\t\tctx = context.Background()\n59\t\t\tvar err error\n60\t\t\ttmpDir, err = os.MkdirTemp(\"\", \"result-writer-test-*\")\n61\t\t\tExpect(err).NotTo(HaveOccurred())\n62\t\n63\t\t\ttaskDir = \"tasks\"\n64\t\t\tExpect(os.MkdirAll(filepath.Join(tmpDir, taskDir), 0750)).To(Succeed())\n65\t\n66\t\t\tfakeGit = &mocks.GitClient{}\n67\t\t\tfakeGit.PathReturns(tmpDir)\n68\t\t\tfakeGit.ListFilesStub = func(_ context.Context, glob string) ([]string, error) {\n69\t\t\t\tmatches, err := filepath.Glob(filepath.Join(tmpDir, glob))\n70\t\t\t\tif err != nil {\n71\t\t\t\t\treturn nil, err\n72\t\t\t\t}\n73\t\t\t\tvar rel []string\n74\t\t\t\tfor _, m := range matches {\n75\t\t\t\t\tr, _ := filepath.Rel(tmpDir, m)\n76\t\t\t\t\trel = append(rel, r)\n77\t\t\t\t}\n78\t\t\t\treturn rel, nil\n79\t\t\t}\n80\t\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n81\t\t\t\treturn os.ReadFile(filepath.Join(tmpDir, relPath)) // #nosec G304 -- test-only path\n82\t\t\t}\n83\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n84\t\t\t\tctx context.Context,\n85\t\t\t\tabsPath string,\n86\t\t\t\tmodify func([]byte) ([]byte, error),\n87\t\t\t\tmessage string,\n88\t\t\t) error {\n89\t\t\t\tcurrent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn err\n92\t\t\t\t}\n93\t\t\t\tupdated, err := modify(current)\n94\t\t\t\tif err != nil {\n95\t\t\t\t\treturn err\n96\t\t\t\t}\n97\t\t\t\treturn os.WriteFile(absPath, updated, 0600) // #nosec G306 -- test helper\n98\t\t\t}\n99\t\n100\t\t\tfakeTime = &libtimemocks.CurrentDateTimeGetter{}\n101\t\t\tfakeTime.NowReturns(libtime.DateTime(time.Date(2026, 4, 18, 12, 0, 0, 0, time.UTC)))\n102\t\n103\t\t\tidentifier = lib.TaskIdentifier(\"test-task-uuid-1234\")\n104\t\t\twriter = result.NewResultWriter(fakeGit, taskDir, fakeTime, metrics.New())\n105\t\t})\n106\t\n107\t\tAfterEach(func() {\n108\t\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n109\t\t})\n110\t\n111\t\twriteTaskFile := func(name, content string) string {\n112\t\t\tabsPath := filepath.Join(tmpDir, taskDir, name)\n113\t\t\tExpect(os.WriteFile(absPath, []byte(content), 0600)).To(Succeed())\n114\t\t\treturn absPath\n115\t\t}\n116\t\n117\t\tDescribe(\"WriteResult\", func() {\n118\t\t\tContext(\"normal write\", func() {\n119\t\t\t\tIt(\"writes frontmatter and content to the matched file\", func() {\n120\t\t\t\t\twriteTaskFile(\n121\t\t\t\t\t\t\"my-task.md\",\n122\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\nassignee: backtest-agent\\ntags:\\n  - agent-task\\n  - test\\n---\\nOld content\\n\",\n123\t\t\t\t\t)\n124\t\n125\t\t\t\t\ttaskFile = lib.Task{\n126\t\t\t\t\t\tTaskIdentifier: identifier,\n127\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n128\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n129\t\t\t\t\t\t\t\"status\":          \"done\",\n130\t\t\t\t\t\t\t\"phase\":           \"done\",\n131\t\t\t\t\t\t},\n132\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n133\t\t\t\t\t}\n134\t\n135\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n136\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n137\t\n138\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n139\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n140\t\t\t\t\tExpect(string(written)).To(HavePrefix(\"---\\n\"))\n141\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"status: done\"))\n142\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"phase: done\"))\n143\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"assignee: backtest-agent\"))\n144\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"agent-task\"))\n145\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"---\\nNew content\\n\"))\n146\t\n147\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n148\t\t\t\t\t_, _, _, msg := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(0)\n149\t\t\t\t\tExpect(msg).To(ContainSubstring(string(identifier)))\n150\t\t\t\t})\n151\t\t\t})\n152\t\n153\t\t\tContext(\"frontmatter merge\", func() {\n154