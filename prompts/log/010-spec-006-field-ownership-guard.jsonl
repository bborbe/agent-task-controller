{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b49082d6fcb0ae82","type":"tool_result","content":"370\t\n371\t// containsEscalationSection reports whether body already has the given\n372\t// escalation header on its own line. Used to prevent duplicate escalation\n373\t// sections when WriteResult runs multiple times on a task that is already\n374\t// at cap (e.g. agent publishes another result while the task sits in\n375\t// phase: human_review).\n376\tfunc containsEscalationSection(body, header string) bool {\n377\t\treturn strings.Contains(body, \"\\n\"+header+\"\\n\")\n378\t}\n379\t\n380\t// GuardDecision records a single ownership-guard discard: the merge kept the\n381\t// on-disk value of a controller-owned field (or the pinned terminal status) and\n382\t// rejected a differing incoming value. Equal values produce no decision.\n383\ttype GuardDecision struct {\n384\t\tField    string\n385\t\tKept     any\n386\t\tRejected any\n387\t}\n388\t\n389\t// MergeFrontmatter returns a new frontmatter map with all keys from existing,\n390\t// overridden by all keys from incoming, then applies the field-ownership guard:\n391\t// controller-owned counters take the on-disk value when present on disk and are\n392\t// absent from the result when not; a terminal on-disk status is pinned. The\n393\t// returned decisions name every field whose differing incoming value was discarded\n394\t// (equal values produce no decision). Neither input map is modified.\n395\tfunc MergeFrontmatter(existing, incoming lib.TaskFrontmatter) (lib.TaskFrontmatter, []GuardDecision) {\n396\t\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n397\t\tfor k, v := range existing {\n398\t\t\tmerged[k] = v\n399\t\t}\n400\t\tfor k, v := range incoming {\n401\t\t\tmerged[k] = v\n402\t\t}\n403\t\tvar decisions []GuardDecision\n404\t\n405\t\t// Controller-owned counters: the on-disk value always wins when the key exists\n406\t\t// on disk (kept verbatim, whatever its type); a key absent on disk stays absent\n407\t\t// even if the incoming payload carries it.\n408\t\tfor _, field := range controllerOwnedFields {\n409\t\t\tdiskValue, onDisk := existing[field]\n410\t\t\tincomingValue, inIncoming := incoming[field]\n411\t\t\tif !onDisk {\n412\t\t\t\tif inIncoming {\n413\t\t\t\t\tdelete(merged, field)\n414\t\t\t\t}\n415\t\t\t\tcontinue\n416\t\t\t}\n417\t\t\tmerged[field] = diskValue\n418\t\t\tif inIncoming && !frontmatterValueEqual(diskValue, incomingValue) {\n419\t\t\t\tdecisions = append(decisions, GuardDecision{Field: field, Kept: diskValue, Rejected: incomingValue})\n420\t\t\t}\n421\t\t}\n422\t\n423\t\t// Terminal on-disk status is pinned: the on-disk status value is kept and the\n424\t\t// incoming status is discarded. Terminal is decided by the normalizing Status()\n425\t\t// accessor compared against terminalStatuses, never by raw string equality on\n426\t\t// the unparsed value. The status decision is reported only when the normalized\n427\t\t// values differ (an incoming alias such as \"done\" against on-disk \"completed\"\n428\t\t// is normalized-equal and produces no decision).\n429\t\tif diskStatus, onDisk := existing[\"status\"]; onDisk && isTerminalStatus(existing.Status()) {\n430\t\t\tmerged[\"status\"] = diskStatus\n431\t\t\tif incomingStatus, ok := incoming[\"status\"]; ok && existing.Status() != incoming.Status() {\n432\t\t\t\tdecisions = append(decisions, GuardDecision{Field: \"status\", Kept: diskStatus, Rejected: incomingStatus})\n433\t\t\t}\n434\t\t}\n435\t\n436\t\treturn merged, decisions\n437\t}\n438\t\n439\tfunc isTerminalStatus(s domain.TaskStatus) bool {\n440\t\tfor _, t := range terminalStatuses {\n441\t\t\tif s == t {\n442\t\t\t\treturn true\n443\t\t\t}\n444\t\t}\n445\t\treturn false\n446\t}\n447\t\n448\t// frontmatterValueEqual reports whether two frontmatter values compare equal,\n449\t// treating numeric int/float64 pairs as equal so a JSON-decoded incoming counter\n450\t// (float64) equals a YAML-decoded on-disk counter (int) at steady state — equal\n451\t// counters must produce no guard log line (DB 6).\n452\tfunc frontmatterValueEqual(a, b any) bool {\n453\t\tif a == b {\n454\t\t\treturn true\n455\t\t}\n456\t\taf, aOK := numericValue(a)\n457\t\tbf, bOK := numericValue(b)\n458\t\treturn aOK && bOK && af == bf\n459\t}\n460\t\n461\tfunc numericValue(v any) (float64, bool) {\n462\t\tswitch n := v.(type) {\n463\t\tcase int:\n464\t\t\treturn float64(n), true\n465\t\tcase int64:\n466\t\t\treturn float64(n), true\n467\t\tcase float64:\n468\t\t\treturn n, true\n469\t\tdefault:"}]},"parent_tool_use_id":null,"session_id":"8a92895d-b4c6-4286-8455-0ddd186ab853","uuid":"794f6620-218c-447d-87d7-0a194c48f162","timestamp":"2026-08-31T12:24:29.910Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/result/result_writer.go","content":"\n// containsEscalationSection reports whether body already has the given\n// escalation header on its own line. Used to prevent duplicate escalation\n// sections when WriteResult runs multiple times on a task that is already\n// at cap (e.g. agent publishes another result while the task sits in\n// phase: human_review).\nfunc containsEscalationSection(body, header string) bool {\n\treturn strings.Contains(body, \"\\n\"+header+\"\\n\")\n}\n\n// GuardDecision records a single ownership-guard discard: the merge kept the\n// on-disk value of a controller-owned field (or the pinned terminal status) and\n// rejected a differing incoming value. Equal values produce no decision.\ntype GuardDecision struct {\n\tField    string\n\tKept     any\n\tRejected any\n}\n\n// MergeFrontmatter returns a new frontmatter map with all keys from existing,\n// overridden by all keys from incoming, then applies the field-ownership guard:\n// controller-owned counters take the on-disk value when present on disk and are\n// absent from the result when not; a terminal on-disk status is pinned. The\n// returned decisions name every field whose differing incoming value was discarded\n// (equal values produce no decision). Neither input map is modified.\nfunc MergeFrontmatter(existing, incoming lib.TaskFrontmatter) (lib.TaskFrontmatter, []GuardDecision) {\n\tmerged := make(lib.TaskFrontmatter, len(existing)+len(incoming))\n\tfor k, v := range existing {\n\t\tmerged[k] = v\n\t}\n\tfor k, v := range incoming {\n\t\tmerged[k] = v\n\t}\n\tvar decisions []GuardDecision\n\n\t// Controller-owned counters: the on-disk value always wins when the key exists\n\t// on disk (kept verbatim, whatever its type); a key absent on disk stays absent\n\t// even if the incoming payload carries it.\n\tfor _, field := range controllerOwnedFields {\n\t\tdiskValue, onDisk := existing[field]\n\t\tincomingValue, inIncoming := incoming[field]\n\t\tif !onDisk {\n\t\t\tif inIncoming {\n\t\t\t\tdelete(merged, field)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tmerged[field] = diskValue\n\t\tif inIncoming && !frontmatterValueEqual(diskValue, incomingValue) {\n\t\t\tdecisions = append(decisions, GuardDecision{Field: field, Kept: diskValue, Rejected: incomingValue})\n\t\t}\n\t}\n\n\t// Terminal on-disk status is pinned: the on-disk status value is kept and the\n\t// incoming status is discarded. Terminal is decided by the normalizing Status()\n\t// accessor compared against terminalStatuses, never by raw string equality on\n\t// the unparsed value. The status decision is reported only when the normalized\n\t// values differ (an incoming alias such as \"done\" against on-disk \"completed\"\n\t// is normalized-equal and produces no decision).\n\tif diskStatus, onDisk := existing[\"status\"]; onDisk && isTerminalStatus(existing.Status()) {\n\t\tmerged[\"status\"] = diskStatus\n\t\tif incomingStatus, ok := incoming[\"status\"]; ok && existing.Status() != incoming.Status() {\n\t\t\tdecisions = append(decisions, GuardDecision{Field: \"status\", Kept: diskStatus, Rejected: incomingStatus})\n\t\t}\n\t}\n\n\treturn merged, decisions\n}\n\nfunc isTerminalStatus(s domain.TaskStatus) bool {\n\tfor _, t := range terminalStatuses {\n\t\tif s == t {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// frontmatterValueEqual reports whether two frontmatter values compare equal,\n// treating numeric int/float64 pairs as equal so a JSON-decoded incoming counter\n// (float64) equals a YAML-decoded on-disk counter (int) at steady state — equal\n// counters must produce no guard log line (DB 6).\nfunc frontmatterValueEqual(a, b any) bool {\n\tif a == b {\n\t\treturn true\n\t}\n\taf, aOK := numericValue(a)\n\tbf, bOK := numericValue(b)\n\treturn aOK && bOK && af == bf\n}\n\nfunc numericValue(v any) (float64, bool) {\n\tswitch n := v.(type) {\n\tcase int:\n\t\treturn float64(n), true\n\tcase int64:\n\t\treturn float64(n), true\n\tcase float64:\n\t\treturn n, true\n\tdefault:","numLines":100,"startLine":370,"totalLines":515}}}
