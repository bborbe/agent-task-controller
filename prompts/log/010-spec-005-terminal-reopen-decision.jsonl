e slot is reusable. On a\n103\t// terminal-status free it returns reopened=true and the prior status so the\n104\t// caller can distinguish a reopen from a first-ever create. Every other\n105\t// occupied state — any non-terminal status, an absent/empty/unknown status,\n106\t// missing frontmatter delimiters, or unparseable YAML — returns\n107\t// ErrTaskAlreadyExists (a benign Failure on the result topic — no overwrite,\n108\t// no git write) wrapped with the \"title path %s occupied\" message shape. A\n109\t// transient git-rest read error is propagated. The decision consumes the\n110\t// bytes already read by this function; the caller must not issue a second\n111\t// ReadFile.\n112\tfunc checkTitlePathFree(\n113\t\tctx context.Context,\n114\t\tgitClient gitclient.GitClient,\n115\t\trelPath string,\n116\t\ttaskIdentifier lib.TaskIdentifier,\n117\t) (reopened bool, priorStatus string, err error) {\n118\t\texisting, err := gitClient.ReadFile(ctx, relPath)\n119\t\tif err != nil {\n120\t\t\tif !isNotFoundReadError(err) {\n121\t\t\t\treturn false, \"\", errors.Wrapf(\n122\t\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n123\t\t\t\t)\n124\t\t\t}\n125\t\t\t// git-rest 404: the title path is free, first-ever create.\n126\t\t\treturn false, \"\", nil\n127\t\t}\n128\t\tfrontmatterStr, parseErr := result.ExtractFrontmatter(ctx, existing)\n129\t\tif parseErr != nil {\n130\t\t\tglog.Warningf(\n131\t\t\t\t\"create-task: cannot read status from existing file at %s for %s; holding title path: %v\",\n132\t\t\t\trelPath, taskIdentifier, parseErr,\n133\t\t\t)\n134\t\t\treturn false, \"\", errors.Wrapf(ctx, task.ErrTaskAlreadyExists, \"title path %s occupied\", relPath)\n135\t\t}\n136\t\texistingFm, parseErr := parseTaskFrontmatter(frontmatterStr)\n137\t\tif parseErr != nil {\n138\t\t\tglog.Warningf(\n139\t\t\t\t\"create-task: cannot parse frontmatter of existing file at %s for %s; holding title path: %v\",\n140\t\t\t\trelPath, taskIdentifier, p