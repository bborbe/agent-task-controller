{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b7b2dea9cf3878e5","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"maps\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\tlib \"github.com/bborbe/agent\"\n15\t\ttask \"github.com/bborbe/agent/command/task\"\n16\t\t\"github.com/bborbe/cqrs/base\"\n17\t\t\"github.com/bborbe/cqrs/cdb\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibkv \"github.com/bborbe/kv\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/validation\"\n22\t\t\"github.com/golang/glog\"\n23\t\n24\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n25\t\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n27\t)\n28\t\n29\t// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n30\t// a new vault task file for the given task_identifier. If cmd.Title passes validation\n31\t// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n32\t// If a file already exists at the resolved path the command returns ErrTaskAlreadyExists\n33\t// (a benign Failure on the result topic — no overwrite, no git write).\n34\t// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n35\t// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n36\t// match vaultName are skipped without side effects (no git write, no error, no result event).\n37\tfunc NewCreateTaskExecutor(\n38\t\tgitClient gitclient.GitClient,\n39\t\ttaskDir string,\n40\t\tvaultName string,\n41\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n42\t\tk int,\n43\t) cdb.CommandObjectExecutorTx {\n44\t\treturn cdb.CommandObjectExecutorTxFunc(\n45\t\t\ttask.CreateCommandOperation,\n46\t\t\ttrue,\n47\t\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n48\t\t\t\tvar cmd task.CreateCommand\n49\t\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n50\t\t\t\t\treturn nil, nil, errors.Wrapf(\n51\t\t\t\t\t\tctx,\n52\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n53\t\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n54\t\t\t\t\t\terr,\n55\t\t\t\t\t)\n56\t\t\t\t}\n57\t\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n58\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n59\t\t\t\t}\n60\t\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n61\t\t\t\t\teffective := cmd.TargetVault\n62\t\t\t\t\tif effective == \"\" {\n63\t\t\t\t\t\teffective = routing.LegacyDefaultVault\n64\t\t\t\t\t}\n65\t\t\t\t\tglog.V(2).Infof(\n66\t\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n67\t\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n68\t\t\t\t\t)\n69\t\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n70\t\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n71\t\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n72\t\t\t\t\treturn nil, nil, errors.Wrapf(\n73\t\t\t\t\t\tctx,\n74\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n75\t\t\t\t\t\t\"cross-vault create for task %s\",\n76\t\t\t\t\t\tcmd.TaskIdentifier,\n77\t\t\t\t\t)\n78\t\t\t\t}\n79\t\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n80\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n81\t\t\t\t}\n82\t\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n83\t\t\t\tif err := checkTitlePathFree(ctx, gitClient, relPath, cmd.TaskIdentifier); err != nil {\n84\t\t\t\t\treturn nil, nil, err\n85\t\t\t\t}\n86\t\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName); err != nil {\n87\t\t\t\t\treturn nil, nil, err\n88\t\t\t\t}\n89\t\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n90\t\t\t\treturn nil, nil, nil\n91\t\t\t},\n92\t\t)\n93\t}\n94\t\n95\t// checkTitlePathFree returns ErrTaskAlreadyExists when the title path is\n96\t// already occupied (benign Failure on the result topic — no overwrite, no\n97\t// git write). A transient git-rest read error is propagated. A \"not found\"\n98\t// read error is swallowed (title path is free).\n99\tfunc checkTitlePathFree(\n100\t\tctx context.Context,\n101\t\tgitClient gitclient.GitClient,\n102\t\trelPath string,\n103\t\ttaskIdentifier lib.TaskIdentifier,\n104\t) error {\n105\t\texisting, err := gitClient.ReadFile(ctx, relPath)\n106\t\tif err == nil {\n107\t\t\tglog.V(2).Infof(\n108\t\t\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n109\t\t\t\trelPath,\n110\t\t\t\tlen(existing),\n111\t\t\t\ttaskIdentifier,\n112\t\t\t)\n113\t\t\treturn errors.Wrapf(\n114\t\t\t\tctx, task.ErrTaskAlreadyExists, \"title path %s occupied\", relPath,\n115\t\t\t)\n116\t\t}\n117\t\tif !isNotFoundReadError(err) {\n118\t\t\treturn errors.Wrapf(\n119\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n120\t\t\t)\n121\t\t}\n122\t\treturn nil\n123\t}\n124\t\n125\t// writeTaskFile builds the task content and writes it atomically to the vault\n126\t// via git-rest, then logs the creation. vaultName is stamped as target_vault so\n127\t// the created task is self-describing for the result-path routing guard.\n128\tfunc writeTaskFile(\n129\t\tctx context.Context,\n130\t\tgitClient gitclient.GitClient,\n131\t\trelPath string,\n132\t\tcmd task.CreateCommand,\n133\t\tvaultName string,\n134\t) error {\n135\t\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n136\t\tif err != nil {\n137\t\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n138\t\t}\n139\t\tabsPath := filepath.Join(gitClient.Path(), relPath)\n140\t\tif err := gitClient.AtomicWriteAndCommitPush(\n141\t\t\tctx,\n142\t\t\tabsPath,\n143\t\t\tcontent,\n144\t\t\t\"[agent-task-controller] create task \"+string(cmd.TaskIdentifier),\n145\t\t); err != nil {\n146\t\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n147\t\t}\n148\t\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n149\t\treturn nil\n150\t}\n151\t\n152\t// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n153\t// file should be written. If cmd.Title passes validation and contains no path\n154\t// separators, the title-derived path is returned; otherwise a WARN is logged and\n155\t// the UUID-derived path is returned as fallback so the task is always materialized.\n156\t// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n157\t// function no longer reads the vault or compares task_identifier.\n158\tfunc resolveCreateTaskRelPath(\n159\t\tctx context.Context,\n160\t\ttaskDir string,\n161\t\tcmd task.CreateCommand,\n162\t) string {\n163\t\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n164\t\n165\t\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n166\t\tif err := cmd.Validate(ctx); err != nil {\n167\t\t\tglog.Warningf(\n168\t\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n169\t\t\t\tcmd.TaskIdentifier, err,\n170\t\t\t)\n171\t\t\treturn uuidRelPath\n172\t\t}\n173\t\n174\t\t// Reject titles containing path separators to prevent path traversal.\n175\t\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n176\t\t\tglog.Warningf(\n177\t\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n178\t\t\t\tcmd.Title,\n179\t\t\t)\n180\t\t\treturn uuidRelPath\n181\t\t}\n182\t\n183\t\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n184\t}\n185\t\n186\t// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n187\t// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n188\t// typed not-found sentinel, so this matches the \"404\" status embedded in the\n189\t// wrapped error message produced by gitRestClient.Get\n190\t// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n191\t// be handled by the caller before calling this helper.\n192\tfunc isNotFoundReadError(err error) bool {\n193\t\tif err == nil {\n194\t\t\treturn false\n195\t\t}\n196\t\treturn strings.Contains(err.Error(), \"returned 404\")\n197\t}\n198\t\n199\t// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n200\t// unusable downstream.\n201\t//\n202\t// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n203\t// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n204\t// doctrine): escalation clears the assignee so no agent claims the task and a\n205\t// human picks it up. Requiring it here made a task that is *born* parked\n206\t// unrepresentable — github-pr-watcher's untrusted-author path stamps\n207\t// `assignee: \"\", phase: human_review` and every such command was rejected, so\n208\t// the PR silently never reached the operator queue (bborbe/git-sync#5,\n209\t// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n210\t// so accepting it at create matches how update and dispatch already behave.\n211\tfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n212\t\tif s, _ := fm.String(\"status\"); s == \"\" {\n213\t\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n214\t\t}\n215\t\treturn nil\n216\t}\n217\t\n218\tfunc buildCreateTaskContent(\n219\t\tctx context.Context,\n220\t\tcmd task.CreateCommand,\n221\t\tvaultName string,\n222\t) ([]byte, error) {\n223\t\tfm := make(lib.TaskFrontmatter)\n224\t\tmaps.Copy(fm, cmd.Frontmatter)\n225\t\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n226\t\tfm[\"target_vault\"] = vaultName\n227\t\treturn marshalFileContent(ctx, fm, cmd.Body)\n228\t}\n229\t\n230\t// supersedePriorRecurringTask collapses a recurring schedule to a single open\n231\t// instance: after a new instance is materialized it lists same-slug candidates,\n232\t// excludes the new instance, ranks them most-recent-first, and transitions every\n233\t// still-in_progress candidate whose period-token is strictly older than the new\n234\t// instance's token to aborted — capped at the k most-recent such candidates.\n235\t// Best-effort: list/read/parse/write errors on any single file are logged and\n236\t// swallowed; the already-written new instance is never rolled back. newRelPath is\n237\t// the repo-root-relative path of the new instance (the superseded_by back-pointer).\n238\tfunc supersedePriorRecurringTask(\n239\t\tctx context.Context,\n240\t\tgitClient gitclient.GitClient,\n241\t\ttaskDir string,\n242\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n243\t\tk int,\n244\t\tcmd task.CreateCommand,\n245\t\tnewRelPath string,\n246\t) {\n247\t\tif !isEligibleForSupersede(cmd) {\n248\t\t\treturn\n249\t\t}\n250\t\tslug, newToken, ok := splitTitleToken(cmd.Title)\n251\t\tif !ok {\n252\t\t\tglog.V(3).Infof(\n253\t\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n254\t\t\t\tcmd.Title, cmd.TaskIdentifier,\n255\t\t\t)\n256\t\t\treturn\n257\t\t}\n258\t\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n259\t\tif err != nil {\n260\t\t\tglog.Warningf(\n261\t\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n262\t\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n263\t\t\t)\n264\t\t\treturn\n265\t\t}\n266\t\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n267\t\tif err != nil {\n268\t\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n269\t\t\treturn\n270\t\t}\n271\t\t// Exclude the new instance and rank.\n272\t\tvar kept []string\n273\t\tfor _, t := range titles {\n274\t\t\tif err := ctx.Err(); err != nil {\n275\t\t\t\treturn\n276\t\t\t}\n277\t\t\tif t == cmd.Title {\n278\t\t\t\tcontinue\n279\t\t\t}\n280\t\t\tkept = append(kept, t)\n281\t\t}\n282\t\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n283\t\tcollapseCandidates(\n284\t\t\tctx,\n285\t\t\tgitClient,\n286\t\t\ttaskDir,\n287\t\t\tcurrentDateTime,\n288\t\t\tk,\n289\t\t\tranked,\n290\t\t\tnewOrdinal,\n291\t\t\tnewRelPath,\n292\t\t\tcmd,\n293\t\t)\n294\t}\n295\t\n296\t// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n297\t// returns their TITLES (basename without \".md\"), filtered to those whose title\n298\t// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n299\t// glob metacharacters; otherwise it lists all task files and filters in memory\n300\t// (glob-injection defense). List errors are returned; the caller logs them once.\n301\tfunc listSameSlugCandidateTitles(\n302\t\tctx context.Context,\n303\t\tgitClient gitclient.GitClient,\n304\t\ttaskDir string,\n305\t\tslug string,\n306\t) ([]string, error) {\n307\t\tprefix := slug + \" - \"\n308\t\tvar glob string\n309\t\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n310\t\t\tglob = filepath.Join(taskDir, \"*.md\")\n311\t\t\tglog.V(2).Infof(\n312\t\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n313\t\t\t\tslug,\n314\t\t\t)\n315\t\t} else {\n316\t\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n317\t\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n318\t\t}\n319\t\trelPaths, err := gitClient.ListFiles(ctx, glob)\n320\t\tif err != nil {\n321\t\t\treturn nil, err\n322\t\t}\n323\t\tvar titles []string\n324\t\tfor _, relPath := range relPaths {\n325\t\t\tif err := ctx.Err(); err != nil {\n326\t\t\t\treturn nil, err\n327\t\t\t}\n328\t\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n329\t\t\tif strings.HasPrefix(title, prefix) {\n330\t\t\t\ttitles = append(titles, title)\n331\t\t\t}\n332\t\t}\n333\t\treturn titles, nil\n334\t}\n335\t\n336\t// collapseCandidates iterates ranked candidates most-recent-first, transitions\n337\t// each still-in_progress candidate older than newOrdinal to aborted, and stops\n338\t// after k candidates have been inspected (read attempted). Best-effort per file.\n339\tfunc collapseCandidates(\n340\t\tctx context.Context,\n341\t\tgitClient gitclient.GitClient,\n342\t\ttaskDir string,\n343\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n344\t\tk int,\n345\t\tranked []rankedCandidate,\n346\t\tnewOrdinal int64,\n347\t\tnewRelPath string,\n348\t\tcmd task.CreateCommand,\n349\t) {\n350\t\tinspected := 0\n351\t\tfor _, rc := range ranked {\n352\t\t\tif err := ctx.Err(); err != nil {\n353\t\t\t\treturn\n354\t\t\t}\n355\t\t\tif inspected >= k {\n356\t\t\t\tbreak\n357\t\t\t}\n358\t\t\tif rc.Ordinal > newOrdinal {\n359\t\t\t\tcontinue\n360\t\t\t}\n361\t\t\tinspected++\n362\t\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n363\t\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n364\t\t\t\tglog.Warningf(\n365\t\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n366\t\t\t\t\trc.Title, cmd.TaskIdentifier,\n367\t\t\t\t)\n368\t\t\t\tcontinue\n369\t\t\t}\n370\t\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n371\t\t\tif err != nil || content == nil {\n372\t\t\t\tcontinue\n373\t\t\t}\n374\t\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n375\t\t\t\tcontinue\n376\t\t\t}\n377\t\t\ttransitionPrior(\n378\t\t\t\tctx,\n379\t\t\t\tgitClient,\n380\t\t\t\tcurrentDateTime,\n381\t\t\t\tcandidateRelPath,\n382\t\t\t\trc.Title,\n383\t\t\t\tnewRelPath,\n384\t\t\t\tcmd.TaskIdentifier,\n385\t\t\t)\n386\t\t}\n387\t}\n388\t\n389\t// isEligibleForSupersede reports whether cmd is a recurring-task instance\n390\t// that should auto-supersede its prior. Returns true only when created_by is\n391\t// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n392\t// Returns false (no supersede) when auto_abort_prior is absent or false — the\n393\t// safe default that prevents accidental supersede of audit-style tasks.\n394\tfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n395\t\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n396\t\tif createdBy != \"recurring-task-creator\" {\n397\t\t\tglog.V(3).\n398\t\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n399\t\t\treturn false\n400\t\t}\n401\t\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n402\t\t\treturn true\n403\t\t}\n404\t\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n405\t\t\treturn true\n406\t\t}\n407\t\tglog.V(3).\n408\t\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n409\t\treturn false\n410\t}\n411\t\n412\t// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n413\t// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n414\t// transient git-rest error (logged by caller).\n415\tfunc readPriorForSupersede(\n416\t\tctx context.Context,\n417\t\tgitClient gitclient.GitClient,\n418\t\tpriorRelPath string,\n419\t\ttaskIdentifier lib.TaskIdentifier,\n420\t) ([]byte, error) {\n421\t\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n422\t\tif err == nil {\n423\t\t\treturn content, nil\n424\t\t}\n425\t\tif isNotFoundReadError(err) {\n426\t\t\tglog.V(3).\n427\t\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n428\t\t\treturn nil, nil\n429\t\t}\n430\t\tglog.Warningf(\n431\t\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n432\t\t\tpriorRelPath,\n433\t\t\ttaskIdentifier,\n434\t\t\terr,\n435\t\t)\n436\t\treturn nil, err\n437\t}\n438\t\n439\t// priorIsInProgress parses the prior file's frontmatter and reports whether\n440\t// its status is in_progress. Returns false (no-op) on parse error or any\n441\t// non-in_progress status.\n442\tfunc priorIsInProgress(\n443\t\tctx context.Context,\n444\t\tcontent []byte,\n445\t\tpriorRelPath string,\n446\t\ttaskIdentifier lib.TaskIdentifier,\n447\t) bool {\n448\t\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n449\t\tif err != nil {\n450\t\t\tglog.Warningf(\n451\t\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n452\t\t\t\tpriorRelPath,\n453\t\t\t\ttaskIdentifier,\n454\t\t\t\terr,\n455\t\t\t)\n456\t\t\treturn false\n457\t\t}\n458\t\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n459\t\tif err != nil {\n460\t\t\tglog.Warningf(\n461\t\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n462\t\t\t\tpriorRelPath,\n463\t\t\t\ttaskIdentifier,\n464\t\t\t\terr,\n465\t\t\t)\n466\t\t\treturn false\n467\t\t}\n468\t\tstatus, _ := priorFm.String(\"status\")\n469\t\tif status != \"in_progress\" {\n470\t\t\tglog.V(3).\n471\t\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n472\t\t\treturn false\n473\t\t}\n474\t\treturn true\n475\t}\n476\t\n477\t// transitionPrior performs the read-modify-write that transitions the prior\n478\t// file to aborted. Best-effort: write errors are logged and swallowed.\n479\tfunc transitionPrior(\n480\t\tctx context.Context,\n481\t\tgitClient gitclient.GitClient,\n482\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n483\t\tpriorRelPath string,\n484\t\tpriorTitle string,\n485\t\tnewRelPath string,\n486\t\ttaskIdentifier lib.TaskIdentifier,\n487\t) {\n488\t\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n489\t\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n490\t\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n491\t\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n492\t\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n493\t\t\tglog.Warningf(\n494\t\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n495\t\t\t\tpriorRelPath,\n496\t\t\t\ttaskIdentifier,\n497\t\t\t\terr,\n498\t\t\t)\n499\t\t\treturn\n500\t\t}\n501\t\tglog.V(2).Infof(\n502\t\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n503\t\t\tpriorRelPath,\n504\t\t\tnewRelPath,\n505\t\t)\n506\t}\n507\t\n508\t// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n509\t// that transitions a prior-period recurring-task instance to aborted.\n510\tfunc buildSupersedeModifyFn(\n511\t\tctx context.Context,\n512\t\tnewRelPath string,\n513\t\tts string,\n514\t) func([]byte) ([]byte, error) {\n515\t\treturn func(current []byte) ([]byte, error) {\n516\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n517\t\t\tif err != nil {\n518\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n519\t\t\t}\n520\t\t\tbody, err := result.ExtractBody(ctx, current)\n521\t\t\tif err != nil {\n522\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n523\t\t\t}\n524\t\t\tfm, err := parseTaskFrontmatter(fmStr)\n525\t\t\tif err != nil {\n526\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n527\t\t\t}\n528\t\t\tfm[\"status\"] = \"aborted\"\n529\t\t\tfm[\"phase\"] = \"done\"\n530\t\t\tfm[\"completed_date\"] = ts\n531\t\t\tfm[\"superseded_by\"] = newRelPath\n532\t\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n533\t\t\treturn marshalFileContent(ctx, fm, body)\n534\t\t}\n535\t}\n536\t"}]},"parent_tool_use_id":null,"session_id":"3b382834-12e1-4988-be26-31fd207a979c","uuid":"18c3b3ac-4a3d-43d4-8855-319820ba06fe","timestamp":"2026-08-27T18:44:38.193Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/command/task_create_task_executor.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage command\n\nimport (\n\t\"context\"\n\t\"maps\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\ttask \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/cqrs/cdb\"\n\t\"github.com/bborbe/errors\"\n\tlibkv \"github.com/bborbe/kv\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/bborbe/validation\"\n\t\"github.com/golang/glog\"\n\n\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n)\n\n// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n// a new vault task file for the given task_identifier. If cmd.Title passes validation\n// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n// If a file already exists at the resolved path the command returns ErrTaskAlreadyExists\n// (a benign Failure on the result topic — no overwrite, no git write).\n// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n// match vaultName are skipped without side effects (no git write, no error, no result event).\nfunc NewCreateTaskExecutor(\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tvaultName string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n) cdb.CommandObjectExecutorTx {\n\treturn cdb.CommandObjectExecutorTxFunc(\n\t\ttask.CreateCommandOperation,\n\t\ttrue,\n\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n\t\t\tvar cmd task.CreateCommand\n\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n\t\t\t\t\terr,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n\t\t\t}\n\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n\t\t\t\teffective := cmd.TargetVault\n\t\t\t\tif effective == \"\" {\n\t\t\t\t\teffective = routing.LegacyDefaultVault\n\t\t\t\t}\n\t\t\t\tglog.V(2).Infof(\n\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"cross-vault create for task %s\",\n\t\t\t\t\tcmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n\t\t\t}\n\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n\t\t\tif err := checkTitlePathFree(ctx, gitClient, relPath, cmd.TaskIdentifier); err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName); err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n\t\t\treturn nil, nil, nil\n\t\t},\n\t)\n}\n\n// checkTitlePathFree returns ErrTaskAlreadyExists when the title path is\n// already occupied (benign Failure on the result topic — no overwrite, no\n// git write). A transient git-rest read error is propagated. A \"not found\"\n// read error is swallowed (title path is free).\nfunc checkTitlePathFree(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) error {\n\texisting, err := gitClient.ReadFile(ctx, relPath)\n\tif err == nil {\n\t\tglog.V(2).Infof(\n\t\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n\t\t\trelPath,\n\t\t\tlen(existing),\n\t\t\ttaskIdentifier,\n\t\t)\n\t\treturn errors.Wrapf(\n\t\t\tctx, task.ErrTaskAlreadyExists, \"title path %s occupied\", relPath,\n\t\t)\n\t}\n\tif !isNotFoundReadError(err) {\n\t\treturn errors.Wrapf(\n\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n\t\t)\n\t}\n\treturn nil\n}\n\n// writeTaskFile builds the task content and writes it atomically to the vault\n// via git-rest, then logs the creation. vaultName is stamped as target_vault so\n// the created task is self-describing for the result-path routing guard.\nfunc writeTaskFile(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\tcmd task.CreateCommand,\n\tvaultName string,\n) error {\n\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n\t}\n\tabsPath := filepath.Join(gitClient.Path(), relPath)\n\tif err := gitClient.AtomicWriteAndCommitPush(\n\t\tctx,\n\t\tabsPath,\n\t\tcontent,\n\t\t\"[agent-task-controller] create task \"+string(cmd.TaskIdentifier),\n\t); err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n\t}\n\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n\treturn nil\n}\n\n// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n// file should be written. If cmd.Title passes validation and contains no path\n// separators, the title-derived path is returned; otherwise a WARN is logged and\n// the UUID-derived path is returned as fallback so the task is always materialized.\n// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n// function no longer reads the vault or compares task_identifier.\nfunc resolveCreateTaskRelPath(\n\tctx context.Context,\n\ttaskDir string,\n\tcmd task.CreateCommand,\n) string {\n\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n\n\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n\tif err := cmd.Validate(ctx); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n\t\t\tcmd.TaskIdentifier, err,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\t// Reject titles containing path separators to prevent path traversal.\n\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n\t\t\tcmd.Title,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n}\n\n// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n// typed not-found sentinel, so this matches the \"404\" status embedded in the\n// wrapped error message produced by gitRestClient.Get\n// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n// be handled by the caller before calling this helper.\nfunc isNotFoundReadError(err error) bool {\n\tif err == nil {\n\t\treturn false\n\t}\n\treturn strings.Contains(err.Error(), \"returned 404\")\n}\n\n// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n// unusable downstream.\n//\n// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n// doctrine): escalation clears the assignee so no agent claims the task and a\n// human picks it up. Requiring it here made a task that is *born* parked\n// unrepresentable — github-pr-watcher's untrusted-author path stamps\n// `assignee: \"\", phase: human_review` and every such command was rejected, so\n// the PR silently never reached the operator queue (bborbe/git-sync#5,\n// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n// so accepting it at create matches how update and dispatch already behave.\nfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n\tif s, _ := fm.String(\"status\"); s == \"\" {\n\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n\t}\n\treturn nil\n}\n\nfunc buildCreateTaskContent(\n\tctx context.Context,\n\tcmd task.CreateCommand,\n\tvaultName string,\n) ([]byte, error) {\n\tfm := make(lib.TaskFrontmatter)\n\tmaps.Copy(fm, cmd.Frontmatter)\n\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n\tfm[\"target_vault\"] = vaultName\n\treturn marshalFileContent(ctx, fm, cmd.Body)\n}\n\n// supersedePriorRecurringTask collapses a recurring schedule to a single open\n// instance: after a new instance is materialized it lists same-slug candidates,\n// excludes the new instance, ranks them most-recent-first, and transitions every\n// still-in_progress candidate whose period-token is strictly older than the new\n// instance's token to aborted — capped at the k most-recent such candidates.\n// Best-effort: list/read/parse/write errors on any single file are logged and\n// swallowed; the already-written new instance is never rolled back. newRelPath is\n// the repo-root-relative path of the new instance (the superseded_by back-pointer).\nfunc supersedePriorRecurringTask(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tcmd task.CreateCommand,\n\tnewRelPath string,\n) {\n\tif !isEligibleForSupersede(cmd) {\n\t\treturn\n\t}\n\tslug, newToken, ok := splitTitleToken(cmd.Title)\n\tif !ok {\n\t\tglog.V(3).Infof(\n\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n\t\t\tcmd.Title, cmd.TaskIdentifier,\n\t\t)\n\t\treturn\n\t}\n\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n\t\t)\n\t\treturn\n\t}\n\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n\tif err != nil {\n\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n\t\treturn\n\t}\n\t// Exclude the new instance and rank.\n\tvar kept []string\n\tfor _, t := range titles {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif t == cmd.Title {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, t)\n\t}\n\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n\tcollapseCandidates(\n\t\tctx,\n\t\tgitClient,\n\t\ttaskDir,\n\t\tcurrentDateTime,\n\t\tk,\n\t\tranked,\n\t\tnewOrdinal,\n\t\tnewRelPath,\n\t\tcmd,\n\t)\n}\n\n// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n// returns their TITLES (basename without \".md\"), filtered to those whose title\n// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n// glob metacharacters; otherwise it lists all task files and filters in memory\n// (glob-injection defense). List errors are returned; the caller logs them once.\nfunc listSameSlugCandidateTitles(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tslug string,\n) ([]string, error) {\n\tprefix := slug + \" - \"\n\tvar glob string\n\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n\t\tglob = filepath.Join(taskDir, \"*.md\")\n\t\tglog.V(2).Infof(\n\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n\t\t\tslug,\n\t\t)\n\t} else {\n\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n\t}\n\trelPaths, err := gitClient.ListFiles(ctx, glob)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar titles []string\n\tfor _, relPath := range relPaths {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n\t\tif strings.HasPrefix(title, prefix) {\n\t\t\ttitles = append(titles, title)\n\t\t}\n\t}\n\treturn titles, nil\n}\n\n// collapseCandidates iterates ranked candidates most-recent-first, transitions\n// each still-in_progress candidate older than newOrdinal to aborted, and stops\n// after k candidates have been inspected (read attempted). Best-effort per file.\nfunc collapseCandidates(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tranked []rankedCandidate,\n\tnewOrdinal int64,\n\tnewRelPath string,\n\tcmd task.CreateCommand,\n) {\n\tinspected := 0\n\tfor _, rc := range ranked {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif inspected >= k {\n\t\t\tbreak\n\t\t}\n\t\tif rc.Ordinal > newOrdinal {\n\t\t\tcontinue\n\t\t}\n\t\tinspected++\n\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n\t\t\tglog.Warningf(\n\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n\t\t\t\trc.Title, cmd.TaskIdentifier,\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n\t\tif err != nil || content == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n\t\t\tcontinue\n\t\t}\n\t\ttransitionPrior(\n\t\t\tctx,\n\t\t\tgitClient,\n\t\t\tcurrentDateTime,\n\t\t\tcandidateRelPath,\n\t\t\trc.Title,\n\t\t\tnewRelPath,\n\t\t\tcmd.TaskIdentifier,\n\t\t)\n\t}\n}\n\n// isEligibleForSupersede reports whether cmd is a recurring-task instance\n// that should auto-supersede its prior. Returns true only when created_by is\n// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n// Returns false (no supersede) when auto_abort_prior is absent or false — the\n// safe default that prevents accidental supersede of audit-style tasks.\nfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n\tif createdBy != \"recurring-task-creator\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n\t\treturn false\n\t}\n\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n\t\treturn true\n\t}\n\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n\t\treturn true\n\t}\n\tglog.V(3).\n\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n\treturn false\n}\n\n// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n// transient git-rest error (logged by caller).\nfunc readPriorForSupersede(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) ([]byte, error) {\n\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n\tif err == nil {\n\t\treturn content, nil\n\t}\n\tif isNotFoundReadError(err) {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n\t\treturn nil, nil\n\t}\n\tglog.Warningf(\n\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n\t\tpriorRelPath,\n\t\ttaskIdentifier,\n\t\terr,\n\t)\n\treturn nil, err\n}\n\n// priorIsInProgress parses the prior file's frontmatter and reports whether\n// its status is in_progress. Returns false (no-op) on parse error or any\n// non-in_progress status.\nfunc priorIsInProgress(\n\tctx context.Context,\n\tcontent []byte,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) bool {\n\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tstatus, _ := priorFm.String(\"status\")\n\tif status != \"in_progress\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n\t\treturn false\n\t}\n\treturn true\n}\n\n// transitionPrior performs the read-modify-write that transitions the prior\n// file to aborted. Best-effort: write errors are logged and swallowed.\nfunc transitionPrior(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tpriorRelPath string,\n\tpriorTitle string,\n\tnewRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) {\n\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn\n\t}\n\tglog.V(2).Infof(\n\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n\t\tpriorRelPath,\n\t\tnewRelPath,\n\t)\n}\n\n// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n// that transitions a prior-period recurring-task instance to aborted.\nfunc buildSupersedeModifyFn(\n\tctx context.Context,\n\tnewRelPath string,\n\tts string,\n) func([]byte) ([]byte, error) {\n\treturn func(current []byte) ([]byte, error) {\n\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n\t\t}\n\t\tbody, err := result.ExtractBody(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n\t\t}\n\t\tfm, err := parseTaskFrontmatter(fmStr)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n\t\t}\n\t\tfm[\"status\"] = \"aborted\"\n\t\tfm[\"phase\"] = \"done\"\n\t\tfm[\"completed_date\"] = ts\n\t\tfm[\"superseded_by\"] = newRelPath\n\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n\t\treturn marshalFileContent(ctx, fm, body)\n\t}\n}\n","numLines":536,"startLine":1,"totalLines":536}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8c7b6832db30493c","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"errors\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\ttask \"github.com/bborbe/agent/command/task\"\n17\t\t\"github.com/bborbe/cqrs/base\"\n18\t\t\"github.com/bborbe/cqrs/cdb\"\n19\t\tlibtime \"github.com/bborbe/time\"\n20\t\tlibtimemocks \"github.com/bborbe/time/mocks\"\n21\t\t. \"github.com/onsi/ginkgo/v2\"\n22\t\t. \"github.com/onsi/gomega\"\n23\t\n24\t\t\"github.com/bborbe/agent-task-controller/mocks\"\n25\t\t\"github.com/bborbe/agent-task-controller/pkg/command\"\n26\t)\n27\t\n28\tconst testK = 7\n29\t\n30\tvar _ = Describe(\"NewCreateTaskExecutor\", func() {\n31\t\tvar (\n32\t\t\tctx      context.Context\n33\t\t\ttmpDir   string\n34\t\t\ttaskDir  string\n35\t\t\tfakeGit  *mocks.GitClient\n36\t\t\texecutor cdb.CommandObjectExecutorTx\n37\t\t\tschemaID cdb.SchemaID\n38\t\t\tclock    *libtimemocks.CurrentDateTimeGetter\n39\t\t)\n40\t\n41\t\tBeforeEach(func() {\n42\t\t\tctx = context.Background()\n43\t\t\tvar err error\n44\t\t\ttmpDir, err = os.MkdirTemp(\"\", \"create-task-test-*\")\n45\t\t\tExpect(err).NotTo(HaveOccurred())\n46\t\n47\t\t\ttaskDir = \"tasks\"\n48\t\t\tExpect(os.MkdirAll(filepath.Join(tmpDir, taskDir), 0750)).To(Succeed())\n49\t\n50\t\t\tfakeGit = &mocks.GitClient{}\n51\t\t\tfakeGit.PathReturns(tmpDir)\n52\t\t\tfakeGit.AtomicWriteAndCommitPushStub = func(\n53\t\t\t\tctx context.Context,\n54\t\t\t\tabsPath string,\n55\t\t\t\tcontent []byte,\n56\t\t\t\tmessage string,\n57\t\t\t) error {\n58\t\t\t\treturn os.WriteFile(absPath, content, 0600) // #nosec G306 -- test helper\n59\t\t\t}\n60\t\t\t// Default: every title path is free unless a test overrides ReadFile.\n61\t\t\tfakeGit.ReadFileReturns(nil, errors.New(\"GET file returned 404: not found\"))\n62\t\n63\t\t\tclock = &libtimemocks.CurrentDateTimeGetter{}\n64\t\t\tclock.NowReturns(libtime.DateTime(time.Date(2026, 6, 15, 10, 0, 0, 0, time.UTC)))\n65\t\n66\t\t\texecutor = command.NewCreateTaskExecutor(fakeGit, taskDir, \"openclaw\", clock, testK)\n67\t\t\tschemaID = cdb.SchemaID{Group: \"agent\", Kind: \"task\", Version: \"v1\"}\n68\t\t})\n69\t\n70\t\tAfterEach(func() {\n71\t\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n72\t\t})\n73\t\n74\t\tbuildCmdObj := func(cmd task.CreateCommand) cdb.CommandObject {\n75\t\t\tevent, err := base.ParseEvent(ctx, cmd)\n76\t\t\tExpect(err).NotTo(HaveOccurred())\n77\t\t\treturn cdb.CommandObject{\n78\t\t\t\tCommand: base.Command{\n79\t\t\t\t\tRequestID: base.NewRequestID(),\n80\t\t\t\t\tOperation: task.CreateCommandOperation,\n81\t\t\t\t\tInitiator: \"test\",\n82\t\t\t\t\tData:      event,\n83\t\t\t\t},\n84\t\t\t\tSchemaID: schemaID,\n85\t\t\t}\n86\t\t}\n87\t\n88\t\tDescribe(\"CommandOperation\", func() {\n89\t\t\tIt(\"returns create-task\", func() {\n90\t\t\t\tExpect(executor.CommandOperation()).To(Equal(base.CommandOperation(\"create-task\")))\n91\t\t\t})\n92\t\t})\n93\t\n94\t\tDescribe(\"HandleCommand\", func() {\n95\t\t\tContext(\"malformed command payload\", func() {\n96\t\t\t\tIt(\"returns ErrCommandObjectSkipped without writing\", func() {\n97\t\t\t\t\t// A channel is not JSON-marshalable, so MarshalInto will fail.\n98\t\t\t\t\tcmdObj := cdb.CommandObject{\n99\t\t\t\t\t\tCommand: base.Command{\n100\t\t\t\t\t\t\tRequestID: base.NewRequestID(),\n101\t\t\t\t\t\t\tOperation: task.CreateCommandOperation,\n102\t\t\t\t\t\t\tInitiator: \"test\",\n103\t\t\t\t\t\t\tData:      base.Event{\"taskIdentifier\": make(chan int)},\n104\t\t\t\t\t\t},\n105\t\t\t\t\t\tSchemaID: schemaID,\n106\t\t\t\t\t}\n107\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n108\t\t\t\t\tExpect(err).To(HaveOccurred())\n109\t\t\t\t\tExpect(errors.Is(err, cdb.ErrCommandObjectSkipped)).To(BeTrue())\n110\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n111\t\t\t\t})\n112\t\t\t})\n113\t\n114\t\t\tContext(\"empty TaskIdentifier\", func() {\n115\t\t\t\tIt(\"returns a validation error without writing\", func() {\n116\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n117\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"\"),\n118\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n119\t\t\t\t\t\t\t\"assignee\": \"claude\",\n120\t\t\t\t\t\t\t\"status\":   \"next\",\n121\t\t\t\t\t\t},\n122\t\t\t\t\t})\n123\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n124\t\t\t\t\tExpect(err).To(HaveOccurred())\n125\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n126\t\t\t\t})\n127\t\t\t})\n128\t\n129\t\t\tContext(\"empty assignee in frontmatter (task born parked)\", func() {\n130\t\t\t\t// An empty assignee is the operator-inbox signal, not a defect:\n131\t\t\t\t// github-pr-watcher's untrusted-author path creates tasks with\n132\t\t\t\t// `assignee: \"\", phase: human_review` so a human picks them up.\n133\t\t\t\t// Requiring assignee here silently dropped every such task.\n134\t\t\t\tIt(\"creates the task without an assignee\", func() {\n135\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n136\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n137\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n138\t\t\t\t\t\t\t\"status\": \"todo\",\n139\t\t\t\t\t\t\t\"phase\":  \"human_review\",\n140\t\t\t\t\t\t},\n141\t\t\t\t\t})\n142\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n143\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n144\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n145\t\t\t\t})\n146\t\t\t})\n147\t\n148\t\t\tContext(\"missing status in frontmatter\", func() {\n149\t\t\t\tIt(\"returns a validation error without writing\", func() {\n150\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n151\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n152\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n153\t\t\t\t\t\t\t\"assignee\": \"claude\",\n154\t\t\t\t\t\t},\n155\t\t\t\t\t})\n156\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n157\t\t\t\t\tExpect(err).To(HaveOccurred())\n158\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"status\"))\n159\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n160\t\t\t\t})\n161\t\t\t})\n162\t\n163\t\t\tContext(\"title path already occupied (collision)\", func() {\n164\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC2)\", func() {\n165\t\t\t\t\t// Second ReadFile call returns existing content → collision on replay.\n166\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(0,\n167\t\t\t\t\t\tnil, errors.New(\"GET 24 Tasks/Replay Task.md returned 404: not found\"))\n168\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n169\t\t\t\t\t\t1,\n170\t\t\t\t\t\t[]byte(\n171\t\t\t\t\t\t\t\"---\\ntask_identifier: replay-task\\nassignee: claude\\nstatus: next\\n---\\n\",\n172\t\t\t\t\t\t),\n173\t\t\t\t\t\tnil,\n174\t\t\t\t\t)\n175\t\n176\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n177\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"replay-task\"),\n178\t\t\t\t\t\tTitle:          \"Replay Task\",\n179\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n180\t\t\t\t\t})\n181\t\n182\t\t\t\t\t// First create: file not found → writes.\n183\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n184\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n185\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n186\t\n187\t\t\t\t\t// Replay: file now exists → sentinel, no second write.\n188\t\t\t\t\t_, _, err = executor.HandleCommand(ctx, nil, cmdObj)\n189\t\t\t\t\tExpect(err).To(HaveOccurred())\n190\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n191\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1)) // still 1\n192\t\t\t\t})\n193\t\t\t})\n194\t\n195\t\t\tContext(\"new filename\", func() {\n196\t\t\t\tIt(\"writes exactly once and returns nil when ReadFile reports not-found (AC3)\", func() {\n197\t\t\t\t\tfakeGit.ReadFileReturns(\n198\t\t\t\t\t\tnil,\n199\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Brand New.md returned 404: not found\"),\n200\t\t\t\t\t)\n201\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n202\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"brand-new\"),\n203\t\t\t\t\t\tTitle:          \"Brand New\",\n204\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n205\t\t\t\t\t})\n206\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n207\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n208\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n209\t\t\t\t})\n210\t\t\t})\n211\t\n212\t\t\tContext(\"collision with a different task_identifier\", func() {\n213\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC4)\", func() {\n214\t\t\t\t\t// Existing file at the title path belongs to a DIFFERENT task — filename owns the\n215\t\t\t\t\t// slot; the executor must not consult frontmatter, must not write.\n216\t\t\t\t\tfakeGit.ReadFileReturns(\n217\t\t\t\t\t\t[]byte(\n218\t\t\t\t\t\t\t\"---\\ntask_identifier: someone-else\\nassignee: alice\\nstatus: todo\\n---\\n\",\n219\t\t\t\t\t\t),\n220\t\t\t\t\t\tnil,\n221\t\t\t\t\t)\n222\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n223\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"new-task-id\"),\n224\t\t\t\t\t\tTitle:          \"My Colliding Task\",\n225\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n226\t\t\t\t\t})\n227\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n228\t\t\t\t\tExpect(err).To(HaveOccurred())\n229\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n230\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n231\t\t\t\t})\n232\t\t\t})\n233\t\n234\t\t\tContext(\"transient git-rest read error\", func() {\n235\t\t\t\tIt(\"propagates the wrapped error and does not write (AC5)\", func() {\n236\t\t\t\t\tfakeGit.ReadFileReturns(\n237\t\t\t\t\t\tnil,\n238\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Flaky.md returned 503: service unavailable\"),\n239\t\t\t\t\t)\n240\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n241\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"flaky-task\"),\n242\t\t\t\t\t\tTitle:          \"Flaky\",\n243\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n244\t\t\t\t\t})\n245\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n246\t\t\t\t\tExpect(err).To(HaveOccurred())\n247\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeFalse())\n248\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"503\"))\n249\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n250\t\t\t\t})\n251\t\t\t})\n252\t\n253\t\t\tContext(\"success: new file created\", func() {\n254\t\t\t\tIt(\"calls AtomicWriteAndCommitPush with correct content and commit message\", func() {\n255\t\t\t\t\ttaskID := lib.TaskIdentifier(\"new-task-abc\")\n256\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n257\t\t\t\t\t\tTaskIdentifier: taskID,\n258\t\t\t\t\t\tTitle:          \"New Task ABC\",\n259\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n260\t\t\t\t\t\t\t\"assignee\": \"claude\",\n261\t\t\t\t\t\t\t\"status\":   \"next\",\n262\t\t\t\t\t\t},\n263\t\t\t\t\t\tBody: \"This is the task body.\\n\",\n264\t\t\t\t\t})\n265\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n266\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n267\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n268\t\n269\t\t\t\t\t_, absPath, content, message := fakeGit.AtomicWriteAndCommitPushArgsForCall(0)\n270\t\t\t\t\tExpect(absPath).To(HaveSuffix(\"New Task ABC.md\"))\n271\t\t\t\t\tExpect(message).To(ContainSubstring(string(taskID)))\n272\t\n273\t\t\t\t\tcontentStr := string(content)\n274\t\t\t\t\tExpect(contentStr).To(HavePrefix(\"---\\n\"))\n275\t\t\t\t\tExpect(strings.Count(contentStr, \"---\")).To(BeNumerically(\">=\", 2))\n276\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"task_identifier:\"))\n277\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"assignee:\"))\n278\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"status:\"))\n279\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"target_vault: openclaw\"))\n280\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"This is the task body.\"))\n281\t\t\t\t})\n282\t\t\t})\n283\t\n284\t\t\tContext(\"git write error\", func() {\n285\t\t\t\tIt(\"returns a wrapped error when AtomicWriteAndCommitPush fails\", func() {\n286\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushStub = nil\n287\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushReturns(errors.New(\"git push failed\"))\n288\t\n289\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n290\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"error-task\"),\n291\t\t\t\t\t\tTitle:          \"Error Task\",\n292\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n293\t\t\t\t\t\t\t\"assignee\": \"claude\",\n294\t\t\t\t\t\t\t\"status\":   \"next\",\n295\t\t\t\t\t\t},\n296\t\t\t\t\t})\n297\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n298\t\t\t\t\tExpect(err).To(HaveOccurred())\n299\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"git push failed\"))\n300\t\t\t\t})\n301\t\t\t})\n302\t\n303\t\t\tContext(\"valid title\", func() {\n304\t\t\t\tIt(\"writes the task file at tasks/{title}.md\", func() {\n305\t\t\t\t\ttaskID := lib.TaskIdentifier(\"uuid-1234\")\n306\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n307\t\t\t\t\t\tTaskIdentifier: taskID,\n308\t\t\t\t\t\tTitle:          \"My Feature Task\",\n309\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n310\t\t\t\t\t\t\t\"assignee\": \"claude\",\n311\t\t\t\t\t\t\t\"status\":   \"next\",\n312\t\t\t\t\t\t},\n313\t