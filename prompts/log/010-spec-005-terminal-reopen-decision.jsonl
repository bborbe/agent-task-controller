esReturns(candidatePaths, nil)\n494\t\t\t\t\t\tmonContent := inProgress(\"ibkr-w28mon\")\n495\t\t\t\t\t\ttueContent := inProgress(\"ibkr-w28tue\")\n496\t\t\t\t\t\tfileContents := map[string][]byte{\n497\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-mon.md\": monContent,\n498\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-tue.md\": tueContent,\n499\t\t\t\t\t\t}\n500\t\t\t\t\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n501\t\t\t\t\t\t\tif content, ok := fileContents[relPath]; ok {\n502\t\t\t\t\t\t\t\treturn content, nil\n503\t\t\t\t\t\t\t}\n504\t\t\t\t\t\t\treturn nil, errors.New(\"GET \" + relPath + \" returned 404: not found\")\n505\t\t\t\t\t\t}\n506\t\n507\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n508\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n509\t\t\t\t\t\tExpect(\n510\t\t\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushCallCount(),\n511\t\t\t\t\t\t).To(Equal(1))\n512\t\t\t\t\t\t// new instance only\n513\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(2))\n514\t\n515\t\t\t\t\t\t// Ranking sorts by ordinal desc; equal ordinals sort by Title desc.\n516\t\t\t\t\t\t// \"2026W28-tue\" > \"2026W28-mon\" alphabetically, so tue is first.\n517\t\t\t\t\t\tpriorContents := [][]byte{tueContent, monContent}\n518\t\t\t\t\t\tpriorSuffixes := []string{\"tue\", \"mon\"}\n519\t\t\t\t\t\tfor i := 0; i < 2; i++ {\n520\t\t\t\t\t\t\t_, absPath, modify, msg := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(\n521\t\t\t\t\t\t\t\ti,\n522\t\t\t\t\t\t\t)\n523\t\t\t\t\t\t\tExpect(msg).To(ContainSubstring(\"auto-supersede prior recurring task\"))\n524\t\t\t\t\t\t\tresultContent, parseErr := modify(priorContents[i])\n525\t\t\t\t\t\t\tExpect(parseErr).NotTo(HaveOccurred())\n526\t\t\t\t\t\t\tresultStr := string(resultContent)\n527\t\t\t\t\t\t\tExpect(resultStr).To(ContainSubstring(\"status: aborted\"))\n528\t\t\t\t\t\t\tExpect(resultStr).To(ContainSubstring(\"phase: done\"))\n529\t\t\t\t\t