func(_ context.Context, relPath string) ([]byte, error) {\n898\t\t\t\t\t\tif content, ok := fileContents[relPath]; ok {\n899\t\t\t\t\t\t\treturn content, nil\n900\t\t\t\t\t\t}\n901\t\t\t\t\t\treturn nil, errors.New(\"GET \" + relPath + \" returned 404: not found\")\n902\t\t\t\t\t}\n903\t\n904\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n905\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n906\t\t\t\t\tExpect(fakeGit.ListFilesCallCount()).To(Equal(1))\n907\t\t\t\t\t_, globArg := fakeGit.ListFilesArgsForCall(0)\n908\t\t\t\t\tExpect(globArg).To(Equal(\"tasks/*.md\")) // list-all fallback, not slug-scoped\n909\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n910\t\t\t\t\t_, absPath, _, _ := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(0)\n911\t\t\t\t\tExpect(absPath).To(HaveSuffix(\"Report [draft] - 2026W27.md\"))\n912\t\t\t\t})\n913\t\n914\t\t\t\t// AC: unrelated-slug filtered out\n915\t\t\t\tIt(\"does not read or close candidates with a different slug\", func() {\n916\t\t\t\t\tnewTitle := \"Weekly Sched - 2026W28\"\n917\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n918\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"weekly-w28filter\"),\n919\t\t\t\t\t\tTitle:          newTitle,\n920\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n921\t\t\t\t\t\t\t\"assignee\":         \"claude\",\n922\t\t\t\t\t\t\t\"status\":           \"next\",\n923\t\t\t\t\t\t\t\"created_by\":       \"recurring-task-creator\",\n924\t\t\t\t\t\t\t\"auto_abort_prior\": true,\n925\t\t\t\t\t\t},\n926\t\t\t\t\t})\n927\t\n928\t\t\t\t\tfakeGit.ListFilesReturns([]string{\n929\t\t\t\t\t\t\"tasks/Weekly Sched - 2026W27.md\",\n930\t\t\t\t\t\t\"tasks/Other Sched - 2026W27.md\",\n931\t\t\t\t\t}, nil)\n932\t\t\t\t\tfileContents := map[string][]byte{\n933\t\t\t\t\t\t\"tasks/Weekly Sched - 2026W27.md\": inProgress(\"weekly-w27\"),\n934\t\t\t\t\t\t\"tasks/Other Sched - 2026W27.md\":  inProgress(\"other-w27\"),\n935\t\t\t\t\t}\n936\t\t\t\t\tfakeGit.ReadFil