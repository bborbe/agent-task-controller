File := func(name, content string) string {\n118\t\t\tabsPath := filepath.Join(tmpDir, taskDir, name)\n119\t\t\tExpect(os.WriteFile(absPath, []byte(content), 0600)).To(Succeed())\n120\t\t\treturn absPath\n121\t\t}\n122\t\n123\t\tDescribe(\"WriteResult\", func() {\n124\t\t\tContext(\"normal write\", func() {\n125\t\t\t\tIt(\"writes frontmatter and content to the matched file\", func() {\n126\t\t\t\t\twriteTaskFile(\n127\t\t\t\t\t\t\"my-task.md\",\n128\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\nassignee: backtest-agent\\ntags:\\n  - agent-task\\n  - test\\n---\\nOld content\\n\",\n129\t\t\t\t\t)\n130\t\n131\t\t\t\t\ttaskFile = lib.Task{\n132\t\t\t\t\t\tTaskIdentifier: identifier,\n133\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n134\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n135\t\t\t\t\t\t\t\"status\":          \"done\",\n136\t\t\t\t\t\t\t\"phase\":           \"done\",\n137\t\t\t\t\t\t},\n138\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n139\t\t\t\t\t}\n140\t\n141\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n142\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n143\t\n144\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n145\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n146\t\t\t\t\tExpect(string(written)).To(HavePrefix(\"---\\n\"))\n147\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"status: done\"))\n148\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"phase: done\"))\n149\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"assignee: backtest-agent\"))\n150\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"agent-task\"))\n151\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"---\\nNew content\\n\"))\n152\t\n153\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n154\t\t\t\t\t_, _, _, msg := fakeGit.AtomicReadModifyWriteAndCommitPushArgsForCall(0)\n155\t\t\t\t\tExpect(msg).To(ContainSubstring(string(identifier)))\n156\t\t\t\t})\n157\t\t\t})\n158\t\n159\t\t\tContext(\"frontmatter merge\", func() {\n160\t\t\t\tIt(\"preserves existing frontmatter keys not sent by agent\", func() {\n161\t\t\t\t\twriteTaskFile(\n162\t\t\t\t\t\t\"my-task.md\",\n163\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nassignee: backtest-agent\\ntags:\\n  - a\\n  - b\\ncustom_field: hello\\n---\\nOld content\\n\",\n164\t\t\t\t\t)\n165\t\n166\t\t\t\t\ttaskFile = lib.Task{\n167\t\t\t\t\t\tTaskIdentifier: identifier,\n168\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n169\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n170\t\t\t\t\t\t\t\"status\":          \"completed\",\n171\t\t\t\t\t\t\t\"phase\":           \"done\",\n172\t\t\t\t\t\t},\n173\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n174\t\t\t\t\t}\n175\t\n176\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n177\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n178\t\n179\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n180\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n181\t\t\t\t\ts := string(written)\n182\t\t\t\t\tExpect(s).To(ContainSubstring(\"assignee: backtest-agent\"))\n183\t\t\t\t\tExpect(s).To(ContainSubstring(\"custom_field: hello\"))\n184\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n185\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n186\t\t\t\t\tExpect(s).To(ContainSubstring(\"task_identifier: test-task-uuid-1234\"))\n187\t\t\t\t\t// tags preserved\n188\t\t\t\t\tExpect(s).To(ContainSubstring(\"- a\"))\n189\t\t\t\t\tExpect(s).To(ContainSubstring(\"- b\"))\n190\t\t\t\t})\n191\t\n192\t\t\t\tIt(\"agent keys override existing keys\", func() {\n193\t\t\t\t\twriteTaskFile(\n194\t\t\t\t\t\t\"my-task.md\",\n195\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: in_progress\\n---\\nOld content\\n\",\n196\t\t\t\t\t)\n197\t\n198\t\t\t\t\ttaskFile = lib.Task{\n199\t\t\t\t\t\tTaskIdentifier: identifier,\n200\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n201\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n202\t\t\t\t\t\t\t\"status\":          \"completed\",\n203\t\t\t\t\t\t\t\"phase\":           \"done\",\n204\t\t\t\t\t\t},\n205\t\t\t\t\t\tContent: lib.TaskContent(\"New content\\n\"),\n206\t\t\t\t\t}\n207\t\n208\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n209\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n210\t\n211\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n212\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n213\t\t\t\t\ts := string(written)\n214\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n215\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n216\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"in_progress\"))\n217\t\t\t\t})\n218\t\t\t})\n219\t\n220\t\t\tContext(\"overwrite\", func() {\n221\t\t\t\tIt(\"fully replaces content on second call\", func() {\n222\t\t\t\t\twriteTaskFile(\n223\t\t\t\t\t\t\"my-task.md\",\n224\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in-progress\\n---\\nFirst content\\n\",\n225\t\t\t\t\t)\n226\t\n227\t\t\t\t\ttaskFile = lib.Task{\n228\t\t\t\t\t\tTaskIdentifier: identifier,\n229\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n230\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n231\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n232\t\t\t\t\t\t},\n233\t\t\t\t\t\tContent: lib.TaskContent(\"First result\\n\"),\n234\t\t\t\t\t}\n235\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n236\t\n237\t\t\t\t\ttaskFile.Content = lib.TaskContent(\"Second result\\n\")\n238\t\t\t\t\ttaskFile.Frontmatter[\"status\"] = \"closed\"\n239\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n240\t\n241\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n242\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n243\t\t\t\t\tExpect(string(written)).To(ContainSubstring(\"Second result\\n\"))