",\n1733\t\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: planning\\nassignee: claude\\ntrigger_count: 1\\n---\\nProbe body\\n\",\n1734\t\t\t\t\t\t)\n1735\t\n1736\t\t\t\t\t\t// Override the BeforeEach stub for this test: simulate a partial\n1737\t\t\t\t\t\t// update from task_update_frontmatter_executor landing on disk\n1738\t\t\t\t\t\t// BETWEEN the moment AtomicReadModifyWriteAndCommitPush would\n1739\t\t\t\t\t\t// fetch current bytes and the moment modify is invoked. We do\n1740\t\t\t\t\t\t// this by mutating the file inside the stub, before calling\n1741\t\t\t\t\t\t// modify with the freshly-re-read bytes. This is exactly what\n1742\t\t\t\t\t\t// git-rest does on a CAS retry: it re-reads from disk on each\n1743\t\t\t\t\t\t// attempt, so modify sees the interleaved write.\n1744\t\t\t\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n1745\t\t\t\t\t\t\tctx context.Context,\n1746\t\t\t\t\t\t\tabsPath string,\n1747\t\t\t\t\t\t\tmodify func([]byte) ([]byte, error),\n1748\t\t\t\t\t\t\tmessage string,\n1749\t\t\t\t\t\t) error {\n1750\t\t\t\t\t\t\t// Simulate the interleaved partial update: another writer\n1751\t\t\t\t\t\t\t// (the executor) added spawn_notification: true and bumped\n1752\t\t\t\t\t\t\t// trigger_count to 2 between our initial read and the modify\n1753\t\t\t\t\t\t\t// call.\n1754\t\t\t\t\t\t\tinterleaved := \"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nphase: planning\\nassignee: claude\\ntrigger_count: 2\\nspawn_notification: true\\n---\\nProbe body\\n\"\n1755\t\t\t\t\t\t\tif err := os.WriteFile(absPath, []byte(interleaved), 0600); err != nil { // #nosec G306 -- test helper\n1756\t\t\t\t\t\t\t\treturn err\n1757\t\t\t\t\t\t\t}\n1758\t\t\t\t\t\t\tcurrent, err := os.ReadFile(absPath) // #nosec G304 -- test helper\n1759\t\t\t\t\t\t\tif err != nil {\n1760\t\t\t\t\t\t\t\treturn err\n1761\t\t\t\t\t\t\t}\n1762\t\t\t\t\t\t\tupdated, err := modify(current)\n1763\t\t\t\t\t\t\tif err != nil {\n1764\t\t\t\t\t\t\t\treturn err\n1765\t\t\t\t\t\t\t}\n1766\t\t\t\t\t\t\treturn os.WriteFile(absPath, updated, 0600) // #nosec G306 -- test helper\n1767\t\t\t\t\t\t}\n1768\t\n1769\t\t\t\t\t\t// Agent publishes terminal completion: status: completed, phase: done.\n1770\t\t\t\t\t\ttaskFile = lib.Task{\n1771\t\t\t\t\t\t\tTaskIdentifier: identifier,\n1772\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1773\t\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1774\t\t\t\t\t\t\t\t\"status\":          \"completed\",\n1775\t\t\t\t\t\t\t\t\"phase\":           \"done\",\n1776\t\t\t\t\t\t\t},\n1777\t\t\t\t\t\t\tContent: lib.TaskContent(\"Probe completed successfully.\\n\"),\n1778\t\t\t\t\t\t}\n1779\t\n1780\t\t\t\t\t\tExpect(writer.WriteResult(ctx, taskFile)).To(Succeed())\n1781\t\n1782\t\t\t\t\t\twritten, readErr := os.ReadFile(\n1783\t\t\t\t\t\t\tfilepath.Join(tmpDir, taskDir, \"probe-task.md\"),\n1784\t\t\t\t\t\t)\n1785\t\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n1786\t\t\t\t\t\ts := string(written)\n1787\t\n1788\t\t\t\t\t\t// 1. Agent's terminal status wins over the stale-disk in_progress.\n1789\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"status: completed\"))\n1790\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"phase: done\"))\n1791\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"status: in_progress\"))\n1792\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"phase: planning\"))\n1793\t\n1794\t\t\t\t\t\t// 2. The interleaved partial update's trigger_count: 2 is preserved\n1795\t\t\t\t\t\t//    (because modifyFn re-reads fresh disk content; the stale\n1796\t\t\t\t\t\t//    snapshot from FindTaskFilePath would have written trigger_count: 1\n1797\t\t\t\t\t\t//    and dropped the bump). This is the load-bearing assertion that\n1798\t\t\t\t\t\t//    proves the race is fixed.\n1799\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"trigger_count: 2\"))\n1800\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"trigger_count: 1\"))\n1801\t\n1802\t\t\t\t\t\t// 3. New body fully replaces old body (WriteResult semantics).\n1803\t\t\t\t\t\tExpect(s).To(ContainSubstring(\"Probe completed successfully.\"))\n1804\t\t\t\t\t\tExpect(s).NotTo(ContainSubstring(\"Probe body\"))\n1805\t\n1806\t\t\t\t\t\t// 4. Exactly one AtomicReadModifyWriteAndCommitPush call.\n1807\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1808\t\n1809\t\t\t\t\t\t// Note: do NOT assert against spawn_notification here.\n1810\t\t\t\t\t\t// applyRetryCounter early-returns when merged.Status() == \"completed\"\n1811\t\t\t\t\t\t// (result_writer.go:151-153) BEFORE the spawn_notification delete\n1812\t\t\t\t\t\t// path at line 183, so the on-disk spawn_notification: true is\n1813\t\t\t\t\t\t// preserved verbatim through the merge. That's a property of the\n1814\t\t\t\t\t\t// existing helper, not part of the race fix this test proves.\n1815\t\t\t\t\t},\n1816\t\t\t\t)\n1817\t\t\t})\n1818\t\n1819\t\t\tContext(\"atomic write and push error\", func() {\n1820\t\t\t\tIt(\"returns error when AtomicWriteAndCommitPush fails\", func() {\n1821\t\t\t\t\twriteTaskFile(\n1822\t\t\t\t\t\t\"my-task.md\",\n1823\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: open\\n---\\nOld content\\n\",\n1824\t\t\t\t\t)\n1825\t\t\t\t\tfakeGit.AtomicReadModifyWriteAndCommitPushStub = func(\n1826\t\t\t\t\t\tctx context.Context,\n1827\t\t\t\t\t\tabsPath string,\n1828\t\t\t\t\t\tmodify func([]byte) ([]byte, error),\n1829\t\t\t\t\t\tmessage string,\n1830\t\t\t\t\t) error {\n1831\t\t\t\t\t\treturn errTest\n1832\t\t\t\t\t}\n1833\t\n1834\t\t\t\t\ttaskFile = lib.Task{\n1835\t\t\t\t\t\tTaskIdentifier: identifier,\n1836\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1837\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1838\t\t\t\t\t\t\t\"status\":          \"done\",\n1839\t\t\t\t\t\t},\n1840\t\t\t\t\t\tContent: lib.TaskContent(\"Result\\n\"),\n1841\t\t\t\t\t}\n1842\t\n1843\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n1844\t\t\t\t\tExpect(err).To(HaveOccurred())\n1845\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1846\t\t\t\t})\n1847\t\t\t})\n1848\t\n1849\t\t\tContext(\"Review section preservation\", func() {\n1850\t\t\t\t// PIt: test documents the known bug — ## Review content is currently stripped.\n1851\t\t\t\t// Remove the P prefix once WriteResult is updated to preserve existing ## Review sections.\n1852\t\t\t\tPIt(\"preserves prior ## Review content when writing a new result\", func() {\n1853\t\t\t\t\twriteTaskFile(\n1854\t\t\t\t\t\t\"my-task.md\",\n1855\t\t\t\t\t\t\"---\\ntask_identifier: test-task-uuid-1234\\nstatus: in_progress\\nassignee: claude\\n---\\n# Body\\n## Review\\nPrior review content\\n\",\n1856\t\t\t\t\t)\n1857\t\n1858\t\t\t\t\ttaskFile = lib.Task{\n1859\t\t\t\t\t\tTaskIdentifier: identifier,\n1860\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n1861\t\t\t\t\t\t\t\"task_identifier\": \"test-task-uuid-1234\",\n1862\t\t\t\t\t\t\t\"status\":          \"in_progress\",\n1863\t\t\t\t\t\t\t\"phase\":           \"ai_review\",\n1864\t\t\t\t\t\t},\n1865\t\t\t\t\t\tContent: lib.TaskContent(\"# Body\\n\\n## Review\\nNew review content\\n\"),\n1866\t\t\t\t\t}\n1867\t\n1868\t\t\t\t\terr := writer.WriteResult(ctx, taskFile)\n1869\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n1870\t\n1871\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(Equal(1))\n1872\t\t\t\t\t// Read the actual file the stub wrote.\n1873\t\t\t\t\twritten, readErr := os.ReadFile(filepath.Join(tmpDir, taskDir, \"my-task.md\"))\n1874\t\t\t\t\tExpect(readErr).NotTo(HaveOccurred())\n1875\t\t\t\t\ts := string(written)\n1876\t\t\t\t\t// Either the prior review survives in-place, OR it survives under an\n1877\t\t\t\t\t// \"## Outdated by force-push\" marker. NEVER stripped silently.\n1878\t\t\t\t\tExpect(s).To(SatisfyAny(\n1879\t\t\t\t\t\tContainSubstring(\"Prior review content\"),\n1880\t\t\t\t\t\tContainSubstring(\"## Outdated by\"),\n1881\t\t\t\t\t))\n1882\t\t\t\t})\n1883\t\t\t})\n1884\t\t})\n1885\t\