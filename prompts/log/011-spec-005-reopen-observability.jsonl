\"),\n603\t\t\t\t\t\t\tTitle:          \"Legacy Task\",\n604\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n605\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n606\t\t\t\t\t\t\t\t\"status\":   \"next\",\n607\t\t\t\t\t\t\t},\n608\t\t\t\t\t\t\t// TargetVault deliberately empty — legacy producer.\n609\t\t\t\t\t\t})\n610\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n611\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n612\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n613\t\t\t\t\t},\n614\t\t\t\t)\n615\t\n616\t\t\t\tIt(\n617\t\t\t\t\t\"skips a command with empty TargetVault when vaultName=personal (legacy fallback is openclaw, not personal)\",\n618\t\t\t\t\tfunc() {\n619\t\t\t\t\t\texecutor := command.NewCreateTaskExecutor(\n620\t\t\t\t\t\t\tfakeGit,\n621\t\t\t\t\t\t\ttaskDir,\n622\t\t\t\t\t\t\t\"personal\",\n623\t\t\t\t\t\t\tclock,\n624\t\t\t\t\t\t\ttestK,\n625\t\t\t\t\t\t)\n626\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n627\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"task-1\"),\n628\t\t\t\t\t\t\tTitle:          \"Legacy Task\",\n629\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n630\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n631\t\t\t\t\t\t\t\t\"status\":   \"next\",\n632\t\t\t\t\t\t\t},\n633\t\t\t\t\t\t\t// TargetVault deliberately empty.\n634\t\t\t\t\t\t})\n635\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n636\t\t\t\t\t\tExpect(errors.Is(err, cdb.ErrCommandObjectSkipped)).To(BeTrue())\n637\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n638\t\t\t\t\t},\n639\t\t\t\t)\n640\t\t\t})\n641\t\n642\t\t\tContext(\"scan-and-collapse supersede\", func() {\n643\t\t\t\tinProgress := func(id string) []byte {\n644\t\t\t\t\treturn []byte(\n645\t\t\t\t\t\t\"---\\ntask_identifier: \" + id + \"\\nassignee: claude\\nstatus: in_progress\\n---\\nbody\\n\",\n646\t\t\t\t\t)\n647\t\t\t\t}\n648\t\n649\t\t\t\t// AC: N-collapse — missed-day gap (Mon+Tue open, Wed fires → both close, Wed stays open)\n650\t\t\t\tIt(\n651\t\t\t\t\t\"closes multiple older in_progress priors when new instance fires (missed-day gap)\",\n652\t\t\t\t\tfunc() {\n653\t\t\t\t\t\tnewTitle := \"IBKR Swing Trading - 2026W28-wed\"\n654\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n655\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"ibkr-w28wed\"),\n656\t\t\t\t\t\t\tTitle:          newTitle,\n657\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n658\t\t\t\t\t\t\t\t\"assignee\":         \"claude\",\n659\t\t\t\t\t\t\t\t\"status\":           \"next\",\n660\t\t\t\t\t\t\t\t\"created_by\":       \"recurring-task-creator\",\n661\t\t\t\t\t\t\t\t\"auto_abort_prior\": true,\n662\t\t\t\t\t\t\t},\n663\t\t\t\t\t\t})\n664\t\n665\t\t\t\t\t\tcandidatePaths := []string{\n666\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-mon.md\",\n667\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-tue.md\",\n668\t\t\t\t\t\t}\n669\t\t\t\t\t\tfakeGit.ListFilesReturns(candidatePaths, nil)\n670\t\t\t\t\t\tmonContent := inProgress(\"ibkr-w28mon\")\n671\t\t\t\t\t\ttueContent := inProgress(\"ibkr-w28tue\")\n672\t\t\t\t\t\tfileContents := map[string][]byte{\n673\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-mon.md\": monContent,\n674\t\t\t\t\t\t\t\"tasks/IBKR Swing Trading - 2026W28-tue.md\": tueContent,\n675\t\t\t\t\t\t}\n676\t\t\t\t\t\tfakeGit.ReadFileStub = func(_ context.Context, relPath string) ([]byte, error) {\n677\t\t\t\t\t\t\tif content, ok := fileContents[relPath]; ok {\n678\t\t\t\t\t\t\t\treturn content, nil\n679\t\t\t\t\t\t\t}\n680\t\t\t\t\t\t\treturn nil, errors.New(\"GET \" + relPath + \" returned 404: not found\")\n681\t\t\t\t\t\t}\n682\t\n683\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n684\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n685\t\t\t\t\t\tExpect(\n686\t\t\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushCallCount(),\n687\t\t\t\t\t\t).To(Equal(1))\n688\t\t\t\t\t\t// new instance only\n689\t\t\t\t\t\tExpect(fakeGit.AtomicReadModifyWriteAndCommitPushCallCount()).To(