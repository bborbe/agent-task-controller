{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b2357dda53944594","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"maps\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\tlib \"github.com/bborbe/agent\"\n15\t\ttask \"github.com/bborbe/agent/command/task\"\n16\t\t\"github.com/bborbe/cqrs/base\"\n17\t\t\"github.com/bborbe/cqrs/cdb\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibkv \"github.com/bborbe/kv\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/validation\"\n22\t\t\"github.com/golang/glog\"\n23\t\n24\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n25\t\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n27\t)\n28\t\n29\t// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n30\t// a new vault task file for the given task_identifier. If cmd.Title passes validation\n31\t// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n32\t// A file that already exists at the resolved path causes ErrTaskAlreadyExists (a benign\n33\t// Failure on the result topic — no overwrite, no git write) UNLESS the existing file's\n34\t// status is terminal (\"completed\"/\"aborted\"), in which case a fresh non-terminal task is\n35\t// materialized at that path.\n36\t// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n37\t// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n38\t// match vaultName are skipped without side effects (no git write, no error, no result event).\n39\tfunc NewCreateTaskExecutor(\n40\t\tgitClient gitclient.GitClient,\n41\t\ttaskDir string,\n42\t\tvaultName string,\n43\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n44\t\tk int,\n45\t) cdb.CommandObjectExecutorTx {\n46\t\treturn cdb.CommandObjectExecutorTxFunc(\n47\t\t\ttask.CreateCommandOperation,\n48\t\t\ttrue,\n49\t\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n50\t\t\t\tvar cmd task.CreateCommand\n51\t\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n52\t\t\t\t\treturn nil, nil, errors.Wrapf(\n53\t\t\t\t\t\tctx,\n54\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n55\t\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n56\t\t\t\t\t\terr,\n57\t\t\t\t\t)\n58\t\t\t\t}\n59\t\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n60\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n61\t\t\t\t}\n62\t\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n63\t\t\t\t\teffective := cmd.TargetVault\n64\t\t\t\t\tif effective == \"\" {\n65\t\t\t\t\t\teffective = routing.LegacyDefaultVault\n66\t\t\t\t\t}\n67\t\t\t\t\tglog.V(2).Infof(\n68\t\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n69\t\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n70\t\t\t\t\t)\n71\t\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n72\t\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n73\t\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n74\t\t\t\t\treturn nil, nil, errors.Wrapf(\n75\t\t\t\t\t\tctx,\n76\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n77\t\t\t\t\t\t\"cross-vault create for task %s\",\n78\t\t\t\t\t\tcmd.TaskIdentifier,\n79\t\t\t\t\t)\n80\t\t\t\t}\n81\t\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n82\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n83\t\t\t\t}\n84\t\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n85\t\t\t\treopened, priorStatus, err := checkTitlePathFree(\n86\t\t\t\t\tctx,\n87\t\t\t\t\tgitClient,\n88\t\t\t\t\trelPath,\n89\t\t\t\t\tcmd.TaskIdentifier,\n90\t\t\t\t\tcmd,\n91\t\t\t\t)\n92\t\t\t\tif err != nil {\n93\t\t\t\t\treturn nil, nil, err\n94\t\t\t\t}\n95\t\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName, reopened, priorStatus); err != nil {\n96\t\t\t\t\treturn nil, nil, err\n97\t\t\t\t}\n98\t\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n99\t\t\t\treturn nil, nil, nil\n100\t\t\t},\n101\t\t)\n102\t}\n103\t\n104\t// checkTitlePathFree reports whether the title path is free for a new task.\n105\t// The slot is free when the path is unoccupied (git-rest 404) OR when the\n106\t// existing file's frontmatter status is a terminal status (\"completed\" or\n107\t// \"aborted\", compared case-sensitively after whitespace trim) — a terminal\n108\t// task is no longer a live duplicate, so the slot is reusable. On a\n109\t// terminal-status free it returns reopened=true and the prior status so the\n110\t// caller can distinguish a reopen from a first-ever create. Every other\n111\t// occupied state — any non-terminal status, an absent/empty/unknown status,\n112\t// missing frontmatter delimiters, or unparseable YAML — returns\n113\t// ErrTaskAlreadyExists (a benign Failure on the result topic — no overwrite,\n114\t// no git write) wrapped with the \"title path %s occupied\" message shape. A\n115\t// transient git-rest read error is propagated. The decision consumes the\n116\t// bytes already read by this function; the caller must not issue a second\n117\t// ReadFile.\n118\t//\n119\t// Recurring-task instances are carved out of the reopen path: a command from\n120\t// the recurring-task-creator publisher (created_by: recurring-task-creator)\n121\t// NEVER reopens a terminal-status file. The recurring pipeline republishes the\n122\t// same title path every tick (always-fire cadences), and the title-path file IS\n123\t// the dedupe state — so a completed instance must hold the slot until the\n124\t// period rolls, exactly as it did before the per-alert reopen feature. Without\n125\t// this carve-out, the next hourly tick reopens and overwrites every completed\n126\t// recurring task with a fresh blank instance (observed 2026-08-27: v0.6.0 wiped\n127\t// 27 completed monthly/quarterly/yearly/weekly tasks).\n128\tfunc checkTitlePathFree(\n129\t\tctx context.Context,\n130\t\tgitClient gitclient.GitClient,\n131\t\trelPath string,\n132\t\ttaskIdentifier lib.TaskIdentifier,\n133\t\tcmd task.CreateCommand,\n134\t) (reopened bool, priorStatus string, err error) {\n135\t\texisting, err := gitClient.ReadFile(ctx, relPath)\n136\t\tif err != nil {\n137\t\t\tif !isNotFoundReadError(err) {\n138\t\t\t\treturn false, \"\", errors.Wrapf(\n139\t\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n140\t\t\t\t)\n141\t\t\t}\n142\t\t\t// git-rest 404: the title path is free, first-ever create.\n143\t\t\treturn false, \"\", nil\n144\t\t}\n145\t\tfrontmatterStr, parseErr := result.ExtractFrontmatter(ctx, existing)\n146\t\tif parseErr != nil {\n147\t\t\tglog.Warningf(\n148\t\t\t\t\"create-task: cannot read status from existing file at %s for %s; holding title path: %v\",\n149\t\t\t\trelPath,\n150\t\t\t\ttaskIdentifier,\n151\t\t\t\tparseErr,\n152\t\t\t)\n153\t\t\treturn false, \"\", errors.Wrapf(\n154\t\t\t\tctx,\n155\t\t\t\ttask.ErrTaskAlreadyExists,\n156\t\t\t\t\"title path %s occupied\",\n157\t\t\t\trelPath,\n158\t\t\t)\n159\t\t}\n160\t\texistingFm, parseErr := parseTaskFrontmatter(frontmatterStr)\n161\t\tif parseErr != nil {\n162\t\t\tglog.Warningf(\n163\t\t\t\t\"create-task: cannot parse frontmatter of existing file at %s for %s; holding title path: %v\",\n164\t\t\t\trelPath,\n165\t\t\t\ttaskIdentifier,\n166\t\t\t\tparseErr,\n167\t\t\t)\n168\t\t\treturn false, \"\", errors.Wrapf(\n169\t\t\t\tctx,\n170\t\t\t\ttask.ErrTaskAlreadyExists,\n171\t\t\t\t\"title path %s occupied\",\n172\t\t\t\trelPath,\n173\t\t\t)\n174\t\t}\n175\t\tstatus, _ := existingFm.String(\"status\")\n176\t\tstatus = strings.TrimSpace(status)\n177\t\tif (status == \"completed\" || status == \"aborted\") && !isRecurringTaskCommand(cmd) {\n178\t\t\treturn true, status, nil\n179\t\t}\n180\t\tglog.V(2).Infof(\n181\t\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n182\t\t\trelPath,\n183\t\t\tlen(existing),\n184\t\t\ttaskIdentifier,\n185\t\t)\n186\t\treturn false, \"\", errors.Wrapf(\n187\t\t\tctx,\n188\t\t\ttask.ErrTaskAlreadyExists,\n189\t\t\t\"title path %s occupied\",\n190\t\t\trelPath,\n191\t\t)\n192\t}\n193\t\n194\t// writeTaskFile builds the task content and creates it in the vault via\n195\t// git-rest, then logs the creation. vaultName is stamped as target_vault so the\n196\t// created task is self-describing for the result-path routing guard.\n197\t// reopened and priorStatus carry the reopen signal from the title-path collision\n198\t// check — reopened is true only when the slot was freed by a terminal-status\n199\t// file, and priorStatus is that file's status — for the write path to use.\n200\t// On reopened == true the write commits with a \"[agent-task-controller] reopen\n201\t// terminal task <id>\" message and emits the unconditional INFO log\n202\t// \"create-task: reopening terminal task\" (visible at default verbosity, naming\n203\t// the path and prior status); a first-ever create (reopened == false) carries\n204\t// neither — it keeps the \"create task\" commit message and the V(2) creation log.\n205\t//\n206\t// The write is create-only (?create_only=1) whenever reopened == false — which\n207\t// covers every first-ever create AND every recurring-task instance (those never\n208\t// reopen, see checkTitlePathFree). git-rest refuses to overwrite an\n209\t// already-occupied path with 409 Conflict, surfaced here as ErrAlreadyExists and\n210\t// mapped to task.ErrTaskAlreadyExists (a benign Failure, no git write). This is\n211\t// the authoritative no-overwrite guarantee: even if checkTitlePathFree's read\n212\t// falsely reports the path free, the create-only write can never clobber an\n213\t// existing task file. The upsert path is used ONLY for reopened == true, the\n214\t// deliberate per-alert reopen of a terminal task.\n215\tfunc writeTaskFile(\n216\t\tctx context.Context,\n217\t\tgitClient gitclient.GitClient,\n218\t\trelPath string,\n219\t\tcmd task.CreateCommand,\n220\t\tvaultName string,\n221\t\treopened bool,\n222\t\tpriorStatus string,\n223\t) error {\n224\t\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n225\t\tif err != nil {\n226\t\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n227\t\t}\n228\t\tabsPath := filepath.Join(gitClient.Path(), relPath)\n229\t\tmsg := \"[agent-task-controller] create task \" + string(cmd.TaskIdentifier)\n230\t\tif reopened {\n231\t\t\tmsg = \"[agent-task-controller] reopen terminal task \" + string(cmd.TaskIdentifier)\n232\t\t\tif err := gitClient.AtomicWriteAndCommitPush(\n233\t\t\t\tctx,\n234\t\t\t\tabsPath,\n235\t\t\t\tcontent,\n236\t\t\t\tmsg,\n237\t\t\t); err != nil {\n238\t\t\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n239\t\t\t}\n240\t\t} else {\n241\t\t\tif err := createTaskFileIfAbsent(\n242\t\t\t\tctx,\n243\t\t\t\tgitClient,\n244\t\t\t\tabsPath,\n245\t\t\t\tcontent,\n246\t\t\t\tmsg,\n247\t\t\t\trelPath,\n248\t\t\t\tcmd,\n249\t\t\t); err != nil {\n250\t\t\t\treturn err\n251\t\t\t}\n252\t\t}\n253\t\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n254\t\t// Unconditional Infof, not V(n)-gated, by design: a reopen overwrites a\n255\t\t// task an operator (or another agent) already closed, so it must be\n256\t\t// visible in prod logs at default verbosity. Gating it behind -v=2 would\n257\t\t// make the one event worth auditing the one event nobody sees. The\n258\t\t// first-ever-create line above stays V(2) — that one is routine.\n259\t\tif reopened {\n260\t\t\tglog.Infof(\n261\t\t\t\t\"create-task: reopening terminal task at %s (prior status %s)\",\n262\t\t\t\trelPath,\n263\t\t\t\tpriorStatus,\n264\t\t\t)\n265\t\t}\n266\t\treturn nil\n267\t}\n268\t\n269\t// createTaskFileIfAbsent performs the create-only write for a non-reopen create\n270\t// (a first-ever create or a recurring-task instance). git-rest refuses an\n271\t// occupied path with 409 Conflict, surfaced here as ErrAlreadyExists and mapped\n272\t// to task.ErrTaskAlreadyExists (a benign Failure, no git write). Extracted from\n273\t// writeTaskFile to keep its nesting within the linter budget.\n274\tfunc createTaskFileIfAbsent(\n275\t\tctx context.Context,\n276\t\tgitClient gitclient.GitClient,\n277\t\tabsPath string,\n278\t\tcontent []byte,\n279\t\tmsg string,\n280\t\trelPath string,\n281\t\tcmd task.CreateCommand,\n282\t) error {\n283\t\tif err := gitClient.AtomicWriteIfAbsentAndCommitPush(ctx, absPath, content, msg); err != nil {\n284\t\t\tif errors.Is(err, gitclient.ErrAlreadyExists) {\n285\t\t\t\tglog.V(2).Infof(\n286\t\t\t\t\t\"create-task: title path %s occupied (create-only write refused), returning ErrTaskAlreadyExists for %s\",\n287\t\t\t\t\trelPath,\n288\t\t\t\t\tcmd.TaskIdentifier,\n289\t\t\t\t)\n290\t\t\t\treturn errors.Wrapf(\n291\t\t\t\t\tctx,\n292\t\t\t\t\ttask.ErrTaskAlreadyExists,\n293\t\t\t\t\t\"title path %s occupied\",\n294\t\t\t\t\trelPath,\n295\t\t\t\t)\n296\t\t\t}\n297\t\t\treturn errors.Wrapf(\n298\t\t\t\tctx,\n299\t\t\t\terr,\n300\t\t\t\t\"atomic create-only write and push for task %s\",\n301\t\t\t\tcmd.TaskIdentifier,\n302\t\t\t)\n303\t\t}\n304\t\treturn nil\n305\t}\n306\t\n307\t// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n308\t// file should be written. If cmd.Title passes validation and contains no path\n309\t// separators, the title-derived path is returned; otherwise a WARN is logged and\n310\t// the UUID-derived path is returned as fallback so the task is always materialized.\n311\t// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n312\t// function no longer reads the vault or compares task_identifier.\n313\tfunc resolveCreateTaskRelPath(\n314\t\tctx context.Context,\n315\t\ttaskDir string,\n316\t\tcmd task.CreateCommand,\n317\t) string {\n318\t\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n319\t\n320\t\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n321\t\tif err := cmd.Validate(ctx); err != nil {\n322\t\t\tglog.Warningf(\n323\t\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n324\t\t\t\tcmd.TaskIdentifier, err,\n325\t\t\t)\n326\t\t\treturn uuidRelPath\n327\t\t}\n328\t\n329\t\t// Reject titles containing path separators to prevent path traversal.\n330\t\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n331\t\t\tglog.Warningf(\n332\t\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n333\t\t\t\tcmd.Title,\n334\t\t\t)\n335\t\t\treturn uuidRelPath\n336\t\t}\n337\t\n338\t\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n339\t}\n340\t\n341\t// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n342\t// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n343\t// typed not-found sentinel, so this matches the \"404\" status embedded in the\n344\t// wrapped error message produced by gitRestClient.Get\n345\t// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n346\t// be handled by the caller before calling this helper.\n347\tfunc isNotFoundReadError(err error) bool {\n348\t\tif err == nil {\n349\t\t\treturn false\n350\t\t}\n351\t\treturn strings.Contains(err.Error(), \"returned 404\")\n352\t}\n353\t\n354\t// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n355\t// unusable downstream.\n356\t//\n357\t// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n358\t// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n359\t// doctrine): escalation clears the assignee so no agent claims the task and a\n360\t// human picks it up. Requiring it here made a task that is *born* parked\n361\t// unrepresentable — github-pr-watcher's untrusted-author path stamps\n362\t// `assignee: \"\", phase: human_review` and every such command was rejected, so\n363\t// the PR silently never reached the operator queue (bborbe/git-sync#5,\n364\t// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n365\t// so accepting it at create matches how update and dispatch already behave.\n366\tfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n367\t\tif s, _ := fm.String(\"status\"); s == \"\" {\n368\t\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n369\t\t}\n370\t\treturn nil\n371\t}\n372\t\n373\tfunc buildCreateTaskContent(\n374\t\tctx context.Context,\n375\t\tcmd task.CreateCommand,\n376\t\tvaultName string,\n377\t) ([]byte, error) {\n378\t\tfm := make(lib.TaskFrontmatter)\n379\t\tmaps.Copy(fm, cmd.Frontmatter)\n380\t\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n381\t\tfm[\"target_vault\"] = vaultName\n382\t\treturn marshalFileContent(ctx, fm, cmd.Body)\n383\t}\n384\t\n385\t// supersedePriorRecurringTask collapses a recurring schedule to a single open\n386\t// instance: after a new instance is materialized it lists same-slug candidates,\n387\t// excludes the new instance, ranks them most-recent-first, and transitions every\n388\t// still-in_progress candidate whose period-token is strictly older than the new\n389\t// instance's token to aborted — capped at the k most-recent such candidates.\n390\t// Best-effort: list/read/parse/write errors on any single file are logged and\n391\t// swallowed; the already-written new instance is never rolled back. newRelPath is\n392\t// the repo-root-relative path of the new instance (the superseded_by back-pointer).\n393\tfunc supersedePriorRecurringTask(\n394\t\tctx context.Context,\n395\t\tgitClient gitclient.GitClient,\n396\t\ttaskDir string,\n397\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n398\t\tk int,\n399\t\tcmd task.CreateCommand,\n400\t\tnewRelPath string,\n401\t) {\n402\t\tif !isEligibleForSupersede(cmd) {\n403\t\t\treturn\n404\t\t}\n405\t\tslug, newToken, ok := splitTitleToken(cmd.Title)\n406\t\tif !ok {\n407\t\t\tglog.V(3).Infof(\n408\t\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n409\t\t\t\tcmd.Title, cmd.TaskIdentifier,\n410\t\t\t)\n411\t\t\treturn\n412\t\t}\n413\t\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n414\t\tif err != nil {\n415\t\t\tglog.Warningf(\n416\t\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n417\t\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n418\t\t\t)\n419\t\t\treturn\n420\t\t}\n421\t\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n422\t\tif err != nil {\n423\t\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n424\t\t\treturn\n425\t\t}\n426\t\t// Exclude the new instance and rank.\n427\t\tvar kept []string\n428\t\tfor _, t := range titles {\n429\t\t\tif err := ctx.Err(); err != nil {\n430\t\t\t\treturn\n431\t\t\t}\n432\t\t\tif t == cmd.Title {\n433\t\t\t\tcontinue\n434\t\t\t}\n435\t\t\tkept = append(kept, t)\n436\t\t}\n437\t\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n438\t\tcollapseCandidates(\n439\t\t\tctx,\n440\t\t\tgitClient,\n441\t\t\ttaskDir,\n442\t\t\tcurrentDateTime,\n443\t\t\tk,\n444\t\t\tranked,\n445\t\t\tnewOrdinal,\n446\t\t\tnewRelPath,\n447\t\t\tcmd,\n448\t\t)\n449\t}\n450\t\n451\t// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n452\t// returns their TITLES (basename without \".md\"), filtered to those whose title\n453\t// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n454\t// glob metacharacters; otherwise it lists all task files and filters in memory\n455\t// (glob-injection defense). List errors are returned; the caller logs them once.\n456\tfunc listSameSlugCandidateTitles(\n457\t\tctx context.Context,\n458\t\tgitClient gitclient.GitClient,\n459\t\ttaskDir string,\n460\t\tslug string,\n461\t) ([]string, error) {\n462\t\tprefix := slug + \" - \"\n463\t\tvar glob string\n464\t\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n465\t\t\tglob = filepath.Join(taskDir, \"*.md\")\n466\t\t\tglog.V(2).Infof(\n467\t\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n468\t\t\t\tslug,\n469\t\t\t)\n470\t\t} else {\n471\t\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n472\t\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n473\t\t}\n474\t\trelPaths, err := gitClient.ListFiles(ctx, glob)\n475\t\tif err != nil {\n476\t\t\treturn nil, err\n477\t\t}\n478\t\tvar titles []string\n479\t\tfor _, relPath := range relPaths {\n480\t\t\tif err := ctx.Err(); err != nil {\n481\t\t\t\treturn nil, err\n482\t\t\t}\n483\t\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n484\t\t\tif strings.HasPrefix(title, prefix) {\n485\t\t\t\ttitles = append(titles, title)\n486\t\t\t}\n487\t\t}\n488\t\treturn titles, nil\n489\t}\n490\t\n491\t// collapseCandidates iterates ranked candidates most-recent-first, transitions\n492\t// each still-in_progress candidate older than newOrdinal to aborted, and stops\n493\t// after k candidates have been inspected (read attempted). Best-effort per file.\n494\tfunc collapseCandidates(\n495\t\tctx context.Context,\n496\t\tgitClient gitclient.GitClient,\n497\t\ttaskDir string,\n498\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n499\t\tk int,\n500\t\tranked []rankedCandidate,\n501\t\tnewOrdinal int64,\n502\t\tnewRelPath string,\n503\t\tcmd task.CreateCommand,\n504\t) {\n505\t\tinspected := 0\n506\t\tfor _, rc := range ranked {\n507\t\t\tif err := ctx.Err(); err != nil {\n508\t\t\t\treturn\n509\t\t\t}\n510\t\t\tif inspected >= k {\n511\t\t\t\tbreak\n512\t\t\t}\n513\t\t\tif rc.Ordinal > newOrdinal {\n514\t\t\t\tcontinue\n515\t\t\t}\n516\t\t\tinspected++\n517\t\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n518\t\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n519\t\t\t\tglog.Warningf(\n520\t\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n521\t\t\t\t\trc.Title, cmd.TaskIdentifier,\n522\t\t\t\t)\n523\t\t\t\tcontinue\n524\t\t\t}\n525\t\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n526\t\t\tif err != nil || content == nil {\n527\t\t\t\tcontinue\n528\t\t\t}\n529\t\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n530\t\t\t\tcontinue\n531\t\t\t}\n532\t\t\ttransitionPrior(\n533\t\t\t\tctx,\n534\t\t\t\tgitClient,\n535\t\t\t\tcurrentDateTime,\n536\t\t\t\tcandidateRelPath,\n537\t\t\t\trc.Title,\n538\t\t\t\tnewRelPath,\n539\t\t\t\tcmd.TaskIdentifier,\n540\t\t\t)\n541\t\t}\n542\t}\n543\t\n544\t// isRecurringTaskCommand reports whether cmd was published by the recurring-task\n545\t// creator (created_by: recurring-task-creator). Such commands must never reopen a\n546\t// terminal-status task file — the recurring pipeline republishes the same title\n547\t// path every tick and the file IS the dedupe state, so a completed instance must\n548\t// hold the slot until its period rolls. The predicate is created_by-only (unlike\n549\t// isEligibleForSupersede, which additionally requires auto_abort_prior): monthly\n550\t// schedules carry auto_abort_prior=false and must still be held.\n551\tfunc isRecurringTaskCommand(cmd task.CreateCommand) bool {\n552\t\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n553\t\treturn createdBy == \"recurring-task-creator\"\n554\t}\n555\t\n556\t// isEligibleForSupersede reports whether cmd is a recurring-task instance\n557\t// that should auto-supersede its prior. Returns true only when created_by is\n558\t// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n559\t// Returns false (no supersede) when auto_abort_prior is absent or false — the\n560\t// safe default that prevents accidental supersede of audit-style tasks.\n561\tfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n562\t\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n563\t\tif createdBy != \"recurring-task-creator\" {\n564\t\t\tglog.V(3).\n565\t\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n566\t\t\treturn false\n567\t\t}\n568\t\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n569\t\t\treturn true\n570\t\t}\n571\t\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n572\t\t\treturn true\n573\t\t}\n574\t\tglog.V(3).\n575\t\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n576\t\treturn false\n577\t}\n578\t\n579\t// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n580\t// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n581\t// transient git-rest error (logged by caller).\n582\tfunc readPriorForSupersede(\n583\t\tctx context.Context,\n584\t\tgitClient gitclient.GitClient,\n585\t\tpriorRelPath string,\n586\t\ttaskIdentifier lib.TaskIdentifier,\n587\t) ([]byte, error) {\n588\t\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n589\t\tif err == nil {\n590\t\t\treturn content, nil\n591\t\t}\n592\t\tif isNotFoundReadError(err) {\n593\t\t\tglog.V(3).\n594\t\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n595\t\t\treturn nil, nil\n596\t\t}\n597\t\tglog.Warningf(\n598\t\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n599\t\t\tpriorRelPath,\n600\t\t\ttaskIdentifier,\n601\t\t\terr,\n602\t\t)\n603\t\treturn nil, err\n604\t}\n605\t\n606\t// priorIsInProgress parses the prior file's frontmatter and reports whether\n607\t// its status is in_progress. Returns false (no-op) on parse error or any\n608\t// non-in_progress status.\n609\tfunc priorIsInProgress(\n610\t\tctx context.Context,\n611\t\tcontent []byte,\n612\t\tpriorRelPath string,\n613\t\ttaskIdentifier lib.TaskIdentifier,\n614\t) bool {\n615\t\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n616\t\tif err != nil {\n617\t\t\tglog.Warningf(\n618\t\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n619\t\t\t\tpriorRelPath,\n620\t\t\t\ttaskIdentifier,\n621\t\t\t\terr,\n622\t\t\t)\n623\t\t\treturn false\n624\t\t}\n625\t\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n626\t\tif err != nil {\n627\t\t\tglog.Warningf(\n628\t\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n629\t\t\t\tpriorRelPath,\n630\t\t\t\ttaskIdentifier,\n631\t\t\t\terr,\n632\t\t\t)\n633\t\t\treturn false\n634\t\t}\n635\t\tstatus, _ := priorFm.String(\"status\")\n636\t\tif status != \"in_progress\" {\n637\t\t\tglog.V(3).\n638\t\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n639\t\t\treturn false\n640\t\t}\n641\t\treturn true\n642\t}\n643\t\n644\t// transitionPrior performs the read-modify-write that transitions the prior\n645\t// file to aborted. Best-effort: write errors are logged and swallowed.\n646\tfunc transitionPrior(\n647\t\tctx context.Context,\n648\t\tgitClient gitclient.GitClient,\n649\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n650\t\tpriorRelPath string,\n651\t\tpriorTitle string,\n652\t\tnewRelPath string,\n653\t\ttaskIdentifier lib.TaskIdentifier,\n654\t) {\n655\t\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n656\t\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n657\t\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n658\t\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n659\t\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n660\t\t\tglog.Warningf(\n661\t\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n662\t\t\t\tpriorRelPath,\n663\t\t\t\ttaskIdentifier,\n664\t\t\t\terr,\n665\t\t\t)\n666\t\t\treturn\n667\t\t}\n668\t\tglog.V(2).Infof(\n669\t\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n670\t\t\tpriorRelPath,\n671\t\t\tnewRelPath,\n672\t\t)\n673\t}\n674\t\n675\t// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n676\t// that transitions a prior-period recurring-task instance to aborted.\n677\tfunc buildSupersedeModifyFn(\n678\t\tctx context.Context,\n679\t\tnewRelPath string,\n680\t\tts string,\n681\t) func([]byte) ([]byte, error) {\n682\t\treturn func(current []byte) ([]byte, error) {\n683\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n684\t\t\tif err != nil {\n685\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n686\t\t\t}\n687\t\t\tbody, err := result.ExtractBody(ctx, current)\n688\t\t\tif err != nil {\n689\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n690\t\t\t}\n691\t\t\tfm, err := parseTaskFrontmatter(fmStr)\n692\t\t\tif err != nil {\n693\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n694\t\t\t}\n695\t\t\tfm[\"status\"] = \"aborted\"\n696\t\t\tfm[\"phase\"] = \"done\"\n697\t\t\tfm[\"completed_date\"] = ts\n698\t\t\tfm[\"superseded_by\"] = newRelPath\n699\t\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n700\t\t\treturn marshalFileContent(ctx, fm, body)\n701\t\t}\n702\t}\n703\t"}]},"parent_tool_use_id":null,"session_id":"19e69b6d-a0b0-4055-9ec0-630671fa4482","uuid":"f9ce788e-0053-4522-8f56-323f4465e26b","timestamp":"2026-09-03T18:09:51.374Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/command/task_create_task_executor.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage command\n\nimport (\n\t\"context\"\n\t\"maps\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\ttask \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/cqrs/cdb\"\n\t\"github.com/bborbe/errors\"\n\tlibkv \"github.com/bborbe/kv\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/bborbe/validation\"\n\t\"github.com/golang/glog\"\n\n\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n)\n\n// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n// a new vault task file for the given task_identifier. If cmd.Title passes validation\n// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n// A file that already exists at the resolved path causes ErrTaskAlreadyExists (a benign\n// Failure on the result topic — no overwrite, no git write) UNLESS the existing file's\n// status is terminal (\"completed\"/\"aborted\"), in which case a fresh non-terminal task is\n// materialized at that path.\n// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n// match vaultName are skipped without side effects (no git write, no error, no result event).\nfunc NewCreateTaskExecutor(\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tvaultName string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n) cdb.CommandObjectExecutorTx {\n\treturn cdb.CommandObjectExecutorTxFunc(\n\t\ttask.CreateCommandOperation,\n\t\ttrue,\n\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n\t\t\tvar cmd task.CreateCommand\n\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n\t\t\t\t\terr,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n\t\t\t}\n\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n\t\t\t\teffective := cmd.TargetVault\n\t\t\t\tif effective == \"\" {\n\t\t\t\t\teffective = routing.LegacyDefaultVault\n\t\t\t\t}\n\t\t\t\tglog.V(2).Infof(\n\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"cross-vault create for task %s\",\n\t\t\t\t\tcmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n\t\t\t}\n\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n\t\t\treopened, priorStatus, err := checkTitlePathFree(\n\t\t\t\tctx,\n\t\t\t\tgitClient,\n\t\t\t\trelPath,\n\t\t\t\tcmd.TaskIdentifier,\n\t\t\t\tcmd,\n\t\t\t)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName, reopened, priorStatus); err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n\t\t\treturn nil, nil, nil\n\t\t},\n\t)\n}\n\n// checkTitlePathFree reports whether the title path is free for a new task.\n// The slot is free when the path is unoccupied (git-rest 404) OR when the\n// existing file's frontmatter status is a terminal status (\"completed\" or\n// \"aborted\", compared case-sensitively after whitespace trim) — a terminal\n// task is no longer a live duplicate, so the slot is reusable. On a\n// terminal-status free it returns reopened=true and the prior status so the\n// caller can distinguish a reopen from a first-ever create. Every other\n// occupied state — any non-terminal status, an absent/empty/unknown status,\n// missing frontmatter delimiters, or unparseable YAML — returns\n// ErrTaskAlreadyExists (a benign Failure on the result topic — no overwrite,\n// no git write) wrapped with the \"title path %s occupied\" message shape. A\n// transient git-rest read error is propagated. The decision consumes the\n// bytes already read by this function; the caller must not issue a second\n// ReadFile.\n//\n// Recurring-task instances are carved out of the reopen path: a command from\n// the recurring-task-creator publisher (created_by: recurring-task-creator)\n// NEVER reopens a terminal-status file. The recurring pipeline republishes the\n// same title path every tick (always-fire cadences), and the title-path file IS\n// the dedupe state — so a completed instance must hold the slot until the\n// period rolls, exactly as it did before the per-alert reopen feature. Without\n// this carve-out, the next hourly tick reopens and overwrites every completed\n// recurring task with a fresh blank instance (observed 2026-08-27: v0.6.0 wiped\n// 27 completed monthly/quarterly/yearly/weekly tasks).\nfunc checkTitlePathFree(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n\tcmd task.CreateCommand,\n) (reopened bool, priorStatus string, err error) {\n\texisting, err := gitClient.ReadFile(ctx, relPath)\n\tif err != nil {\n\t\tif !isNotFoundReadError(err) {\n\t\t\treturn false, \"\", errors.Wrapf(\n\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n\t\t\t)\n\t\t}\n\t\t// git-rest 404: the title path is free, first-ever create.\n\t\treturn false, \"\", nil\n\t}\n\tfrontmatterStr, parseErr := result.ExtractFrontmatter(ctx, existing)\n\tif parseErr != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: cannot read status from existing file at %s for %s; holding title path: %v\",\n\t\t\trelPath,\n\t\t\ttaskIdentifier,\n\t\t\tparseErr,\n\t\t)\n\t\treturn false, \"\", errors.Wrapf(\n\t\t\tctx,\n\t\t\ttask.ErrTaskAlreadyExists,\n\t\t\t\"title path %s occupied\",\n\t\t\trelPath,\n\t\t)\n\t}\n\texistingFm, parseErr := parseTaskFrontmatter(frontmatterStr)\n\tif parseErr != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: cannot parse frontmatter of existing file at %s for %s; holding title path: %v\",\n\t\t\trelPath,\n\t\t\ttaskIdentifier,\n\t\t\tparseErr,\n\t\t)\n\t\treturn false, \"\", errors.Wrapf(\n\t\t\tctx,\n\t\t\ttask.ErrTaskAlreadyExists,\n\t\t\t\"title path %s occupied\",\n\t\t\trelPath,\n\t\t)\n\t}\n\tstatus, _ := existingFm.String(\"status\")\n\tstatus = strings.TrimSpace(status)\n\tif (status == \"completed\" || status == \"aborted\") && !isRecurringTaskCommand(cmd) {\n\t\treturn true, status, nil\n\t}\n\tglog.V(2).Infof(\n\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n\t\trelPath,\n\t\tlen(existing),\n\t\ttaskIdentifier,\n\t)\n\treturn false, \"\", errors.Wrapf(\n\t\tctx,\n\t\ttask.ErrTaskAlreadyExists,\n\t\t\"title path %s occupied\",\n\t\trelPath,\n\t)\n}\n\n// writeTaskFile builds the task content and creates it in the vault via\n// git-rest, then logs the creation. vaultName is stamped as target_vault so the\n// created task is self-describing for the result-path routing guard.\n// reopened and priorStatus carry the reopen signal from the title-path collision\n// check — reopened is true only when the slot was freed by a terminal-status\n// file, and priorStatus is that file's status — for the write path to use.\n// On reopened == true the write commits with a \"[agent-task-controller] reopen\n// terminal task <id>\" message and emits the unconditional INFO log\n// \"create-task: reopening terminal task\" (visible at default verbosity, naming\n// the path and prior status); a first-ever create (reopened == false) carries\n// neither — it keeps the \"create task\" commit message and the V(2) creation log.\n//\n// The write is create-only (?create_only=1) whenever reopened == false — which\n// covers every first-ever create AND every recurring-task instance (those never\n// reopen, see checkTitlePathFree). git-rest refuses to overwrite an\n// already-occupied path with 409 Conflict, surfaced here as ErrAlreadyExists and\n// mapped to task.ErrTaskAlreadyExists (a benign Failure, no git write). This is\n// the authoritative no-overwrite guarantee: even if checkTitlePathFree's read\n// falsely reports the path free, the create-only write can never clobber an\n// existing task file. The upsert path is used ONLY for reopened == true, the\n// deliberate per-alert reopen of a terminal task.\nfunc writeTaskFile(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\tcmd task.CreateCommand,\n\tvaultName string,\n\treopened bool,\n\tpriorStatus string,\n) error {\n\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n\t}\n\tabsPath := filepath.Join(gitClient.Path(), relPath)\n\tmsg := \"[agent-task-controller] create task \" + string(cmd.TaskIdentifier)\n\tif reopened {\n\t\tmsg = \"[agent-task-controller] reopen terminal task \" + string(cmd.TaskIdentifier)\n\t\tif err := gitClient.AtomicWriteAndCommitPush(\n\t\t\tctx,\n\t\t\tabsPath,\n\t\t\tcontent,\n\t\t\tmsg,\n\t\t); err != nil {\n\t\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n\t\t}\n\t} else {\n\t\tif err := createTaskFileIfAbsent(\n\t\t\tctx,\n\t\t\tgitClient,\n\t\t\tabsPath,\n\t\t\tcontent,\n\t\t\tmsg,\n\t\t\trelPath,\n\t\t\tcmd,\n\t\t); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n\t// Unconditional Infof, not V(n)-gated, by design: a reopen overwrites a\n\t// task an operator (or another agent) already closed, so it must be\n\t// visible in prod logs at default verbosity. Gating it behind -v=2 would\n\t// make the one event worth auditing the one event nobody sees. The\n\t// first-ever-create line above stays V(2) — that one is routine.\n\tif reopened {\n\t\tglog.Infof(\n\t\t\t\"create-task: reopening terminal task at %s (prior status %s)\",\n\t\t\trelPath,\n\t\t\tpriorStatus,\n\t\t)\n\t}\n\treturn nil\n}\n\n// createTaskFileIfAbsent performs the create-only write for a non-reopen create\n// (a first-ever create or a recurring-task instance). git-rest refuses an\n// occupied path with 409 Conflict, surfaced here as ErrAlreadyExists and mapped\n// to task.ErrTaskAlreadyExists (a benign Failure, no git write). Extracted from\n// writeTaskFile to keep its nesting within the linter budget.\nfunc createTaskFileIfAbsent(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tabsPath string,\n\tcontent []byte,\n\tmsg string,\n\trelPath string,\n\tcmd task.CreateCommand,\n) error {\n\tif err := gitClient.AtomicWriteIfAbsentAndCommitPush(ctx, absPath, content, msg); err != nil {\n\t\tif errors.Is(err, gitclient.ErrAlreadyExists) {\n\t\t\tglog.V(2).Infof(\n\t\t\t\t\"create-task: title path %s occupied (create-only write refused), returning ErrTaskAlreadyExists for %s\",\n\t\t\t\trelPath,\n\t\t\t\tcmd.TaskIdentifier,\n\t\t\t)\n\t\t\treturn errors.Wrapf(\n\t\t\t\tctx,\n\t\t\t\ttask.ErrTaskAlreadyExists,\n\t\t\t\t\"title path %s occupied\",\n\t\t\t\trelPath,\n\t\t\t)\n\t\t}\n\t\treturn errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"atomic create-only write and push for task %s\",\n\t\t\tcmd.TaskIdentifier,\n\t\t)\n\t}\n\treturn nil\n}\n\n// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n// file should be written. If cmd.Title passes validation and contains no path\n// separators, the title-derived path is returned; otherwise a WARN is logged and\n// the UUID-derived path is returned as fallback so the task is always materialized.\n// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n// function no longer reads the vault or compares task_identifier.\nfunc resolveCreateTaskRelPath(\n\tctx context.Context,\n\ttaskDir string,\n\tcmd task.CreateCommand,\n) string {\n\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n\n\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n\tif err := cmd.Validate(ctx); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n\t\t\tcmd.TaskIdentifier, err,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\t// Reject titles containing path separators to prevent path traversal.\n\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n\t\t\tcmd.Title,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n}\n\n// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n// typed not-found sentinel, so this matches the \"404\" status embedded in the\n// wrapped error message produced by gitRestClient.Get\n// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n// be handled by the caller before calling this helper.\nfunc isNotFoundReadError(err error) bool {\n\tif err == nil {\n\t\treturn false\n\t}\n\treturn strings.Contains(err.Error(), \"returned 404\")\n}\n\n// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n// unusable downstream.\n//\n// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n// doctrine): escalation clears the assignee so no agent claims the task and a\n// human picks it up. Requiring it here made a task that is *born* parked\n// unrepresentable — github-pr-watcher's untrusted-author path stamps\n// `assignee: \"\", phase: human_review` and every such command was rejected, so\n// the PR silently never reached the operator queue (bborbe/git-sync#5,\n// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n// so accepting it at create matches how update and dispatch already behave.\nfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n\tif s, _ := fm.String(\"status\"); s == \"\" {\n\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n\t}\n\treturn nil\n}\n\nfunc buildCreateTaskContent(\n\tctx context.Context,\n\tcmd task.CreateCommand,\n\tvaultName string,\n) ([]byte, error) {\n\tfm := make(lib.TaskFrontmatter)\n\tmaps.Copy(fm, cmd.Frontmatter)\n\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n\tfm[\"target_vault\"] = vaultName\n\treturn marshalFileContent(ctx, fm, cmd.Body)\n}\n\n// supersedePriorRecurringTask collapses a recurring schedule to a single open\n// instance: after a new instance is materialized it lists same-slug candidates,\n// excludes the new instance, ranks them most-recent-first, and transitions every\n// still-in_progress candidate whose period-token is strictly older than the new\n// instance's token to aborted — capped at the k most-recent such candidates.\n// Best-effort: list/read/parse/write errors on any single file are logged and\n// swallowed; the already-written new instance is never rolled back. newRelPath is\n// the repo-root-relative path of the new instance (the superseded_by back-pointer).\nfunc supersedePriorRecurringTask(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tcmd task.CreateCommand,\n\tnewRelPath string,\n) {\n\tif !isEligibleForSupersede(cmd) {\n\t\treturn\n\t}\n\tslug, newToken, ok := splitTitleToken(cmd.Title)\n\tif !ok {\n\t\tglog.V(3).Infof(\n\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n\t\t\tcmd.Title, cmd.TaskIdentifier,\n\t\t)\n\t\treturn\n\t}\n\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n\t\t)\n\t\treturn\n\t}\n\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n\tif err != nil {\n\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n\t\treturn\n\t}\n\t// Exclude the new instance and rank.\n\tvar kept []string\n\tfor _, t := range titles {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif t == cmd.Title {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, t)\n\t}\n\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n\tcollapseCandidates(\n\t\tctx,\n\t\tgitClient,\n\t\ttaskDir,\n\t\tcurrentDateTime,\n\t\tk,\n\t\tranked,\n\t\tnewOrdinal,\n\t\tnewRelPath,\n\t\tcmd,\n\t)\n}\n\n// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n// returns their TITLES (basename without \".md\"), filtered to those whose title\n// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n// glob metacharacters; otherwise it lists all task files and filters in memory\n// (glob-injection defense). List errors are returned; the caller logs them once.\nfunc listSameSlugCandidateTitles(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tslug string,\n) ([]string, error) {\n\tprefix := slug + \" - \"\n\tvar glob string\n\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n\t\tglob = filepath.Join(taskDir, \"*.md\")\n\t\tglog.V(2).Infof(\n\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n\t\t\tslug,\n\t\t)\n\t} else {\n\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n\t}\n\trelPaths, err := gitClient.ListFiles(ctx, glob)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar titles []string\n\tfor _, relPath := range relPaths {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n\t\tif strings.HasPrefix(title, prefix) {\n\t\t\ttitles = append(titles, title)\n\t\t}\n\t}\n\treturn titles, nil\n}\n\n// collapseCandidates iterates ranked candidates most-recent-first, transitions\n// each still-in_progress candidate older than newOrdinal to aborted, and stops\n// after k candidates have been inspected (read attempted). Best-effort per file.\nfunc collapseCandidates(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tranked []rankedCandidate,\n\tnewOrdinal int64,\n\tnewRelPath string,\n\tcmd task.CreateCommand,\n) {\n\tinspected := 0\n\tfor _, rc := range ranked {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif inspected >= k {\n\t\t\tbreak\n\t\t}\n\t\tif rc.Ordinal > newOrdinal {\n\t\t\tcontinue\n\t\t}\n\t\tinspected++\n\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n\t\t\tglog.Warningf(\n\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n\t\t\t\trc.Title, cmd.TaskIdentifier,\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n\t\tif err != nil || content == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n\t\t\tcontinue\n\t\t}\n\t\ttransitionPrior(\n\t\t\tctx,\n\t\t\tgitClient,\n\t\t\tcurrentDateTime,\n\t\t\tcandidateRelPath,\n\t\t\trc.Title,\n\t\t\tnewRelPath,\n\t\t\tcmd.TaskIdentifier,\n\t\t)\n\t}\n}\n\n// isRecurringTaskCommand reports whether cmd was published by the recurring-task\n// creator (created_by: recurring-task-creator). Such commands must never reopen a\n// terminal-status task file — the recurring pipeline republishes the same title\n// path every tick and the file IS the dedupe state, so a completed instance must\n// hold the slot until its period rolls. The predicate is created_by-only (unlike\n// isEligibleForSupersede, which additionally requires auto_abort_prior): monthly\n// schedules carry auto_abort_prior=false and must still be held.\nfunc isRecurringTaskCommand(cmd task.CreateCommand) bool {\n\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n\treturn createdBy == \"recurring-task-creator\"\n}\n\n// isEligibleForSupersede reports whether cmd is a recurring-task instance\n// that should auto-supersede its prior. Returns true only when created_by is\n// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n// Returns false (no supersede) when auto_abort_prior is absent or false — the\n// safe default that prevents accidental supersede of audit-style tasks.\nfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n\tif createdBy != \"recurring-task-creator\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n\t\treturn false\n\t}\n\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n\t\treturn true\n\t}\n\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n\t\treturn true\n\t}\n\tglog.V(3).\n\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n\treturn false\n}\n\n// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n// transient git-rest error (logged by caller).\nfunc readPriorForSupersede(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) ([]byte, error) {\n\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n\tif err == nil {\n\t\treturn content, nil\n\t}\n\tif isNotFoundReadError(err) {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n\t\treturn nil, nil\n\t}\n\tglog.Warningf(\n\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n\t\tpriorRelPath,\n\t\ttaskIdentifier,\n\t\terr,\n\t)\n\treturn nil, err\n}\n\n// priorIsInProgress parses the prior file's frontmatter and reports whether\n// its status is in_progress. Returns false (no-op) on parse error or any\n// non-in_progress status.\nfunc priorIsInProgress(\n\tctx context.Context,\n\tcontent []byte,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) bool {\n\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tstatus, _ := priorFm.String(\"status\")\n\tif status != \"in_progress\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n\t\treturn false\n\t}\n\treturn true\n}\n\n// transitionPrior performs the read-modify-write that transitions the prior\n// file to aborted. Best-effort: write errors are logged and swallowed.\nfunc transitionPrior(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tpriorRelPath string,\n\tpriorTitle string,\n\tnewRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) {\n\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn\n\t}\n\tglog.V(2).Infof(\n\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n\t\tpriorRelPath,\n\t\tnewRelPath,\n\t)\n}\n\n// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n// that transitions a prior-period recurring-task instance to aborted.\nfunc buildSupersedeModifyFn(\n\tctx context.Context,\n\tnewRelPath string,\n\tts string,\n) func([]byte) ([]byte, error) {\n\treturn func(current []byte) ([]byte, error) {\n\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n\t\t}\n\t\tbody, err := result.ExtractBody(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n\t\t}\n\t\tfm, err := parseTaskFrontmatter(fmStr)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n\t\t}\n\t\tfm[\"status\"] = \"aborted\"\n\t\tfm[\"phase\"] = \"done\"\n\t\tfm[\"completed_date\"] = ts\n\t\tfm[\"superseded_by\"] = newRelPath\n\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n\t\treturn marshalFileContent(ctx, fm, body)\n\t}\n}\n","numLines":703,"startLine":1,"totalLines":703}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8dfff751f0283ec5","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"errors\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\tlib \"github.com/bborbe/agent\"\n16\t\ttask \"github.com/bborbe/agent/command/task\"\n17\t\t\"github.com/bborbe/cqrs/base\"\n18\t\t\"github.com/bborbe/cqrs/cdb\"\n19\t\tlibtime \"github.com/bborbe/time\"\n20\t\tlibtimemocks \"github.com/bborbe/time/mocks\"\n21\t\t. \"github.com/onsi/ginkgo/v2\"\n22\t\t. \"github.com/onsi/gomega\"\n23\t\n24\t\t\"github.com/bborbe/agent-task-controller/mocks\"\n25\t\t\"github.com/bborbe/agent-task-controller/pkg/command\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n27\t)\n28\t\n29\tconst testK = 7\n30\t\n31\tvar _ = Describe(\"NewCreateTaskExecutor\", func() {\n32\t\tvar (\n33\t\t\tctx      context.Context\n34\t\t\ttmpDir   string\n35\t\t\ttaskDir  string\n36\t\t\tfakeGit  *mocks.GitClient\n37\t\t\texecutor cdb.CommandObjectExecutorTx\n38\t\t\tschemaID cdb.SchemaID\n39\t\t\tclock    *libtimemocks.CurrentDateTimeGetter\n40\t\t)\n41\t\n42\t\tBeforeEach(func() {\n43\t\t\tctx = context.Background()\n44\t\t\tvar err error\n45\t\t\ttmpDir, err = os.MkdirTemp(\"\", \"create-task-test-*\")\n46\t\t\tExpect(err).NotTo(HaveOccurred())\n47\t\n48\t\t\ttaskDir = \"tasks\"\n49\t\t\tExpect(os.MkdirAll(filepath.Join(tmpDir, taskDir), 0750)).To(Succeed())\n50\t\n51\t\t\tfakeGit = &mocks.GitClient{}\n52\t\t\tfakeGit.PathReturns(tmpDir)\n53\t\t\tfakeGit.AtomicWriteAndCommitPushStub = func(\n54\t\t\t\tctx context.Context,\n55\t\t\t\tabsPath string,\n56\t\t\t\tcontent []byte,\n57\t\t\t\tmessage string,\n58\t\t\t) error {\n59\t\t\t\treturn os.WriteFile(absPath, content, 0600) // #nosec G306 -- test helper\n60\t\t\t}\n61\t\t\tfakeGit.AtomicWriteIfAbsentAndCommitPushStub = func(\n62\t\t\t\tctx context.Context,\n63\t\t\t\tabsPath string,\n64\t\t\t\tcontent []byte,\n65\t\t\t\tmessage string,\n66\t\t\t) error {\n67\t\t\t\treturn os.WriteFile(absPath, content, 0600) // #nosec G306 -- test helper\n68\t\t\t}\n69\t\t\t// Default: every title path is free unless a test overrides ReadFile.\n70\t\t\tfakeGit.ReadFileReturns(nil, errors.New(\"GET file returned 404: not found\"))\n71\t\n72\t\t\tclock = &libtimemocks.CurrentDateTimeGetter{}\n73\t\t\tclock.NowReturns(libtime.DateTime(time.Date(2026, 6, 15, 10, 0, 0, 0, time.UTC)))\n74\t\n75\t\t\texecutor = command.NewCreateTaskExecutor(fakeGit, taskDir, \"openclaw\", clock, testK)\n76\t\t\tschemaID = cdb.SchemaID{Group: \"agent\", Kind: \"task\", Version: \"v1\"}\n77\t\t})\n78\t\n79\t\tAfterEach(func() {\n80\t\t\tExpect(os.RemoveAll(tmpDir)).To(Succeed())\n81\t\t})\n82\t\n83\t\tbuildCmdObj := func(cmd task.CreateCommand) cdb.CommandObject {\n84\t\t\tevent, err := base.ParseEvent(ctx, cmd)\n85\t\t\tExpect(err).NotTo(HaveOccurred())\n86\t\t\treturn cdb.CommandObject{\n87\t\t\t\tCommand: base.Command{\n88\t\t\t\t\tRequestID: base.NewRequestID(),\n89\t\t\t\t\tOperation: task.CreateCommandOperation,\n90\t\t\t\t\tInitiator: \"test\",\n91\t\t\t\t\tData:      event,\n92\t\t\t\t},\n93\t\t\t\tSchemaID: schemaID,\n94\t\t\t}\n95\t\t}\n96\t\n97\t\tDescribe(\"CommandOperation\", func() {\n98\t\t\tIt(\"returns create-task\", func() {\n99\t\t\t\tExpect(executor.CommandOperation()).To(Equal(base.CommandOperation(\"create-task\")))\n100\t\t\t})\n101\t\t})\n102\t\n103\t\tDescribe(\"HandleCommand\", func() {\n104\t\t\tContext(\"malformed command payload\", func() {\n105\t\t\t\tIt(\"returns ErrCommandObjectSkipped without writing\", func() {\n106\t\t\t\t\t// A channel is not JSON-marshalable, so MarshalInto will fail.\n107\t\t\t\t\tcmdObj := cdb.CommandObject{\n108\t\t\t\t\t\tCommand: base.Command{\n109\t\t\t\t\t\t\tRequestID: base.NewRequestID(),\n110\t\t\t\t\t\t\tOperation: task.CreateCommandOperation,\n111\t\t\t\t\t\t\tInitiator: \"test\",\n112\t\t\t\t\t\t\tData:      base.Event{\"taskIdentifier\": make(chan int)},\n113\t\t\t\t\t\t},\n114\t\t\t\t\t\tSchemaID: schemaID,\n115\t\t\t\t\t}\n116\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n117\t\t\t\t\tExpect(err).To(HaveOccurred())\n118\t\t\t\t\tExpect(errors.Is(err, cdb.ErrCommandObjectSkipped)).To(BeTrue())\n119\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n120\t\t\t\t})\n121\t\t\t})\n122\t\n123\t\t\tContext(\"empty TaskIdentifier\", func() {\n124\t\t\t\tIt(\"returns a validation error without writing\", func() {\n125\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n126\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"\"),\n127\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n128\t\t\t\t\t\t\t\"assignee\": \"claude\",\n129\t\t\t\t\t\t\t\"status\":   \"next\",\n130\t\t\t\t\t\t},\n131\t\t\t\t\t})\n132\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n133\t\t\t\t\tExpect(err).To(HaveOccurred())\n134\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n135\t\t\t\t})\n136\t\t\t})\n137\t\n138\t\t\tContext(\"empty assignee in frontmatter (task born parked)\", func() {\n139\t\t\t\t// An empty assignee is the operator-inbox signal, not a defect:\n140\t\t\t\t// github-pr-watcher's untrusted-author path creates tasks with\n141\t\t\t\t// `assignee: \"\", phase: human_review` so a human picks them up.\n142\t\t\t\t// Requiring assignee here silently dropped every such task.\n143\t\t\t\tIt(\"creates the task without an assignee\", func() {\n144\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n145\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n146\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n147\t\t\t\t\t\t\t\"status\": \"todo\",\n148\t\t\t\t\t\t\t\"phase\":  \"human_review\",\n149\t\t\t\t\t\t},\n150\t\t\t\t\t})\n151\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n152\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n153\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1))\n154\t\t\t\t})\n155\t\t\t})\n156\t\n157\t\t\tContext(\"missing status in frontmatter\", func() {\n158\t\t\t\tIt(\"returns a validation error without writing\", func() {\n159\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n160\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n161\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n162\t\t\t\t\t\t\t\"assignee\": \"claude\",\n163\t\t\t\t\t\t},\n164\t\t\t\t\t})\n165\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n166\t\t\t\t\tExpect(err).To(HaveOccurred())\n167\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"status\"))\n168\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n169\t\t\t\t})\n170\t\t\t})\n171\t\n172\t\t\tContext(\"title path already occupied (collision)\", func() {\n173\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC2)\", func() {\n174\t\t\t\t\t// Second ReadFile call returns existing content → collision on replay.\n175\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(0,\n176\t\t\t\t\t\tnil, errors.New(\"GET 24 Tasks/Replay Task.md returned 404: not found\"))\n177\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n178\t\t\t\t\t\t1,\n179\t\t\t\t\t\t[]byte(\n180\t\t\t\t\t\t\t\"---\\ntask_identifier: replay-task\\nassignee: claude\\nstatus: next\\n---\\n\",\n181\t\t\t\t\t\t),\n182\t\t\t\t\t\tnil,\n183\t\t\t\t\t)\n184\t\n185\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n186\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"replay-task\"),\n187\t\t\t\t\t\tTitle:          \"Replay Task\",\n188\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n189\t\t\t\t\t})\n190\t\n191\t\t\t\t\t// First create: file not found → writes via create-only.\n192\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n193\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n194\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1))\n195\t\n196\t\t\t\t\t// Replay: file now exists → sentinel, no second write.\n197\t\t\t\t\t_, _, err = executor.HandleCommand(ctx, nil, cmdObj)\n198\t\t\t\t\tExpect(err).To(HaveOccurred())\n199\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n200\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1)) // still 1\n201\t\t\t\t})\n202\t\t\t})\n203\t\n204\t\t\tContext(\"new filename\", func() {\n205\t\t\t\tIt(\"writes exactly once and returns nil when ReadFile reports not-found (AC3)\", func() {\n206\t\t\t\t\tfakeGit.ReadFileReturns(\n207\t\t\t\t\t\tnil,\n208\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Brand New.md returned 404: not found\"),\n209\t\t\t\t\t)\n210\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n211\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"brand-new\"),\n212\t\t\t\t\t\tTitle:          \"Brand New\",\n213\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n214\t\t\t\t\t})\n215\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n216\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n217\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1))\n218\t\t\t\t})\n219\t\t\t})\n220\t\n221\t\t\tContext(\"collision with a different task_identifier\", func() {\n222\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC4)\", func() {\n223\t\t\t\t\t// Existing file at the title path belongs to a DIFFERENT task and its status\n224\t\t\t\t\t// \"todo\" is non-terminal — filename owns the slot, no overwrite.\n225\t\t\t\t\tfakeGit.ReadFileReturns(\n226\t\t\t\t\t\t[]byte(\n227\t\t\t\t\t\t\t\"---\\ntask_identifier: someone-else\\nassignee: alice\\nstatus: todo\\n---\\n\",\n228\t\t\t\t\t\t),\n229\t\t\t\t\t\tnil,\n230\t\t\t\t\t)\n231\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n232\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"new-task-id\"),\n233\t\t\t\t\t\tTitle:          \"My Colliding Task\",\n234\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n235\t\t\t\t\t})\n236\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n237\t\t\t\t\tExpect(err).To(HaveOccurred())\n238\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeTrue())\n239\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n240\t\t\t\t})\n241\t\t\t})\n242\t\n243\t\t\tContext(\"transient git-rest read error\", func() {\n244\t\t\t\tIt(\"propagates the wrapped error and does not write (AC5)\", func() {\n245\t\t\t\t\tfakeGit.ReadFileReturns(\n246\t\t\t\t\t\tnil,\n247\t\t\t\t\t\terrors.New(\"GET 24 Tasks/Flaky.md returned 503: service unavailable\"),\n248\t\t\t\t\t)\n249\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n250\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"flaky-task\"),\n251\t\t\t\t\t\tTitle:          \"Flaky\",\n252\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n253\t\t\t\t\t})\n254\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n255\t\t\t\t\tExpect(err).To(HaveOccurred())\n256\t\t\t\t\tExpect(errors.Is(err, task.ErrTaskAlreadyExists)).To(BeFalse())\n257\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"503\"))\n258\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n259\t\t\t\t})\n260\t\t\t})\n261\t\n262\t\t\tContext(\"terminal status completed frees the title path (reopen)\", func() {\n263\t\t\t\tIt(\n264\t\t\t\t\t\"materializes a fresh non-terminal task over the completed file (AC terminal-completed)\",\n265\t\t\t\t\tfunc() {\n266\t\t\t\t\t\tfakeGit.ReadFileReturns(\n267\t\t\t\t\t\t\t[]byte(\n268\t\t\t\t\t\t\t\t\"---\\ntask_identifier: old-id\\nassignee: alice\\nstatus: completed\\nphase: done\\ncompleted_date: 2026-06-01T10:00:00Z\\n---\\npremature triage verdict for this alert\\n\",\n269\t\t\t\t\t\t\t),\n270\t\t\t\t\t\t\tnil,\n271\t\t\t\t