{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9ddc0d44f2de9d21","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage command\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"maps\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\tlib \"github.com/bborbe/agent\"\n15\t\ttask \"github.com/bborbe/agent/command/task\"\n16\t\t\"github.com/bborbe/cqrs/base\"\n17\t\t\"github.com/bborbe/cqrs/cdb\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibkv \"github.com/bborbe/kv\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/validation\"\n22\t\t\"github.com/golang/glog\"\n23\t\n24\t\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n25\t\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n26\t\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n27\t)\n28\t\n29\t// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n30\t// a new vault task file for the given task_identifier. If cmd.Title passes validation\n31\t// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n32\t// A file that already exists at the resolved path causes ErrTaskAlreadyExists (a benign\n33\t// Failure on the result topic — no overwrite, no git write) UNLESS the existing file's\n34\t// status is terminal (\"completed\"/\"aborted\"), in which case a fresh non-terminal task is\n35\t// materialized at that path.\n36\t// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n37\t// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n38\t// match vaultName are skipped without side effects (no git write, no error, no result event).\n39\tfunc NewCreateTaskExecutor(\n40\t\tgitClient gitclient.GitClient,\n41\t\ttaskDir string,\n42\t\tvaultName string,\n43\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n44\t\tk int,\n45\t) cdb.CommandObjectExecutorTx {\n46\t\treturn cdb.CommandObjectExecutorTxFunc(\n47\t\t\ttask.CreateCommandOperation,\n48\t\t\ttrue,\n49\t\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n50\t\t\t\tvar cmd task.CreateCommand\n51\t\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n52\t\t\t\t\treturn nil, nil, errors.Wrapf(\n53\t\t\t\t\t\tctx,\n54\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n55\t\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n56\t\t\t\t\t\terr,\n57\t\t\t\t\t)\n58\t\t\t\t}\n59\t\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n60\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n61\t\t\t\t}\n62\t\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n63\t\t\t\t\teffective := cmd.TargetVault\n64\t\t\t\t\tif effective == \"\" {\n65\t\t\t\t\t\teffective = routing.LegacyDefaultVault\n66\t\t\t\t\t}\n67\t\t\t\t\tglog.V(2).Infof(\n68\t\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n69\t\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n70\t\t\t\t\t)\n71\t\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n72\t\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n73\t\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n74\t\t\t\t\treturn nil, nil, errors.Wrapf(\n75\t\t\t\t\t\tctx,\n76\t\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n77\t\t\t\t\t\t\"cross-vault create for task %s\",\n78\t\t\t\t\t\tcmd.TaskIdentifier,\n79\t\t\t\t\t)\n80\t\t\t\t}\n81\t\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n82\t\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n83\t\t\t\t}\n84\t\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n85\t\t\t\treopened, priorStatus, err := checkTitlePathFree(\n86\t\t\t\t\tctx,\n87\t\t\t\t\tgitClient,\n88\t\t\t\t\trelPath,\n89\t\t\t\t\tcmd.TaskIdentifier,\n90\t\t\t\t)\n91\t\t\t\tif err != nil {\n92\t\t\t\t\treturn nil, nil, err\n93\t\t\t\t}\n94\t\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName, reopened, priorStatus); err != nil {\n95\t\t\t\t\treturn nil, nil, err\n96\t\t\t\t}\n97\t\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n98\t\t\t\treturn nil, nil, nil\n99\t\t\t},\n100\t\t)\n101\t}\n102\t\n103\t// checkTitlePathFree reports whether the title path is free for a new task.\n104\t// The slot is free when the path is unoccupied (git-rest 404) OR when the\n105\t// existing file's frontmatter status is a terminal status (\"completed\" or\n106\t// \"aborted\", compared case-sensitively after whitespace trim) — a terminal\n107\t// task is no longer a live duplicate, so the slot is reusable. On a\n108\t// terminal-status free it returns reopened=true and the prior status so the\n109\t// caller can distinguish a reopen from a first-ever create. Every other\n110\t// occupied state — any non-terminal status, an absent/empty/unknown status,\n111\t// missing frontmatter delimiters, or unparseable YAML — returns\n112\t// ErrTaskAlreadyExists (a benign Failure on the result topic — no overwrite,\n113\t// no git write) wrapped with the \"title path %s occupied\" message shape. A\n114\t// transient git-rest read error is propagated. The decision consumes the\n115\t// bytes already read by this function; the caller must not issue a second\n116\t// ReadFile.\n117\tfunc checkTitlePathFree(\n118\t\tctx context.Context,\n119\t\tgitClient gitclient.GitClient,\n120\t\trelPath string,\n121\t\ttaskIdentifier lib.TaskIdentifier,\n122\t) (reopened bool, priorStatus string, err error) {\n123\t\texisting, err := gitClient.ReadFile(ctx, relPath)\n124\t\tif err != nil {\n125\t\t\tif !isNotFoundReadError(err) {\n126\t\t\t\treturn false, \"\", errors.Wrapf(\n127\t\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n128\t\t\t\t)\n129\t\t\t}\n130\t\t\t// git-rest 404: the title path is free, first-ever create.\n131\t\t\treturn false, \"\", nil\n132\t\t}\n133\t\tfrontmatterStr, parseErr := result.ExtractFrontmatter(ctx, existing)\n134\t\tif parseErr != nil {\n135\t\t\tglog.Warningf(\n136\t\t\t\t\"create-task: cannot read status from existing file at %s for %s; holding title path: %v\",\n137\t\t\t\trelPath,\n138\t\t\t\ttaskIdentifier,\n139\t\t\t\tparseErr,\n140\t\t\t)\n141\t\t\treturn false, \"\", errors.Wrapf(\n142\t\t\t\tctx,\n143\t\t\t\ttask.ErrTaskAlreadyExists,\n144\t\t\t\t\"title path %s occupied\",\n145\t\t\t\trelPath,\n146\t\t\t)\n147\t\t}\n148\t\texistingFm, parseErr := parseTaskFrontmatter(frontmatterStr)\n149\t\tif parseErr != nil {\n150\t\t\tglog.Warningf(\n151\t\t\t\t\"create-task: cannot parse frontmatter of existing file at %s for %s; holding title path: %v\",\n152\t\t\t\trelPath,\n153\t\t\t\ttaskIdentifier,\n154\t\t\t\tparseErr,\n155\t\t\t)\n156\t\t\treturn false, \"\", errors.Wrapf(\n157\t\t\t\tctx,\n158\t\t\t\ttask.ErrTaskAlreadyExists,\n159\t\t\t\t\"title path %s occupied\",\n160\t\t\t\trelPath,\n161\t\t\t)\n162\t\t}\n163\t\tstatus, _ := existingFm.String(\"status\")\n164\t\tstatus = strings.TrimSpace(status)\n165\t\tif status == \"completed\" || status == \"aborted\" {\n166\t\t\treturn true, status, nil\n167\t\t}\n168\t\tglog.V(2).Infof(\n169\t\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n170\t\t\trelPath,\n171\t\t\tlen(existing),\n172\t\t\ttaskIdentifier,\n173\t\t)\n174\t\treturn false, \"\", errors.Wrapf(\n175\t\t\tctx,\n176\t\t\ttask.ErrTaskAlreadyExists,\n177\t\t\t\"title path %s occupied\",\n178\t\t\trelPath,\n179\t\t)\n180\t}\n181\t\n182\t// writeTaskFile builds the task content and writes it atomically to the vault\n183\t// via git-rest, then logs the creation. vaultName is stamped as target_vault so\n184\t// the created task is self-describing for the result-path routing guard.\n185\t// reopened and priorStatus carry the reopen signal from the title-path collision\n186\t// check — reopened is true only when the slot was freed by a terminal-status\n187\t// file, and priorStatus is that file's status — for the write path to use.\n188\tfunc writeTaskFile(\n189\t\tctx context.Context,\n190\t\tgitClient gitclient.GitClient,\n191\t\trelPath string,\n192\t\tcmd task.CreateCommand,\n193\t\tvaultName string,\n194\t\treopened bool,\n195\t\tpriorStatus string,\n196\t) error {\n197\t\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n198\t\tif err != nil {\n199\t\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n200\t\t}\n201\t\tabsPath := filepath.Join(gitClient.Path(), relPath)\n202\t\tif err := gitClient.AtomicWriteAndCommitPush(\n203\t\t\tctx,\n204\t\t\tabsPath,\n205\t\t\tcontent,\n206\t\t\t\"[agent-task-controller] create task \"+string(cmd.TaskIdentifier),\n207\t\t); err != nil {\n208\t\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n209\t\t}\n210\t\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n211\t\treturn nil\n212\t}\n213\t\n214\t// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n215\t// file should be written. If cmd.Title passes validation and contains no path\n216\t// separators, the title-derived path is returned; otherwise a WARN is logged and\n217\t// the UUID-derived path is returned as fallback so the task is always materialized.\n218\t// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n219\t// function no longer reads the vault or compares task_identifier.\n220\tfunc resolveCreateTaskRelPath(\n221\t\tctx context.Context,\n222\t\ttaskDir string,\n223\t\tcmd task.CreateCommand,\n224\t) string {\n225\t\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n226\t\n227\t\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n228\t\tif err := cmd.Validate(ctx); err != nil {\n229\t\t\tglog.Warningf(\n230\t\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n231\t\t\t\tcmd.TaskIdentifier, err,\n232\t\t\t)\n233\t\t\treturn uuidRelPath\n234\t\t}\n235\t\n236\t\t// Reject titles containing path separators to prevent path traversal.\n237\t\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n238\t\t\tglog.Warningf(\n239\t\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n240\t\t\t\tcmd.Title,\n241\t\t\t)\n242\t\t\treturn uuidRelPath\n243\t\t}\n244\t\n245\t\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n246\t}\n247\t\n248\t// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n249\t// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n250\t// typed not-found sentinel, so this matches the \"404\" status embedded in the\n251\t// wrapped error message produced by gitRestClient.Get\n252\t// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n253\t// be handled by the caller before calling this helper.\n254\tfunc isNotFoundReadError(err error) bool {\n255\t\tif err == nil {\n256\t\t\treturn false\n257\t\t}\n258\t\treturn strings.Contains(err.Error(), \"returned 404\")\n259\t}\n260\t\n261\t// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n262\t// unusable downstream.\n263\t//\n264\t// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n265\t// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n266\t// doctrine): escalation clears the assignee so no agent claims the task and a\n267\t// human picks it up. Requiring it here made a task that is *born* parked\n268\t// unrepresentable — github-pr-watcher's untrusted-author path stamps\n269\t// `assignee: \"\", phase: human_review` and every such command was rejected, so\n270\t// the PR silently never reached the operator queue (bborbe/git-sync#5,\n271\t// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n272\t// so accepting it at create matches how update and dispatch already behave.\n273\tfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n274\t\tif s, _ := fm.String(\"status\"); s == \"\" {\n275\t\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n276\t\t}\n277\t\treturn nil\n278\t}\n279\t\n280\tfunc buildCreateTaskContent(\n281\t\tctx context.Context,\n282\t\tcmd task.CreateCommand,\n283\t\tvaultName string,\n284\t) ([]byte, error) {\n285\t\tfm := make(lib.TaskFrontmatter)\n286\t\tmaps.Copy(fm, cmd.Frontmatter)\n287\t\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n288\t\tfm[\"target_vault\"] = vaultName\n289\t\treturn marshalFileContent(ctx, fm, cmd.Body)\n290\t}\n291\t\n292\t// supersedePriorRecurringTask collapses a recurring schedule to a single open\n293\t// instance: after a new instance is materialized it lists same-slug candidates,\n294\t// excludes the new instance, ranks them most-recent-first, and transitions every\n295\t// still-in_progress candidate whose period-token is strictly older than the new\n296\t// instance's token to aborted — capped at the k most-recent such candidates.\n297\t// Best-effort: list/read/parse/write errors on any single file are logged and\n298\t// swallowed; the already-written new instance is never rolled back. newRelPath is\n299\t// the repo-root-relative path of the new instance (the superseded_by back-pointer).\n300\tfunc supersedePriorRecurringTask(\n301\t\tctx context.Context,\n302\t\tgitClient gitclient.GitClient,\n303\t\ttaskDir string,\n304\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n305\t\tk int,\n306\t\tcmd task.CreateCommand,\n307\t\tnewRelPath string,\n308\t) {\n309\t\tif !isEligibleForSupersede(cmd) {\n310\t\t\treturn\n311\t\t}\n312\t\tslug, newToken, ok := splitTitleToken(cmd.Title)\n313\t\tif !ok {\n314\t\t\tglog.V(3).Infof(\n315\t\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n316\t\t\t\tcmd.Title, cmd.TaskIdentifier,\n317\t\t\t)\n318\t\t\treturn\n319\t\t}\n320\t\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n321\t\tif err != nil {\n322\t\t\tglog.Warningf(\n323\t\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n324\t\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n325\t\t\t)\n326\t\t\treturn\n327\t\t}\n328\t\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n329\t\tif err != nil {\n330\t\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n331\t\t\treturn\n332\t\t}\n333\t\t// Exclude the new instance and rank.\n334\t\tvar kept []string\n335\t\tfor _, t := range titles {\n336\t\t\tif err := ctx.Err(); err != nil {\n337\t\t\t\treturn\n338\t\t\t}\n339\t\t\tif t == cmd.Title {\n340\t\t\t\tcontinue\n341\t\t\t}\n342\t\t\tkept = append(kept, t)\n343\t\t}\n344\t\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n345\t\tcollapseCandidates(\n346\t\t\tctx,\n347\t\t\tgitClient,\n348\t\t\ttaskDir,\n349\t\t\tcurrentDateTime,\n350\t\t\tk,\n351\t\t\tranked,\n352\t\t\tnewOrdinal,\n353\t\t\tnewRelPath,\n354\t\t\tcmd,\n355\t\t)\n356\t}\n357\t\n358\t// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n359\t// returns their TITLES (basename without \".md\"), filtered to those whose title\n360\t// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n361\t// glob metacharacters; otherwise it lists all task files and filters in memory\n362\t// (glob-injection defense). List errors are returned; the caller logs them once.\n363\tfunc listSameSlugCandidateTitles(\n364\t\tctx context.Context,\n365\t\tgitClient gitclient.GitClient,\n366\t\ttaskDir string,\n367\t\tslug string,\n368\t) ([]string, error) {\n369\t\tprefix := slug + \" - \"\n370\t\tvar glob string\n371\t\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n372\t\t\tglob = filepath.Join(taskDir, \"*.md\")\n373\t\t\tglog.V(2).Infof(\n374\t\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n375\t\t\t\tslug,\n376\t\t\t)\n377\t\t} else {\n378\t\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n379\t\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n380\t\t}\n381\t\trelPaths, err := gitClient.ListFiles(ctx, glob)\n382\t\tif err != nil {\n383\t\t\treturn nil, err\n384\t\t}\n385\t\tvar titles []string\n386\t\tfor _, relPath := range relPaths {\n387\t\t\tif err := ctx.Err(); err != nil {\n388\t\t\t\treturn nil, err\n389\t\t\t}\n390\t\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n391\t\t\tif strings.HasPrefix(title, prefix) {\n392\t\t\t\ttitles = append(titles, title)\n393\t\t\t}\n394\t\t}\n395\t\treturn titles, nil\n396\t}\n397\t\n398\t// collapseCandidates iterates ranked candidates most-recent-first, transitions\n399\t// each still-in_progress candidate older than newOrdinal to aborted, and stops\n400\t// after k candidates have been inspected (read attempted). Best-effort per file.\n401\tfunc collapseCandidates(\n402\t\tctx context.Context,\n403\t\tgitClient gitclient.GitClient,\n404\t\ttaskDir string,\n405\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n406\t\tk int,\n407\t\tranked []rankedCandidate,\n408\t\tnewOrdinal int64,\n409\t\tnewRelPath string,\n410\t\tcmd task.CreateCommand,\n411\t) {\n412\t\tinspected := 0\n413\t\tfor _, rc := range ranked {\n414\t\t\tif err := ctx.Err(); err != nil {\n415\t\t\t\treturn\n416\t\t\t}\n417\t\t\tif inspected >= k {\n418\t\t\t\tbreak\n419\t\t\t}\n420\t\t\tif rc.Ordinal > newOrdinal {\n421\t\t\t\tcontinue\n422\t\t\t}\n423\t\t\tinspected++\n424\t\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n425\t\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n426\t\t\t\tglog.Warningf(\n427\t\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n428\t\t\t\t\trc.Title, cmd.TaskIdentifier,\n429\t\t\t\t)\n430\t\t\t\tcontinue\n431\t\t\t}\n432\t\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n433\t\t\tif err != nil || content == nil {\n434\t\t\t\tcontinue\n435\t\t\t}\n436\t\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n437\t\t\t\tcontinue\n438\t\t\t}\n439\t\t\ttransitionPrior(\n440\t\t\t\tctx,\n441\t\t\t\tgitClient,\n442\t\t\t\tcurrentDateTime,\n443\t\t\t\tcandidateRelPath,\n444\t\t\t\trc.Title,\n445\t\t\t\tnewRelPath,\n446\t\t\t\tcmd.TaskIdentifier,\n447\t\t\t)\n448\t\t}\n449\t}\n450\t\n451\t// isEligibleForSupersede reports whether cmd is a recurring-task instance\n452\t// that should auto-supersede its prior. Returns true only when created_by is\n453\t// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n454\t// Returns false (no supersede) when auto_abort_prior is absent or false — the\n455\t// safe default that prevents accidental supersede of audit-style tasks.\n456\tfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n457\t\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n458\t\tif createdBy != \"recurring-task-creator\" {\n459\t\t\tglog.V(3).\n460\t\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n461\t\t\treturn false\n462\t\t}\n463\t\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n464\t\t\treturn true\n465\t\t}\n466\t\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n467\t\t\treturn true\n468\t\t}\n469\t\tglog.V(3).\n470\t\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n471\t\treturn false\n472\t}\n473\t\n474\t// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n475\t// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n476\t// transient git-rest error (logged by caller).\n477\tfunc readPriorForSupersede(\n478\t\tctx context.Context,\n479\t\tgitClient gitclient.GitClient,\n480\t\tpriorRelPath string,\n481\t\ttaskIdentifier lib.TaskIdentifier,\n482\t) ([]byte, error) {\n483\t\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n484\t\tif err == nil {\n485\t\t\treturn content, nil\n486\t\t}\n487\t\tif isNotFoundReadError(err) {\n488\t\t\tglog.V(3).\n489\t\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n490\t\t\treturn nil, nil\n491\t\t}\n492\t\tglog.Warningf(\n493\t\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n494\t\t\tpriorRelPath,\n495\t\t\ttaskIdentifier,\n496\t\t\terr,\n497\t\t)\n498\t\treturn nil, err\n499\t}\n500\t\n501\t// priorIsInProgress parses the prior file's frontmatter and reports whether\n502\t// its status is in_progress. Returns false (no-op) on parse error or any\n503\t// non-in_progress status.\n504\tfunc priorIsInProgress(\n505\t\tctx context.Context,\n506\t\tcontent []byte,\n507\t\tpriorRelPath string,\n508\t\ttaskIdentifier lib.TaskIdentifier,\n509\t) bool {\n510\t\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n511\t\tif err != nil {\n512\t\t\tglog.Warningf(\n513\t\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n514\t\t\t\tpriorRelPath,\n515\t\t\t\ttaskIdentifier,\n516\t\t\t\terr,\n517\t\t\t)\n518\t\t\treturn false\n519\t\t}\n520\t\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n521\t\tif err != nil {\n522\t\t\tglog.Warningf(\n523\t\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n524\t\t\t\tpriorRelPath,\n525\t\t\t\ttaskIdentifier,\n526\t\t\t\terr,\n527\t\t\t)\n528\t\t\treturn false\n529\t\t}\n530\t\tstatus, _ := priorFm.String(\"status\")\n531\t\tif status != \"in_progress\" {\n532\t\t\tglog.V(3).\n533\t\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n534\t\t\treturn false\n535\t\t}\n536\t\treturn true\n537\t}\n538\t\n539\t// transitionPrior performs the read-modify-write that transitions the prior\n540\t// file to aborted. Best-effort: write errors are logged and swallowed.\n541\tfunc transitionPrior(\n542\t\tctx context.Context,\n543\t\tgitClient gitclient.GitClient,\n544\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n545\t\tpriorRelPath string,\n546\t\tpriorTitle string,\n547\t\tnewRelPath string,\n548\t\ttaskIdentifier lib.TaskIdentifier,\n549\t) {\n550\t\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n551\t\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n552\t\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n553\t\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n554\t\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n555\t\t\tglog.Warningf(\n556\t\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n557\t\t\t\tpriorRelPath,\n558\t\t\t\ttaskIdentifier,\n559\t\t\t\terr,\n560\t\t\t)\n561\t\t\treturn\n562\t\t}\n563\t\tglog.V(2).Infof(\n564\t\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n565\t\t\tpriorRelPath,\n566\t\t\tnewRelPath,\n567\t\t)\n568\t}\n569\t\n570\t// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n571\t// that transitions a prior-period recurring-task instance to aborted.\n572\tfunc buildSupersedeModifyFn(\n573\t\tctx context.Context,\n574\t\tnewRelPath string,\n575\t\tts string,\n576\t) func([]byte) ([]byte, error) {\n577\t\treturn func(current []byte) ([]byte, error) {\n578\t\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n579\t\t\tif err != nil {\n580\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n581\t\t\t}\n582\t\t\tbody, err := result.ExtractBody(ctx, current)\n583\t\t\tif err != nil {\n584\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n585\t\t\t}\n586\t\t\tfm, err := parseTaskFrontmatter(fmStr)\n587\t\t\tif err != nil {\n588\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n589\t\t\t}\n590\t\t\tfm[\"status\"] = \"aborted\"\n591\t\t\tfm[\"phase\"] = \"done\"\n592\t\t\tfm[\"completed_date\"] = ts\n593\t\t\tfm[\"superseded_by\"] = newRelPath\n594\t\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n595\t\t\treturn marshalFileContent(ctx, fm, body)\n596\t\t}\n597\t}\n598\t"}]},"parent_tool_use_id":null,"session_id":"60f8de36-9160-4048-8723-df7d215fbbd1","uuid":"ae05f24f-a4be-439a-b7ae-a7c0471e1cc4","timestamp":"2026-08-27T18:53:58.243Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/command/task_create_task_executor.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage command\n\nimport (\n\t\"context\"\n\t\"maps\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\ttask \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/cqrs/cdb\"\n\t\"github.com/bborbe/errors\"\n\tlibkv \"github.com/bborbe/kv\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/bborbe/validation\"\n\t\"github.com/golang/glog\"\n\n\tgitclient \"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n\tresult \"github.com/bborbe/agent-task-controller/pkg/result\"\n\t\"github.com/bborbe/agent-task-controller/pkg/routing\"\n)\n\n// NewCreateTaskExecutor creates a cdb.CommandObjectExecutorTx that materializes\n// a new vault task file for the given task_identifier. If cmd.Title passes validation\n// the file is written at tasks/{title}.md; otherwise it falls back to tasks/{task_identifier}.md.\n// A file that already exists at the resolved path causes ErrTaskAlreadyExists (a benign\n// Failure on the result topic — no overwrite, no git write) UNLESS the existing file's\n// status is terminal (\"completed\"/\"aborted\"), in which case a fresh non-terminal task is\n// materialized at that path.\n// Frontmatter must include \"assignee\" and \"status\"; missing fields return a wrapped validation error.\n// Commands whose effective target vault (cmd.TargetVault or the legacy fallback) does not\n// match vaultName are skipped without side effects (no git write, no error, no result event).\nfunc NewCreateTaskExecutor(\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tvaultName string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n) cdb.CommandObjectExecutorTx {\n\treturn cdb.CommandObjectExecutorTxFunc(\n\t\ttask.CreateCommandOperation,\n\t\ttrue,\n\t\tfunc(ctx context.Context, tx libkv.Tx, commandObject cdb.CommandObject) (*base.EventID, base.Event, error) {\n\t\t\tvar cmd task.CreateCommand\n\t\t\tif err := commandObject.Command.Data.MarshalInto(ctx, &cmd); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"malformed CreateTaskCommand: %v\",\n\t\t\t\t\terr,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := cmd.TaskIdentifier.Validate(ctx); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate task_identifier\")\n\t\t\t}\n\t\t\tif !routing.ShouldProcess(cmd, vaultName) {\n\t\t\t\teffective := cmd.TargetVault\n\t\t\t\tif effective == \"\" {\n\t\t\t\t\teffective = routing.LegacyDefaultVault\n\t\t\t\t}\n\t\t\t\tglog.V(2).Infof(\n\t\t\t\t\t\"create-task: skipped vault mismatch target=%q effective=%q vault=%q task=%s\",\n\t\t\t\t\tcmd.TargetVault, effective, vaultName, cmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t\t// ErrCommandObjectSkipped — not nil: a nil return with SendResultEnabled\n\t\t\t\t// publishes a spurious Success result on the shared result topic for every\n\t\t\t\t// cross-vault create (go-cqrs/skipped-not-nil-for-non-retryable).\n\t\t\t\treturn nil, nil, errors.Wrapf(\n\t\t\t\t\tctx,\n\t\t\t\t\tcdb.ErrCommandObjectSkipped,\n\t\t\t\t\t\"cross-vault create for task %s\",\n\t\t\t\t\tcmd.TaskIdentifier,\n\t\t\t\t)\n\t\t\t}\n\t\t\tif err := validateCreateTaskFrontmatter(ctx, cmd.Frontmatter); err != nil {\n\t\t\t\treturn nil, nil, errors.Wrapf(ctx, err, \"validate frontmatter\")\n\t\t\t}\n\t\t\trelPath := resolveCreateTaskRelPath(ctx, taskDir, cmd)\n\t\t\treopened, priorStatus, err := checkTitlePathFree(\n\t\t\t\tctx,\n\t\t\t\tgitClient,\n\t\t\t\trelPath,\n\t\t\t\tcmd.TaskIdentifier,\n\t\t\t)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tif err := writeTaskFile(ctx, gitClient, relPath, cmd, vaultName, reopened, priorStatus); err != nil {\n\t\t\t\treturn nil, nil, err\n\t\t\t}\n\t\t\tsupersedePriorRecurringTask(ctx, gitClient, taskDir, currentDateTime, k, cmd, relPath)\n\t\t\treturn nil, nil, nil\n\t\t},\n\t)\n}\n\n// checkTitlePathFree reports whether the title path is free for a new task.\n// The slot is free when the path is unoccupied (git-rest 404) OR when the\n// existing file's frontmatter status is a terminal status (\"completed\" or\n// \"aborted\", compared case-sensitively after whitespace trim) — a terminal\n// task is no longer a live duplicate, so the slot is reusable. On a\n// terminal-status free it returns reopened=true and the prior status so the\n// caller can distinguish a reopen from a first-ever create. Every other\n// occupied state — any non-terminal status, an absent/empty/unknown status,\n// missing frontmatter delimiters, or unparseable YAML — returns\n// ErrTaskAlreadyExists (a benign Failure on the result topic — no overwrite,\n// no git write) wrapped with the \"title path %s occupied\" message shape. A\n// transient git-rest read error is propagated. The decision consumes the\n// bytes already read by this function; the caller must not issue a second\n// ReadFile.\nfunc checkTitlePathFree(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) (reopened bool, priorStatus string, err error) {\n\texisting, err := gitClient.ReadFile(ctx, relPath)\n\tif err != nil {\n\t\tif !isNotFoundReadError(err) {\n\t\t\treturn false, \"\", errors.Wrapf(\n\t\t\t\tctx, err, \"check existing task file at %s for %s\", relPath, taskIdentifier,\n\t\t\t)\n\t\t}\n\t\t// git-rest 404: the title path is free, first-ever create.\n\t\treturn false, \"\", nil\n\t}\n\tfrontmatterStr, parseErr := result.ExtractFrontmatter(ctx, existing)\n\tif parseErr != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: cannot read status from existing file at %s for %s; holding title path: %v\",\n\t\t\trelPath,\n\t\t\ttaskIdentifier,\n\t\t\tparseErr,\n\t\t)\n\t\treturn false, \"\", errors.Wrapf(\n\t\t\tctx,\n\t\t\ttask.ErrTaskAlreadyExists,\n\t\t\t\"title path %s occupied\",\n\t\t\trelPath,\n\t\t)\n\t}\n\texistingFm, parseErr := parseTaskFrontmatter(frontmatterStr)\n\tif parseErr != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: cannot parse frontmatter of existing file at %s for %s; holding title path: %v\",\n\t\t\trelPath,\n\t\t\ttaskIdentifier,\n\t\t\tparseErr,\n\t\t)\n\t\treturn false, \"\", errors.Wrapf(\n\t\t\tctx,\n\t\t\ttask.ErrTaskAlreadyExists,\n\t\t\t\"title path %s occupied\",\n\t\t\trelPath,\n\t\t)\n\t}\n\tstatus, _ := existingFm.String(\"status\")\n\tstatus = strings.TrimSpace(status)\n\tif status == \"completed\" || status == \"aborted\" {\n\t\treturn true, status, nil\n\t}\n\tglog.V(2).Infof(\n\t\t\"create-task: title path %s already occupied (%d bytes), returning ErrTaskAlreadyExists for %s\",\n\t\trelPath,\n\t\tlen(existing),\n\t\ttaskIdentifier,\n\t)\n\treturn false, \"\", errors.Wrapf(\n\t\tctx,\n\t\ttask.ErrTaskAlreadyExists,\n\t\t\"title path %s occupied\",\n\t\trelPath,\n\t)\n}\n\n// writeTaskFile builds the task content and writes it atomically to the vault\n// via git-rest, then logs the creation. vaultName is stamped as target_vault so\n// the created task is self-describing for the result-path routing guard.\n// reopened and priorStatus carry the reopen signal from the title-path collision\n// check — reopened is true only when the slot was freed by a terminal-status\n// file, and priorStatus is that file's status — for the write path to use.\nfunc writeTaskFile(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\trelPath string,\n\tcmd task.CreateCommand,\n\tvaultName string,\n\treopened bool,\n\tpriorStatus string,\n) error {\n\tcontent, err := buildCreateTaskContent(ctx, cmd, vaultName)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"build task file content for %s\", cmd.TaskIdentifier)\n\t}\n\tabsPath := filepath.Join(gitClient.Path(), relPath)\n\tif err := gitClient.AtomicWriteAndCommitPush(\n\t\tctx,\n\t\tabsPath,\n\t\tcontent,\n\t\t\"[agent-task-controller] create task \"+string(cmd.TaskIdentifier),\n\t); err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"atomic write and push for task %s\", cmd.TaskIdentifier)\n\t}\n\tglog.V(2).Infof(\"create-task: created task file at %s for %s\", relPath, cmd.TaskIdentifier)\n\treturn nil\n}\n\n// resolveCreateTaskRelPath returns the repo-root-relative path where the task\n// file should be written. If cmd.Title passes validation and contains no path\n// separators, the title-derived path is returned; otherwise a WARN is logged and\n// the UUID-derived path is returned as fallback so the task is always materialized.\n// Filename-collision detection is the caller's job (via gitClient.ReadFile) — this\n// function no longer reads the vault or compares task_identifier.\nfunc resolveCreateTaskRelPath(\n\tctx context.Context,\n\ttaskDir string,\n\tcmd task.CreateCommand,\n) string {\n\tuuidRelPath := filepath.Join(taskDir, string(cmd.TaskIdentifier)+\".md\")\n\n\t// Re-validate the command (defense-in-depth: sender may have been bypassed).\n\tif err := cmd.Validate(ctx); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title validation failed for task %s (%v); falling back to UUID path\",\n\t\t\tcmd.TaskIdentifier, err,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\t// Reject titles containing path separators to prevent path traversal.\n\tif strings.ContainsAny(cmd.Title, \"/\\\\\") {\n\t\tglog.Warningf(\n\t\t\t\"create-task: Title %q contains path separator; falling back to UUID path\",\n\t\t\tcmd.Title,\n\t\t)\n\t\treturn uuidRelPath\n\t}\n\n\treturn filepath.Join(taskDir, cmd.Title+\".md\")\n}\n\n// isNotFoundReadError reports whether a gitClient.ReadFile error means the file\n// does not exist (git-rest returns HTTP 404). git-rest's Get does not expose a\n// typed not-found sentinel, so this matches the \"404\" status embedded in the\n// wrapped error message produced by gitRestClient.Get\n// (\"GET <path> returned 404: ...\"). A nil error is NOT a not-found error and must\n// be handled by the caller before calling this helper.\nfunc isNotFoundReadError(err error) bool {\n\tif err == nil {\n\t\treturn false\n\t}\n\treturn strings.Contains(err.Error(), \"returned 404\")\n}\n\n// validateCreateTaskFrontmatter rejects a create-command whose frontmatter is\n// unusable downstream.\n//\n// `assignee` is deliberately NOT required. An empty assignee is the fleet's\n// operator-inbox signal (see the \"Make Parked Agent Tasks Visible to Operator\"\n// doctrine): escalation clears the assignee so no agent claims the task and a\n// human picks it up. Requiring it here made a task that is *born* parked\n// unrepresentable — github-pr-watcher's untrusted-author path stamps\n// `assignee: \"\", phase: human_review` and every such command was rejected, so\n// the PR silently never reached the operator queue (bborbe/git-sync#5,\n// 2026-07-28). `vault_scanner` already treats an empty assignee as unclaimed,\n// so accepting it at create matches how update and dispatch already behave.\nfunc validateCreateTaskFrontmatter(ctx context.Context, fm lib.TaskFrontmatter) error {\n\tif s, _ := fm.String(\"status\"); s == \"\" {\n\t\treturn errors.Wrap(ctx, validation.Error, \"frontmatter missing required field: status\")\n\t}\n\treturn nil\n}\n\nfunc buildCreateTaskContent(\n\tctx context.Context,\n\tcmd task.CreateCommand,\n\tvaultName string,\n) ([]byte, error) {\n\tfm := make(lib.TaskFrontmatter)\n\tmaps.Copy(fm, cmd.Frontmatter)\n\tfm[\"task_identifier\"] = string(cmd.TaskIdentifier)\n\tfm[\"target_vault\"] = vaultName\n\treturn marshalFileContent(ctx, fm, cmd.Body)\n}\n\n// supersedePriorRecurringTask collapses a recurring schedule to a single open\n// instance: after a new instance is materialized it lists same-slug candidates,\n// excludes the new instance, ranks them most-recent-first, and transitions every\n// still-in_progress candidate whose period-token is strictly older than the new\n// instance's token to aborted — capped at the k most-recent such candidates.\n// Best-effort: list/read/parse/write errors on any single file are logged and\n// swallowed; the already-written new instance is never rolled back. newRelPath is\n// the repo-root-relative path of the new instance (the superseded_by back-pointer).\nfunc supersedePriorRecurringTask(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tcmd task.CreateCommand,\n\tnewRelPath string,\n) {\n\tif !isEligibleForSupersede(cmd) {\n\t\treturn\n\t}\n\tslug, newToken, ok := splitTitleToken(cmd.Title)\n\tif !ok {\n\t\tglog.V(3).Infof(\n\t\t\t\"auto-supersede: new title %q has no period-token suffix, skipping for %s\",\n\t\t\tcmd.Title, cmd.TaskIdentifier,\n\t\t)\n\t\treturn\n\t}\n\tnewOrdinal, err := parsePeriodTokenOrdinal(ctx, newToken)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: new token (len %d) unrecognized for %s: %v\",\n\t\t\tlen(newToken), cmd.TaskIdentifier, err,\n\t\t)\n\t\treturn\n\t}\n\ttitles, err := listSameSlugCandidateTitles(ctx, gitClient, taskDir, slug)\n\tif err != nil {\n\t\tglog.Warningf(\"auto-supersede: list candidates failed for slug %q: %v\", slug, err)\n\t\treturn\n\t}\n\t// Exclude the new instance and rank.\n\tvar kept []string\n\tfor _, t := range titles {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif t == cmd.Title {\n\t\t\tcontinue\n\t\t}\n\t\tkept = append(kept, t)\n\t}\n\tranked := rankSameSlugCandidatesDescending(ctx, kept)\n\tcollapseCandidates(\n\t\tctx,\n\t\tgitClient,\n\t\ttaskDir,\n\t\tcurrentDateTime,\n\t\tk,\n\t\tranked,\n\t\tnewOrdinal,\n\t\tnewRelPath,\n\t\tcmd,\n\t)\n}\n\n// listSameSlugCandidateTitles lists task files scoped to a schedule's slug and\n// returns their TITLES (basename without \".md\"), filtered to those whose title\n// starts with \"<slug> - \". It uses a slug-scoped glob when the slug contains no\n// glob metacharacters; otherwise it lists all task files and filters in memory\n// (glob-injection defense). List errors are returned; the caller logs them once.\nfunc listSameSlugCandidateTitles(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tslug string,\n) ([]string, error) {\n\tprefix := slug + \" - \"\n\tvar glob string\n\tif strings.ContainsAny(slug, \"*?[]\\\\\") {\n\t\tglob = filepath.Join(taskDir, \"*.md\")\n\t\tglog.V(2).Infof(\n\t\t\t\"auto-supersede: slug %q contains glob metacharacters; falling back to list-all + in-memory filter\",\n\t\t\tslug,\n\t\t)\n\t} else {\n\t\tglob = filepath.Join(taskDir, slug+\" - *.md\")\n\t\tglog.V(3).Infof(\"auto-supersede: listing slug-scoped glob %q\", glob)\n\t}\n\trelPaths, err := gitClient.ListFiles(ctx, glob)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar titles []string\n\tfor _, relPath := range relPaths {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\ttitle := strings.TrimSuffix(filepath.Base(relPath), \".md\")\n\t\tif strings.HasPrefix(title, prefix) {\n\t\t\ttitles = append(titles, title)\n\t\t}\n\t}\n\treturn titles, nil\n}\n\n// collapseCandidates iterates ranked candidates most-recent-first, transitions\n// each still-in_progress candidate older than newOrdinal to aborted, and stops\n// after k candidates have been inspected (read attempted). Best-effort per file.\nfunc collapseCandidates(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\ttaskDir string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tk int,\n\tranked []rankedCandidate,\n\tnewOrdinal int64,\n\tnewRelPath string,\n\tcmd task.CreateCommand,\n) {\n\tinspected := 0\n\tfor _, rc := range ranked {\n\t\tif err := ctx.Err(); err != nil {\n\t\t\treturn\n\t\t}\n\t\tif inspected >= k {\n\t\t\tbreak\n\t\t}\n\t\tif rc.Ordinal > newOrdinal {\n\t\t\tcontinue\n\t\t}\n\t\tinspected++\n\t\tcandidateRelPath := filepath.Join(taskDir, rc.Title+\".md\")\n\t\tif strings.ContainsAny(rc.Title, \"/\\\\\") {\n\t\t\tglog.Warningf(\n\t\t\t\t\"auto-supersede: candidate title %q contains path separator; skipping for %s\",\n\t\t\t\trc.Title, cmd.TaskIdentifier,\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\t\tcontent, err := readPriorForSupersede(ctx, gitClient, candidateRelPath, cmd.TaskIdentifier)\n\t\tif err != nil || content == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif !priorIsInProgress(ctx, content, candidateRelPath, cmd.TaskIdentifier) {\n\t\t\tcontinue\n\t\t}\n\t\ttransitionPrior(\n\t\t\tctx,\n\t\t\tgitClient,\n\t\t\tcurrentDateTime,\n\t\t\tcandidateRelPath,\n\t\t\trc.Title,\n\t\t\tnewRelPath,\n\t\t\tcmd.TaskIdentifier,\n\t\t)\n\t}\n}\n\n// isEligibleForSupersede reports whether cmd is a recurring-task instance\n// that should auto-supersede its prior. Returns true only when created_by is\n// the recurring-task publisher AND auto_abort_prior is explicitly true (opt-in).\n// Returns false (no supersede) when auto_abort_prior is absent or false — the\n// safe default that prevents accidental supersede of audit-style tasks.\nfunc isEligibleForSupersede(cmd task.CreateCommand) bool {\n\tcreatedBy, _ := cmd.Frontmatter.String(\"created_by\")\n\tif createdBy != \"recurring-task-creator\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: skip %s (created_by=%q != recurring-task-creator)\", cmd.TaskIdentifier, createdBy)\n\t\treturn false\n\t}\n\tif b, _ := cmd.Frontmatter[\"auto_abort_prior\"].(bool); b {\n\t\treturn true\n\t}\n\tif s, _ := cmd.Frontmatter[\"auto_abort_prior\"].(string); s == \"true\" {\n\t\treturn true\n\t}\n\tglog.V(3).\n\t\tInfof(\"auto-supersede: skip %s (auto_abort_prior not true — opt-in required)\", cmd.TaskIdentifier)\n\treturn false\n}\n\n// readPriorForSupersede reads the prior file. Returns (nil, nil) on a\n// not-found (first-ever instance — benign no-op). Returns (nil, err) on a\n// transient git-rest error (logged by caller).\nfunc readPriorForSupersede(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) ([]byte, error) {\n\tcontent, err := gitClient.ReadFile(ctx, priorRelPath)\n\tif err == nil {\n\t\treturn content, nil\n\t}\n\tif isNotFoundReadError(err) {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: no prior instance at %s for %s (first-ever instance)\", priorRelPath, taskIdentifier)\n\t\treturn nil, nil\n\t}\n\tglog.Warningf(\n\t\t\"auto-supersede: read prior %s failed for %s: %v\",\n\t\tpriorRelPath,\n\t\ttaskIdentifier,\n\t\terr,\n\t)\n\treturn nil, err\n}\n\n// priorIsInProgress parses the prior file's frontmatter and reports whether\n// its status is in_progress. Returns false (no-op) on parse error or any\n// non-in_progress status.\nfunc priorIsInProgress(\n\tctx context.Context,\n\tcontent []byte,\n\tpriorRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) bool {\n\tfrontmatterStr, err := result.ExtractFrontmatter(ctx, content)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: extract frontmatter from prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tpriorFm, err := parseTaskFrontmatter(frontmatterStr)\n\tif err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: parse prior frontmatter %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn false\n\t}\n\tstatus, _ := priorFm.String(\"status\")\n\tif status != \"in_progress\" {\n\t\tglog.V(3).\n\t\t\tInfof(\"auto-supersede: prior %s status=%q (not in_progress), no-op for %s\", priorRelPath, status, taskIdentifier)\n\t\treturn false\n\t}\n\treturn true\n}\n\n// transitionPrior performs the read-modify-write that transitions the prior\n// file to aborted. Best-effort: write errors are logged and swallowed.\nfunc transitionPrior(\n\tctx context.Context,\n\tgitClient gitclient.GitClient,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n\tpriorRelPath string,\n\tpriorTitle string,\n\tnewRelPath string,\n\ttaskIdentifier lib.TaskIdentifier,\n) {\n\tts := currentDateTime.Now().UTC().Format(time.RFC3339)\n\tpriorAbsPath := filepath.Join(gitClient.Path(), priorRelPath)\n\tmodify := buildSupersedeModifyFn(ctx, newRelPath, ts)\n\tmsg := \"[agent-task-controller] auto-supersede prior recurring task \" + priorTitle\n\tif err := gitClient.AtomicReadModifyWriteAndCommitPush(ctx, priorAbsPath, modify, msg); err != nil {\n\t\tglog.Warningf(\n\t\t\t\"auto-supersede: write prior %s failed for %s: %v\",\n\t\t\tpriorRelPath,\n\t\t\ttaskIdentifier,\n\t\t\terr,\n\t\t)\n\t\treturn\n\t}\n\tglog.V(2).Infof(\n\t\t\"auto-supersede: %s -> %s (prior superseded by new instance)\",\n\t\tpriorRelPath,\n\t\tnewRelPath,\n\t)\n}\n\n// buildSupersedeModifyFn builds the modify closure for AtomicReadModifyWriteAndCommitPush\n// that transitions a prior-period recurring-task instance to aborted.\nfunc buildSupersedeModifyFn(\n\tctx context.Context,\n\tnewRelPath string,\n\tts string,\n) func([]byte) ([]byte, error) {\n\treturn func(current []byte) ([]byte, error) {\n\t\tfmStr, err := result.ExtractFrontmatter(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract frontmatter\")\n\t\t}\n\t\tbody, err := result.ExtractBody(ctx, current)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"extract body\")\n\t\t}\n\t\tfm, err := parseTaskFrontmatter(fmStr)\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse frontmatter\")\n\t\t}\n\t\tfm[\"status\"] = \"aborted\"\n\t\tfm[\"phase\"] = \"done\"\n\t\tfm[\"completed_date\"] = ts\n\t\tfm[\"superseded_by\"] = newRelPath\n\t\tfm[\"created_by\"] = \"recurring-task-creator\"\n\t\treturn marshalFileContent(ctx, fm, body)\n\t}\n}\n","numLines":598,"startLine":1,"totalLines":598}}}
