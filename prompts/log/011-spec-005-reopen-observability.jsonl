r).NotTo(HaveOccurred())\n384\t\t\t\t\t\t_, _, content1, _ := fakeGit.AtomicWriteAndCommitPushArgsForCall(1)\n385\t\n386\t\t\t\t\t\tExpect(content1).To(Equal(content0))\n387\t\t\t\t\t},\n388\t\t\t\t)\n389\t\t\t})\n390\t\n391\t\t\tContext(\"reopen then replay is idempotent\", func() {\n392\t\t\t\tIt(\n393\t\t\t\t\t\"reopens a terminal file once, then holds the path on replay (AC replay-idempotency)\",\n394\t\t\t\t\tfunc() {\n395\t\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n396\t\t\t\t\t\t\t0,\n397\t\t\t\t\t\t\t[]byte(\n398\t\t\t\t\t\t\t\t\"---\\ntask_identifier: replay-old\\nassignee: alice\\nstatus: completed\\n---\\nbody\\n\",\n399\t\t\t\t\t\t\t),\n400\t\t\t\t\t\t\tnil,\n401\t\t\t\t\t\t)\n402\t\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n403\t\t\t\t\t\t\t1,\n404\t\t\t\t\t\t\t[]byte(\"---\\nstatus: next\\n---\\n\"),\n405\t\t\t\t\t\t\tnil,\n406\t\t\t\t\t\t)\n407\t\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n408\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"replay-idempotent\"),\n409\t\t\t\t\t\t\tTitle:          \"Replay Idempotent\",\n410\t\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n411\t\t\t\t\t\t})\n412\t\t\t\t\t\t// First handle: terminal file → reopen → write.\n413\t\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n414\t\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n415\t\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(1))\n416\t\t\t\t\t\t// Replay: just-written non-terminal content → hold path.\n417\t\t\t\t\t\t_, _, err = executor.HandleCommand(ctx, nil, cmdObj)\n418\t\t\t\t\t\tExpect(err).To(HaveOccurred())\n419\t\t\t\t\t\talreadyExists := errors.Is(err, task.ErrTaskAlreadyExists)\n420\t\t\t\t\t\tExpect(alreadyExists).To(BeTrue())\n421\t\t\t\t\t\tExpect(\n422\t\t\t\t\t\t\tfakeGit.AtomicWriteAndCommitPushCallCount(),\n423\t\t\t\t\t\t).To(Equal(1))\n424\t\t\t\t\t\t// unchanged across replay\n425\t\t\t\t\t},\n426\t\t\t\t)\n427\t\t\t})\n428\t\n429\t\t\tContext(\"success: