sk-abc\")\n587\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n588\t\t\t\t\t\tTaskIdentifier: taskID,\n589\t\t\t\t\t\tTitle:          \"New Task ABC\",\n590\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n591\t\t\t\t\t\t\t\"assignee\": \"claude\",\n592\t\t\t\t\t\t\t\"status\":   \"next\",\n593\t\t\t\t\t\t},\n594\t\t\t\t\t\tBody: \"This is the task body.\\n\",\n595\t\t\t\t\t})\n596\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n597\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n598\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1))\n599\t\n600\t\t\t\t\t_, absPath, content, message := fakeGit.AtomicWriteIfAbsentAndCommitPushArgsForCall(\n601\t\t\t\t\t\t0,\n602\t\t\t\t\t)\n603\t\t\t\t\tExpect(absPath).To(HaveSuffix(\"New Task ABC.md\"))\n604\t\t\t\t\tExpect(message).To(ContainSubstring(string(taskID)))\n605\t\n606\t\t\t\t\tcontentStr := string(content)\n607\t\t\t\t\tExpect(contentStr).To(HavePrefix(\"---\\n\"))\n608\t\t\t\t\tExpect(strings.Count(contentStr, \"---\")).To(BeNumerically(\">=\", 2))\n609\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"task_identifier:\"))\n610\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"assignee:\"))\n611\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"status:\"))\n612\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"target_vault: openclaw\"))\n613\t\t\t\t\tExpect(contentStr).To(ContainSubstring(\"This is the task body.\"))\n614\t\t\t\t})\n615\t\t\t})\n616\t\n617\t\t\tContext(\"git write error\", func() {\n618\t\t\t\tIt(\"returns a wrapped error when AtomicWriteIfAbsentAndCommitPush fails\", func() {\n619\t\t\t\t\tfakeGit.AtomicWriteIfAbsentAndCommitPushReturns(errors.New(\"git push failed\"))\n620\t\n621\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n622\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"error-task\"),\n623\t\t\t\t\t\tTitle:          \"Error Task\",\n624\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n625\t\t\t\t\t\t\t\"assignee\": \"claude\",\n626\t\t\t\t\t\t\t\"s