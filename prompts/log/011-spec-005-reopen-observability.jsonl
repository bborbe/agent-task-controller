executor.HandleCommand(ctx, nil, cmdObj)\n152\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n153\t\t\t\t\tExpect(fakeGit.AtomicWriteIfAbsentAndCommitPushCallCount()).To(Equal(1))\n154\t\t\t\t})\n155\t\t\t})\n156\t\n157\t\t\tContext(\"missing status in frontmatter\", func() {\n158\t\t\t\tIt(\"returns a validation error without writing\", func() {\n159\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n160\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"my-task-id\"),\n161\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n162\t\t\t\t\t\t\t\"assignee\": \"claude\",\n163\t\t\t\t\t\t},\n164\t\t\t\t\t})\n165\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n166\t\t\t\t\tExpect(err).To(HaveOccurred())\n167\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"status\"))\n168\t\t\t\t\tExpect(fakeGit.AtomicWriteAndCommitPushCallCount()).To(Equal(0))\n169\t\t\t\t})\n170\t\t\t})\n171\t\n172\t\t\tContext(\"title path already occupied (collision)\", func() {\n173\t\t\t\tIt(\"returns ErrTaskAlreadyExists and does not write (AC2)\", func() {\n174\t\t\t\t\t// Second ReadFile call returns existing content → collision on replay.\n175\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(0,\n176\t\t\t\t\t\tnil, errors.New(\"GET 24 Tasks/Replay Task.md returned 404: not found\"))\n177\t\t\t\t\tfakeGit.ReadFileReturnsOnCall(\n178\t\t\t\t\t\t1,\n179\t\t\t\t\t\t[]byte(\n180\t\t\t\t\t\t\t\"---\\ntask_identifier: replay-task\\nassignee: claude\\nstatus: next\\n---\\n\",\n181\t\t\t\t\t\t),\n182\t\t\t\t\t\tnil,\n183\t\t\t\t\t)\n184\t\n185\t\t\t\t\tcmdObj := buildCmdObj(task.CreateCommand{\n186\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"replay-task\"),\n187\t\t\t\t\t\tTitle:          \"Replay Task\",\n188\t\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\", \"status\": \"next\"},\n189\t\t\t\t\t})\n190\t\n191\t\t\t\t\t// First create: file not found → writes via create-only.\n192\t\t\t\t\t_, _, err := executor.HandleCommand(ctx, nil, cmdObj)\n193\t\t\t\t\tExpect(err).NotTo(HaveOc